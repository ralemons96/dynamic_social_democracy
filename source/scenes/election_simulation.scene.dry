title: Election Simulation
set-jump: post_election


- @1928: 1928 historical scenario
- @1930: 1930 historical scenario
- @1932: 1932 (July) historical scenario

@1928
on-arrival: {!
Q.commons = 46; // industry and trade
Q.guild = 13; // "old mittelstand"
// 16.4 trade & commerce, 6.6 public and private services, 4.4 domestic help
Q.burgher = 14; // "new mittelstand"
Q.landed = 25; // agriculture and forestry employment... but many of those are proletarians so...
// source: https://surface.syr.edu/cgi/viewcontent.cgi?filename=3&article=1016&context=books&type=additional page 43, table 3.3
Q.disfavored = 8.6;
Q.faithful = 30;

Q.classes = ['commons', 'guild', 'burgher', 'landed', 'disfavored', 'faithful'];
Q.parties = ['marcher', 'collectivist', 'unionist', 'ddp', 'gold', 'traditionalist', 'royalist', 'other'];

// Support for party by social group
// they don't have to sum to 100 since the electoral calculations will be normalized.
Q.commons_marcher = 65;
Q.commons_collectivist = 20;
Q.commons_unionist = 5;
Q.commons_ddp = 0;
Q.commons_gold = 0;
Q.commons_traditionalist = 5;
Q.commons_royalist = 0;
Q.commons_other = 10;

Q.guild_marcher = 5;
Q.guild_collectivist = 0;
Q.guild_unionist = 5;
Q.guild_ddp= 10;
Q.guild_gold = 25;
Q.guild_traditionalist = 25;
Q.guild_royalist = 10;
Q.guild_other = 10;

Q.burgher_marcher = 5;
Q.burgher_collectivist = 0;
Q.burgher_unionist = 10;
Q.burgher_ddp= 25;
Q.burgher_gold = 25;
Q.burgher_traditionalist = 10;
Q.burgher_royalist = 5;
Q.burgher_other = 15;

Q.landed_marcher = 10;
Q.landed_collectivist = 0;
Q.landed_unionist = 5;
Q.landed_ddp= 5;
Q.landed_gold = 15;
Q.landed_traditionalist = 45;
Q.landed_royalist = 5;
Q.landed_other = 10;

Q.disfavored_marcher = 25;
Q.disfavored_collectivist = 55;
Q.disfavored_unionist = 1;
Q.disfavored_ddp = 0;
Q.disfavored_gold = 0;
Q.disfavored_traditionalist = 5;
Q.disfavored_royalist = 15;
Q.disfavored_other = 9;

Q.faithful_marcher = 15;
Q.faithful_collectivist = 5;
Q.faithful_unionist = 50;
Q.faithful_ddp = 0;
Q.faithful_gold = 5;
Q.faithful_traditionalist = 5;
Q.faithful_royalist = 0;
Q.faithful_other = 10;
!}
go-to: election_algorithm
set-jump: post_election

