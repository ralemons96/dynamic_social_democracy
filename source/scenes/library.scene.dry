            <td style="background-color: rgba(122, 60, 0, 0.2);">[+ guild_royalist_display +]%</td>
            <td style="background-color: rgba(122, 60, 0, 0.2);">[+ landed_royalist_display +]%</td>
            <td style="background-color: rgba(122, 60, 0, 0.2);">[+ disfavored_royalist_display +]%</td>
            <td style="background-color: rgba(122, 60, 0, 0.2);">[+ faithful_royalist_display +]%</td>
        {!</tr>!} ?]
        [? if royalist_split: {!<tr>!}
            <td><span style="color: #7A3C00;">**Royalists**</span></td>
            <td style="background-color: rgba(106, 30, 30, 0.2); padding: 10px;">[+ commons_royalist_display +]%</td>
            <td style="background-color: rgba(106, 30, 30, 0.2);">[+ burgher_royalist_display +]%</td>
            <td style="background-color: rgba(122, 60, 0, 0.2);">[+ guild_royalist_display +]%</td>
            <td style="background-color: rgba(122, 60, 0, 0.2);">[+ landed_royalist_display +]%</td>
            <td style="background-color: rgba(20, 46, 32, 0.2);">[+ disfavored_royalist_display +]%</td>
            <td style="background-color: rgba(122, 60, 0, 0.2);">[+ faithful_royalist_display +]%</td>
        {!</tr>!} ?]
        <tr>
            <td>**Others**</td>
            <td style="background-color: rgba(153, 153, 153, 0.1); padding: 10px;">[+ commons_other_display +]%</td>
            <td style="background-color: rgba(153, 153, 153, 0.1);">[+ burgher_other_display +]%</td>
            <td style="background-color: rgba(153, 153, 153, 0.1);">[+ guild_other_display +]%</td>
            <td style="background-color: rgba(153, 153, 153, 0.1);">[+ landed_other_display +]%</td>
            <td style="background-color: rgba(153, 153, 153, 0.1);">[+ disfavored_other_display +]%</td>
            <td style="background-color: rgba(153, 153, 153, 0.1);">[+ faithful_other_display +]%</td>
        </tr>
    </table>
</div>

@parties
go-to: menu

[? if gnu_formed: <span style="color: #BFC8CC;">**GNU**</span> - (Commonwealth National Unity Front) - A "presidential" party founded by Chancellor Kurt von Staal and his allies, this movement embraces a syncretic ideology that defies easy categorization within the political spectrum. At its core, it is built on militarism, nationalism, and corporatism. The party garners support from urbanites, blue-collar workers, the middle classes, and even some of the unemployed, all united by their shared loyalty to the chancellor. ?]

[? if gnu_formed: Current relations: [+ gnu_relation : relationships +] ?]

<span style="color: #c00000;">**Marchers**</span> - (Reformist Party of the Commonwealth) - this is us. We are a Reformist and democratic party of the working class. We are the heirs to the first reformers — to Corwin Vael, who gave the Commons its creed, and to the tribunes who carried it into the old Empire's Assembly. We are the foremost defenders of the Republic. The modern <span style="color: #c00000;">**Marchers**</span> was formed from the reunion of the "Patriot" <span style="color: #c00000;">**Marchers**</span>, who backed the Second Great War, and the "Independent" wing, who opposed it.

[? if not concord_formed: [? if started: <span style="color: #000000;">**[+ unionist_party_name +]**</span>?][? if not started: <span style="color: #000000;">**Unionists**</span>?] - ([? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">Faithful People's Party</span>?]) - a centrist to center-right Faithful party that supports the Republic, and has historically supported many of our labor, welfare, and anti-militarist priorities. They have often been in coalitions with us. They are often associated with the <span style="color: #A2D8E0;">**Arcanists**</span> (the Arcanists), which represents Faithful in <span style="color: #00CCFF;">Avriza</span>. [? if (year >= 1930 or chancellor == "Askew") and unionist_leader == "Renck": They have appeared to take a more conservative turn recently, with the rise of Askew and the party leader, Aurelian Renck. ?][? if (year >= 1930 or chancellor == "Askew") and unionist_leader == "Sedgewick": They have appeared to take a more conservative turn recently, with the rise of Askew and the party leader, Adam Sedgewick, who has taken a focus on interfaithizing the party. ?][? if (year >= 1930 or chancellor == "Askew") and unionist_leader == "Hawkins": They have appeared to take a more conservative turn recently, with the rise of Askew and support of austerity. ?][? if year >= 1930 and unionist_leader == "Stilling": They have appeared to take a more leftist turn recently, with the election of Aldwin Stilling and support of certain left-wing economic policies. ?]?]

[? if concord_formed: <span style="color: #000000;">**[+ unionist_party_name +]**</span> - (Faithful People's Party) - a center-right to right-wing Faithful party formed out of a merger between the Faithful <span style="color: #000000;">Unionist Party</span> and right-wing dissenting <span style="color: #3E88B3;">**Traditionalists**</span>. Our relations are much rockier than they were with the <span style="color: #000000;">Unionists</span>. They are often associated with the <span style="color: #A2D8E0;">**Arcanists**</span> (the Arcanists), which represents Faithful in <span style="color: #00CCFF;">Avriza</span>. The party is split into many factions, being largely divided by religion and former party status. [? if concord_ideology == "Left" or concord_ideology == "Moderate": The party seeks to emulate the <span style="color: #0087DC;">Tory</span> conservatives in <span style="color: #C8102E;">Fulyria</span>?][? if concord_ideology == "Right": The party's current ideology is not too dissimilar to that of the former <span style="color: #3E88B3;">**Traditionalists**</span>?]. ?]

Current relations: [+ unionist_relation : relationships +]

[? if not lvp_formed: [? if started: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if not started: <span style="color: #D3C24D;">**Golds**</span> ?] - [? if ddp_name == "Gold" or not ddp_name: (Commonwealth Democratic Party)?][? if ddp_name == "DStP": (Commonwealth State Party)?] - [? if ddp_name == "Gold" or not ddp_name: a left-liberal party, popular among the intelligentsia and educated middle class. Although, they have been shifting towards the right over the years. They have often been in coalitions with us. ?][? if ddp_name == "DStP": a liberal party, waning in popularity among the intelligentsia and middle class. [? if dstp_collapsed == 0: They have shifted considerably to the right in recent years and have merged with the political wing of the supremacist Young Commonwealth Order in an effort to revive their party.?][? if dstp_collapsed == 1: They have shifted considerably to the right in recent years and have merged with the political wing of the supremacist Young Commonwealth Order in an effort to revive their party. Furthermore, the Young Commonwealth Order has broken off, essentially just leaving the <span style="color: #D3C24D;">**Golds**</span> with a different name.?] They have often been in coalitions with us. ?] ?]

[? if not lvp_formed: Current relations: [+ ddp_relation : relationships +] ?]

[? if not lvp_formed and gold_exist: <span style="color: #C0A054;">**Golds**</span> - (Commonwealth People's Party) - a conservative-liberal party founded by Gustav Stratton, supported by the middle classes, Burghers and guild-masters. The industrial and right wing of the party has been gaining noticeable influence in recent years with Stratton's neglect of party affairs. [? if gold_ideology == "Right": The industrial wing of the party has succeeded in it's takeover of the party and are much less inclined to work with us.?] We have occasionally been in coalitions. ?]

[? if not lvp_formed and gold_exist: Current relations: [+ gold_relation : relationships +] ?]

[? if lvp_formed: <span style="color: #C0A054;">**Golds**</span> - a liberal party, popular among the propertied and the middle class. Formed from a merger of the two former liberal parties, the left-liberal <span style="color: #D3C24D;">**[+ ddp_name +]**</span> and conservative-liberal <span style="color: #C0A054;">**Golds**</span>. Its predecessors have often been in coalitions with us. ?]

[? if lvp_formed: Current relations: [+ lvp_relation : relationships +] ?]

[? if kvp_formed: <span style="color: #0087DC;">**KVP**</span> - (Conservative People's Party) - a moderate right-wing conservative nationalist party, supported by rural workers, former aristocracy, landowners and conservative dissenters. The party seeks to emulate the <span style="color: #0087DC;">Tory</span> conservatives in <span style="color: #C8102E;">Fulyria</span>. ?]

[? if kvp_formed: Current relations: [+ kvp_relation : relationships +] ?]

[? if not concord_formed: <span style="color: #3E88B3;">**Traditionalists**</span> - (Commonwealth National People's Party) - a right-wing party of **Aristocratic Nationalism**, with authoritarian, monarchist, and racist elements. It is supported by the former aristocracy, rural landowners, and conservative dissenters. [? if traditionalist_gold_formed: They have recently merged with the <span style="color: #C0A054;">**Golds**</span>. ?]?]

[? if not concord_formed: Current relations: [+ traditionalist_relation : relationships +]?]

[? if dnf_formed: <span style="color: #003755;">**DNF**</span> - (Commonwealth National Front) - a far-right nationalist-conservative party, led by Alfred Mallin, originally split from the <span style="color: #3E88B3;">**Traditionalists**</span>. It is supported by a small but loyal base of Mallin supporters, consisting of former aristocrats, racists and nationalists. ?]

[? if dnf_formed: Current relations: [+ dnf_relation : relationships +] ?]

<span style="color: #700000;">**Collectivists**</span> - (Commonwealth Collectivist Party) - a radical left-wing offshoot of the <span style="color: #c00000;">**Marchers**</span> that emerged from the turmoil of the Founding. They reject parliamentary democracy, calling instead for a second revolution — a Second Republic that would sweep away the merchant-barons, the reactionary generals, and the old elites who, they say, corrupt the Commonwealth from within. Their creed, **Collectivism**, is Reformism pursued by revolution rather than the ballot.

Current relations: [+ collectivist_relation : relationships +]

[? if sapd_formed: <span style="color: #9B0000;">**Laborists**</span> - (Reformist Worker's Party of the Commonwealth) - a party recently formed in a split from the <span style="color: #c00000;">**Marchers**</span>, the <span style="color: #9B0000;">**Laborists**</span> is essentially an agglomeration of various left-wing splinter groups between the <span style="color: #c00000;">**Marchers**</span> and <span style="color: #700000;">**Collectivists**</span>. ?]

<span style="color: #7A3C00;">**Royalists**</span> - (Imperial Sovereigntist Commonwealth Worker's Party, or <span style="color: #7A3C00;">Royalists</span>) - a far-right party of **Imperial Sovereigntism** — nationalist and monarchist — that would see the Empire restored, and its old hierarchy of blood with it. Led by Alaric Gallax, they attempted a coup in 4288, and were banned for it, but have since been legalized.

Current relations: [+ royalist_relation : relationships +]

**Other parties** - there is a multitude of small, mostly conservative parties, such as the Economic Party of the Commonwealth Middle Class, the Farmer's Party, the Agricultural League, and others. [? if traditionalist_split == 1: They also consist of splinter parties from the <span style="color: #3E88B3;">**Traditionalists**</span>, as a result of Mallin's radical right policies as chairman. ?]Their political position usually lies between the [? if (gold_exist and not lvp_formed) or not started: <span style="color: #C0A054;">**Golds**</span>?][? if lvp_formed: <span style="color: #C0A054;">**Golds**</span>?][? if not gold_exist and started: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>?] and the [? if not concord_formed: <span style="color: #3E88B3;">**Traditionalists**</span>?][? if concord_formed: <span style="color: #003755;">**DNF**</span>?].

@paramilitaries
on-arrival: {!
Q.banner_strength = Math.round(Q.banner_strength);
Q.warden_strength = Math.round(Q.warden_strength);
Q.loyalist_strength = Math.round(Q.loyalist_strength); 
Q.vanguard_strength = Math.round(Q.vanguard_strength); 
!}
go-to: menu

**Paramilitary groups:**

**the Banners** <span style="color: #000000;"><b>Schwarz</b></span>-<span style="color: #DD0000;"><b>Rot</b></span>-<span style="color: #FFCC00;"><b>Gold</b></span>: The Banners are an organization affiliated with all of the democratic parties - the <span style="color: #c00000;">**Marchers**</span>, <span style="color: #000000;">**[+ unionist_party_name +]**</span>, and [? if lvp_formed: the former ?]<span style="color: #D3C24D;">**[+ ddp_name +]**</span>, but primarily with the <span style="color: #c00000;">**Marchers**</span>. Historically, this has been an unarmed organization.

Strength: [+ banner_strength +] thousand

Militarization: [+ banner_militancy : militancy +]

**the Vanguard**: The "Red Front", the paramilitary associated with the <span style="color: #700000;">**Collectivists**</span>.

Strength: [+ vanguard_strength +] thousand

Militarization: [+ vanguard_militancy : militancy +]

**the Wardens**: A <span style="color: #3E88B3;">right-wing nationalist</span> organization of primarily Great War veterans, descended from the *officer-militias* that emerged after the war. [? if not concord_formed: Associated with the <span style="color: #3E88B3;">**Traditionalists**</span>.?][? if concord_formed: Associated with the <span style="color: #000000;">**[+ unionist_party_name +]**</span> and <span style="color: #003755;">**DNF**</span>.?]

Strength: [+ warden_strength +] thousand

Militarization: [+ warden_militancy : militancy +]

**the Loyalists**: This is the <span style="color: #7A3C00;">Royalist</span> paramilitary group.

Strength: [+ loyalist_strength +] thousand

Militarization: [+ loyalist_militancy : militancy +]

**Official military/paramilitary groups:**

**Commonwealth Army**: [+ army_strength +] thousand troops. This is the Commonwealth's military.

Loyalty: [+ army_loyalty : loyalty +]

**Heartland police**: [+ heartland_police_strength +] thousand members.

Loyalty: [+ heartland_police_loyalty : loyalty +]



@factions

**Internal factions of the** <span style="color: #c00000;">**Marchers**</span>

Overall dissent: [+ dissent_percent : dissent +]

**Left**

Many leftists are former members of the <span style="color: #D47B9B;">**USPD**</span> (the left-wing, anti-war <span style="color: #D47B9B;">Independent Reformist Party</span>), or are young radicals. Many are interested in closer cooperation with the <span style="color: #700000;">**Collectivists**</span>, and some support extra-parliamentary action.

Strength: [+ left_strength : strength +]

Dissent: [+ left_dissent : dissent +]

**Centrists**

Centrists in the <span style="color: #c00000;">**Marchers**</span> are followers of the doctrine of orthodox <span style="color: #9B0000;">Vaelism</span> as expounded by Corwin Vael and later Vendrin Bell. They seek a middle course between reform and revolution, while defending the democratic state.

Strength: [+ center_strength : strength +]

Dissent: [+ center_dissent : dissent +]

**Labor**

Many <span style="color: #c00000;">**Marchers**</span> members are also part of the Greater Worker's Guild, the federation of Free Guilds. Their goal is economic reform and benefits for organized workers.

Strength: [+ labor_strength : strength +]

Dissent: [+ labor_dissent : dissent +]

**Revisionists**

Revisionists are pragmatic participants in government, and seek to expand the welfare state and defend democracy against the <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span> and <span style="color: #700000;">left</span>. [? if marcher_heartland : They are dominant in the state government of Heartland. ?]

Strength: [+ reformist_strength : strength +]

Dissent: [+ reformist_dissent : dissent +]

[? if neorevisionism: **Neorevisionists** ?]

[? if neorevisionism: Neorevisionists focus on defending the republic and expanding democracy, while also expanding the party's base beyond the working class to create a people's party. They support new propaganda methods and extra-parliamentary action in defense of the republic. ?]

[? if neorevisionism: Strength: [+ knight_strength : strength +] ?]

[? if neorevisionism: Dissent: [+ knight_dissent : dissent +] ?]

[? if social_patriot: **Social Patriots** ?]

[? if social_patriot: Social Patriots combine support for pro-worker social programs with fervent Commonwealth nationalism and anti-<span style="color: #700000;">collectivism</span>. Many of those who identify with this tendency seem to be little more than lapdogs of Staal[? if gnu_formed :&nbsp;and his <span style="color: #BFC8CC;">**GNU**</span>?]. Other factions view their positions as contradictory and incoherent[? if staal_marcher_influence > 5 :, but perhaps they may know best after all..?]. ?]

[? if social_patriot: Strength: [+ social_patriot_strength : strength +] ?]

[? if social_patriot: Dissent: [+ social_patriot_dissent : dissent +] ?]

@figures
title: Figures and Charts
go-to: menu
on-arrival: {!
Q.unionist_minus_bvp_votes = parseFloat((Q.unionist_votes - Q.bvp_votes).toFixed(1));
Q.unionist_minus_bvp_r = parseFloat((Q.unionist_r - Q.bvp_r).toFixed(1));
if (Q.bvp_r == Q.unionist_r) Q.unionist_minus_bvp_r = 0;
!}
on-display: {!
const data = [];

if (Q.collectivist_r) {
    data.push({
        "id": "collectivist",
        "legend": "Collectivist",
        "name": "Collectivist",
        "seats": Math.round(Q.collectivist_r * Q.reichstag_size),
    });
}

if (Q.sapd_r && Q.sapd_formed) {
    data.push({
        "id": "sapd",
        "legend": "Laborists",
        "name": "Laborists",
        "seats": Math.round(Q.sapd_r * Q.reichstag_size),
    });
}

if (Q.marcher_r && !Q.rdp_r) {
    data.push({
        "id": "marcher",
        "legend": "Marcher",
        "name": "Marcher",
        "seats": Math.round(Q.marcher_r * Q.reichstag_size),
    });
} else if (Q.marcher_r && Q.rdp_r) {
    data.push({
        "id": "marcher",
        "legend": "Marcher",
        "name": "Marcher",
        "seats": Math.round((Q.marcher_r - Q.rdp_r) * Q.reichstag_size),
    });
}

if (Q.rdp_r) {
    data.push({
        "id": "rdp",
        "legend": "RDP",
        "name": "RDP",
        "seats": Math.round(Q.rdp_r * Q.reichstag_size),
    });
}

if (Q.traditionalist_r && Q.traditionalist_wholesome) {
    data.push({
        "id": "traditionalist_wholesome",
        "legend": "Traditionalist",
        "name": "Traditionalist",
        "seats": Math.round(Q.traditionalist_r * Q.reichstag_size),
    });
}

if (Q.ddp_r && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r * Q.reichstag_size),
    });
}

if (Q.lvp_r && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r * Q.reichstag_size),
    });
}


if (Q.unionist_minus_bvp_r) {
    data.push({
        "id": "unionist",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(Q.unionist_minus_bvp_r * Q.reichstag_size),
    });
}

if (Q.bvp_r) {
    data.push({
        "id": "bvp",
        "legend": "Arcanists",
        "name": "Arcanists",
        "seats": Math.round(Q.bvp_r * Q.reichstag_size),
    });
}

if (Q.gold_r && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "gold",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r * Q.reichstag_size),
    });
}

if (Q.left_gnu_r && Q.left_gnu) {
    data.push({
        "id": "left_gnu",
        "legend": "Left_DNEF",
        "name": "Left_DNEF",
        "seats": Math.round(Q.left_gnu_r * Q.reichstag_size),
    });
}

if (Q.true_gnu_r && Q.gnu_formed && !Q.right_gnu && !Q.left_gnu) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round(Q.true_gnu_r * Q.reichstag_size),
    });
}

if (Q.true_gnu_r && Q.gnu_formed && Q.right_gnu && !Q.left_gnu) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round((Q.true_gnu_r - Q.right_gnu_r) * Q.reichstag_size),
    });
}

if (Q.true_gnu_r && Q.gnu_formed && !Q.right_gnu && Q.left_gnu) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round((Q.true_gnu_r - Q.left_gnu_r) * Q.reichstag_size),
    });
}

if (Q.right_gnu_r && Q.right_gnu) {
    data.push({
        "id": "right_gnu",
        "legend": "Right_DNEF",
        "name": "Right_DNEF",
        "seats": Math.round(Q.right_gnu_r * Q.reichstag_size),
    });
}

if (Q.wp_r) {
    data.push({
        "id": "wp",
        "legend": "WP",
        "name": "WP",
        "seats": Math.round(Q.wp_r * Q.reichstag_size),
    });
}

if (Q.cnblp_r) {
    data.push({
        "id": "farm3",
        "legend": "CNBLP",
        "name": "CNBLP",
        "seats": Math.round(Q.cnblp_r * Q.reichstag_size),
    });
}

if (Q.csvd_r && Q.csvd_formed) {
    data.push({
        "id": "csvd",
        "legend": "CSVD",
        "name": "CSVD",
        "seats": Math.round(Q.csvd_r * Q.reichstag_size),
    });
}

if (Q.other_r) {
    data.push({
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.true_other_r * Q.reichstag_size),
    });
}

if (Q.true_aspd_r && (Q.aspd_other || Q.aspd_kvp)) {
    data.push({
        "id": "aspd",
        "legend": "ASPD",
        "name": "ASPD",
        "seats": Math.round(Q.true_aspd_r * Q.reichstag_size),
    });
}

if (Q.kvp_formed && Q.kvp_r && !Q.aspd_kvp && !Q.traditionalist_gold_formed) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round(Q.kvp_r * Q.reichstag_size),
    });
} else if (Q.kvp_formed && Q.kvp_r && Q.aspd_kvp && !Q.traditionalist_gold_formed) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round((Q.kvp_r - Q.true_aspd_r) * Q.reichstag_size),
    });
}

if (Q.traditionalist_gold_formed) {
    data.push({
        "id": "fkp",
        "legend": "FKP",
        "name": "FKP",
        "seats": Math.round(Q.kvp_r * Q.reichstag_size),
    });
}

if (Q.traditionalist_r && !Q.traditionalist_wholesome) {
    data.push({
        "id": "traditionalist",
        "legend": "Traditionalist",
        "name": "Traditionalist",
        "seats": Math.round(Q.traditionalist_r * Q.reichstag_size),
    });
}

if (Q.dnf_formed && Q.dnf_r) {
    data.push({
        "id": "dnf",
        "legend": "DNF",
        "name": "DNF",
        "seats": Math.round(Q.dnf_r * Q.reichstag_size),
    });
}

if (Q.dsu_exist && Q.dsu_r) {
    data.push({
        "id": "dsu",
        "legend": "DSU",
        "name": "DSU",
        "seats": Math.round(Q.dsu_r * Q.reichstag_size),
    });
}

if (Q.royalist_split && Q.royalist_gallax_r) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_gallax_r * Q.reichstag_size),
    });
}

if (!Q.royalist_split && Q.royalist_r) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_r * Q.reichstag_size),
    });
}

if (Q.nvf_exist && Q.nvf_r) {
    data.push({
        "id": "nvf",
        "legend": "NVF",
        "name": "NVF",
        "seats": Math.round(Q.nvf_r * Q.reichstag_size),
    });
}
if (d3 && window) {
    // get screen width
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);

    var lines = d3.linegraph(false, false,
            Q.parties_graph,
            {'marcher': '#E3000F', 'collectivist': '#700000', 'ddp': '#D3C24D', 'unionist': '#000', 'gold': '#D5AC27', 'traditionalist': '#3E88B3', 'royalist': '#7A3C00', 'other': '#a0a0a0', 'sapd': '#9B0000', 'dnf': '#003755', 'kvp': '#0087DC', 'lvp': '#FFCC00', 'gnu': '#BFC8CC', 'fkp': '#00C0FF'},
            {'marcher': 'Marcher', 'collectivist': 'Collectivist', 'ddp': Q.ddp_name, 'unionist': Q.unionist_party_name + ' + Arcanists', 'gold': 'Gold', 'traditionalist': 'Traditionalist', 'royalist': 'Royalist', 'other': 'Others', 'sapd': 'Laborists', 'dnf': 'DNF', 'kvp': 'KVP', 'lvp': 'LVP', 'gnu': 'GNU', 'fkp': 'FKP'});
    lines.width(width).height(400);
    //var svg = lines(Q.election_records);
    if (Q.election_records.length > 0) {
        d3.select("#election_history").datum(Q.election_records).call(lines);
    }
    //document.getElementById('election_history').innerHTML = svg.outerHTML;

    // party support records should not have so many ticks
    if (Q.game_over || (!Q.historical_mode && !Q.rubicon)) {
        var lines_2 = d3.linegraph(true, true,
            Q.parties_graph,
            {'marcher': '#E3000F', 'collectivist': '#700000', 'ddp': '#D3C24D', 'unionist': '#000', 'gold': '#D5AC27', 'traditionalist': '#3E88B3', 'royalist': '#7A3C00', 'other': '#a0a0a0', 'sapd': '#9B0000', 'dnf': '#003755', 'kvp': '#0087DC', 'lvp': '#FFCC00', 'gnu': '#BFC8CC', 'fkp': '#00C0FF'},
            {'marcher': 'Marcher', 'collectivist': 'Collectivist', 'ddp': Q.ddp_name, 'unionist': Q.unionist_party_name + ' + Arcanists', 'gold': 'Gold', 'traditionalist': 'Traditionalist', 'royalist': 'Royalist', 'other': 'Others', 'sapd': 'Laborists', 'dnf': 'DNF', 'kvp': 'KVP', 'lvp': 'LVP', 'gnu': 'GNU', 'fkp': 'FKP'});
        lines_2.width(width).height(400);
        d3.select("#party_support_history").datum(Q.party_support_records).call(lines_2);
    }

    // economic stats
    var minInflation = d3.min(Q.economic_records, d => d.inflation);
    var maxUnemployment = d3.max(Q.economic_records, d => d.unemployment);
    var lines_3 = d3.linegraph(true, true, ['inflation', 'unemployment'],
            {'inflation': '#0000FF', 'unemployment': '#FF0000'},
            {'inflation': 'Inflation', 'unemployment': 'Unemployment'},
            maxUnemployment + 5, minInflation - 5, 21);
    lines_3.width(width).height(300);
    d3.select("#economic_history").datum(Q.economic_records).call(lines_3);
}
!}

