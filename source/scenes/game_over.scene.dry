         style="width: 100%; height: 100%; object-fit: cover; display: block;">
  {!</td>!}
  {!<td style="border: 2px solid #0077FF; background-color: rgba(10, 24, 97, 0.25);">!}
    <div style="padding-left: 0.5em;">
      <div style="font-weight: bold;">Catastrophe Politics</div>
      <div class="achievement_subtitle"> - govern with an <span style="color: #c00000; font-weight: bold;">Marchers</span>-only cabinet after 5 elections or more, with the <span style="color: #c00000; font-weight: bold;">Marchers</span> having never entered toleration or government.
    </div>
  {!</td>!}
{!</tr>!}
?]

