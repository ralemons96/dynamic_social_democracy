         style="width: 100%; height: 100%; object-fit: cover; display: block;">
  {!</td>!}
  {!<td style="border: 2px solid #c00000; background-color: rgba(97, 24, 19, 0.2);">!}
    <div style="padding-left: 0.5em;">
      <div style="font-weight: bold;">Grand Popular Front</div>
      <div class="achievement_subtitle"> - With Hawkins or Stilling leading the <span style="color: #000000;">Unionist Party</span> and the Conciliators leading the <span style="color: #700000; font-weight: bold;">Collectivists</span>, form a government consisting of the <span style="color: #c00000; font-weight: bold;">Marchers</span>, <span style="color: #700000; font-weight: bold;">Collectivists</span>, and <span style="color: #000000; font-weight: bold;">Z</span>.
      </div>
    </div>
  {!</td>!}
{!</tr>!}
?]

