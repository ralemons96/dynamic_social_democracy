title: Game Over.
new-page: true
go-to: eg_menu
on-arrival: {!
Q.game_over = 1;
// Achievements:
// Große Koalition - form a grand coalition
// The Iron Banners - Form the Iron Banner.

// calculate normalized class voting for the achievements
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}

const q = dendryUI.dendryEngine.state.qualities;
const dynamicMode = q.dynamic_mode;
const historicalMode = q.historical_mode;

const newlyAddedAchievements = [];

if (!Array.isArray(Q.initialAchievements)) {
  if (Q.initialAchievements && typeof Q.initialAchievements === "object") {
    Q.initialAchievements = Object.keys(Q.initialAchievements);
  } else {
    Q.initialAchievements = [];
  }
}

for (const key in q) {
  if ((key.startsWith("game_achievement") || key.startsWith("achievement")) && q[key] === 1) {
    if (!Q.initialAchievements.includes(key)) {
      newlyAddedAchievements.push(key);
    }
  }
}

if (!dynamicMode && !historicalMode && Q.difficulty != 1) {
  for (const key of newlyAddedAchievements) {
    q[key] = 0;
  }
}

if ((Q.dynamic_mode || Q.historical_mode || Q.difficulty == 1) && !((Q.year == 1934 && Q.month > 7) || Q.year >= 1935)) {
  // Red Duke of the Heartland - At the end of the game, Lyle Bristol is president, chancellor, and minister-president of prussia at the same time.
  if (Q.president == 'Bristol' && Q.chancellor == 'Bristol' && Q.heartland_leader == "Bristol") {
      this.achieve('red_tzar_of_heartland');
  }
  // Civil War - enter a long civil war.
  if (Q.long_war) {
      this.achieve('civil_war');
  }
  // Victory for the Commonwealth - victory for the republic
  if (Q.republic_victory) {
      this.achieve('victory_for_the_republic');
  }
  // Unity, Justice and Freedom - survive without a civil war.

  // United Front - form a united front with the Collectivists, and win the civil war.

  // Popular Front - form a popular front government, and win the civil war.

  // Economic Policy - enact an economic plan.
  // Economic Miracle - reduce unemployment below 10% and have a non-negative budget by 1933.
  if (Q.year >= 1932  && Q.disfavored < 8.6 && Q.budget > 0 && Q.inflation < 5) {
      this.achieve('wirtschaftswunder');
  }
  // Bulwark of Democracy - resist the Heartland Coup, and win.
  if (Q.republic_victory && Q.resist_coup) {
      this.achieve('bollwerk_der_demokratie');
  }
  // The Imperial Corporal - deport hitler
  // People's Party - form a people's party
  // Harnfell - legalize 2 of homosexual rights and trans rights.
  if (Q.homosexual_rights >= 2) {
      this.achieve('hirschfeld');
  }
  // Mädchen und Uniform - a woman's place is in the the Banners.
  // Equality - Support and enact reforms for women's rights.
  if ((Q.womens_work && Q.womens_rights >= 5) || (Q.abortion_rights && Q.womens_rights >= 3)) {
      this.achieve('equality');
  }

  // Son of His Class - elect Ernst Halsmark as president or chancellor.
  if (Q.chancellor == "Halsmark" || Q.president == "Halsmark") {
      this.achieve('sohn_seiner_klasse');
  }
  // The Red Banner - join the Collectivists in the Laborer's Day march.
  // Majority Party - form an <span style="color: #c00000;">**Marchers**</span> majority government in the Assembly.
  // Panic in the Middle Class - have over 50% of New Middle Class support.
  if (Q.burgher_marcher_normalized && Q.burgher_marcher_normalized >= 50) {
      this.achieve('panik_im_mittelstand');
  }
  // Farmers' Revolution - have over 50% rural support.
  if (Q.landed_marcher_normalized && Q.landed_marcher_normalized >= 50) {
      this.achieve('bauernrevolution');
  }
  if (Q.faithful_marcher_normalized && Q.faithful_marcher_normalized >= 50) {
      this.achieve('katholischer_sozialismus');
  }
  if (Q.commons_marcher_normalized >= 80 && Q.burgher_marcher_normalized <= 20 && Q.guild_marcher_normalized <= 20 && Q.landed_marcher_normalized <= 20) {
      this.achieve('klassenkampf');
  }
  if (Q.commons_marcher_normalized >= 40 && Q.burgher_marcher_normalized >= 40 && Q.guild_marcher_normalized >= 40 && Q.landed_marcher_normalized >= 40) {
      this.achieve('grosse_volkspartei');
  }
  // The Collective Republic - begin the transformation to a socialist economy.
  if (Q.marcher_in_government && ((Q.nationalization_progress >= 2 && Q.economic_democracy >= 3) || (Q.nationalization_progress >= 1 && Q.economic_democracy >= 4))) {
      this.achieve('raterepublik');
  }
  // Polycrisis - survive both a fascist coup and a capital strike.
  if (Q.march_on_berlin_seen && Q.capital_strike_seen && Q.chancellor != "Gallax" && Q.president != "Gallax" && !Q.total_defeat) {
      this.achieve("polykrise");
  }
  // Economic Experiment - implement two different economic plans.
  if ((Q.nationalization_progress >= 1 && Q.wtb_implemented >= 1) || (Q.wtb_implemented >= 1 && Q.moderate_plan_progress >= 1) || (Q.nationalization_progress >= 1 && Q.moderate_plan_progress >= 1)) {
      this.achieve("wirtschaftsexperiment");
  }
  // Syndicalism - support workshop takeovers by workers.
  if (Q.factory_takeovers >= 2) {
      this.achieve("syndikalismus");
  }
  // A Failed Experiment - lose the civil war against Gallax.
  if ((Q.chancellor_party == "Royalist" || Q.chancellor == "Gallax" || Q.president == "Gorrick" || Q.president == "Frask" || Q.president == "Gallax") && Q.total_defeat) {
      this.achieve('stolperstein');
  }
  // The Exetar Program - fulfill the goals of the Heidelberg programm - increase welfare, reform justice, support women's rights, progressive taxation, works councils, build a European  Free Guild.
  if ((Q.welfare > 0 && Q.judicial_reform >= 2 && Q.womens_work >= 1 && Q.family_law >= 1 && Q.upper_tax_rates > Q.lower_tax_rates && Q.works_councils > 0 && Q.eu > 0)) {
      this.achieve('heidelberger_programm');
  }
  if (Q.chancellor == "Aldermoor" && Q.president == "Hewes") {
      this.achieve('traumteam');
  }
  if ((Q.president != "Hammerton" && Q.president != "Gallax" && Q.president != "Gorrick" && Q.president != "Selden" && Q.chancellor != "Gallax" && !Q.hammerstein_win) && (Q.return_to_normalcy || Q.marcher_votes >= 50 || Q.marcher_r >= 50 && Q.pro_republic >= 80 || Q.royalist_votes < 8) && (Q.marcher_votes >= 50 || Q.marcher_r >= 50) && !Q.civil_war_seen && !Q.rubicon) {
      this.achieve('ldp');
  }
  if (Q.civil_war_seen && Q.long_war && Q.west_aid) {
      this.achieve('der_grosse_neustart');
  }

  const partySupport = {
    nsdap: Q.royalist_r,
    spd: Q.marcher_r,
    kpd: Q.collectivist_r,
    z: Q.unionist_r,
    dnvp: Q.traditionalist_r,
    ddp: Q.ddp_r,
    dvp: Q.gold_r,
    lvp: Q.lvp_r,
    kvp: Q.kvp_r,
    dnf: Q.dnf_r,
    sapd: Q.sapd_r,
    other: Q.other_r,
    dnef: Q.gnu_r,
  };

  const filteredPartySupport = Object.entries(partySupport)
    .filter(([party]) => Q.parties.includes(party))
    .filter(([_, value]) => typeof value === 'number' && !isNaN(value));

  const sortedParties = filteredPartySupport.sort((a, b) => b[1] - a[1]);

  const thelargestparty = sortedParties[0]?.[0] ?? null;

  const secondLargestParty = sortedParties[1]?.[0] ?? null;

  if (thelargestparty === 'lvp') {
    Q.the_largest_party = 'lvp';
  }

  if (secondLargestParty === 'traditionalist') {
    Q.second_largest_party = 'traditionalist';
  }

  if (Q.true_christian_democracy && Q.traditionalist_leader == "Trevannon" && Q.second_largest_party == "traditionalist") {
      this.achieve('deutsche_tory_demokratie');
  }

  if (Q.schwarze_null && (Q.nationalization_progress >= 4 || Q.wtb_implemented >= 4)) {
      this.achieve('schwarze_null');
  }

  if (Q.traditionalist_leader == "Maine" && Q.traditionalist_r >= 20 && Q.commons_traditionalist_normalized >= Q.commons_marcher_normalized && Q.commons_traditionalist_normalized >= Q.commons_collectivist_normalized && Q.commons_traditionalist_normalized >= Q.commons_unionist_normalized && Q.commons_traditionalist_normalized >= Q.commons_royalist_normalized) {
      this.achieve('neue_arbeiterpartei');
  }

  if (Q.ddp_r >= 8 && Q.ddp_r >= (Q.gold_r * 2) && Q.gold_exist && !Q.lvp_formed) {
      this.achieve('linksliberale_renaissance');
  }

  if (Q.unionist_relation <= 5 && ((Q.ddp_relation <= 5 && (Q.gold_relation <= 5 || !Q.gold_exist) && !Q.lvp_formed) || Q.lvp_relation <= 5 && Q.lvp_formed) && Q.collectivist_relation <= 5 && (Q.kvp_relation <= 5 || !Q.kvp_formed) && Q.traditionalist_relation <= 5 && Q.royalist_relation <= 5 && (Q.gnu_relation <= 5 || !Q.gnu_formed)) {
      this.achieve('wer_braucht_schon_freunde');
  }

  if (Q.ddp_ideology == "Right" && !Q.dstp_formed && Q.gold_ideology == "Left" && Q.gold_exist && !Q.lvp_formed) {
  }

  if (Q.gov_burden_fail >= 10 && Q.in_marcher_majority) {
      this.achieve('leere_parolen');
  }

  if (Q.eu && !Q.eu_negotiation) {
      this.achieve('weltfrieden');
  }

  if (Q.bavaria_marcher && Q.wurttemberg_marcher && (Q.thuringia_marcher || Q.red_thuringia) && (Q.saxony_marcher || Q.red_saxony) && Q.marcher_heartland) {
      this.achieve('staatspolitiker');
  }

  if (Q.polizeistaat) {
      this.achieve('polizeistaat');
  }

  if (Q.president == "Hewes" && Q.chancellor == "Aldermoor" && Q.unionist_leader == "Aldermoor" && Q.unionist_party_name == "Concord" && Q.lvp_formed && Q.constitutional_reform >= 3 && !Q.royalist_r && !Q.collectivist_r && Q.neorevisionism && Q.reformist_strength >= Q.left_strength && Q.reformist_strength >= Q.center_strength && Q.reformist_strength >= Q.labor_strength) {
      this.achieve('wahre_bundesrepublik');
  }

  if ((Q.kvp_r > Q.traditionalist_r && Q.kvp_formed && Q.kvp_r && !Q.concord_kvp_formed || Q.dnf_r > Q.traditionalist_r && Q.traditionalist_ideology == "Moderate" && Q.dnf_r) && !Q.concord_formed) {
      this.achieve('das_blatt_hat_sich_gewendet');
  }

  if ((Q.royalist_votes < Q.modeerscheinung_check && !Q.rubicon) || (Q.royalist_gallax_votes < Q.modeerscheinung_check && Q.rubicon)) {
      this.achieve('modeerscheinung');
  }

  if (Q.peoples_party && Q.kvp_formed && (Q.lvp_formed || Q.gold_exist) && Q.unionist_party_name == "Concord") {
      this.achieve('volkspartei_fur_das_volk');
  }

  if (Q.war_loans == 0 && !Q.foreign_aid && !Q.eu && !Q.soviet_export && !Q.soviet_aid_forpol && Q.disfavored < 15 && Q.budget > 0 && Q.year >= 1930) {
      this.achieve('wir_schaffen_das');
  }

  if (((Q.ddp_leader == "Lindell" || Q.ddp_leader == "Lüders") && (Q.gold_leader == "Thiel" && Q.gold_exist) && !Q.lvp_formed || ((Q.lvp_leader == "Hewes" || Q.lvp_leader == "Bäumer" || Q.lvp_leader == "Stolper") && Q.lvp_formed)) && Q.true_christian_democracy && Q.traditionalist_leader == "Trevannon" && Q.collectivist_leader == "Conciliators" && (((Q.unionist_leader == "Stilling" || Q.unionist_leader == "Hawkins" && !Q.fake_joos) && !Q.concord_formed) || Q.concord_leader == "Sedgewick" && Q.concord_formed)) {
      this.achieve('blockparteien_parade');
  }

  if 
    (((Q.ddp_leader == "Lindell" || Q.lvp_formed) && (Q.gold_leader == "Thiel" || Q.gold_leader == "Glatzel" || !Q.gold_exist || Q.lvp_formed) && (Q.lvp_leader == "Glatzel" || !Q.lvp_formed)) && ((Q.traditionalist_leader == "Maine" && Q.unionist_leader == "Stilling") && !Q.concord_formed || (Q.concord_leader == "Maine" || Q.concord_leader == "Sedgewick") && Q.concord_formed)) {
      this.achieve('der_arbeiterstaat');
  }

  if (Q.papen_republic_victory && Q.collectivist_explode && Q.gallax_dead) {
      this.achieve('gegen_papen_gallax_thalmann');
  }

  if (Q.president == "Vesh") {
      this.achieve('wels');
  }

  if (Q.sapd_votes > Q.collectivist_votes) {
      this.achieve('kommunistische_alternative');
  }

  if (Q.labor_minister_party == "Marcher" && Q.interior_minister_party == "Marcher" && Q.finance_minister_party == "Marcher" && Q.economic_minister_party == "Marcher" && Q.foreign_minister_party == "Marcher" && Q.justice_minister_party == "Marcher" && Q.agriculture_minister_party == "Marcher" && Q.army_minister_party == "Marcher" && (Q.heartland_leader == "Bristol" || Q.heartland_leader == "Pendrigon") && Q.chancellor_party == "Marcher" && (Q.president == "Bristol" || Q.president == "Pendrigon" && !Q.left_split || Q.president == "Shackley" || Q.president == "Vesh" || Q.president == "Grzesinski" || Q.president == "Jessamy" || (Q.president == "Pendrigon" && !Q.left_split))) {
      this.achieve('die_rote_republik');
  }

  if (Q.guild_marcher_normalized >= 40 && Q.guild_marcher_normalized > Q.commons_marcher_normalized) {
      this.achieve('champagner_sozialisten');
  }

  const achievementsKey = "Reformism: An Alternate History_achievements";

  const rawData = localStorage.getItem(achievementsKey);

  let achievements;
  try {
    achievements = JSON.parse(rawData);
  } catch (e) {
    achievements = null;
  }

  if ((!achievements || achievements.soziale_politik_fur_dich !== 1) && Q.soziale_politik_fur_dich) {
      this.achieve('soziale_politik_fur_dich');
  }

  if (Q.notwendigkeit) {
      this.achieve('notwendigkeit');
  }

  if (Q.president != "Hammerton" && Q.president != "Gallax" && Q.president !=   "Gorrick" && Q.president != "Selden" && Q.chancellor != "Gallax" && !Q.hammerstein_win && !(Q.president == "Hargen" && Q.chancellor == "Selden")) {
    if ((Q.president == "Pendrigon" || Q.president == "Halsmark" || Q.president == "Munzer" || Q.president == "Ostwick" || Q.president == "Mann") && Q.in_left_front && !Q.civil_war_seen) {
      Q.collectivist_points_calc = 0;
      Q.collectivist_points_calc += Q.vanguard_force;
      Q.collectivist_points_calc += (100 - Q.pro_republic) / 2;
      Q.collectivist_points_calc += Q.disfavored / 2;
      Q.collectivist_points_calc += Q.collectivist_votes;
      Q.collectivist_points_calc += Q.soviet_relation;
      if (Q.presid_calcent == "Halsmark") Q.collectivist_points_calc += 16;
      if (Q.president == "Munzer") Q.collectivist_points_calc += 10;
      if (Q.collectivist_leader == "Conciliators") Q.collectivist_points_calc += 6;
      if (Q.sapd_formed) {
        Q.collectivist_points_calc += 2;
        Q.collectivist_points_calc += Q.sapd_votes;
      }
      if (Q.marcher_votes < 26) Q.collectivist_points_calc += 5;
      if (Q.eu) Q.collectivist_points_calc -= 10;
      if (Q.marcher_votes >= 36) Q.collectivist_points_calc -= 5;
      if (Q.marcher_votes >= 40) Q.collectivist_points_calc -= 5;

      if (Q.collectivist_points_calc >= 50) {
        this.achieve('nach_der_marcher_wir');
      } else {
        this.achieve('1919_geracht');
      }
    }
  }
  if (Q.president != "Hammerton" && Q.president != "Gallax" && Q.president != "Gorrick" && Q.president != "Selden" && Q.chancellor != "Gallax" && !Q.hammerstein_win && !(Q.president ==   "Hargen" && Q.chancellor == "Selden")) {
    Q.weimar_win_calc = 1;
  } else {
    Q.weimar_win_calc = 0;
  }
  if ((Q.in_left_front || Q.in_popular_front) && Q.collectivist_coalition_success && Q.wurttemberg_collectivist && Q.bavaria_collectivist && Q.red_thuringia && Q.red_saxony && Q.weimar_win_calc && !Q.collectivist_points_calc && !Q.civil_war_seen && Q.year >= 1934) {
    this.achieve('eurokommunismus');
  }
  if (Q.army_strength >= 200 && Q.disfavored < 15 && Q.budget > 0 && Q.tariffs > 5 && (Q.marcher_in_government || Q.chancellor_party == "Marcher")) {
    this.achieve('kriegswirtschaft');
  }
  if (Q.marcher_votes >= 67 && Q.marcher_r >= 67 && Q.in_social_liberal_coalition) {
    this.achieve('sechs_sieben');
  }
  if (Q.rubicon_mini_trigger && Q.rubicon_mini_leave && Q.chancellor == "Gallax") {
    this.achieve('er_ist_wieder_da');
  }
  if (!Q.hammerstein_win && Q.staal_marcher_concession >= 2) {
    this.achieve('abgrundlaufer');
  }
  if (Q.chancellor == "Askew" && Q.president == "Askew" && Q.heartland_leader == "Askew") {
    this.achieve('bruning_uber_alles');
  }
  if (Q.der_aufstieg_skywalkers) {
    this.achieve('der_aufstieg_skywalkers');
  }
  if (Q.chancellor == "Yardley" && Q.left_cartel_france && Q.reparations_resolved && (Q.sdapo_win || Q.austria_peace) && Q.radio) {
  }
  if (Q.year == 1934 && Q.month == 7 && Q.hilferding_advisor && Q.wels_advisor && Q.kleber_der_partei) {
    this.achieve('kleber_der_partei');
  }
  if (Q.heartland_police_loyalty >= 0.95 && Q.army_loyalty >= 0.95 && Q.interior_police_loyalty >= 0.95 && Q.judicial_reform >= 2 && Q.heartland_purge >= 2) {
    this.achieve('grosse_sauberung');
  }
  if (Q.judicial_reform >= 4 && Q.weltbuhne_dropped == 1 && Q.gallax_deported == 1 && Q.rohm_explode == 1 && Q.heartland_legal_returned == 1 && Q.vanguard_banned == 1) {
    this.achieve('die_rote_justiz');
  }
// Askew der Rotfrontkampfer
// Cole und Eikenvorst
  if (Q.lvp_r == 0 && Q.lvp_formed) {
    this.achieve('lindner_moribund');
  }
  if (Q.the_largest_party == 'lvp') {
    this.achieve('tausendjahrige_libreich');
  }
}
this.achieve('game_completed');
!}

= End

[? if (chancellor == royalist_chancellor or president == "Gallax" or president == "Gorrick" or president == "Frask") and not republic_victory: <iframe src="https://en.wikipedia.org/wiki/The_Holocaust" height="800 " width="545" style=" margin-left: -20px; border: 1px solid #000; "></iframe> ?]

@eg_menu

- #endings
- @ending_slides: View ending slides.
- @modinfo.paths: View completed paths.
- @end_game: End game.


@hitler_wins
view-if: (chancellor == royalist_chancellor or president == "Gallax" or president == "Gorrick" or president == "Frask") and (total_defeat==1 or civil_war_seen == 0)
title: Alaric Gallax is in undisputed control over the Commonwealth.
tags: endings
go-to: eg_menu

Alaric Gallax is in undisputed control over the Commonwealth. The <span style="color: #c00000;">**Marchers**</span>, along with all of the democratic forces, have failed.

[? if civil_war_seen == 1 : At the very least, we fought back. Perhaps our resistance will be celebrated in an impossible-to-forsee future. ?]

@war_against_hitler
view-if: (chancellor == royalist_chancellor or president == "Gallax" or president == "Gorrick" or president == "Frask") and (long_war == 1)
title: Alaric Gallax is in power, but we are fighting to stop him.
tags: endings
go-to: eg_menu

Alaric Gallax has taken power in the Commonwealth. However, we have rallied the democratic forces of the country against him, and are fighting back. The outcome of this war is uncertain.


@no_hitler
view-if: chancellor != "Gallax" and president != "Gallax" and president != "Gorrick" and chancellor_party != "Royalist"
title: Gallax does not yet control the Commonwealth...
tags: endings
go-to: eg_menu

Gallax does not yet control the Commonwealth. [? if chancellor == "Goodryke" : However, Chancellor Goodryke's <span style="color: #808080;">authoritarianism</span> and <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span> politics are paving the way for Gallax, or someone like him, to take power. ?] [? if chancellor == "Staal" : However, Chancellor Staal's <span style="color: #808080;">authoritarianism</span> and scheming is paving the way for Gallax, or someone like him, to take power. ?][? if resist_coup == 1 and republic_victory == 0 and long_war == 0 and coup_victory == 0 : Given our defeat in the Heartland coup, the <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span> appears to be ascendant. ?][? if chancellor == "Askew" : However, Chancellor Askew's austerity policies and the continuation of the depression are paving the way for Gallax, or someone like him, to take power. ?]

[? if gallax_deported == 1 : We have deported Gallax back to Austria. Hopefully he will never return. ?]

@nsdap_win
view-if: chancellor == "Goebbels" or chancellor == "Gorrick" or president == "Gorrick" or president == "Frask"
title: Despite the deportation of Gallax, the <span style="color: #7A3C00;">Royalists</span> have still taken power...
tags: endings
go-to: eg_menu

<p>Despite the deportation of Gallax, the <span style="color: #7A3C00;">**Royalists**</span> has somehow still wormed its way into power.</p> [? if long_war == 1 : We are fighting them for control of the Commonwealth. ?]


@civil_war_won
title: We have won the civil war.
view-if: republic_victory == 1
tags: endings
go-to: eg_menu

We have won the civil war against the <span style="color: #808080;">reactionary</span> forces. the Commonwealth will be changed forever, but it is too early to know how.

@civil_war_lost
title: We lost the civil war.
view-if: total_defeat == 1
tags: endings
go-to: eg_menu

We have lost the civil war. At least it was a quick coup, and ended before the Commonwealth could be plunged into total war.

@long_war
title: the Commonwealth is gripped by civil war.
view-if: long_war == 1
tags: endings
go-to: eg_menu

the Commonwealth is currently in the grip of a civil war, a brutal affair that has no obvious end. Thousands of lives have already been extinguished, and it is likely that the war will not stop until the Commonwealth's cities are reduced to ruins. 

[? if is_favorable == 0 : The current conditions are not favorable for us. ?][? if west_relation >= 2: Our cause is popular in the West, but their sclerotic governments are reluctant to send us aid. ?][? if soviet_aid >= 1 : The <span style="color: #750e0e;">Soviet Union</span> has aided the <span style="color: #700000;">Communists</span>, but not the <span style="color: #c00000;">socialists</span> and <span style="color: #D3C24D;">democrats</span>, in an attempt to shape the Commonwealth's future government. ?][? if east_aid >= 1 : <span style="color: #DC143C;">Pol</span><span style="color: #FFFFFF;">and</span> and <span style="color: #11457E;">Czech</span><span style="color: #FFFFFF;">oslo</span><span style="color: #D7141A;">vakia</span> have sent some assistance against the fascists. ?]


@braun_victorious
title: Lyle Bristol victorious
view-if: president == "Bristol"
tags: endings
go-to: eg_menu

Lyle Bristol has been elected as President of the Commonwealth. He had never desired to be the most powerful man in the Commonwealth, but now he is.

@rosenfeld_victorious
title: Cael Pendrigon victorious
view-if: president == "Pendrigon"
tags: endings
go-to: eg_menu

Cael Pendrigon has been elected as President of the Commonwealth. He had never desired to be the most powerful man in the Commonwealth, but together with the <span style="color: #700000;">**Collectivists**</span>, we are in for a <span style="color: #9B0000;">socialist</span> future.

@president_schumacher
title: Kurt Shackley victorious
view-if: president == "Shackley"
tags: endings
go-to: eg_menu

Kurt Shackley has been elected as President of the Commonwealth. As a young and ambitious <span style="color: #c00000;">**Marchers**</span> member, he will be shaping the Commonwealth for years to come.

@president_grzesinski
title: Albert Grzesinski victorious
view-if: president == "Grzesinski"
tags: endings
go-to: eg_menu

Albert Grzesinski has been elected President of the Commonwealth. As a young and ambitious <span style="color: #c00000;">**Marchers**</span> member, he will be shaping the Commonwealth for years to come.

@president_wels
title: Joran Vesh victorious
view-if: president == "Vesh"
tags: endings
go-to: eg_menu

Joran Vesh has been elected President of the Commonwealth. What a long journey it has been for the <span style="color: #c00000;">**Marchers**</span>'s chairman through the Republic. He will be shaping the Commonwealth for years to come.

@president_juchacz
title: Marie Jessamy is President
view-if: president == "Jessamy"
tags: endings
go-to: eg_menu

Marie Jessamy has been elected as President of the Commonwealth. She is the first woman to be elected as the head of state of any republic, and will contribute to shaping the Commonwealth for years to come.

@president_einstein
title: Aldous Verrin is President
view-if: president == "Verrin"
tags: endings
go-to: eg_menu

Aldous Verrin, possibly the most famous scientist in the world, has been elected as President of the Commonwealth. As one of the <span style="color: #005EB8;">beast-blooded</span> and a pacifist, he is the repudiation of everything the <span style="color: #7A3C00;">Royalists</span> stood for, and a symbol of a new Commonwealth Republic that has moved beyond its checkered past.



@spd_victorious
title: <span style="color: #c00000;">**Marchers**</span> still in government
view-if: marcher_in_government == 1 and chancellor_party == "Marcher" and total_defeat == 0 and long_war == 0 and not staal_marcher
tags: endings
go-to: eg_menu

The <span style="color: #c00000;">**Marchers**</span> is still in government, under Chancellor [+ chancellor +]. Given the circumstances, this is a substantial accomplishment.

@spd_victorious_2
title: The <span style="color: #c00000;">**Marchers**</span> is victorious?
view-if: total_defeat == 0 and long_war == 0 and staal_marcher and wtb_implemented
tags: endings
go-to: eg_menu

We were forced to strike a deal with Kurt von Staal, abandoning our pacifist and anti-militarist roots. With his reputation as a schemer, he could betray us at any moment.

Was it really worth it?

@communist_victory
title: <span style="color: #700000;">**Communist**</span> victory
view-if: chancellor_party == "Collectivist" or president == "Halsmark" and total_defeat == 0 and long_war == 0
tags: endings
go-to: eg_menu

The <span style="color: #700000;">**Collectivists**</span> has won power in the Commonwealth, with our assistance. They will try to remake the Commonwealth in the <span style="color: #750e0e;">Central Union</span>'s image. How much they succeed is yet to be determined.

@works_program
title: Works program enacted!
view-if: works_program > 0
tags: endings
go-to: eg_menu

Our government has enacted a public works program!

@unemployment_reduced
title: Unemployment has been reduced from its peak.
view-if: disfavored <= 15 and disfavored >= 10 and veran_crash_seen
tags: endings
go-to: eg_menu

While still uncomfortably high, unemployment levels are nowhere near their peak. This is a success of our economic policy.

@unemployment_reduced_2
title: Unemployment has been successfully reduced!
view-if: disfavored < 10 and veran_crash_seen
tags: endings
go-to: eg_menu

Unemployment levels have fallen substantially! This is a success of our economic policy.



@unemployment_high
title: Unemployment is still too high.
view-if: disfavored >= 15 and (chancellor != "Gallax" and president != "Gallax") and (total_defeat == 0) and long_war == 0
tags: endings
go-to: eg_menu

Unemployment is still at dangerously high levels. Even though Gallax is not in power, the situation is ripe for instability and extremism.


@emergency_government
title: <span style="color: #c00000;">**Marchers**</span> ruling in an emergency government.
view-if: in_emergency_government == 1
tags: endings
go-to: eg_menu

The <span style="color: #c00000;">**Marchers**</span> is ruling as part of an emergency minority government, led by President [+ president +] and Chancellor [+ chancellor +]. This is a temporary and unstable arrangement, leaving the door open to further <span style="color: #808080;">authoritarianism</span>.

@peoples_party_achieved
title: The <span style="color: #c00000;">**Marchers**</span> is a "People's Party".
view-if: peoples_party == 1
tags: endings
go-to: eg_menu

The <span style="color: #c00000;">**Marchers**</span> has been declared a "People's Party", representing all of the people, not just the working class. This policy has many supporters and detractors, and what will become of the party is still unclear.

@nationalization_achieved
title: Socialization of the economy has commenced.
view-if: nationalization_progress >= 2
tags: endings
go-to: eg_menu

As part of our <span style="color: #c00000;">socialist</span> economic plan, we have nationalized a substantial portion of the economy, beginning the transition to actual <span style="color: #9b0000;">socialism</span>.

@works_councils
title: Works councils have more power.
view-if: works_councils >= 3
tags: endings
go-to: eg_menu

Works councils now have substantially greater influence, giving workers democratic control over their economic lives.

@european_union
title: There is now a <span style="color: #001489;">Regional</span> <span style="color: #FFDD00;">Concordant</span>!
view-if: eu = 1
tags: endings
go-to: eg_menu

We have helped to form a <span style="color: #001489;">Regional</span> <span style="color: #FFDD00;">Concordant</span> to bring peace and prosperity to the continent. Time will tell how effective it will be.

@achievements
title: Achievements
view-if: achievement_game_completed == 1
on-arrival: {!
const toolsWrapper = document.getElementById('tools_wrapper');
if (toolsWrapper) {
  toolsWrapper.style.display = 'none';
}
const elements = document.querySelectorAll('header, #content, footer');
elements.forEach(el => {
