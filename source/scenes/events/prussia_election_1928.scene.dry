on-arrival: in_center_right_coalition_heartland = 1; hands_tied_heartland = 0; hands_tied_heartland = 1 if ((ddp_relation < 35 and not lvp_formed) or (lvp_relation < 40 and lvp_formed) or weimar_coalition_heartland < 45 or concord_formed); heartland_leader = "Sedgewick"; heartland_leader = "Askew" if unionist_leader == "Sedgewick"; burgher_marcher -= 4; landed_marcher -= 2; ddp_right += 1; ddp_cohesion -= 2; gold_right += 3; lvp_right += 3; center_dissent += 10 if hands_tied_heartland; left_dissent += 5 if hands_tied_heartland; labor_dissent += 20 if hands_tied_heartland; reformist_dissent += 20 if hands_tied_heartland; knight_dissent += 10 if hands_tied_heartland; heartland_police_loyalty -= 0.08; heartland_police_strength -= 15; pro_republic -= 3; ddp_relation -= 5; unionist_relation -= 5; gold_relation -= 5; lvp_relation -= 5; hands_tied_heartland = 0

[? if not ((ddp_relation < 35 and not lvp_formed) or (lvp_relation < 40 and lvp_formed) or weimar_coalition_heartland < 45 or concord_formed): Letting go the democratic bulwark to the right-wing parties is deeply unpopular among all party members, and provides no discernible benefit. ?][? if ((ddp_relation < 35 and not lvp_formed) or (lvp_relation < 40 and lvp_formed) or weimar_coalition_heartland < 45 or concord_formed): Unfortunately, the current political situation doesn't allow us a choice but to abandon the democratic bulwark. Hopefully we can reestablish control in a few years. ?]

