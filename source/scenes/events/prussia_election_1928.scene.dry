title: Heartland state Assembly Election
view-if: ((year = next_election_year_heartland and month >= next_election_month_heartland) and (next_election_week_heartland == week or not rubicon or not next_election_week_heartland)) or (year > next_election_year_heartland)
new-page: true
tags: event
priority: 2
on-arrival: was_in_social_catholic_coalition_heartland = 0; was_in_social_liberal_coalition_heartland = 0; was_in_weimar_coalition_heartland = 0; was_in_grand_coalition_heartland = 0; was_in_social_catholic_coalition_heartland = 1 if in_social_catholic_coalition_heartland == 1 or in_minority_social_catholic_coalition_heartland == 1; was_in_social_liberal_coalition_heartland = 1 if in_social_liberal_coalition_heartland == 1 or in_minority_social_liberal_coalition_heartland == 1; was_in_weimar_coalition_heartland = 1 if ((in_weimar_coalition_heartland == 1 or in_minority_weimar_coalition_heartland == 1) or (in_grand_coalition_heartland == 1 and lvp_formed)); was_in_grand_coalition_heartland = 1 if (in_grand_coalition_heartland == 1 or in_minority_grand_coalition_heartland == 1); in_right_coalition_heartland = 0; in_social_catholic_coalition_heartland = 0; in_social_liberal_coalition_heartland = 0; in_weimar_coalition_heartland = 0; in_grand_coalition_heartland = 0; in_minority_grand_coalition_heartland = 0; in_popular_front_heartland = 0; in_left_front_heartland = 0; in_marcher_majority_heartland = 0; in_center_right_coalition_heartland = 0; in_far_right_coalition_heartland = 0; in_minority_weimar_coalition_heartland = 0; in_minority_social_catholic_coalition_heartland = 0; in_minority_social_liberal_coalition_heartland = 0; marcher_heartland = 0; right_heartland = 0; ddp_in_popular_front_heartland = 0; collectivist_goals_seen_heartland = 0; marcher_toleration_heartland = 0
on-departure: {! 
Q.in_election_heartland = 0;
Q.next_election_year_heartland = Q.next_election_year_heartland + 4; 
Q.n_elections_heartland += 1;
Q.next_election_time_heartland = Q.time + 48;
if (Q.n_elections_heartland == 1) {
    Q.next_election_month_heartland -= 1;
}
if (Q.in_social_catholic_coalition_heartland || Q.in_social_liberal_coalition_heartland || Q.in_weimar_coalition_heartland == 1 || Q.in_grand_coalition_heartland == 1 || Q.in_popular_front_heartland == 1 || Q.in_left_front_heartland == 1 || Q.in_marcher_majority_heartland == 1 || Q.in_minority_weimar_coalition_heartland == 1 || Q.in_minority_grand_coalition_heartland == 1) {
    Q.marcher_heartland = 1;
    Q.right_heartland = 0;
} else if (Q.in_right_coalition_heartland == 1 || Q.in_center_right_coalition_heartland == 1 || Q.heartland_leader == "Goodryke" || Q.heartland_leader == "Gorrick" || Q.in_far_right_coalition_heartland == 1) {
    Q.right_heartland = 1;
    Q.marcher_heartland = 0;
}
!}
set-jump: new_elections
face-image: img/prussia.png

= Elections, [+ month : month +] [+ year_display +]

The Heartland state Assembly elections are to be held now.

- @new_elections: May we do our best...

@new_elections
on-arrival: {!  
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c + '_' + party] < 0) {
            Q[c + '_' + party] = 0;
        }
        class_votes += Q[c + '_' + party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized_prussia'] = Math.round(100 * Q[c + '_' + party] / class_votes);
    }
}

// Define adjustment factors
if (Q.year == 1928) {
    var adjustment_factors = {
        spd: 0.98,
        sapd: 0.6,
        kpd: 1.1,
        ddp: 0.95,
        lvp: 0.97,
        z: 1.02,
        dvp: 1.0,
        dnvp: 1.2,
        nsdap: 0.66,
        other: 0.88,
        kvp: 1.2,
        dnf: 0.65
    };
} else if (Q.year == 1929) {
    var adjustment_factors = {
        spd: 0.97,
        sapd: 0.8,
        kpd: 1.08,
        ddp: 0.95,
        lvp: 0.96,
        z: 1.02,
        dvp: 1.025,
        dnvp: 1.3,
        nsdap: 1.0,
        other: 0.85,
        kvp: 1.3,
        dnf: 0.7
    };
} else if (Q.year == 1930 && Q.kvp_formed == 1) {
    var adjustment_factors = {
        spd: 0.95,
        sapd: 1.0,
        kpd: 1.05,
        ddp: 0.95,
        lvp: 0.95,
        z: 1.02,
        dvp: 1.05,
        dnvp: 0.8,
        nsdap: 1.0,
        other: 0.8,
        kvp: 1.3,
        dnf: 0.8
    };
} else if (Q.year == 1930 && Q.kvp_formed == 0) {
    var adjustment_factors = {
        spd: 0.95,
        sapd: 1.0,
        kpd: 1.05,
        ddp: 0.95,
        lvp: 0.95,
        z: 1.02,
        dvp: 1.0,
        dnvp: 1.3,
        nsdap: 1.0,
        other: 0.75,
        kvp: 1.3,
        dnf: 0.8
    };
} else if (Q.year == 1931) {
    var adjustment_factors = {
        spd: 0.95,
        sapd: 1.3,
        kpd: 1.0,
        ddp: 0.95,
        lvp: 1.0,
        z: 1.02,
        dvp: 1.1,
        dnvp: 1.25,
        nsdap: 1.0,
        other: 0.7,
        kvp: 1.0,
        dnf: 0.9
    };
} else if (Q.year >= 1932) {
    var adjustment_factors = {
        spd: 0.95,
        sapd: 1.5,
        kpd: 1.0,
        ddp: 0.95,
        lvp: 1.0,
        z: 1.02,
        dvp: 1.0,
        dnvp: 1.2,
        nsdap: 1.0,
        other: 0.65,
        kvp: 0.8,
        dnf: 1.0
    };
}

if (Q.ddp_votes < 3) Q.adjustmentFactors_ddp_heartland = 0.8;
if (Q.ddp_votes < 2) Q.adjustmentFactors_ddp_heartland = 0.5;
if (Q.ddp_votes < 1.5) Q.adjustmentFactors_ddp_heartland = 0.3;
if (Q.ddp_votes < 1) Q.adjustmentFactors_ddp_heartland = 0.1;
if (Q.ddp_votes >= 3) Q.adjustmentFactors_ddp_heartland = 1.0;

if (Q.dstp_gnu) Q.adjustmentFactors_ddp_heartland = 1.0;

if (Q.other_votes < 10) Q.adjustmentFactors_other_heartland = 0.6;
if (Q.other_votes < 8) Q.adjustmentFactors_other_heartland = 0.5;
if (Q.other_votes < 7) Q.adjustmentFactors_other_heartland = 0.4;
if (Q.other_votes < 6) Q.adjustmentFactors_other_heartland = 0.3;
if (Q.other_votes < 5) Q.adjustmentFactors_other_heartland = 0.15;
if (Q.other_votes >= 10) Q.adjustmentFactors_other_heartland = 0.7;

if (Q.other_gnu) Q.adjustmentFactors_other_heartland = 0;

if (!Q.hugenberg_gold && !Q.bourgeois_list && !Q.gold_gnu) {
    if (Q.gold_votes < 1.2) {
        Q.adjustmentFactors_gold = 0.5;
    }
    if (Q.gold_votes < 0.8) {
        Q.adjustmentFactors_gold = 0.3;
    }
}

// Calculate support for each of the parties
var total_support = 0;
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) {
            party_support += Q[c] * Q[c + '_' + party];
        } else {
            party_support += Q[c] * Q[c + '_' + party + '_normalized_prussia'];
        }
    }
    // Apply adjustment factor
    Q[party + '_support'] = party_support * (adjustment_factors[party] || 1.0);
    total_support += Q[party + '_support'];
}

// Normalize support (fraction)
for (var party of Q.parties) {
    Q[party + '_normalized_prussia'] = Q[party + '_support'] / total_support;
    Q[party + '_votes_prussia'] = Math.round(Q[party + '_normalized_prussia'] * 1000) / 10;
}

var new_party_sum_prussia = 0;
var total_reichstag_without_prussia = 0; // Initialize a variable to accumulate 'reichstag_without_' values
var total_other_party_sum_prussia = 0; // Initialize a variable to accumulate '_other_party_sum' values

// Step 1: Calculate adjusted values and the sum for redistribution
for (var party of Q.parties) {
    let factor_prussia = Q['adjustmentFactors_' + party + '_prussia'] || 1.0; // Default to 1.0 if not set

    Q['old_' + party + '_r_prussia'] = Q[party + '_r_prussia']; // Store the original r value for comparison

    // Handle constitutional reform logic: set the party's share to 0 based on conditions
    if ((Q.constitutional_reform > 0 &&
             (Q[party + '_votes_prussia'] < Q.electoral_threshold || 
             (Q.electoral_threshold > 1 && party === 'other'))) 
            || Q[party + '_banned']) {
        Q[party + '_r_prussia'] = 0;
    } else {
        // Adjust `r` based on the adjustment factor if not affected by constitutional reform
        Q['original_' + party + '_r_prussia'] = Math.round(Q[party + '_votes_prussia'] * 10) / 10;
        Q[party + '_r_prussia'] = Math.round(Q[party + '_votes_prussia'] * factor_prussia * 10) / 10;
    }

    if (factor_prussia !== 1.0) { // Only apply to parties with adjustment factors
        // Calculate the Assembly without the current party's share
        Q['reichstag_without_' + party + '_prussia'] = 100 - Q['original_' + party + '_r_prussia'];
        total_reichstag_without_prussia += Q['reichstag_without_' + party + '_prussia']; // Accumulate the total of 'reichstag_without_' values

        // Calculate the sum of the remaining parties
        Q[party + '_other_party_sum_prussia'] = Q['reichstag_without_' + party + '_prussia'] -
            (Q[party + '_votes_prussia'] - Q[party + '_r_prussia']);
        total_other_party_sum_prussia += Q[party + '_other_party_sum_prussia']; // Accumulate the total of '_other_party_sum' values
    } else {
        // For non-adjusted parties, accumulate their r value for the redistribution
        new_party_sum_prussia += Q[party + '_r_prussia'];
    }
}

// Step 2: Redistribute results among non-adjusted parties to ensure the total is 100%
if (new_party_sum_prussia > 0) {
    for (var party of Q.parties) {
        let factor_prussia = Q['adjustmentFactors_' + party + '_prussia'] || 1.0;

        if (Q[party + '_r_prussia'] === 0) continue;

        var total_reichstag_without_party_prussia = total_reichstag_without_prussia - (100 - Q['original_' + party + '_r_prussia']);
        var total_other_party_sum_party_prussia = total_other_party_sum_prussia - (Q['reichstag_without_' + party + '_prussia'] - (Q[party + '_votes_prussia'] - Q[party + '_r_prussia']));

        if (factor_prussia === 1.0) {
            if (total_other_party_sum_prussia > 0) {
                Q[party + '_r_prussia'] = Math.round((Q[party + '_r_prussia'] * total_reichstag_without_prussia) / total_other_party_sum_prussia * 10) / 10;
            } else {
                Q[party + '_r_prussia'] = Q[party + '_r_prussia'];
            }
        } else if (factor_prussia !== 1.0 && total_reichstag_without_party_prussia > 0 && total_other_party_sum_party_prussia > 0) {
            let scaling_factor_prussia = total_reichstag_without_party_prussia / total_other_party_sum_party_prussia;
            Q[party + '_r_prussia'] = Math.round(Q[party + '_r_prussia'] * scaling_factor_prussia * 10) / 10;
        }
    }

    // Step 3: Normalize to ensure the total sums to exactly 100%
    let total_r_sum_prussia = 0;

    // Calculate the total of all `r` values after redistribution
    for (var party of Q.parties) {
        total_r_sum_prussia += Q[party + '_r_prussia'];
    }

    // Adjust each party's `r` value proportionally if the total isn't 100
    if (total_r_sum_prussia !== 100) {
        let normalization_factor_prussia = 100 / total_r_sum_prussia;
        for (var party of Q.parties) {
            if (Q[party + '_r_prussia'] > 0) {
                Q[party + '_r_prussia'] = Math.round(Q[party + '_r_prussia'] * normalization_factor_prussia * 10) / 10;
            }
        }
    }
}

if (Q.gnu_formed) {
    Q.staal_gnu_r_heartland = Q.gnu_r_heartland;
    Q.staal_gnu_votes_heartland = Q.gnu_votes_heartland;
    if (Q.other_gnu) {
        if (Q.other_r_heartland) {
            Q.gnu_r_heartland += Q.other_r_heartland;
            Q.other_r_heartland = 0;
        }
        Q.gnu_votes_heartland += Q.other_votes_heartland;
    }
    if (Q.dstp_gnu) {
        if (Q.ddp_r_heartland) {
            Q.gnu_r_heartland += Q.ddp_r_heartland;
            Q.ddp_r_heartland = 0;
        }
        Q.gnu_votes_heartland += Q.ddp_votes_heartland;
    }
    if (Q.lvp_gnu) {
        if (Q.lvp_r_heartland) {
            Q.gnu_r += Q.lvp_r_heartland;
            Q.lvp_r_heartland = 0;
        }
        Q.gnu_votes_heartland += Q.lvp_votes_heartland;
    }
    if (Q.kvp_gnu) {
        if (Q.kvp_r_heartland) {
            Q.gnu_r_heartland += Q.kvp_r_heartland;
            Q.kvp_r_heartland = 0;
        }
        Q.gnu_votes_heartland += Q.kvp_votes_heartland;
    }
    if (Q.gold_gnu) {
        if (Q.gold_r_heartland) {
            Q.gnu_r_heartland += Q.gold_r_heartland;
            Q.gold_r_heartland = 0;
        }
        Q.gnu_votes_heartland += Q.gold_votes_heartland;
    }
    if (Q.unionist_gnu) {
        if (Q.unionist_r_heartland) {
            Q.gnu_r_heartland += Q.unionist_r_heartland;
            Q.unionist_r_heartland = 0;
        }
        Q.gnu_votes_heartland += Q.unionist_votes_heartland;
    }
    if (Q.traditionalist_gnu) {
        if (Q.traditionalist_r_heartland) {
            Q.gnu_r_heartland += Q.traditionalist_r_heartland;
            Q.traditionalist_r_heartland = 0;
        }
        Q.gnu_votes_heartland += Q.traditionalist_votes_heartland;
    }
    Q.gnu_votes_heartland = Math.round(Q.gnu_votes_heartland * 10) / 10;
    Q.gnu_r_heartland = Math.round(Q.gnu_r_heartland * 10) / 10;
}

// Step 3: Calculate changes in results
for (var party of Q.parties) {
    Q['change_' + party + '_r_prussia'] = Q[party + '_r_prussia'] - Q['old_' + party + '_r_prussia'];
    var sign_prussia = Q['change_' + party + '_r_prussia'] > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q['change_' + party + '_r_prussia'] < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q['change_' + party + '_r_prussia'] = Math.abs(Q['change_' + party + '_r_prussia']);
    Q['str_change_' + party + '_prussia'] = sign_prussia + parseFloat(Q['change_' + party + '_r_prussia']).toFixed(1);

    // Calculate changes in votes
    Q['change_' + party + '_votes_prussia'] = Q[party + '_votes_prussia'] - Q['previous_' + party + '_last_election_votes_prussia'];
    if (Q['previous_' + party + '_last_election_votes_prussia'] === undefined) {
        Q['change_' + party + '_votes_prussia'] = Q[party + '_votes_prussia'];
    }

    var sign2_prussia = Q['change_' + party + '_votes_prussia'] > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q['change_' + party + '_votes_prussia'] < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q['str_votes_change_' + party + '_prussia'] = sign2_prussia + Math.abs(Q['change_' + party + '_votes_prussia']).toFixed(1);
}

// Store current votes as previous for the next iteration
for (var party of Q.parties) {
    Q[party + '_last_election_votes_prussia'] = parseFloat(Q[party + '_votes_prussia']).toFixed(1);
    Q['previous_' + party + '_last_election_votes_prussia'] = parseFloat(Q[party + '_last_election_votes_prussia']).toFixed(1);
}

if (Q.royalist_split) {
    if (Q.dsu_exist) {
        Q.dsu_r_heartland = parseFloat(Q.dsu_votes.toFixed(1));
        Q.dsu_votes_heartland = parseFloat(Q.dsu_votes.toFixed(1));
    }
    if (Q.nvf_exist) {
        Q.nvf_r_heartland = parseFloat(Q.nvf_votes.toFixed(1));
        Q.nvf_votes_heartland = parseFloat(Q.nvf_votes.toFixed(1));
    }
    if (Q.dsu_exist || Q.nvf_exist) {
        Q.royalist_gallax_r_heartland = parseFloat(Q.royalist_gallax_votes.toFixed(1));
        Q.royalist_gallax_votes_heartland = parseFloat(Q.royalist_gallax_votes.toFixed(1));
    }
    if ((Q.dsu_votes_heartland + Q.nvf_votes_heartland + Q.royalist_gallax_votes_heartland) !== Q.royalist_votes_heartland) {
        let total = Q.dsu_votes_heartland + Q.nvf_votes_heartland + Q.royalist_gallax_votes_heartland;
        let factor = Q.royalist_votes_heartland / total;

        Q.dsu_votes_heartland = parseFloat((Q.dsu_votes_heartland * factor).toFixed(1));
        Q.nvf_votes_heartland = parseFloat((Q.nvf_votes_heartland * factor).toFixed(1));
        Q.royalist_gallax_votes_heartland = parseFloat((Q.royalist_gallax_votes_heartland * factor).toFixed(1));
    }
    if ((Q.dsu_r_heartland + Q.nvf_r_heartland + Q.royalist_gallax_r_heartland) !== Q.royalist_r) {
        let total = Q.dsu_r_heartland + Q.nvf_r_heartland + Q.royalist_gallax_r_heartland;
        let factor = Q.royalist_r_heartland / total;

        Q.dsu_r_heartland = parseFloat((Q.dsu_r_heartland * factor).toFixed(1));
        Q.nvf_r_heartland = parseFloat((Q.nvf_r_heartland * factor).toFixed(1));
        Q.royalist_gallax_r_heartland = parseFloat((Q.royalist_gallax_r_heartland * factor).toFixed(1));
    }
    if (Q.dsu_exist) {
        Q.str_votes_change_dsu_heartland = Q.dsu_votes_heartland - Q.previous_dsu_last_election_votes_heartland;
        var sign2 = Q.str_votes_change_dsu_heartland > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_dsu_heartland < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_dsu_heartland = sign2 + Math.abs(Q.str_votes_change_dsu_heartland).toFixed(1);

        Q.str_change_dsu_heartland = Q.dsu_r_heartland - Q.old_dsu_r_heartland;
        var sign2 = Q.str_change_dsu_heartland > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_dsu_heartland < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_dsu_heartland = sign2 + Math.abs(Q.str_change_dsu_heartland).toFixed(1);
    }
    if (Q.nvf_exist) {
        Q.str_votes_change_nvf_heartland = Q.nvf_votes_heartland - Q.previous_nvf_last_election_votes_heartland;
        var sign2 = Q.str_votes_change_nvf_heartland > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_nvf_heartland < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_nvf_heartland = sign2 + Math.abs(Q.str_votes_change_nvf_heartland).toFixed(1);

        Q.str_change_nvf_heartland = Q.nvf_r_heartland - Q.old_nvf_r_heartland;
        var sign2 = Q.str_change_nvf_heartland > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_nvf_heartland < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_nvf_heartland = sign2 + Math.abs(Q.str_change_nvf_heartland).toFixed(1);
    }
    if (Q.nvf_exist || Q.dsu_exist) {
        if (Q.previous_royalist_gallax_last_election_votes_heartland == 0) Q.previous_royalist_gallax_last_election_votes_heartland = Q.previous_royalist_last_election_votes_heartland
        if (Q.old_royalist_gallax_r_heartland == 0) Q.old_royalist_gallax_r_heartland = Q.old_royalist_r_heartland

        Q.str_votes_change_royalist_gallax_heartland = Q.royalist_gallax_votes_heartland - Q.previous_royalist_gallax_last_election_votes_heartland;
        var sign2 = Q.str_votes_change_royalist_gallax_heartland > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_royalist_gallax_heartland < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_royalist_gallax_heartland = sign2 + Math.abs(Q.str_votes_change_royalist_gallax_heartland).toFixed(1);

        Q.str_change_royalist_gallax_heartland = Q.royalist_gallax_r_heartland - Q.old_royalist_gallax_r_heartland;
        var sign2 = Q.str_change_royalist_gallax_heartland > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_royalist_gallax_heartland < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_royalist_gallax_heartland = sign2 + Math.abs(Q.str_change_royalist_gallax_heartland).toFixed(1);
    }
    Q.previous_dsu_last_election_votes_heartland = Q.dsu_votes_heartland;
    Q.old_dsu_r_heartland = Q.dsu_r_heartland;
    Q.previous_nvf_last_election_votes_heartland = Q.nvf_votes_heartland;
    Q.old_nvf_r_heartland = Q.nvf_r_heartland;
    Q.previous_royalist_gallax_last_election_votes_heartland = Q.royalist_gallax_votes_heartland;
    Q.old_royalist_gallax_r_heartland = Q.royalist_gallax_r_heartland;
}

if (Q.gnu_formed && Q.nvf_exist) {
    if (Q.nvf_gnu) {
        if (Q.nvf_r_heartland) {
            Q.gnu_r += Q.nvf_r_heartland;
            Q.nvf_r_heartland = 0;
        }
        Q.gnu_votes_heartland += Q.nvf_votes_heartland;
    }
    Q.gnu_votes_heartland = Math.round(Q.gnu_votes_heartland * 10) / 10;
    Q.gnu_r = Math.round(Q.gnu_r * 10) / 10;
}

if (Q.gnu_formed) {
    Q.str_votes_change_staal_gnu_heartland = Q.staal_gnu_votes_heartland - Q.previous_staal_gnu_last_election_votes_heartland;
    var sign2 = Q.str_votes_change_staal_gnu_heartland > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_staal_gnu_heartland < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_staal_gnu_heartland = sign2 + Math.abs(Q.str_votes_change_staal_gnu_heartland).toFixed(1);
    Q.previous_staal_gnu_last_election_votes_heartland = Q.staal_gnu_votes_heartland;
}

Q.largest_party_heartland = 'Marcher';
if (Q.royalist_r_heartland >= Q.marcher_r_heartland && Q.royalist_r_heartland >= Q.collectivist_r_heartland) {
    Q.largest_party_heartland = 'Royalist';
}
if (Q.collectivist_r_heartland >= Q.marcher_r_heartland && Q.collectivist_r_heartland >= Q.royalist_r_heartland) {
    Q.largest_party_heartland = 'Collectivist';
}

// coalitions
if (Q.lvp_formed) {
    Q.weimar_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland + Q.unionist_r_heartland ).toFixed(1));
} else {
    Q.weimar_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland).toFixed(1));
}

if (Q.lvp_formed) {
    Q.social_liberal_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland).toFixed(1));
} else {
    Q.social_liberal_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland).toFixed(1));
}

Q.social_catholic_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.unionist_r_heartland).toFixed(1));

if (Q.lvp_formed) {
    Q.grand_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland + Q.unionist_r_heartland).toFixed(1));
} else {
    Q.grand_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.bourgeois_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.bourgeois_coalition_heartland = parseFloat((Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.bourgeois_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland).toFixed(1));
} else {
    Q.bourgeois_coalition_heartland = parseFloat((Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.center_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.ddp_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (!Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
} else {
    Q.center_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.ddp_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
}

if (Q.lvp_formed) {
    Q.right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
} else {
    Q.right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
}

if (Q.traditionalist_ideology === "Moderate") {
    Q.far_right_coalition_heartland = parseFloat((Q.dnf_r_heartland + Q.royalist_r_heartland).toFixed(1));
} else {
    Q.far_right_coalition_heartland = parseFloat((Q.traditionalist_r_heartland + Q.royalist_r_heartland).toFixed(1));
}

if (Q.gold_leader == "Coalfax" && Q.gold_ideology == "Right" && Q.gold_right - Q.gold_left >= 15 || Q.hugenberg_gold) {
    Q.far_right_coalition_heartland = parseFloat((Q.far_right_coalition_heartland + Q.gold_r_heartland).toFixed(1));
}

Q.left_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.sapd_r_heartland).toFixed(1));

if (Q.lvp_formed) {
    Q.popular_front_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.unionist_r_heartland + Q.sapd_r_heartland).toFixed(1));
} else if (Q.liberal_parliament == 0) {
    Q.popular_front_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.unionist_r_heartland + Q.ddp_r_heartland + Q.sapd_r_heartland).toFixed(1));
} else if (Q.liberal_parliament == 1) {
    Q.popular_front_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.unionist_r_heartland + Q.sapd_r_heartland).toFixed(1));
}

if (Q.traditionalist_ideology === "Moderate") {
    Q.anti_democratic_coalition_heartland = parseFloat((Q.collectivist_r_heartland + Q.royalist_r_heartland + Q.dnf_r_heartland).toFixed(1));
} else {
    Q.anti_democratic_coalition_heartland = parseFloat((Q.collectivist_r_heartland + Q.royalist_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
}

if (Q.lvp_formed) {
    Q.neo_weimar_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland + Q.unionist_r_heartland + Q.other_r_heartland).toFixed(1));
} else {
    Q.neo_weimar_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.cordon_sanitaire_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland + Q.unionist_r_heartland + Q.other_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.cordon_sanitaire_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.cordon_sanitaire_heartland = parseFloat((Q.marcher_r_heartland + Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
} else {
    Q.cordon_sanitaire_heartland = parseFloat((Q.marcher_r_heartland + Q.unionist_r_heartland + Q.ddp_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r).toFixed(1));
}

// Q.gallax_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.traditionalist_r_heartland + Q.royalist_r_heartland).toFixed(1));

if (Q.lvp_formed) {
    Q.progressive_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + (Q.lvp_r_heartland / 2) + Q.sapd_r_heartland).toFixed(1));
} else {
    Q.progressive_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.ddp_r_heartland + Q.sapd_r_heartland).toFixed(1));
}

if (Q.gnu_formed) {
    Q.staal_right_coalition_heartland = parseFloat((Q.gnu_r_heartland + Q.lvp_r_heartland + Q.gold_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland + Q.other_r_heartland + Q.kvp_r_heartland + Q.traditionalist_r_heartland + Q.dnf_r_heartland + Q.dsu_r_heartland).toFixed(1));
    Q.staal_left_coalition_heartland = parseFloat((Q.gnu_r_heartland + Q.marcher_r_heartland + Q.lvp_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland).toFixed(1));
}

if (Q.collectivist_relation >= 30 && Q.sapd_formed == 1) {
    Q.weimar_coalition_heartland += Q.sapd_r_heartland;
}

if ((Q.royalist_votes_heartland + Q.dnf_votes_heartland >= 30 && Q.traditionalist_ideology == "Moderate" || Q.royalist_votes_heartland + Q.traditionalist_votes_heartland >= 30 && Q.traditionalist_ideology == "Radical") && Q.weimar_coalition_heartland < 45 && Q.president == "DuFour" && !Q.rubicon) {
    Q.dufour_angry_bruning += 45;
    Q.dufour_angry += 20;
    Q.dufour_angry_heartland = 1;
} else {
    Q.dufour_angry_heartland = 0;
}

if (Q.left_coalition_heartland >= 50) {
    Q.collectivist_relation += 5;
    Q.left_strength += 5;
}

if (Q.year >= 1932) {
    Q.landtag_size = 4.23;
} else {
    Q.landtag_size = 4.5;
}

// not sure why seats decreased from 450 to 423 between 4293 and 4297, considering the turnout vastly increased

!}
on-display: {!
data = [{
    "id": "collectivist",
    "legend": "Collectivist",
    "name": "Collectivist",
    "seats": Math.round(Q.collectivist_r_heartland * Q.landtag_size),
}];

if (Q.sapd_formed && Q.sapd_r_heartland) {
    data.push({
        "id": "sapd",
        "legend": "Laborists",
        "name": "Laborists",
        "seats": Math.round(Q.sapd_r_heartland * Q.landtag_size),
    });
}

data = data.concat([{
    "id": "marcher",
    "legend": "Marcher",
    "name": "Marcher",
    "seats": Math.round(Q.marcher_r_heartland * Q.landtag_size),
}]);

if (Q.ddp_r_heartland && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r_heartland * Q.landtag_size),
    });
}

if (Q.lvp_r_heartland && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r_heartland * Q.landtag_size),
    });
}

if (Q.unionist_r_heartland) {
    data.push({
        "id": "unionist",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(Q.unionist_r_heartland * Q.landtag_size),
    });
}

if (Q.gold_r_heartland && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "gold",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r_heartland * Q.landtag_size),
    });
}

if (Q.gnu_r_heartland && Q.gnu_formed) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round(Q.gnu_r_heartland * Q.landtag_size),
    });
}

if (Q.other_r_heartland) {
    data.push({
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_r_heartland * Q.landtag_size),
    });
}

if (Q.kvp_formed && Q.kvp_r_heartland && !Q.traditionalist_gold_formed) {
    data.push({
        "id": "kvp",
        "legend": "CPP",
        "name": "CPP",
        "seats": Math.round(Q.kvp_r_heartland * Q.landtag_size),
    });
}

if (Q.traditionalist_gold_formed) {
    data.push({
        "id": "fkp",
        "legend": "FCP",
        "name": "FCP",
        "seats": Math.round(Q.kvp_r_heartland * Q.landtag_size),
    });
}

if (Q.traditionalist_r_heartland) {
    data.push({
        "id": "traditionalist",
        "legend": "Traditionalist",
        "name": "Traditionalist",
        "seats": Math.round(Q.traditionalist_r_heartland * Q.landtag_size),
    });
}
if (Q.dnf_formed && Q.dnf_r_heartland) {
    data.push({
        "id": "dnf",
        "legend": "CNF",
        "name": "CNF",
        "seats": Math.round(Q.dnf_r_heartland * Q.landtag_size),
    });
}
if (Q.dsu_exist && Q.dsu_r_heartland) {
    data.push({
        "id": "dsu",
        "legend": "CSG",
        "name": "CSG",
        "seats": Math.round(Q.dsu_r_heartland * Q.landtag_size),
    });
}

if (Q.royalist_split && Q.royalist_gallax_r_heartland) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_gallax_r_heartland * Q.landtag_size),
    });
}

if (!Q.royalist_split && Q.royalist_r_heartland) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_r_heartland * Q.landtag_size),
    });
}

if (Q.nvf_exist && Q.nvf_r_heartland) {
    data.push({
        "id": "nvf",
        "legend": "NPF",
        "name": "NPF",
        "seats": Math.round(Q.nvf_r_heartland * Q.landtag_size),
    });
}

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}
