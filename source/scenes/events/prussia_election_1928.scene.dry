[? if gnu_formed: {!<tr><td><div class="box" style='background-color:#BFC8CC; outline: 2px; outline-style: solid;'> </div> !} **GNU:** {!</td><td>!} **[+ gnu_votes_heartland +]%** {!</td><td>!} **[+ str_votes_change_gnu_heartland +]** {!</td><td>!} **[+ gnu_r_heartland +]%** {!</td><td>!} **[+ str_change_gnu_heartland +]** {!</td></tr>!} ?]

[? if gnu_formed: {!<tr><td><div class="box2" style='background-color:#BFC8CC'> </div> !} GNU: {!</td><td>!} [+ staal_gnu_votes_heartland +]% {!</td><td>!} [+ str_votes_change_staal_gnu_heartland +] {!</td><td>!} [+ gnu_r_heartland +]% {!</td><td>!} [+ str_change_gnu_heartland +] {!</td></tr>!} ?]

[? if not lvp_formed and dstp_gnu: {!<tr><td><div class="box2" style='background-color:#A79A3F'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_votes_heartland +]% {!</td><td>!} [+ str_votes_change_ddp_heartland +] {!</td><td>!} [+ ddp_r_heartland +]% {!</td><td>!} [+ str_change_ddp_heartland +] {!</td></tr>!} ?]

[? if lvp_formed and lvp_gnu: {!<tr><td><div class="box2" style='background-color:#CC9900'> </div> !} Golds: {!</td><td>!} [+ lvp_votes_heartland +]% {!</td><td>!} [+ str_votes_change_lvp_heartland +] {!</td><td>!} [+ lvp_r_heartland +]% {!</td><td>!} [+ str_change_lvp_heartland +] {!</td></tr>!} ?]

[? if unionist_gnu: {!<tr><td><div class="box2" style='background-color:#1A0000'> </div> !} [+ unionist_party_name +]: {!</td><td>!} [+ unionist_votes_heartland +]% {!</td><td>!} [+ str_votes_change_unionist_heartland +] {!</td><td>!} [+ unionist_r_heartland +]% {!</td><td>!} [+ str_change_unionist_heartland +] {!</td></tr>!} ?]

[? if not lvp_formed and gold_exist and gold_gnu: {!<tr><td><div class="box2" style='background-color:#AA861F'> </div> !} Golds: {!</td><td>!} [+ gold_votes_heartland +]% {!</td><td>!} [+ str_votes_change_gold_heartland +] {!</td><td>!} [+ gold_r_heartland +]% {!</td><td>!} [+ str_change_gold_heartland +] {!</td></tr>!} ?]

[? if other_gnu: {!<tr><td><div class="box2" style='background-color:#707070'> </div> !} Others: {!</td><td>!} [+ other_votes_heartland +]% {!</td><td>!} [+ str_votes_change_other_heartland +] {!</td><td>!} [+ other_r_heartland +]% {!</td><td>!} [+ str_change_other_heartland +] {!</td></tr>!} ?]

[? if kvp_formed and not concord_kvp_formed and not traditionalist_gold_formed and kvp_gnu: {!<tr><td><div class="box2" style='background-color:#0072C0'> </div> !}CPP: {!</td><td>!} [+ kvp_votes_heartland +]% {!</td><td>!} [+ str_votes_change_kvp_heartland +] {!</td><td>!} [+ kvp_r_heartland +]% {!</td><td>!} [+ str_change_kvp_heartland +] {!</td></tr>!} ?]

[? if traditionalist_gold_formed: {!<tr><td><div class="box2" style='background-color:#00C0FF'> </div> !}FCP: {!</td><td>!} [+ kvp_votes_heartland +]% {!</td><td>!} [+ str_votes_change_kvp_heartland +] {!</td><td>!} [+ kvp_r_heartland +]% {!</td><td>!} [+ str_change_kvp_heartland +] {!</td></tr>!} ?]

[? if not concord_formed and not traditionalist_defunct and traditionalist_gnu: {!<tr><td><div class="box2" style='background-color:#316B8F'> </div> !} Traditionalists: {!</td><td>!} [+ traditionalist_votes_heartland +]% {!</td><td>!} [+ str_votes_change_traditionalist_heartland +] {!</td><td>!} [+ traditionalist_r_heartland +]% {!</td><td>!} [+ str_change_traditionalist_heartland +] {!</td></tr>!}?]

[? if nvf_exist and nvf_gnu: {!<tr><td><div class="box2" style='background-color:#0F2116'> </div> !} NPF: {!</td><td>!} [+ nvf_votes_heartland +]% {!</td><td>!} [+ str_votes_change_nvf_heartland +] {!</td><td>!} [+ nvf_r_heartland +]% {!</td><td>!} [+ str_change_nvf_heartland +] {!</td></tr>!} ?]

[? if gnu_formed: <tr><td colspan="5" style="text-align: center;"><hr id="read-marker"></td></tr> ?]

[? if gnu_formed: {!<tr><td><div class="box" style='background-color:#E3000F;'> </div> !} Marchers: {!</td><td>!} [+ marcher_votes_heartland +]% {!</td><td>!} [+ str_votes_change_marcher_heartland +] {!</td><td>!} [+ marcher_r_heartland +]% {!</td><td>!} [+ str_change_marcher_heartland +] {!</td></tr>!} ?]

[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#9B0000'> </div> !}Laborists: {!</td><td>!} [+ sapd_votes_heartland +]% {!</td><td>!} [+ str_votes_change_sapd_heartland +] {!</td><td>!} [+ sapd_r_heartland +]% {!</td><td>!} [+ str_change_sapd_heartland +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#700000'> </div> !}Collectivists: {!</td><td>!} [+ collectivist_votes_heartland +]% {!</td><td>!} [+ str_votes_change_collectivist_heartland +] {!</td><td>!} [+ collectivist_r_heartland +]% {!</td><td>!} [+ str_change_collectivist_heartland +] {!</td></tr>!}

[? if not lvp_formed and not dstp_gnu: {!<tr><td><div class="box" style='background-color:#D3C24D'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_votes_heartland +]% {!</td><td>!} [+ str_votes_change_ddp_heartland +] {!</td><td>!} [+ ddp_r_heartland +]% {!</td><td>!} [+ str_change_ddp_heartland +] {!</td></tr>!} ?]

[? if lvp_formed and not lvp_gnu: {!<tr><td><div class="box" style='background-color:#C0A054'> </div> !} Golds: {!</td><td>!} [+ lvp_votes_heartland +]% {!</td><td>!} [+ str_votes_change_lvp_heartland +] {!</td><td>!} [+ lvp_r_heartland +]% {!</td><td>!} [+ str_change_lvp_heartland +] {!</td></tr>!} ?]

[? if not unionist_gnu: {!<tr><td><div class="box" style='background-color:#000'> </div> !} [+ unionist_party_name +]: {!</td><td>!} [+ unionist_votes_heartland +]% {!</td><td>!} [+ str_votes_change_unionist_heartland +] {!</td><td>!} [+ unionist_r_heartland +]% {!</td><td>!} [+ str_change_unionist_heartland +] {!</td></tr>!} ?]

[? if not lvp_formed and gold_exist and not gold_gnu: {!<tr><td><div class="box" style='background-color:#D5AC27'> </div> !} Golds: {!</td><td>!} [+ gold_votes_heartland +]% {!</td><td>!} [+ str_votes_change_gold_heartland +] {!</td><td>!} [+ gold_r_heartland +]% {!</td><td>!} [+ str_change_gold_heartland +] {!</td></tr>!} ?]

[? if not other_gnu: {!<tr><td><div class="box" style='background-color:#a0a0a0'> </div> !} Others: {!</td><td>!} [+ other_votes_heartland +]% {!</td><td>!} [+ str_votes_change_other_heartland +] {!</td><td>!} [+ other_r_heartland +]% {!</td><td>!} [+ str_change_other_heartland +] {!</td></tr>!} ?]

[? if kvp_formed and not concord_kvp_formed and not kvp_gnu: {!<tr><td><div class="box" style='background-color:#0087DC'> </div> !}CPP: {!</td><td>!} [+ kvp_votes_heartland +]% {!</td><td>!} [+ str_votes_change_kvp_heartland +] {!</td><td>!} [+ kvp_r_heartland +]% {!</td><td>!} [+ str_change_kvp_heartland +] {!</td></tr>!} ?]

[? if not concord_formed and not traditionalist_gnu: {!<tr><td><div class="box" style='background-color:#3E88B3'> </div> !} Traditionalists: {!</td><td>!} [+ traditionalist_votes_heartland +]% {!</td><td>!} [+ str_votes_change_traditionalist_heartland +] {!</td><td>!} [+ traditionalist_r_heartland +]% {!</td><td>!} [+ str_change_traditionalist_heartland +] {!</td></tr>!}?]

[? if dnf_formed : {!<tr><td><div class="box" style='background-color:#003755'> </div> !}CNF: {!</td><td>!} [+ dnf_votes_heartland +]% {!</td><td>!} [+ str_votes_change_dnf_heartland +] {!</td><td>!} [+ dnf_r_heartland +]% {!</td><td>!} [+ str_change_dnf_heartland +] {!</td></tr>!} ?]

[? if dsu_exist: {!<tr><td><div class="box" style='background-color:#6A1E1E'> </div> !} CSG: {!</td><td>!} [+ dsu_votes_heartland +]% {!</td><td>!} [+ str_votes_change_dsu_heartland +] {!</td><td>!} [+ dsu_r_heartland +]% {!</td><td>!} [+ str_change_dsu_heartland +] {!</td></tr>!} ?]

[? if not royalist_split: {!<tr><td><div class="box" style='background-color:#7A3C00'> </div> !} Royalists: {!</td><td>!} [+ royalist_votes_heartland +]% {!</td><td>!} [+ str_votes_change_royalist_heartland +] {!</td><td>!} [+ royalist_r_heartland +]% {!</td><td>!} [+ str_change_royalist_heartland +] {!</td></tr>!} ?]

[? if royalist_split: {!<tr><td><div class="box" style='background-color:#7A3C00'> </div> !} Royalists: {!</td><td>!} [+ royalist_gallax_votes_heartland +]% {!</td><td>!} [+ str_votes_change_royalist_gallax_heartland +] {!</td><td>!} [+ royalist_gallax_r_heartland +]% {!</td><td>!} [+ str_change_royalist_gallax_heartland +] {!</td></tr>!} ?]

[? if nvf_exist and not nvf_gnu: {!<tr><td><div class="box" style='background-color:#142e20'> </div> !} NPF: {!</td><td>!} [+ nvf_votes_heartland +]% {!</td><td>!} [+ str_votes_change_nvf_heartland +] {!</td><td>!} [+ nvf_r_heartland +]% {!</td><td>!} [+ str_change_nvf_heartland +] {!</td></tr>!} ?]
{!</table>!}

[? if royalist_urgency <= 1 and royalist_r_heartland >= 15 : The rapid rise in <span style="color: #7A3C00;">**Royalists**</span> votes is extremely worrying. Many had believed that the party was <span style="color: #ff0000;">moribund</span>; now, some of us consider it to be the greatest threat to democracy in the Commonwealth. ?]

[? if anti_democratic_coalition_heartland >= 50 and traditionalist_ideology == "Radical": Together, the anti-democratic <span style="color: #700000;">**Collectivists**</span>, <span style="color: #3E88B3;">**Traditionalists**</span>, and <span style="color: #7A3C00;">**Royalists**</span> have a majority in the state Assembly. A stable governing majority will be almost impossible. ?]

[? if anti_democratic_coalition_heartland >= 50 and traditionalist_ideology == "Moderate": Together, the anti-democratic <span style="color: #700000;">**Collectivists**</span>, <span style="color: #003755;">**CNF**</span>, and <span style="color: #7A3C00;">**Royalists**</span> have a majority in the state Assembly. A stable governing majority will be almost impossible. ?]

[? if dufour_angry_heartland : The rapid rise of the <span style="color: #7A3C00;">**Royalists**</span> in Heartland, traditionally a democratic stronghold, has significantly shifted the national mood. To conservative elites, including President DuFour, this surge has reinforced the belief that the <span style="color: #7A3C00;">**Royalists**</span> must be incorporated into the federal government. With [+ royalist_votes +]% of the population now backing the movement, it cannot be ignored much longer.  ?]

[? if left_coalition_heartland >= 50: The fact that the <span style="color: #9B0000;">Vaelist</span> parties now hold a majority in the state Assembly by themselves has energized the grassroots of both our parties to push for closer cooperation. ?]

