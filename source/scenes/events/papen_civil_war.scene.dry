title: The Final Battle
audio: music/communist/A_las_barricadas.ogg
on-arrival: {!
Q.banner_strength = Math.round(Q.banner_strength);
Q.warden_strength = Math.round(Q.warden_strength);
Q.loyalist_strength = Math.round(Q.loyalist_strength);
Q.vanguard_strength = Math.round(Q.vanguard_strength);
// re-calculate dissent, in case we transitioned from, say, the Collectivists support that raised reformist dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.knight_strength;
var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent + Q.knight_strength*Q.knight_dissent;

Q.dissent = 0.01*total_dissent/total_strength;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

Q.civil_war_seen = 1;

// our allies
Q.total_power = 0;
Q.banner_power = Q.banner_strength*Q.banner_militancy;
if (Q.dissent > 0.15) {
    Q.banner_power *= (1 - Q.dissent/1.5);
}
Q.total_power += Q.banner_power;
Q.heartland_police_power = Q.heartland_police_strength*Q.heartland_police_militancy*Q.heartland_police_loyalty;
if (Q.marcher_heartland && Q.heartland_leader == "Bristol" || Q.heartland_leader == "Pendrigon") {
    Q.total_power += Q.heartland_police_power;
} else if (Q.marcher_heartland && Q.heartland_leader !== "Bristol" && Q.heartland_leader !== "Pendrigon") {
    Q.total_power += (Q.heartland_police_power / 2);
}
if (Q.army_loyalty < 0) {
    Q.army_loyalty = 0;
}
Q.loyal_army_power = Q.army_strength*Q.army_militancy*Q.army_loyalty;
if (Q.marcher_in_government && Q.chancellor_party == "Marcher") {
    Q.total_power += Q.loyal_army_power;
} else {
    Q.total_power += Q.loyal_army_power/4;
}
Q.vanguard_power = Q.vanguard_strength*Q.vanguard_militancy;
if (Q.collectivist_relation >= 60) {
    Q.total_power += Q.vanguard_power;
} else if (Q.collectivist_relation >= 45) {
    Q.total_power += Q.vanguard_power*0.5;
}
// general strike strength
// maximum (given 25 labor strength) is 400
// use normalized workers_spd instead of labor_strength?
Q.normalized_commons_marcher = 100*Q.commons_marcher/(Q.commons_marcher + Q.commons_collectivist + Q.commons_royalist + Q.commons_other + Q.commons_traditionalist + Q.commons_unionist);
Q.normalized_commons_collectivist = 100*Q.commons_collectivist/(Q.commons_marcher + Q.commons_collectivist + Q.commons_royalist + Q.commons_other + Q.commons_traditionalist + Q.commons_unionist);
Q.normalized_commons_total = Q.normalized_commons_marcher;
if (Q.collectivist_relation >= 60) {
    Q.normalized_commons_total += Q.normalized_commons_collectivist;
} else if (Q.collectivist_relation >= 45) {
    Q.normalized_commons_total += Q.normalized_commons_collectivist*0.5;
}
Q.total_power += (2 - Q.labor_dissent/100)*Q.normalized_commons_total*(2 - Q.disfavored/100)*2.5;
console.log("Supporter strength:", Q.total_power);

// our enemies
Q.enemy_power = 0;
Q.loyalist_power = Q.loyalist_strength*Q.loyalist_militancy;
Q.enemy_power += Q.loyalist_power;
Q.warden_power = Q.warden_strength*Q.warden_militancy;
Q.enemy_power += Q.warden_power;
Q.hostile_army_power = Q.army_strength*Q.army_militancy*(1-Q.army_loyalty);
Q.enemy_power += Q.hostile_army_power;
console.log("Enemy strength:", Q.enemy_power);

if (Q.total_power > Q.enemy_power*1.1) {
    Q.republic_victory = 1;
    Q.papen_republic_victory = 1;
} else if (Q.total_power/Q.enemy_power >= 0.6) {
    Q.long_war = 1;
} else {
    Q.total_defeat = 1;
}

if (Q.total_defeat) { 
    Q.papen_power = 0;
    Q.royalist_power = 0;
    if (Q.hostile_army_power) Q.papen_power += Q.hostile_army_power;
    if (Q.heartland_leader == "Goodryke") Q.papen_power += Q.heartland_police_strength*Q.heartland_police_militancy*(1-Q.heartland_police_loyalty);
    Q.papen_power += Q.warden_strength*Q.warden_militancy;
    Q.royalist_power += Q.loyalist_strength*Q.loyalist_militancy;
    Q.royalist_power += (Q.commons_royalist_normalized + Q.disfavored_royalist_normalized);
    if (Q.papen_power >= Q.royalist_power) {
        Q.papen_win = 1;
    } else {
        Q.royalist_win = 1;
    }
}

Q.is_favorable = 0;
if (Q.total_power >= Q.enemy_power*0.95) {
    Q.is_favorable = 1;
}
!}
go-to: war_menu

= The Array of Forces

Our enemies are the <span style="color: #808080;">nationalist</span> <span style="color: #3E88B3;">**Wardens**</span>, with [+ warden_strength +] thousand troops, and the <span style="color: #7A3C00;">Royalist</span> <span style="color: #7A3C00;">**Loyalists**</span>, with [+ loyalist_strength +] thousand troops, both fighting on different sides. The loyalties of the Commonwealth Army, with its [+ army_strength +] thousand regular soldiers, and Heartland police, with [+ heartland_police_strength +] thousand members, are unclear, with many <span style="color: #7A3C00;">Royalist</span> and <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> sympathizers in each. 

Goodryke is backed primarily by the Commonwealth Army, the <span style="color: #3E88B3;">**Wardens**</span>, Mallin and his party, industrial elites, and President DuFour himself.

On our side, we have the Banners, at [+ banner_strength +] thousand members. [? if dissent > 0.15 and dissent <= 0.25: It is somewhat weakened by dissent within the party, and some members choose not to fight. ?][? if dissent > 0.25 and dissent < 0.5: It is weakened by dissent within the party, and many members choose not to fight. ?][? if dissent >= 0.5: It is heavily weakened by dissent within the party, and a substantial portion of members choose not to fight. ?]

[? if banner_militancy < 0.25 : Unfortunately, the Banners are poorly trained and equipped, and will not be able to stand against our more militarized opponents. ?][? if banner_militancy >= 0.25 and banner_militancy < 0.5 : We have spent some resources training and equipping the Banners. Let us hope our people can persist. ?][? if banner_militancy >= 0.5 : We have spent quite a great deal of resources on turning the Banners into a fighting force. Let us hope that they survive. ?]

What else do we have?

@war_menu

- @rw_help: Appeal to the Commonwealth Army to stand down.
- @kpd_help: Call for support from the <span style="color: #700000;">Collectivists</span>.
- @general_strike: Call a general strike!
- @loyal_police: Call up the loyal portions of the police.
- @war_outcome: Now, the battle...

@rw_help
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1

We have urged the Commonwealth Army to stand down, to avoid killing their countrymen. [? if army_loyalty < 0.2 : Unfortunately, few heed our calls; the Commonwealth Army detests us. ?][? if army_loyalty >= 0.2 and army_loyalty < 0.4 : Some officers and troops heed our calls to not fight against us. Some even join us. ?][? if army_loyalty >= 0.4 and army_loyalty < 0.6 : The Commonwealth Army is split. Many avoid taking a side, or join our side. ?][? if army_loyalty >= 0.6 : Surprisingly, the majority of the Commonwealth Army is on our side! Our preparations have worked. ?]

@kpd_help
max-visits: 1
view-if: chancellor_party != "Collectivist" and president != "Halsmark" 
go-to: war_menu
on-arrival: war_choices += 1

There are [+ vanguard_strength +] thousand fighters with the <span style="color: #700000;">Collectivist</span> <span style="color: #8B0000;">**Vanguard**</span>, in addition to the workers who support the <span style="color: #700000;">**Collectivists**</span>.

[? if collectivist_relation >= 60 : The <span style="color: #700000;">**Collectivists**</span> is entirely on our side, owing to our good relations. ?][? if collectivist_relation < 60 and collectivist_relation >= 45 : Most of the <span style="color: #700000;">**Collectivists**</span> is on our side, due to their good relations with us. ?][? if collectivist_relation < 45 : The <span style="color: #700000;">**Collectivists**</span> does not support us. ?]

@general_strike
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1

A general strike stopped the officers’ putsch in 4285, and it can stop <span style="color: #7A3C00;">Imperial Sovereigntism</span> today. [? if normalized_commons_total > 70 : The workers are largely united with us. ?][? if normalized_commons_total >= 50 and normalized_commons_total <= 70 : There is some dissent within labor, but a majority of workers support the general strike. ?][? if normalized_commons_total > 30 and normalized_commons_total < 50 : However, there is substantial dissent within labor, and less than half support the general strike. ?][? if normalized_commons_total <= 30 : However, labor is deeply divided, and most workers do not heed the call to strike. ?]


@loyal_police
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1
view-if: marcher_heartland = 1

Since we still control the Heartland government, we can call upon the Heartland police. [? if heartland_police_loyalty < 0.4 : Unfortunately, the police are politically unreliable at best. ?][? if heartland_police_loyalty >= 0.4 and heartland_police_loyalty < 0.65 : In this crucial hour, the Heartland police are split, with about half actively supporting our efforts. ?][? if heartland_police_loyalty >= 0.65 : Most join in supporting our efforts. Our efforts in cultivating <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> loyalties in the police have proven their worth. ?]




@foreign_intervention
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1; 

# note: the Heartland coup should not trigger foreign intervention...


@war_outcome
view-if: war_choices >= 2
go-to: defeat if total_defeat = 1; long_war if long_war = 1; republic_victory if republic_victory = 1

@defeat

= Total Defeat

Our forces are no match for those of the <span style="color: #808080;">reactionaries</span>. the Banners fighters are quickly overpowered by the forces of the <span style="color: #3E88B3;">Wardens</span>, <span style="color: #7A3C00;">**Loyalists**</span>, and Commonwealth Army. Many are killed before the rest surrender. Our remaining leaders either flee the country or face execution, as the <span style="color: #808080;">reactionaries</span> and <span style="color: #7A3C00;">Royalists</span> soon turn on each other.

[? if papen_win: Following our defeat, the better-equipped Commonwealth Army and <span style="color: #3E88B3;">**Wardens**</span> turn against the weakening <span style="color: #7A3C00;">**Loyalists**</span>, defeating them after a brutal struggle. [+ royalist_leader +] commits suicide, and many high-ranking <span style="color: #7A3C00;">**Royalists**</span> leaders are imprisoned. Goodryke has won—though with 90% of the country against him. ?][? if royalist_win: Following our defeat, the fanatical <span style="color: #7A3C00;">**Loyalists**</span> overwhelms the smaller but well equipped Commonwealth Army, and uses defections of pro-<span style="color: #7A3C00;">Royalist</span> elements in the <span style="color: #3E88B3;">**Wardens**</span> to their advantage. Eventually, Goodryke, hated by 90% of the Commonwealth people, is captured and executed along with President DuFour. Isen Glade and the <span style="color: #7A3C00;">**Loyalists**</span> now have significant influence in the new Commonwealth, vowing to go on a campaign of <span style="color: #7e0000;">**unspeakable**</span> <span style="color: #3f0000;">**horror**</span> against <span style="color: #005EB8;">beast-blooded</span>, and endless wars of violent expansion that will ruin the whole continent.  ?]

Our resistance will be recorded in the history books, and in the future, our names will be honored. But for now, all is lost.

- @game_over: Game over.

@long_war
go-to: long_war_intervention if resist_coup == 0; game_over_menu if resist_coup == 1

= Long War

The initial phase of the action ends, and somehow, both sides remain standing.

The war settles into fixed battle lines. This will not be a quick coup, but a long civil war. The nation will destroy itself before it can be rebuilt again.

@game_over_menu

While we might want to call for foreign assistance, the foreign powers see the "Heartland Coup" as a purely internal matter.

- @game_over

# no war

@long_war_intervention

- @west_aid: Perhaps we can receive aid from the Western powers, <span style="color: #002654;">Ethia</span> and <span style="color: #C8102E;">Fulyria</span>.
- @soviet_aid: Perhaps we can receive aid from the <span style="color: #750e0e;">Central Union</span>.
- @east_aid: Perhaps our northern neighbors, <span style="color: #DC143C;">the Allied States</span> and <span style="color: #11457E;">Cinderwall</span>, can help us. If they know anything, they do not want <span style="color: #7A3C00;">Sovereigntists</span> coming to power in the Commonwealth.
- @game_over: Game over.

@west_aid
choose-if: west_relation >= 2
unavailable-subtitle: Our relations are not strong enough.
on-arrival: west_aid += 1
max-visits: 1
go-to: long_war_intervention

We send a call for help to the West, but their governments are divided on whether or not to support us. We have to survive on our own until they make a decision.

@soviet_aid
choose-if: (soviet_relation >= 1 and collectivist_relation >= 50) or (collectivist_relation >= 75)
on-arrival: soviet_aid += 1
unavailable-subtitle: Our relations are not strong enough.
max-visits: 1
go-to: long_war_intervention

We send a call for help to the <span style="color: #750e0e;">Central Union</span>. The <span style="color: #700000;">**Collectivists**</span> receives the bulk of the aid, while the Banners and our loyal military units are left floundering. If we win, this does not bode well for our future.

@east_aid
choose-if: east_relation >= 2
on-arrival: east_aid += 1
unavailable-subtitle: Our relations are not strong enough.
max-visits: 1
go-to: long_war_intervention

<span style="color: #DC143C;">the Allied States</span> and <span style="color: #11457E;">Cinderwall</span> are largely too absorbed in their own problems to be of much help, but weapons and volunteers filter through the parts of the borders that we control.

@republic_victory

= Victory for the Republic

In a chaotic civil war between the Banners and <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> parties, <span style="color: #3E88B3;">**Wardens**</span> and the Commonwealth Army, and the <span style="color: #7A3C00;">**Loyalists**</span>: the anti-democratic forces are defeated! The infighting between the extremists have largely benefitted us.

The battle lines hold, and the <span style="color: #7A3C00;">**Loyalists**</span>, <span style="color: #3E88B3;">**Wardens**</span>, and Commonwealth Army forces are defeated. Today, the forces of the republic prevail over the <span style="color: #7A3C00;">Sovereigntists</span> and the <span style="color: #3E88B3;">reactionaries</span>. There is a new revolution in the Commonwealth. Let us hope it produces a longer-lasting peace than the previous one.

- @game_over: Game over.

