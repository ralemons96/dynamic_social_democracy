on-arrival: {!
if (Q.pro_republic < 50) Q.pro_republic += Q.traditionalist_votes;
Q.pro_republic += 3

if (Q.land_reform >= 1 || Q.landed_marcher_normalized >= 30 || (Q.landed_royalist_normalized >= (Q.landed_traditionalist_normalized + 5) && !Q.stegerwald_path) || (Q.landed_royalist_normalized >= (Q.landed_traditionalist_normalized + 7) && Q.stegerwald_path)) {
    Q.schiele_trigger = 1;
}

if (((Q.pro_republic >= ((Q.royalist_votes + Q.dnf_votes + Q.collectivist_votes)*2)) && Q.true_christian_democracy) || !Q.true_christian_democracy) {
    Q.treviranus_trigger = 1;
}

if (Q.pro_republic < ((Q.royalist_votes + Q.dnf_votes + Q.collectivist_votes)*2) && Q.true_christian_democracy) {
