@no_more
title: No more ministries.
on-arrival: {!
if (Q.labor_minister_party !== "Marcher") Q.labor_minister_party = "Unionist";
if (Q.labor_minister !== "Wistle") Q.labor_minister = "Sedgewick";

if (Q.labor_minister_party !== "Marcher" && Q.in_social_liberal_coalition) Q.labor_minister_party = Q.ddp_name;
if (Q.labor_minister_party !== "Marcher" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.labor_minister_party = "LVP";
if (Q.labor_minister !== "Wistle" && Q.in_social_liberal_coalition) Q.labor_minister = "Lindell";

if (Q.interior_minister_party !== "Marcher") Q.interior_minister_party = "Unionist";
if (Q.interior_minister !== "Heath") Q.interior_minister = "Werth";

if (Q.interior_minister_party !== "Marcher" && Q.in_social_liberal_coalition) Q.interior_minister_party = Q.ddp_name;
if (Q.interior_minister_party !== "Marcher" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.interior_minister_party = "LVP";
if (Q.interior_minister !== "Heath" && Q.in_social_liberal_coalition) Q.interior_minister = "Kells";

if (Q.finance_minister_party !== "Marcher" && Q.in_grand_coalition && !Q.lvp_formed) {
    Q.finance_minister_party = "Gold";
} else if (Q.finance_minister_party !== "Marcher" && Q.in_grand_coalition && Q.lvp_formed) {
    Q.finance_minister_party = "LVP";
}
if (Q.finance_minister !== "Bell" && (Q.in_grand_coalition)) Q.finance_minister = "Moldren";

if (Q.finance_minister_party !== "Marcher" && (Q.in_weimar_coalition || Q.in_popular_front || Q.in_social_catholic_coalition)) Q.finance_minister_party = "Unionist";
if (Q.finance_minister !== "Bell" && (Q.in_weimar_coalition || Q.in_popular_front || Q.in_social_catholic_coalition)) Q.finance_minister = "Calder";

if (Q.finance_minister_party !== "Marcher" && Q.in_social_liberal_coalition) Q.finance_minister_party = Q.ddp_name;
if (Q.finance_minister_party !== "Marcher" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.finance_minister_party = "LVP";
if (Q.finance_minister !== "Bell" && Q.in_social_liberal_coalition) Q.finance_minister = "Galanides";
if (Q.finance_minister !== "Bell" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.finance_minister = "Moldren";

if (Q.economic_minister_party !== "Marcher" && Q.in_grand_coalition && !Q.lvp_formed) {
    Q.economic_minister_party = "Gold";
} else if (Q.economic_minister_party !== "Marcher" && (Q.in_grand_coalition || Q.in_weimar_coalition) && Q.lvp_formed) {
    Q.economic_minister_party = "LVP";
}
if (Q.economic_minister !== "Smitt" && Q.in_grand_coalition) Q.economic_minister = "Curthose";

if (Q.economic_minister_party !== "Marcher" && (Q.in_weimar_coalition && !Q.lvp_formed || (Q.in_popular_front && Q.liberal_parliament === 0 && Q.bourgeois_parliament_ddp == 0 && !Q.lvp_formed))) Q.economic_minister_party = Q.ddp_name;
if (Q.economic_minister_party !== "Marcher" && (Q.in_weimar_coalition && Q.lvp_formed || (Q.in_popular_front && Q.liberal_parliament === 0 && Q.lvp_formed))) Q.economic_minister_party = "LVP";
if (Q.economic_minister !== "Smitt" && (Q.in_weimar_coalition || (Q.in_popular_front && Q.liberal_parliament === 0 && Q.bourgeois_parliament_ddp == 0 && !Q.lvp_formed))) Q.economic_minister = "Dietrich";

if (Q.economic_minister_party !== "Marcher" && (Q.in_popular_front && (Q.liberal_parliament || Q.bourgeois_parliament_ddp) && !Q.lvp_formed)) Q.economic_minister_party = "Unionist";
if (Q.economic_minister_party !== "Marcher" && (Q.in_popular_front && Q.lvp_formed)) Q.economic_minister_party = "Unionist";
if (Q.economic_minister_party == "Unionist" && Q.in_popular_front) Q.economic_minister = "Askew";

if (Q.economic_minister_party !== "Marcher" && Q.in_social_liberal_coalition) Q.economic_minister_party = Q.ddp_name;
if (Q.economic_minister_party !== "Marcher" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.economic_minister_party = "LVP";
if (Q.economic_minister !== "Smitt" && Q.in_social_liberal_coalition) Q.economic_minister = "Trennick";
if (Q.economic_minister !== "Smitt" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.economic_minister = "Curthose";

if (Q.economic_minister_party !== "Marcher" && (Q.in_social_catholic_coalition || (Q.in_popular_front && (Q.liberal_parliament === 1 || Q.bourgeois_parliament_ddp == 1 || Q.lvp_formed)))) Q.economic_minister_party = "Unionist";
if (Q.economic_minister !== "Smitt" && (Q.in_social_catholic_coalition || (Q.in_popular_front && (Q.liberal_parliament === 1 || Q.bourgeois_parliament_ddp == 1 || Q.lvp_formed)))) Q.economic_minister = "Askew";

if (Q.justice_minister_party !== "Marcher" && !Q.lvp_formed) {
    Q.justice_minister_party = Q.ddp_name;
} else if (Q.justice_minister_party !== "Marcher" && Q.lvp_formed) {
    Q.justice_minister_party = "LVP";
}
if (Q.justice_minister !== "Radbourne") Q.justice_minister = "Penn";

if (Q.justice_minister_party !== "Marcher" && (Q.in_weimar_coalition || Q.in_popular_front && (Q.liberal_parliament === 1 || Q.bourgeois_parliament_ddp == 1 || Q.lvp_formed) || Q.in_social_catholic_coalition)) Q.justice_minister_party = "Unionist";
if (Q.justice_minister !== "Radbourne" && (Q.in_weimar_coalition || Q.in_popular_front && (Q.liberal_parliament === 1 || Q.bourgeois_parliament_ddp == 1 || Q.lvp_formed) || Q.in_social_catholic_coalition)) Q.justice_minister = "Verrald";

if (Q.justice_minister_party !== "Marcher" && Q.in_social_liberal_coalition) Q.justice_minister_party = Q.ddp_name;
if (Q.justice_minister_party !== "Marcher" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.justice_minister_party = "LVP";
if (Q.justice_minister !== "Radbourne" && Q.in_social_liberal_coalition) Q.justice_minister = "Penn";

if (Q.foreign_minister_party !== "Marcher" && !Q.lvp_formed) {
    Q.foreign_minister_party = "Gold";
} else if (Q.foreign_minister_party !== "Marcher" && Q.lvp_formed) {
    Q.foreign_minister_party = "LVP";
}
if (Q.foreign_minister !== "Yardley") Q.foreign_minister = "Stratton";
if (Q.foreign_minister !== "Yardley" && Q.stresemann_dead === 1) Q.foreign_minister = "Curthose";
if (Q.foreign_minister_party !== "Marcher" && (Q.in_weimar_coalition && Q.lvp_formed)) Q.foreign_minister_party = "LVP";
if (Q.foreign_minister_party !== "Marcher" && (Q.in_weimar_coalition && !Q.lvp_formed || Q.in_popular_front || Q.in_social_catholic_coalition)) Q.foreign_minister_party = "Unionist";
if (Q.foreign_minister !== "Yardley" && (Q.in_weimar_coalition && !Q.lvp_formed || Q.in_popular_front || Q.in_social_catholic_coalition)) Q.foreign_minister = "Werth";

if (Q.foreign_minister_party !== "Marcher" && Q.in_social_liberal_coalition) Q.foreign_minister_party = Q.ddp_name;
if (Q.foreign_minister_party !== "Marcher" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.foreign_minister_party = "LVP";
if (Q.foreign_minister !== "Yardley" && Q.in_social_liberal_coalition) Q.foreign_minister = "Prittwell";

if (Q.agriculture_minister_party !== "Marcher" && !Q.lvp_formed) {
    Q.agriculture_minister_party = Q.ddp_name;
} else if (Q.agriculture_minister_party !== "Marcher" && Q.lvp_formed) {
    Q.agriculture_minister_party = "LVP";
}
if (Q.agriculture_minister !== "Bayle") Q.agriculture_minister = "Dietrich";

if (Q.agriculture_minister_party !== "Marcher" && (Q.in_weimar_coalition || Q.in_popular_front || Q.in_social_catholic_coalition)) Q.agriculture_minister_party = "Unionist";
if (Q.agriculture_minister !== "Bayle" && (Q.in_weimar_coalition || Q.in_popular_front || Q.in_social_catholic_coalition)) Q.agriculture_minister = "Harmes";

if (Q.agriculture_minister_party !== "Marcher" && Q.in_social_liberal_coalition) Q.agriculture_minister_party = Q.ddp_name;
if (Q.agriculture_minister_party !== "Marcher" && Q.in_social_liberal_coalition && Q.lvp_formed) Q.agriculture_minister_party = "LVP";
if (Q.agriculture_minister !== "Bayle" && Q.in_social_liberal_coalition) Q.agriculture_minister = "Dietrich";

if (Q.army_minister_party !== "Marcher") Q.army_minister_party = "I";
if (Q.army_minister !== "Lebbon") Q.army_minister = "Ravabelle";

if (!Q.gold_exist) {
    if (Q.foreign_minister_party == "Gold") { 
        Q.foreign_minister_party = "Unionist";
        Q.foreign_minister = "Askew";
    }
    if (Q.economic_minister_party == "Gold") Q.economic_minister_party = "Traditionalist";
    if (Q.finance_minister_party == "Gold") Q.finance_minister_party = "Traditionalist";
}

const ministries = [
    "foreign_minister_party",
    "interior_minister_party",
    "justice_minister_party",
    "labor_minister_party",
    "army_minister_party",
    "economic_minister_party",
    "finance_minister_party",
    "agriculture_minister_party"
];

ministries.forEach(ministry => {
    let partyKey = `${ministry}`;
    if (Q[partyKey] == "Unionist" || Q[partyKey] == "Traditionalist") {
        Q[partyKey] = "Unionist";
    }
});

if (Q.in_wholesome_coalition) {
    ministries.forEach(ministry => {
    let partyKey = `${ministry}`;
    if (Q[partyKey] != "Marcher") {
        Q[partyKey] = "Traditionalist";
    }
});
}
if (Q.dufour_angry_old > 0) Q.dufour_angry = Q.dufour_angry_old;
!}
subtitle: [? if leverage >= 10 : We still have some more leverage to gain ministries. ?][? if leverage < 10 : We do not have much leverage left. ?]
