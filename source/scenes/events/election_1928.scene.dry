        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_change_other = sign2 + Math.abs(Q.str_change_other).toFixed(1);
    Q.old_other_r = Q.other_r;
}

if (Q.gnu_formed && Q.nvf_exist) {
    if (Q.nvf_gnu) {
        if (Q.nvf_r) {
            Q.gnu_r += Q.nvf_r;
            Q.nvf_r = 0;
        }
        Q.gnu_votes += Q.nvf_votes;
    }
    Q.gnu_votes = Math.round(Q.gnu_votes * 10) / 10;
    Q.gnu_r = Math.round(Q.gnu_r * 10) / 10;
}

if (Q.gnu_formed) {
    Q.true_gnu_r = Math.round(Q.gnu_r * 10) / 10;
    Q.right_gnu_r = 0;
    Q.left_gnu_r = 0;
    Q.str_votes_change_staal_gnu = Q.staal_gnu_votes - Q.previous_staal_gnu_last_election_votes;
    
    var sign2 = Q.str_votes_change_staal_gnu > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_staal_gnu < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_staal_gnu = sign2 + Math.abs(Q.str_votes_change_staal_gnu).toFixed(1);
    Q.previous_staal_gnu_last_election_votes = Q.staal_gnu_votes;

    if (Q.right_gnu) {
        Q.right_gnu_r = Q.right_gnu_votes*(Q.gnu_r / Q.gnu_votes);
        Q.staal_gnu_r -= Q.right_gnu_r;

        Q.str_votes_change_right_gnu = Q.right_gnu_votes - Q.previous_right_gnu_last_election_votes;
        var sign2 = Q.str_votes_change_right_gnu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_right_gnu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_right_gnu = sign2 + Math.abs(Q.str_votes_change_right_gnu).toFixed(1);
        Q.previous_right_gnu_last_election_votes = Q.right_gnu_votes;

        Q.str_votes_change_staal_gnu = Q.staal_gnu_votes - Q.previous_staal_gnu_last_election_votes;
        var sign2 = Q.str_votes_change_staal_gnu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_staal_gnu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_staal_gnu = sign2 + Math.abs(Q.str_votes_change_staal_gnu).toFixed(1);
        Q.previous_staal_gnu_last_election_votes = Q.staal_gnu_votes;

        // reichstag share

        Q.str_change_right_gnu = Q.right_gnu_r - Q.old_right_gnu_r;
        var sign2 = Q.str_change_right_gnu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_right_gnu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_right_gnu = sign2 + Math.abs(Q.str_change_right_gnu).toFixed(1);
        Q.old_right_gnu_r = Q.right_gnu_r;

        Q.str_change_staal_gnu = Q.staal_gnu_r - Q.old_staal_gnu_r;
        var sign2 = Q.str_change_staal_gnu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_staal_gnu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_staal_gnu = sign2 + Math.abs(Q.str_change_staal_gnu).toFixed(1);
        Q.old_staal_gnu_r = Q.staal_gnu_r;
        Q.true_gnu_r = Q.gnu_r - Q.right_gnu_r;
        Q.true_gnu_r = Math.round(Q.gnu_r * 10) / 10;
        Q.right_gnu_r = Math.round(Q.right_gnu_r * 10) / 10;
    } else if (Q.left_gnu) {
        Q.left_gnu_r = Q.left_gnu_votes*(Q.gnu_r / Q.gnu_votes);
        Q.staal_gnu_r -= Q.left_gnu_r;

        Q.str_votes_change_left_gnu = Q.left_gnu_votes - Q.previous_left_gnu_last_election_votes;
        var sign2 = Q.str_votes_change_left_gnu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_left_gnu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_left_gnu = sign2 + Math.abs(Q.str_votes_change_left_gnu).toFixed(1);
        Q.previous_left_gnu_last_election_votes = Q.left_gnu_votes;

        Q.str_votes_change_staal_gnu = Q.staal_gnu_votes - Q.previous_staal_gnu_last_election_votes;
        var sign2 = Q.str_votes_change_staal_gnu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_staal_gnu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_staal_gnu = sign2 + Math.abs(Q.str_votes_change_staal_gnu).toFixed(1);
        Q.previous_staal_gnu_last_election_votes = Q.staal_gnu_votes;

        // reichstag share

        Q.str_change_left_gnu = Q.left_gnu_r - Q.old_left_gnu_r;
        var sign2 = Q.str_change_left_gnu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_left_gnu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_left_gnu = sign2 + Math.abs(Q.str_change_left_gnu).toFixed(1);
        Q.old_left_gnu_r = Q.left_gnu_r;

        Q.str_change_staal_gnu = Q.staal_gnu_r - Q.old_staal_gnu_r;
        var sign2 = Q.str_change_staal_gnu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_staal_gnu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_staal_gnu = sign2 + Math.abs(Q.str_change_staal_gnu).toFixed(1);
        Q.old_staal_gnu_r = Q.staal_gnu_r;
        Q.true_gnu_r = Q.gnu_r - Q.left_gnu_r;
        Q.true_gnu_r = Math.round(Q.gnu_r * 10) / 10;
        Q.left_gnu_r = Math.round(Q.left_gnu_r * 10) / 10;
    }
    Q.staal_gnu_r = Math.round(Q.staal_gnu_r * 10) / 10;
}

if ((Q.time - Q.marxist_malus_time >= 10 || !Q.marxist_malus_time) && (Q.left_strength >= Q.reformist_strength + Q.labor_strength)) {
    if (Q.marcher_votes >= 50) {
        Q.unionist_relation -= 12;
        Q.ddp_relation -= 12;
        Q.lvp_relation -= 12;
        Q.gold_relation -= 12;
        Q.lvp_right += 6;
        Q.gold_right += 6;
        Q.ddp_right += 5;
        Q.ddp_cohesion -= 4;
    } else if (Q.marcher_votes >= 45) {
        Q.unionist_relation -= 9;
        Q.ddp_relation -= 9;
        Q.lvp_relation -= 9;
        Q.gold_relation -= 9;
        Q.lvp_right += 4;
        Q.gold_right += 4;
        Q.ddp_right += 3;
        Q.ddp_cohesion -= 3;
    } else if (Q.marcher_votes >= 40) {
        Q.unionist_relation -= 6;
        Q.ddp_relation -= 6;
        Q.lvp_relation -= 6;
        Q.gold_relation -= 6;
        Q.lvp_right += 3;
        Q.gold_right += 3;
        Q.ddp_right += 2;
        Q.ddp_cohesion -= 2;
    } else if (Q.marcher_votes >= 35) {
        Q.unionist_relation -= 4;
        Q.ddp_relation -= 4;
        Q.lvp_relation -= 4;
        Q.gold_relation -= 4;
        Q.lvp_right += 2;
        Q.gold_right += 2;
        Q.ddp_right += 1;
        Q.ddp_cohesion -= 1;
    }
    Q.marxist_malus_time = Q.time;
}

Q.last_election_time = Q.time;

if (Q.election_boycott && Q.boycott_effect) {
    Q.commons_staal_bonus -= 1;
    Q.republicans_staal_bonus -= 1;
    Q.industrialists_staal_bonus -= 0.5;
    Q.nationalists_staal_bonus -= 0.5;
    if (Q.boycott_effect >= 1.05) {
        Q.commons_staal_bonus -= 1;
        Q.republicans_staal_bonus -= 1;
        Q.industrialists_staal_bonus -= 0.5;
        Q.nationalists_staal_bonus -= 0.5;
    }
    if (Q.boycott_effect >= 1.1) {
        Q.commons_staal_bonus -= 1;
        Q.republicans_staal_bonus -= 1;
        Q.industrialists_staal_bonus -= 0.5;
        Q.nationalists_staal_bonus -= 0.5;
    }
}

// The largest party can only be the Royalists or the SPD.
Q.largest_party = 'Marcher';
if (Q.royalist_r >= Q.marcher_r && Q.royalist_r >= Q.collectivist_r && Q.royalist_r >= Q.unionist_r) {
    Q.largest_party = 'Royalist';
}

if (Q.collectivist_r >= Q.marcher_r && Q.collectivist_r >= Q.royalist_r && Q.collectivist_r >= Q.unionist_r) {
    Q.largest_party = 'Collectivist';
}

if (Q.unionist_r >= Q.marcher_r && Q.unionist_r >= Q.royalist_r && Q.unionist_r >= Q.collectivist_r) {
    Q.largest_party = 'Unionist';
}

// coalitions
if (Q.lvp_formed) {
    Q.weimar_coalition = parseFloat((Q.marcher_r + Q.lvp_r + Q.unionist_r - Q.bvp_r).toFixed(1));
} else {
    Q.weimar_coalition = parseFloat((Q.marcher_r + Q.ddp_r + Q.unionist_r - Q.bvp_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.social_liberal_coalition = parseFloat((Q.marcher_r + Q.lvp_r).toFixed(1));
} else {
    Q.social_liberal_coalition = parseFloat((Q.marcher_r + Q.ddp_r).toFixed(1));
}

Q.social_catholic_coalition = parseFloat((Q.marcher_r + Q.unionist_r - Q.bvp_r).toFixed(1));

if (Q.lvp_formed) {
    Q.grand_coalition = parseFloat((Q.marcher_r + Q.lvp_r + Q.unionist_r).toFixed(1));
} else {
    Q.grand_coalition = parseFloat((Q.marcher_r + Q.ddp_r + Q.unionist_r + Q.gold_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.unionist_r + Q.gold_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r).toFixed(1));
} else {
    Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.unionist_r + Q.gold_r + Q.other_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r + Q.traditionalist_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.unionist_r + Q.ddp_r + Q.gold_r + Q.other_r + Q.traditionalist_r + Q.kvp_r).toFixed(1));
} else if (!Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r + Q.traditionalist_r).toFixed(1));
} else {
    Q.center_right_coalition = parseFloat((Q.unionist_r + Q.ddp_r + Q.gold_r + Q.other_r + Q.traditionalist_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.right_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r + Q.traditionalist_r).toFixed(1));
} else {
    Q.right_coalition = parseFloat((Q.unionist_r + Q.gold_r + Q.other_r + Q.traditionalist_r).toFixed(1));
}

if (Q.traditionalist_ideology === "Moderate") {
    Q.far_right_coalition = parseFloat((Q.dnf_r + Q.royalist_r).toFixed(1));
} else {
    Q.far_right_coalition = parseFloat((Q.traditionalist_r + Q.royalist_r).toFixed(1));
}

if (Q.gold_leader == "Coalfax" && Q.gold_ideology == "Right" && Q.gold_right - Q.gold_left >= 15 || Q.hugenberg_gold) {
    Q.far_right_coalition = parseFloat((Q.far_right_coalition + Q.gold_r).toFixed(1));
}

Q.left_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.sapd_r).toFixed(1));

if (Q.lvp_formed) {
    Q.popular_front_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.unionist_r - Q.bvp_r + Q.sapd_r).toFixed(1));
} else if (Q.liberal_parliament == 0 && Q.bourgeois_parliament_ddp == 0) {
    Q.popular_front_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.unionist_r + Q.ddp_r - Q.bvp_r + Q.sapd_r).toFixed(1));
} else if (Q.liberal_parliament == 1 || Q.bourgeois_parliament_ddp == 1) {
    Q.popular_front_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.unionist_r - Q.bvp_r + Q.sapd_r).toFixed(1));
}

if (Q.traditionalist_ideology === "Moderate") {
    Q.anti_democratic_coalition = parseFloat((Q.collectivist_r + Q.royalist_r + Q.dnf_r).toFixed(1));
} else {
    Q.anti_democratic_coalition = parseFloat((Q.collectivist_r + Q.royalist_r + Q.traditionalist_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.neo_weimar_coalition = parseFloat((Q.marcher_r + Q.lvp_r + Q.unionist_r + Q.other_r).toFixed(1));
} else {
    Q.neo_weimar_coalition = parseFloat((Q.marcher_r + Q.ddp_r + Q.unionist_r + Q.gold_r + Q.other_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.marcher_r + Q.lvp_r + Q.unionist_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.marcher_r + Q.ddp_r + Q.unionist_r + Q.gold_r + Q.other_r + Q.traditionalist_r + Q.kvp_r).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.marcher_r + Q.unionist_r + Q.lvp_r + Q.other_r + Q.traditionalist_r).toFixed(1));
} else {
    Q.cordon_sanitaire = parseFloat((Q.marcher_r + Q.unionist_r + Q.ddp_r + Q.gold_r + Q.other_r + Q.traditionalist_r).toFixed(1));
}

Q.gallax_right_coalition = parseFloat((Q.unionist_r + Q.royalist_r).toFixed(1));

Q.goerdeler_right_coalition = parseFloat((Q.unionist_r + Q.gold_r + Q.lvp_r + Q.other_r + Q.kvp_r + Q.traditionalist_r + Q.dnf_r).toFixed(1));

if (Q.lvp_formed) {
    Q.progressive_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + (Q.lvp_r / 3) + Q.sapd_r).toFixed(1));
} else {
    Q.progressive_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.ddp_r + Q.sapd_r).toFixed(1));
}

if (Q.gnu_formed) {
    Q.staal_right_coalition = parseFloat((Q.gnu_r + Q.lvp_r + Q.gold_r + Q.ddp_r + Q.unionist_r + Q.other_r + Q.kvp_r + Q.traditionalist_r + Q.dnf_r + Q.dsu_r).toFixed(1));
    Q.staal_left_coalition = parseFloat((Q.gnu_r + Q.marcher_r + Q.lvp_r + Q.ddp_r + Q.unionist_r).toFixed(1));
}

if (Q.collectivist_relation >= 30 && Q.sapd_formed == 1) {
    Q.weimar_coalition += Q.sapd_r;
}

Q.leverage = Q.marcher_r;
if (Q.right_coalition >= 50 && (Q.traditionalist_ideology == "Moderate" || Q.traditionalist_westarp) || Q.center_right_coalition >= 50 && Q.traditionalist_ideology == "Moderate") Q.leverage -= 5;
Q.support_collectivist_grand = 0;
Q.support_collectivist_weimar = 0;

Q.bruning_coalition = Q.neo_weimar_coalition;
if (Q.kvp_formed) Q.bruning_coalition += Q.kvp_r;
if (Q.traditionalist_ideology == "Moderate" && !Q.traditionalist_defect) Q.bruning_coalition = Q.cordon_sanitaire;
Q.bruning_coalition_loss = 0;
if (Q.cnblp_defect) Q.bruning_coalition_loss += Q.cnblp_r;
if (Q.wp_defect) Q.bruning_coalition_loss += Q.wp_r;
if (Q.gold_defect) Q.bruning_coalition_loss += (Q.gold_r*0.7);
if (Q.lvp_defect) Q.bruning_coalition_loss += (Q.lvp_r*0.4);
Q.bruning_coalition = Q.bruning_coalition - Q.bruning_coalition_loss;
Q.traditionalist_angry = 0;
if (Q.year >= 1932) {
    Q.elections_1932 += 1;
    Q.royalist_funds -= 1;
}
Q.grand_coalition_failed = 0;
// Reset government and ministers... Based on Askew's 4295 govt
Q.coalition_dissent = 0;
Q.collectivist_coalition_dissent = 0;
if (!Q.marcher_in_government) {
    Q.dufour_angry = 0;
    Q.dufour_angry_old = 0;
}
if (Q.marcher_in_government) Q.dufour_angry_old = Q.dufour_angry;
Q.marcher_in_government = 0;
Q.in_weimar_coalition = 0;
Q.in_grand_coalition = 0;
Q.in_wholesome_coalition = 0;
Q.in_social_catholic_coalition = 0;
Q.in_social_catholic_coalition = 0;
Q.in_left_front = 0;
Q.in_popular_front = 0;
Q.in_emergency_government = 0;
Q.in_minority_government = 0;
Q.in_unity_government = 0;
Q.marcher_toleration = 0;
Q.marcher_toleration_right = 0;
Q.marcher_caretaker = 0;
if (Q.lvp_formed) Q.foreign_minister_party = 'LVP'; 
if (!Q.lvp_formed) Q.foreign_minister_party = 'Gold';
Q.interior_minister_party = 'Unionist';
Q.justice_minister_party = 'I';
Q.labor_minister_party = 'Unionist';
Q.army_minister_party = 'I';
if (Q.lvp_formed) Q.economic_minister_party = 'LVP'; 
if (!Q.lvp_formed) Q.economic_minister_party = Q.ddp_name;
if (Q.lvp_formed) Q.finance_minister_party = 'LVP'; 
if (!Q.lvp_formed) Q.finance_minister_party = 'Gold';
Q.agriculture_minister_party = 'Unionist';

Q.ddp_in_popular_front = 0;

// reset Collectivists goals
Q.collectivist_goals_seen = 0;
Q.collectivist_ultimatum_seen = 0;
Q.welfare_goal = 0;
Q.agriculture_goal = 0;
Q.economy_goal = 0;
Q.finance_goal = 0;
Q.labor_goal = 0;
Q.foreign_goal = 0;
Q.interior_goal = 0;
Q.army_goal = 0;

Q.welfare_goal_completed = 0;
Q.agriculture_goal_completed = 0;
Q.economy_goal_completed = 0;
Q.finance_goal_completed = 0;
Q.labor_goal_completed = 0;
Q.foreign_goal_completed = 0;
Q.interior_goal_completed = 0;
Q.army_goal_completed = 0;

Q.concord_ministers_accepted = 0;
Q.concord_economy_accepted = 0;
Q.concord_chancellor_accepted = 0;
Q.concord_banner_accepted = 0;
Q.concord_women_accepted = 0;

Q.strike_term_seen = 0;
Q.grand_coalition_collapsed = 0;

// understanding the enemy
if (Q.royalist_r >= 15) {
    Q.understanding_enemy_timer = 2;
}

if (Q.dstp_formed && !Q.dstp_collapse_seen) {
    Q.dstp_election = 1;
}

if (Q.ddp_r < 3.6 && !Q.lvp_formed && !Q.liberal_parliament && !Q.bourgeois_parliament_ddp && Q.ddp_r) {
    Q.ddp_factionless = 1
}

if (Q.gallax_right_coalition >= 50 && Q.rubicon) {
    if (!Q.gallax_right_coalition_time) Q.gallax_right_coalition_time = Q.time;
}

if (Q.change_royalist_votes < -2 && Q.rubicon) {
    if (!Q.royalist_decline_time) Q.royalist_decline_time = Q.time;
}

if ((Q.marcher_votes < 20 && Q.staal_marcher_r >= 3) || (Q.marcher_votes < 25 && Q.marcher_votes > 20 && Q.staal_marcher_r >= 4)) {
    Q.staal_r_marcher -= 2;
    if (Q.staal_marcher_r >= 6) Q.staal_r_marcher -= 2;
    Q.staal_marcher_support -= 4;
    Q.staal_marcher_influence -= 1;
    Q.center_dissent += 5;
    Q.left_dissent += 5;
    Q.knight_dissent += 5;
}

if (Q.gnu_formed) Q.dufour_staal_r += Math.round((Q.gnu_votes / 10) * 10) / 10;

if (Q.left_coalition >= 50) {
    Q.collectivist_relation += 10;
    Q.left_strength += 10;
    Q.communist_coalition += 1;
    Q.coup_progress += 1;
}

var lippe_adjustment_factors = {
    spd: 1.32,
    sapd: 0.4,
    kpd: 0.91,
    ddp: 0.62,
    lvp: 1.15,
    z: 0.17,
    dvp: 2.0,
    dnvp: 1.19,
    nsdap: 1.05,
    other: 1.7,
    kvp: 1.35,
    dnf: 0.5
};

Q.old_marcher_lippe_elections_vote = Q.marcher_votes * lippe_adjustment_factors.spd;
Q.old_sapd_lippe_elections_vote = Q.sapd_votes * lippe_adjustment_factors.sapd;
Q.old_collectivist_lippe_elections_vote = Q.collectivist_votes * lippe_adjustment_factors.kpd;
Q.old_ddp_lippe_elections_vote = Q.ddp_votes * lippe_adjustment_factors.ddp;
Q.old_lvp_lippe_elections_vote = Q.lvp_votes * lippe_adjustment_factors.lvp;
Q.old_unionist_lippe_elections_vote = Q.unionist_votes * lippe_adjustment_factors.z;
Q.old_gold_lippe_elections_vote = Q.gold_votes * lippe_adjustment_factors.dvp;
Q.old_traditionalist_lippe_elections_vote = Q.traditionalist_votes * lippe_adjustment_factors.dnvp;
Q.old_royalist_lippe_elections_vote = Q.royalist_votes * lippe_adjustment_factors.nsdap;
Q.old_other_lippe_elections_vote = Q.other_votes * lippe_adjustment_factors.other;
Q.old_kvp_lippe_elections_vote = Q.kvp_votes * lippe_adjustment_factors.kvp;
Q.old_dnf_lippe_elections_vote = Q.dnf_votes * lippe_adjustment_factors.dnf;

if (Q.year < 1929) {
    Q.reichstag_size = 4.91;
} else if (Q.year < 1930) {
    Q.reichstag_size = 5.2;
} else if (Q.year < 1931) {
    Q.reichstag_size = 5.77;
    if (Q.disfavored < 8) Q.reichstag_size -= 0.1;
} else if (Q.year < 1932) {
    Q.reichstag_size = 5.95;
    if (Q.disfavored < 20) Q.reichstag_size -= 0.1;
    if (Q.disfavored < 25) Q.reichstag_size -= 0.1;
    if (Q.disfavored < 30) Q.reichstag_size -= 0.1;
} else if (Q.year < 1933) {
    Q.reichstag_size = 6.08;
    if (Q.disfavored < 20) Q.reichstag_size -= 0.1;
    if (Q.disfavored < 25) Q.reichstag_size -= 0.1;
    if (Q.disfavored < 30) Q.reichstag_size -= 0.1;
} else if (Q.year < 1934) {
    Q.reichstag_size = 5.95;
    if (Q.disfavored < 20) Q.reichstag_size -= 0.1;
    if (Q.disfavored < 25) Q.reichstag_size -= 0.1;
    if (Q.disfavored < 30) Q.reichstag_size -= 0.1;
} else {
    Q.reichstag_size = 5.5;
    if (Q.disfavored < 20) Q.reichstag_size -= 0.1;
    if (Q.disfavored < 25) Q.reichstag_size -= 0.1;
    if (Q.disfavored < 30) Q.reichstag_size -= 0.1;
}

var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties_graph) {
    election_result[party] = Q[party + '_r'];
}
Q.election_records.push(election_result);
!}
on-departure: royalist_urgency = 1 if (royalist_urgency == 0 and royalist_r >= 15)
on-display: {!
const data = [];

if (Q.collectivist_r) {
    data.push({
        "id": "collectivist",
        "legend": "Collectivist",
        "name": "Collectivist",
        "seats": Math.round(Q.collectivist_r * Q.reichstag_size),
    });
}

if (Q.sapd_r && Q.sapd_formed) {
    data.push({
        "id": "sapd",
        "legend": "Laborists",
        "name": "Laborists",
        "seats": Math.round(Q.sapd_r * Q.reichstag_size),
    });
}

if (Q.marcher_r && !Q.rdp_r) {
    data.push({
        "id": "marcher",
        "legend": "Marcher",
        "name": "Marcher",
        "seats": Math.round(Q.marcher_r * Q.reichstag_size),
    });
} else if (Q.marcher_r && Q.rdp_r) {
    data.push({
        "id": "marcher",
        "legend": "Marcher",
        "name": "Marcher",
        "seats": Math.round((Q.marcher_r - Q.rdp_r) * Q.reichstag_size),
    });
}

if (Q.rdp_r) {
    data.push({
        "id": "rdp",
        "legend": "RDP",
        "name": "RDP",
        "seats": Math.round(Q.rdp_r * Q.reichstag_size),
    });
}

if (Q.traditionalist_r && Q.traditionalist_wholesome) {
    data.push({
        "id": "traditionalist_wholesome",
        "legend": "Traditionalist",
        "name": "Traditionalist",
        "seats": Math.round(Q.traditionalist_r * Q.reichstag_size),
    });
}

if (Q.ddp_r && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r * Q.reichstag_size),
    });
}

if (Q.lvp_r && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r * Q.reichstag_size),
    });
}


if (Q.unionist_minus_bvp_r) {
    data.push({
        "id": "unionist",
        "legend": Q.unionist_party_name,
        "name": Q.unionist_party_name,
        "seats": Math.round(Q.unionist_minus_bvp_r * Q.reichstag_size),
    });
}

if (Q.bvp_r) {
    data.push({
        "id": "bvp",
        "legend": "Arcanists",
        "name": "Arcanists",
        "seats": Math.round(Q.bvp_r * Q.reichstag_size),
    });
}

if (Q.gold_r && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "gold",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r * Q.reichstag_size),
    });
}

if (Q.left_gnu_r && Q.left_gnu) {
    data.push({
        "id": "left_gnu",
        "legend": "Left_GNU",
        "name": "Left_GNU",
        "seats": Math.round(Q.left_gnu_r * Q.reichstag_size),
    });
}

if (Q.true_gnu_r && Q.gnu_formed && !Q.right_gnu && !Q.left_gnu) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round(Q.true_gnu_r * Q.reichstag_size),
    });
}

if (Q.true_gnu_r && Q.gnu_formed && Q.right_gnu && !Q.left_gnu) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round((Q.true_gnu_r - Q.right_gnu_r) * Q.reichstag_size),
    });
}

if (Q.true_gnu_r && Q.gnu_formed && !Q.right_gnu && Q.left_gnu) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round((Q.true_gnu_r - Q.left_gnu_r) * Q.reichstag_size),
    });
}

if (Q.right_gnu_r && Q.right_gnu) {
    data.push({
        "id": "right_gnu",
        "legend": "Right_GNU",
        "name": "Right_GNU",
        "seats": Math.round(Q.right_gnu_r * Q.reichstag_size),
    });
}

if (Q.wp_r) {
    data.push({
        "id": "wp",
        "legend": "ECP",
        "name": "ECP",
        "seats": Math.round(Q.wp_r * Q.reichstag_size),
    });
}

if (Q.cnblp_r) {
    data.push({
        "id": "farm3",
        "legend": "FCL",
        "name": "FCL",
        "seats": Math.round(Q.cnblp_r * Q.reichstag_size),
    });
}

if (Q.csvd_r && Q.csvd_formed) {
    data.push({
        "id": "csvd",
        "legend": "FSP",
        "name": "FSP",
        "seats": Math.round(Q.csvd_r * Q.reichstag_size),
    });
}

if (Q.other_r) {
    data.push({
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.true_other_r * Q.reichstag_size),
    });
}

if (Q.true_aspd_r && (Q.aspd_other || Q.aspd_kvp)) {
    data.push({
        "id": "aspd",
        "legend": "ORP",
        "name": "ORP",
        "seats": Math.round(Q.true_aspd_r * Q.reichstag_size),
    });
}

if (Q.kvp_formed && Q.kvp_r && !Q.aspd_kvp && !Q.traditionalist_gold_formed) {
    data.push({
        "id": "kvp",
        "legend": "CPP",
        "name": "CPP",
        "seats": Math.round(Q.kvp_r * Q.reichstag_size),
    });
} else if (Q.kvp_formed && Q.kvp_r && Q.aspd_kvp && !Q.traditionalist_gold_formed) {
    data.push({
        "id": "kvp",
        "legend": "CPP",
        "name": "CPP",
        "seats": Math.round((Q.kvp_r - Q.true_aspd_r) * Q.reichstag_size),
    });
}

if (Q.traditionalist_gold_formed) {
    data.push({
        "id": "fkp",
        "legend": "FCP",
        "name": "FCP",
        "seats": Math.round(Q.kvp_r * Q.reichstag_size),
    });
}

if (Q.traditionalist_r && !Q.traditionalist_wholesome) {
    data.push({
        "id": "traditionalist",
        "legend": "Traditionalist",
        "name": "Traditionalist",
        "seats": Math.round(Q.traditionalist_r * Q.reichstag_size),
    });
}

if (Q.dnf_formed && Q.dnf_r) {
    data.push({
        "id": "dnf",
        "legend": "CNF",
        "name": "CNF",
        "seats": Math.round(Q.dnf_r * Q.reichstag_size),
    });
}

if (Q.dsu_exist && Q.dsu_r) {
    data.push({
        "id": "dsu",
        "legend": "CSG",
        "name": "CSG",
        "seats": Math.round(Q.dsu_r * Q.reichstag_size),
    });
}

if (Q.royalist_split && Q.royalist_gallax_r) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_gallax_r * Q.reichstag_size),
    });
}

if (!Q.royalist_split && Q.royalist_r) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_r * Q.reichstag_size),
    });
}

if (Q.nvf_exist && Q.nvf_r) {
    data.push({
        "id": "nvf",
        "legend": "NPF",
        "name": "NPF",
        "seats": Math.round(Q.nvf_r * Q.reichstag_size),
    });
}

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);

    var lines = d3.linegraph(false, false,
            Q.parties_graph,
            {'marcher': '#E3000F', 'collectivist': '#700000', 'ddp': '#D3C24D', 'unionist': '#000', 'gold': '#D5AC27', 'traditionalist': '#3E88B3', 'royalist': '#7A3C00', 'other': '#a0a0a0', 'sapd': '#9B0000', 'dnf': '#003755', 'kvp': '#0087DC', 'lvp': '#FFCC00', 'gnu': '#BFC8CC', 'fkp': '#00C0FF'},
            {'marcher': 'Marcher', 'collectivist': 'Collectivist', 'ddp': Q.ddp_name, 'unionist': Q.unionist_party_name + ' + Arcanists', 'gold': 'Gold', 'traditionalist': 'Traditionalist', 'royalist': 'Royalist', 'other': 'Others', 'sapd': 'Laborists', 'dnf': 'CNF', 'kvp': 'CPP', 'lvp': 'LVP', 'gnu': 'GNU', 'fkp': 'FCP'});
    lines.width(width).height(400);
    //var svg = lines(Q.election_records);
    d3.select("#election_history").datum(Q.election_records).call(lines);
    //document.getElementById('election_history').innerHTML = svg.outerHTML;

    // party support records should not have so many ticks
    if (!Q.historical_mode) {
        var lines_2 = d3.linegraph(true, true,
            Q.parties_graph,
            {'marcher': '#E3000F', 'collectivist': '#700000', 'ddp': '#D3C24D', 'unionist': '#000', 'gold': '#D5AC27', 'traditionalist': '#3E88B3', 'royalist': '#7A3C00', 'other': '#a0a0a0', 'sapd': '#9B0000', 'dnf': '#003755', 'kvp': '#0087DC', 'lvp': '#FFCC00', 'gnu': '#BFC8CC', 'fkp': '#00C0FF'},
            {'marcher': 'Marcher', 'collectivist': 'Collectivist', 'ddp': Q.ddp_name, 'unionist': Q.unionist_party_name + ' + Arcanists', 'gold': 'Gold', 'traditionalist': 'Traditionalist', 'royalist': 'Royalist', 'other': 'Others', 'sapd': 'Laborists', 'dnf': 'CNF', 'kvp': 'CPP', 'lvp': 'LVP', 'gnu': 'GNU', 'fkp': 'FCP'});
        lines_2.width(width).height(400);
        d3.select("#party_support_history").datum(Q.party_support_records).call(lines_2);
    }
}
!}
go-to: achievement_check_e

= Election results

{!<svg id="reichstag" style="width: 500px; height: 250px;"> </svg>!}
[? if gnu_formed: Assembly mandates for the other parties in the <span style="color: #BFC8CC;">Commonwealth National Unity Front</span> organization are counted toward the party itself for simplicity's sake. ?]
{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td><td>Assembly Seats</td><td>% Change</td></tr>!}
[? if not gnu_formed: {!<tr><td><div class="box" style='background-color:#E3000F; outline: 2px; outline-style: solid;'> </div> !} **Marchers:** {!</td><td>!} **[+ marcher_votes +]%** {!</td><td>!} **[+ str_votes_change_marcher +]** {!</td><td>!} **[+ marcher_r +]%** {!</td><td>!} **[+ str_change_marcher +]** {!</td></tr>!} ?][? if gnu_formed: {!<tr><td><div class="box" style='background-color:#BFC8CC; outline: 2px; outline-style: solid;'> </div> !} **GNU:** {!</td><td>!} **[+ gnu_votes +]%** {!</td><td>!} **[+ str_votes_change_gnu +]** {!</td><td>!} **[+ true_gnu_r +]%** {!</td><td>!} **[+ str_change_gnu +]** {!</td></tr>!} ?]

[? if gnu_formed and not (right_gnu or left_gnu): {!<tr><td><div class="box2" style='background-color:#BFC8CC'> </div> !} GNU: {!</td><td>!} [+ staal_gnu_votes +]% {!</td><td>!} [+ str_votes_change_staal_gnu +] {!</td><td>!} [+ staal_gnu_r +]% {!</td><td>!} [+ str_change_gnu +] {!</td></tr>!} ?]

[? if gnu_formed and (right_gnu or left_gnu): {!<tr><td><div class="box3" style='background-color:#BFC8CC'> </div> !} GNU: {!</td><td>!} [+ staal_gnu_votes +]% {!</td><td>!} [+ str_votes_change_staal_gnu +] {!</td><td>!} [+ staal_gnu_r +]% {!</td><td>!} [+ str_change_gnu +] {!</td></tr>!} ?]

[? if gnu_formed and left_gnu: {!<tr><td><div class="box2" style='background-color:#B86558'> </div> !} GNU-SB: {!</td><td>!} [+ left_gnu_votes +]% {!</td><td>!} [+ str_votes_change_left_gnu +] {!</td><td>!} [+ left_gnu_r +]% {!</td><td>!} [+ str_change_left_gnu +] {!</td></tr>!} ?]

[? if gnu_formed and right_gnu: {!<tr><td><div class="box2" style='background-color:#5F7278'> </div> !} GNU-FL: {!</td><td>!} [+ right_gnu_votes +]% {!</td><td>!} [+ str_votes_change_right_gnu +] {!</td><td>!} [+ right_gnu_r +]% {!</td><td>!} [+ str_change_right_gnu +] {!</td></tr>!} ?]

[? if gnu_formed and (right_gnu or left_gnu): <tr><td colspan="5" style="text-align: center;"><hr id="read-marker"></td></tr> ?]

[? if not lvp_formed and dstp_gnu: {!<tr><td><div class="box2" style='background-color:#A79A3F'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_votes +]% {!</td><td>!} [+ str_votes_change_ddp +] {!</td><td>!} [+ ddp_r +]% {!</td><td>!} [+ str_change_ddp +] {!</td></tr>!} ?]

[? if lvp_formed and lvp_gnu: {!<tr><td><div class="box2" style='background-color:#CC9900'> </div> !} Golds: {!</td><td>!} [+ lvp_votes +]% {!</td><td>!} [+ str_votes_change_lvp +] {!</td><td>!} [+ lvp_r +]% {!</td><td>!} [+ str_change_lvp +] {!</td></tr>!} ?]

[? if unionist_gnu: {!<tr><td><div class="box2" style='background-color:#1A0000'> </div> !} [+ unionist_party_name +]: {!</td><td>!} [+ unionist_minus_bvp_votes +]% {!</td><td>!} [+ str_votes_change_unionist +] {!</td><td>!} [+ unionist_minus_bvp_r +]% {!</td><td>!} [+ str_change_unionist +] {!</td></tr>!} ?]

[? if unionist_gnu: {!<tr><td><div class="box2" style='background-color:#7aa7af'> </div> !} Arcanists: {!</td><td>!} [+ bvp_votes +]% {!</td><td>!} [+ str_votes_change_bvp +] {!</td><td>!} [+ bvp_r +]% {!</td><td>!} [+ str_change_bvp +] {!</td></tr>!} ?]

[? if not lvp_formed and gold_exist and gold_gnu: {!<tr><td><div class="box2" style='background-color:#AA861F'> </div> !} Golds: {!</td><td>!} [+ gold_votes +]% {!</td><td>!} [+ str_votes_change_gold +] {!</td><td>!} [+ gold_r +]% {!</td><td>!} [+ str_change_gold +] {!</td></tr>!} ?]

[? if other_gnu: {!<tr><td><div class="box2" style='background-color:#707070'> </div> !} Others: {!</td><td>!} [+ other_votes +]% {!</td><td>!} [+ str_votes_change_other +] {!</td><td>!} [+ other_r +]% {!</td><td>!} [+ str_change_other +] {!</td></tr>!} ?]

[? if kvp_formed and not concord_kvp_formed and kvp_gnu: {!<tr><td><div class="box2" style='background-color:#0072C0'> </div> !}CPP: {!</td><td>!} [+ kvp_votes +]% {!</td><td>!} [+ str_votes_change_kvp +] {!</td><td>!} [+ kvp_r +]% {!</td><td>!} [+ str_change_kvp +] {!</td></tr>!} ?]

[? if not concord_formed and traditionalist_gnu: {!<tr><td><div class="box2" style='background-color:#316B8F'> </div> !} Traditionalists: {!</td><td>!} [+ traditionalist_votes +]% {!</td><td>!} [+ str_votes_change_traditionalist +] {!</td><td>!} [+ traditionalist_r +]% {!</td><td>!} [+ str_change_traditionalist +] {!</td></tr>!}?]

[? if nvf_exist and nvf_gnu: {!<tr><td><div class="box2" style='background-color:#0F2116'> </div> !} NPF: {!</td><td>!} [+ nvf_votes +]% {!</td><td>!} [+ str_votes_change_nvf +] {!</td><td>!} [+ nvf_r +]% {!</td><td>!} [+ str_change_nvf +] {!</td></tr>!} ?]

[? if gnu_formed: <tr><td colspan="5" style="text-align: center;"><hr id="read-marker"></td></tr> ?]

[? if gnu_formed: {!<tr><td><div class="box" style='background-color:#E3000F;'> </div> !} Marchers: {!</td><td>!} [+ marcher_votes +]% {!</td><td>!} [+ str_votes_change_marcher +] {!</td><td>!} [+ marcher_r +]% {!</td><td>!} [+ str_change_marcher +] {!</td></tr>!} ?]

[? if lvp_formed and rdp_list: {!<tr><td><div class="box2" style='background-color:#E0B0FF'> </div> !} RDP: {!</td><td>!} [+ rdp_votes +]% {!</td><td>!} [+ str_votes_change_rdp +] {!</td><td>!} [+ rdp_r +]% {!</td><td>!} [+ str_change_rdp +] {!</td></tr>!} ?]

[? if not concord_formed and not traditionalist_gnu and not traditionalist_defunct and traditionalist_wholesome: {!<tr><td><div class="box" style='background-color:#3E88B3'> </div> !} Traditionalists: {!</td><td>!} [+ traditionalist_votes +]% {!</td><td>!} [+ str_votes_change_traditionalist +] {!</td><td>!} [+ traditionalist_r +]% {!</td><td>!} [+ str_change_traditionalist +] {!</td></tr>!}?]

[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#9B0000'> </div> !}Laborists: {!</td><td>!} [+ sapd_votes +]% {!</td><td>!} [+ str_votes_change_sapd +] {!</td><td>!} [+ sapd_r +]% {!</td><td>!} [+ str_change_sapd +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#700000'> </div> !}Collectivists: {!</td><td>!} [+ collectivist_votes +]% {!</td><td>!} [+ str_votes_change_collectivist +] {!</td><td>!} [+ collectivist_r +]% {!</td><td>!} [+ str_change_collectivist +] {!</td></tr>!}

[? if not lvp_formed and not dstp_gnu: {!<tr><td><div class="box" style='background-color:#D3C24D'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_votes +]% {!</td><td>!} [+ str_votes_change_ddp +] {!</td><td>!} [+ ddp_r +]% {!</td><td>!} [+ str_change_ddp +] {!</td></tr>!} ?]

[? if lvp_formed and not lvp_gnu: {!<tr><td><div class="box" style='background-color:#C0A054'> </div> !} Golds: {!</td><td>!} [+ lvp_votes +]% {!</td><td>!} [+ str_votes_change_lvp +] {!</td><td>!} [+ lvp_r +]% {!</td><td>!} [+ str_change_lvp +] {!</td></tr>!} ?]

[? if not unionist_gnu: {!<tr><td><div class="box" style='background-color:#000'> </div> !} [+ unionist_party_name +]: {!</td><td>!} [+ unionist_minus_bvp_votes +]% {!</td><td>!} [+ str_votes_change_unionist +] {!</td><td>!} [+ unionist_minus_bvp_r +]% {!</td><td>!} [+ str_change_unionist +] {!</td></tr>!} ?]

[? if not unionist_gnu: {!<tr><td><div class="box" style='background-color:#A2D8E0'> </div> !} Arcanists: {!</td><td>!} [+ bvp_votes +]% {!</td><td>!} [+ str_votes_change_bvp +] {!</td><td>!} [+ bvp_r +]% {!</td><td>!} [+ str_change_bvp +] {!</td></tr>!} ?]

[? if not lvp_formed and gold_exist and not gold_gnu: {!<tr><td><div class="box" style='background-color:#D5AC27'> </div> !} Golds: {!</td><td>!} [+ gold_votes +]% {!</td><td>!} [+ str_votes_change_gold +] {!</td><td>!} [+ gold_r +]% {!</td><td>!} [+ str_change_gold +] {!</td></tr>!} ?]
 
[? if not other_gnu: {!<tr><td><div class="box" style='background-color:#a0a0a0'> </div> !} Others: {!</td><td>!} [+ other_votes +]% {!</td><td>!} [+ str_votes_change_other +] {!</td><td>!} [+ other_r +]% {!</td><td>!} [+ str_change_other +] {!</td></tr>!} ?]

[? if aspd_other: {!<tr><td><div class="box2" style='background-color:#fe9e00'> </div> !} ORP: {!</td><td>!} [+ aspd_votes +]% {!</td><td>!} [+ str_votes_change_aspd +] {!</td><td>!} [+ aspd_r +]% {!</td><td>!} [+ str_change_aspd +] {!</td></tr>!} ?]

[? if traditionalist_gold_formed and not kvp_gnu: {!<tr><td><div class="box" style='background-color:#00C0FF'> </div> !}FCP: {!</td><td>!} [+ kvp_votes +]% {!</td><td>!} [+ str_votes_change_kvp +] {!</td><td>!} [+ kvp_r +]% {!</td><td>!} [+ str_change_kvp +] {!</td></tr>!} ?]

[? if kvp_formed and not traditionalist_gold_formed and not concord_kvp_formed and not kvp_gnu: {!<tr><td><div class="box" style='background-color:#0087DC'> </div> !}CPP: {!</td><td>!} [+ kvp_votes +]% {!</td><td>!} [+ str_votes_change_kvp +] {!</td><td>!} [+ kvp_r +]% {!</td><td>!} [+ str_change_kvp +] {!</td></tr>!} ?]

[? if aspd_kvp: {!<tr><td><div class="box2" style='background-color:#fe9e00'> </div> !} ORP: {!</td><td>!} [+ aspd_votes +]% {!</td><td>!} [+ str_votes_change_aspd +] {!</td><td>!} [+ aspd_r +]% {!</td><td>!} [+ str_change_aspd +] {!</td></tr>!} ?]

[? if not concord_formed and not traditionalist_gnu and not traditionalist_defunct and not traditionalist_wholesome: {!<tr><td><div class="box" style='background-color:#3E88B3'> </div> !} Traditionalists: {!</td><td>!} [+ traditionalist_votes +]% {!</td><td>!} [+ str_votes_change_traditionalist +] {!</td><td>!} [+ traditionalist_r +]% {!</td><td>!} [+ str_change_traditionalist +] {!</td></tr>!}?]

[? if dnf_formed : {!<tr><td><div class="box" style='background-color:#003755'> </div> !}CNF: {!</td><td>!} [+ dnf_votes +]% {!</td><td>!} [+ str_votes_change_dnf +] {!</td><td>!} [+ dnf_r +]% {!</td><td>!} [+ str_change_dnf +] {!</td></tr>!} ?]

[? if dsu_exist: {!<tr><td><div class="box" style='background-color:#6A1E1E'> </div> !} CSG: {!</td><td>!} [+ dsu_votes +]% {!</td><td>!} [+ str_votes_change_dsu +] {!</td><td>!} [+ dsu_r +]% {!</td><td>!} [+ str_change_dsu +] {!</td></tr>!} ?]

[? if not royalist_split: {!<tr><td><div class="box" style='background-color:#7A3C00'> </div> !} Royalists: {!</td><td>!} [+ royalist_votes +]% {!</td><td>!} [+ str_votes_change_royalist +] {!</td><td>!} [+ royalist_r +]% {!</td><td>!} [+ str_change_royalist +] {!</td></tr>!} ?]

[? if royalist_split: {!<tr><td><div class="box" style='background-color:#7A3C00'> </div> !} Royalists: {!</td><td>!} [+ royalist_gallax_votes +]% {!</td><td>!} [+ str_votes_change_royalist_gallax +] {!</td><td>!} [+ royalist_gallax_r +]% {!</td><td>!} [+ str_change_royalist_gallax +] {!</td></tr>!} ?]

[? if nvf_exist and not nvf_gnu: {!<tr><td><div class="box" style='background-color:#142e20'> </div> !} NPF: {!</td><td>!} [+ nvf_votes +]% {!</td><td>!} [+ str_votes_change_nvf +] {!</td><td>!} [+ nvf_r +]% {!</td><td>!} [+ str_change_nvf +] {!</td></tr>!} ?]
{!</table>!}

{!<button class="tab_button" id="demographics_tab" onclick="window.toggleDem();">Demographic Results</button>!}
{!<button class="tab_button" id="election_tab" onclick="window.toggleElectionGraph();">Previous Elections Graph</button>!}
{!<button class="tab_button" id="graph_tab" onclick="window.toggleGraph();">Party Support Graph</button>!}

{!<div id="results" style="display: none;">!}
    {!<div style="overflow-x:auto;">!}
    {!<table style="text-align:center; border-spacing: 0.2em;">!}
        {!<tr>!}
            {!<th>Party</th>!}
            {!<th>Commons</th>!}
            {!<th>Burghers</th>!}
            {!<th>Guilds</th>!}
            {!<th>Landed</th>!}
            {!<th>Disfavored</th>!}
            {!<th>Faithful</th>!}
        {!</tr>!}
        [? if gnu_formed: {!<tr>!}
            {!<td><span style="color: #BFC8CC;">!}**GNU**{!</span></td>!}
            {!<td style="background-color: rgba(191, 200, 204, 0.2); padding: 10px; font-size: 0.85em;">!}[+ commons_gnu_display +]%[? if n_elections != 1 and demo_change_commons_gnu_display != 0 : ([+ demo_change_commons_gnu_display +])?]{!</td>!}
            {!<td style="background-color: rgba(191, 200, 204, 0.2); font-size: 0.85em;">!}[+ burgher_gnu_display +]%[? if n_elections != 1 and demo_change_burgher_gnu_display != 0 : ([+ demo_change_burgher_gnu_display +])?]{!</td>!}
            {!<td style="background-color: rgba(191, 200, 204, 0.2); font-size: 0.85em;">!}[+ guild_gnu_display +]%[? if n_elections != 1 and demo_change_guild_gnu_display != 0 : ([+ demo_change_guild_gnu_display +])?]{!</td>!}
            {!<td style="background-color: rgba(191, 200, 204, 0.2); font-size: 0.85em;">!}[+ landed_gnu_display +]%[? if n_elections != 1 and demo_change_landed_gnu_display != 0 : ([+ demo_change_landed_gnu_display +])?]{!</td>!}
            {!<td style="background-color: rgba(191, 200, 204, 0.2); font-size: 0.85em;">!}[+ disfavored_gnu_display +]%[? if n_elections != 1 and demo_change_disfavored_gnu_display != 0 : ([+ demo_change_disfavored_gnu_display +])?]{!</td>!}
            {!<td style="background-color: rgba(191, 200, 204, 0.2); font-size: 0.85em;">!}[+ faithful_gnu_display +]%[? if n_elections != 1 and demo_change_faithful_gnu_display != 0 : ([+ demo_change_faithful_gnu_display +])?]{!</td>!}
        {!</tr>!}?]
        {!<tr>!}
            {!<td><span style="color: #c00000;"><b>Marchers</b></span></td>!}
            {!<td style="background-color: rgba(192, 0, 0, 0.1); font-size: 0.85em; padding: 10px">!}[+ commons_marcher_display +]%[? if n_elections != 1 and demo_change_commons_marcher_display != 0 : ([+ demo_change_commons_marcher_display +])?]{!</td>!}
            {!<td style="background-color: rgba(192, 0, 0, 0.1); font-size: 0.85em;">!}[+ burgher_marcher_display +]%[? if n_elections != 1 and demo_change_burgher_marcher_display != 0 : ([+ demo_change_burgher_marcher_display +])?]{!</td>!}
            {!<td style="background-color: rgba(192, 0, 0, 0.1); font-size: 0.85em;">!}[+ guild_marcher_display +]%[? if n_elections != 1 and demo_change_guild_marcher_display != 0 : ([+ demo_change_guild_marcher_display +])?]{!</td>!}
            {!<td style="background-color: rgba(192, 0, 0, 0.1); font-size: 0.85em;">!}[+ landed_marcher_display +]%[? if n_elections != 1 and demo_change_landed_marcher_display != 0 : ([+ demo_change_landed_marcher_display +])?]{!</td>!}
            {!<td style="background-color: rgba(192, 0, 0, 0.1); font-size: 0.85em;">!}[+ disfavored_marcher_display +]%[? if n_elections != 1 and demo_change_disfavored_marcher_display != 0 : ([+ demo_change_disfavored_marcher_display +])?]{!</td>!}
            {!<td style="background-color: rgba(192, 0, 0, 0.1); font-size: 0.85em;">!}[+ faithful_marcher_display +]%[? if n_elections != 1 and demo_change_faithful_marcher_display != 0 : ([+ demo_change_faithful_marcher_display +])?]{!</td>!}
        {!</tr>!}
        [? if sapd_formed: {!<tr>!}
            {!<td><span style="color: #9B0000;">!}**Laborists**{!</span></td>!}
            {!<td style="background-color: rgba(155, 0, 0, 0.2); padding: 10px; font-size: 0.85em;">!}[+ commons_sapd_display +]%[? if n_elections != 1 and demo_change_commons_sapd_display != 0 : ([+ demo_change_commons_sapd_display +])?]{!</td>!}
            {!<td style="background-color: rgba(155, 0, 0, 0.2); font-size: 0.85em;">!}[+ burgher_sapd_display +]%[? if n_elections != 1 and demo_change_burgher_sapd_display != 0 : ([+ demo_change_burgher_sapd_display +])?]{!</td>!}
