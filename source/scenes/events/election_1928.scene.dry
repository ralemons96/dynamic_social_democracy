        {!</tr>!}
        {!<tr>!}
            {!<td><span style="color: #700000;"><b>Collectivists</b></span></td>!}
            {!<td style="background-color: rgba(112, 0, 0, 0.2); font-size: 0.85em; padding: 10px">!}[+ commons_collectivist_display +]%[? if n_elections != 1 and demo_change_commons_collectivist_display != 0 : ([+ demo_change_commons_collectivist_display +])?]{!</td>!}
            {!<td style="background-color: rgba(112, 0, 0, 0.2); font-size: 0.85em;">!}[+ burgher_collectivist_display +]%[? if n_elections != 1 and demo_change_burgher_collectivist_display != 0 : ([+ demo_change_burgher_collectivist_display +])?]{!</td>!}
