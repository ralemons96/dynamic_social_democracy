    Q.pre_previous_unionist_last_election_votes = Q.previous_unionist_last_election_votes;
    Q.unionist_votes_pre = Q.unionist_votes;

    Q.adjustmentFactors_votes_marcher = 1.0;
    Q.adjustmentFactors_votes_sapd = 1.0;
    Q.adjustmentFactors_votes_collectivist = 1.0;
    Q.adjustmentFactors_votes_unionist = 1.0;
    Q.adjustmentFactors_votes_ddp = 1.0;
    Q.adjustmentFactors_votes_gold = 1.0;
    Q.adjustmentFactors_votes_lvp = 1.0;
    Q.adjustmentFactors_votes_traditionalist = 1.0;
    Q.adjustmentFactors_votes_royalist = 1.0;
    Q.adjustmentFactors_votes_dnf = 1.0;
    Q.adjustmentFactors_votes_kvp = 1.0;
    Q.adjustmentFactors_votes_other = 1.0;

    Q.adjustmentFactors_marcher = 1.0;
    Q.adjustmentFactors_sapd = 1.0;
    Q.adjustmentFactors_collectivist = 1.0;
    Q.adjustmentFactors_unionist = 1.0;
    Q.adjustmentFactors_ddp = 1.0;
    Q.adjustmentFactors_gold = 1.0;
    Q.adjustmentFactors_lvp = 1.0;
    Q.adjustmentFactors_traditionalist = 1.0;
    Q.adjustmentFactors_royalist = 1.0;
    Q.adjustmentFactors_dnf = 1.0;
    Q.adjustmentFactors_gnu = 1.0;
    Q.adjustmentFactors_kvp = 1.0;
    Q.adjustmentFactors_other = 0.75;

    var new_party_sum = 0;
    var total_reichstag_without = 0;  // Initialize a variable to accumulate 'reichstag_without_' values
    var total_other_party_sum = 0;    // Initialize a variable to accumulate '_other_party_sum' values
    if (Q.year === 1928 && Q.traditionalist_leader === "Mallin" || Q.traditionalist_westarp) {
        Q.adjustmentFactors_other = 0.75;
    } else if (Q.year === 1929 && Q.traditionalist_leader === "Mallin") {
        Q.adjustmentFactors_other = 0.85;
    } else if (Q.year === 1930 && Q.traditionalist_leader === "Mallin") {
        Q.adjustmentFactors_other = 0.9;
    } else if (Q.year === 1931 && Q.traditionalist_leader === "Mallin") {
        Q.adjustmentFactors_other = 0.8;
    } else if (Q.year >= 1932 && Q.traditionalist_leader === "Mallin") {
        Q.adjustmentFactors_other = 0.6;
    } else if (Q.year >= 1928 && Q.traditionalist_leader === "Triumvirate") {
        Q.adjustmentFactors_other = 0.75;
    } else if (Q.year === 1928 && Q.traditionalist_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.65;
    } else if (Q.year === 1929 && Q.traditionalist_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.7;
    } else if (Q.year === 1930 && Q.traditionalist_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.75;
    } else if (Q.year === 1931 && Q.traditionalist_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.7;
    } else if (Q.year >= 1932 && Q.traditionalist_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.6;
    }
    if (Q.kvp_cnblp_sister) {
        Q.adjustmentFactors_other += 0.05;
    }
    if (Q.bourgeois_parliament || Q.bourgeois_parliament_no_liberals) {
        Q.adjustmentFactors_other += 0.05;
    }
    if (Q.other_votes >= 8 && Q.year >= 1931) {
        Q.adjustmentFactors_other += 0.1;
    }
    if (Q.other_gnu) {
        Q.adjustmentFactors_other = 0;
    }
    if (Q.concord_formed) Q.adjustmentFactors_other = 0.6;
    if (Q.aspd_other) Q.adjustmentFactors_other += 0.4;
    Q.adjustmentFactors_ddp = 1.0;
    if (!Q.bourgeois_list_ddp && !Q.dstp_gnu) {
        if (Q.ddp_votes < 1 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.3;
        } else if (Q.ddp_votes < 1.5 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.65;
        } else if (Q.ddp_votes < 3 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.75;
        } else if (Q.ddp_votes < 4 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.85;
        }
    }
    if (Q.ddp_alliance) Q.adjustmentFactors_ddp = 0.8;
    if (Q.ddp_alliance_glaze) Q.adjustmentFactors_ddp = 1.1;
    Q.adjustmentFactors_gold = 1.0;
    if (!Q.hugenberg_gold && !Q.bourgeois_list && !Q.gold_gnu) {
        if (Q.gold_votes < 1.5) {
            Q.adjustmentFactors_gold = 0.25;
        } else if (Q.gold_votes < 2) {
            Q.adjustmentFactors_gold = 0.4;
        } else if (Q.gold_votes < 2.5) {
            Q.adjustmentFactors_gold = 0.6;            
        } else if (Q.gold_votes < 3) {
            Q.adjustmentFactors_gold = 0.8;   
        }
    }
    if (Q.hugenberg_gold) Q.adjustmentFactors_gold = 1.0;

    if (Q.election_boycott) {
        Q.adjustmentFactors_votes_marcher = 1.0*(1-Q.marcher_boycott_efficacy);
        Q.adjustmentFactors_votes_sapd = 0.0;
        Q.adjustmentFactors_votes_collectivist = 0.0;
        Q.adjustmentFactors_votes_unionist = 1.0*(1-Q.unionist_boycott_efficacy);
        Q.adjustmentFactors_votes_ddp = 1.0*(1-Q.lib_boycott_efficacy);
        Q.adjustmentFactors_votes_gold = 1.0*(1.2-Q.lib_boycott_efficacy);
        Q.adjustmentFactors_votes_lvp = 1.0*(1-Q.lib_boycott_efficacy);
        Q.adjustmentFactors_votes_traditionalist = 1.0;
        if (Q.traditionalist_ideology == "Radical") Q.adjustmentFactors_votes_traditionalist = 0.6;
        Q.adjustmentFactors_votes_royalist = 1.0;
        if (Q.nvf_exist && !Q.nvf_gnu) Q.adjustmentFactors_votes_royalist -= 0.1;
        Q.adjustmentFactors_votes_dnf = 1.0;
        if (Q.traditionalist_ideology == "Moderate") Q.adjustmentFactors_votes_dnf = 0.4;
        Q.adjustmentFactors_votes_kvp = 1.0;
        Q.adjustmentFactors_votes_other = 1.0;

        Q.collectivist_banned = 1;
        Q.sapd_banned = 1;
        Q.marcher_banned = 1;
        if (Q.unionist_boycott_efficacy >= 0.74) Q.unionist_banned = 1;
        if (Q.lib_boycott_efficacy >= 0.74) Q.ddp_banned = 1;
        if (Q.lib_boycott_efficacy >= 0.89) Q.gold_banned = 1;
        if (Q.lib_boycott_efficacy >= 0.74) Q.lvp_banned = 1;
        if (Q.traditionalist_ideology == "Radical") Q.traditionalist_banned = 1;
        if (Q.traditionalist_ideology == "Moderate") Q.dnf_banned = 1;
    } else {
        Q.marcher_banned = 0;
        Q.unionist_banned = 0;
        Q.ddp_banned = 0;
        Q.gold_banned = 0;
        Q.lvp_banned = 0;
        Q.traditionalist_banned = 0;
        Q.dnf_banned = 0;
    }
    let total_adjusted_votes = 0;
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_votes_' + party] || 1.0;
        Q['original_' + party + '_votes'] = Q[party + '_votes'];
        Q[party + '_votes'] = Q[party + '_votes'] * factor;
        total_adjusted_votes += Q[party + '_votes'];
    }

    let normalization_factor = 100 / total_adjusted_votes;
    Q.boycott_effect = normalization_factor;
    for (var party of Q.parties) {
        Q[party + '_votes'] = Math.round(Q[party + '_votes'] * normalization_factor * 10) / 10;
    }
    // Step 1: Calculate adjusted values and the sum for redistribution
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_' + party] || 1.0; // Default to 1.0 if not set
        
        Q['old_' + party + '_r'] = Q[party + '_r']; // Store the original r value for comparison
        
        // Handle constitutional reform logic: set the party's share to 0 based on conditions
        if ((Q.constitutional_reform > 0 &&
             (Q[party + '_votes'] < Q.electoral_threshold || 
             (Q.electoral_threshold > 1 && party === 'other'))) 
            || Q[party + '_banned']) {
            Q[party + '_r'] = 0;
        } else {
            // Adjust `r` based on the adjustment factor if not affected by constitutional reform
            Q['original_' + party + '_r'] = Math.round(Q[party + '_votes'] * 10) / 10;
            Q[party + '_r'] = Math.round(Q[party + '_votes'] * factor * 10) / 10;
        }
        
        if (Q[party + '_r'] > 0) {
            if (factor !== 1.0) { // Only apply to parties with adjustment factors
                // Calculate the Assembly without the current party's share
                Q['reichstag_without_' + party] = 100 - Q['original_' + party + '_r'];
                total_reichstag_without += Q['reichstag_without_' + party]; // Accumulate the total of 'reichstag_without_' values

                // Calculate the sum of the remaining parties
                Q[party + '_other_party_sum'] = Q['reichstag_without_' + party] - (Q[party + '_votes'] - Q[party + '_r']);
                total_other_party_sum += Q[party + '_other_party_sum']; // Accumulate the total of '_other_party_sum' values
            } else {
                // For non-adjusted parties, accumulate their r value for the redistribution
                new_party_sum += Q[party + '_r'];
            }
        }
    }
    
console.log(Q.marcher_r)

// Step 2: Redistribute results among non-adjusted parties to ensure the total is 100%
if (new_party_sum > 0) {
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_' + party] || 1.0;

        if (Q[party + '_r'] === 0) continue;

        var total_reichstag_without_party = total_reichstag_without - (100 - Q['original_' + party + '_r']);
        var total_other_party_sum_party = total_other_party_sum - (Q['reichstag_without_' + party] - (Q[party + '_votes'] - Q[party + '_r']));

        console.log(Q.marcher_r)

        if (factor === 1.0) {
            if (total_other_party_sum > 0) {
                Q[party + '_r'] = Math.round((Q[party + '_r'] * total_reichstag_without) / total_other_party_sum * 10) / 10;
            } else {
                Q[party + '_r'] = Q[party + '_r'];
            }
        } else if (factor !== 1.0 && total_reichstag_without_party > 0 && total_other_party_sum_party > 0) {
            let scaling_factor = total_reichstag_without_party / total_other_party_sum_party;
            Q[party + '_r'] = Math.round(Q[party + '_r'] * scaling_factor * 10) / 10;
        }
    }

    console.log(Q.marcher_r)

    // Step 3: Normalize to ensure the total sums to exactly 100%
    let total_r_sum = 0;

    // Calculate the total of all `r` values after redistribution
    for (var party of Q.parties) {
        total_r_sum += Q[party + '_r'];
    }

    // Adjust each party's `r` value proportionally if the total isn't 100
    if (total_r_sum !== 100) {
        let normalization_factor = 100 / total_r_sum;
        for (var party of Q.parties) {
            if (Q[party + '_r'] > 0) {
                Q[party + '_r'] = Math.round(Q[party + '_r'] * normalization_factor * 10) / 10;
            }
        }
    }
    console.log(Q.marcher_r)
}
if (Q.election_boycott) {
    Q.gnu_votes += Q.marcher_votes;
    Q.marcher_votes = 0;
    if (Q.unionist_boycott_efficacy >= 0.74) {
        Q.gnu_votes += Q.unionist_votes;
        Q.unionist_votes = 0;
    }
    if (Q.lib_boycott_efficacy >= 0.74) { 
        Q.gnu_votes += Q.ddp_votes;
        Q.ddp_votes = 0;
    }
    if (Q.lib_boycott_efficacy >= 0.89) { 
        Q.gnu_votes += Q.lvp_votes;
        Q.gold_votes = 0;
    }
    if (Q.lib_boycott_efficacy >= 0.74) { 
        Q.gnu_votes += Q.gold_votes;
        Q.lvp_votes = 0;
    }
    if (Q.traditionalist_ideology == "Radical") {
        Q.gnu_votes += Q.traditionalist_votes;
        Q.traditionalist_votes = 0;
    }
    if (Q.traditionalist_ideology == "Moderate") {
        Q.gnu_votes += Q.dnf_votes;
        Q.dnf_votes = 0;
    }
}
if (Q.gnu_formed) {
    Q.staal_gnu_r = Q.gnu_r;
    Q.staal_gnu_votes = Q.gnu_votes;
    if (Q.right_gnu) Q.staal_gnu_votes -= Q.right_gnu_votes;
    if (Q.left_gnu) Q.staal_gnu_votes -= Q.left_gnu_votes;

    if (Q.ddp_r) Q.ddp_r_last = Q.ddp_r;
    if (Q.lvp_r) Q.lvp_r_last = Q.lvp_r;
