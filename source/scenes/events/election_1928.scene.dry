@finalize_cvp_demands
title: We have come to an agreement with the <span style="color: #000000;">**[+ unionist_party_name +]**</span>.
subtitle: This is an unstable arrangement, but it will set a historic precedent.
choose-if: concord_negotiations_points >= concord_negotiations_min
unavailable-subtitle: The <span style="color: #000000;">[+ unionist_party_name +]</span> is not satisfied with our current promises.
on-arrival: {!
if (Q.concord_banner_accepted) {
    Q.banner_militancy = 0.02;
    if (Q.banner_strength > 2000) Q.banner_strength = 2000;
    Q.heartland_police_strength += 40;
}
if (Q.concord_economy_accepted && Q.budget < 0) {
    Q.austerity_budget = Q.budget*-1;
    Q.budget = 0;
    Q.commons_marcher -= Q.austerity_budget*3;
    Q.burgher_marcher -= Q.austerity_budget*2;
    Q.guild_marcher -= Q.austerity_budget;
    Q.disfavored_marcher -= Q.austerity_budget*3;
    Q.faithful_marcher -= Q.austerity_budget;
    if (Q.welfare >= 1) Q.welfare -= 2;
    Q.commons_collectivist += Q.austerity_budget*2;
    Q.commons_royalist += Q.austerity_budget;
    Q.disfavored_collectivist += Q.austerity_budget*2;
    Q.disfavored_royalist += Q.austerity_budget*2;
    Q.left_dissent += 10*Q.austerity_budget;
    Q.center_dissent += 7*Q.austerity_budget;
    Q.labor_dissent += 10*Q.austerity_budget;
    Q.reformist_dissent += 5*Q.austerity_budget;
    Q.disfavored += Q.austerity_budget;
    Q.collectivist_coalition_dissent += 1;
    Q.collectivist_relation -= 10;
}
!}
go-to: social_catholic_coalition_cvp_2 if not left_split; social_catholic_coalition_cvp_3 if left_split; social_catholic_coalition_cvp_4 if unionist_r > (marcher_r + bvp_r)
achievement: historischer_kompromiss

@social_catholic_coalition_cvp_4
