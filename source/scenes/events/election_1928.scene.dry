            {!<td style="background-color: rgba(106, 30, 30, 0.2); font-size: 0.85em;">!}[+ burgher_royalist_display +]%[? if n_elections != 1 and demo_change_burgher_royalist_display != 0 : ([+ demo_change_burgher_royalist_display +])?]{!</td>!}
