        {!</tr>!}?]
        {!<tr>!}
            {!<td>!}<span style="color: #000000;">**[+ unionist_party_name +]**</span> + <span style="color: #4B758B;">**Arcanists**</span>{!</td>!}
            {!<td style="background-color: rgba(0, 0, 0, 0.2); font-size: 0.85em; padding: 10px">!}[+ commons_unionist_display +]%[? if n_elections != 1 and demo_change_commons_unionist_display != 0 : ([+ demo_change_commons_unionist_display +])?]{!</td>!}
            {!<td style="background-color: rgba(0, 0, 0, 0.2); font-size: 0.85em;">!}[+ burgher_unionist_display +]%[? if n_elections != 1 and demo_change_burgher_unionist_display != 0 : ([+ demo_change_burgher_unionist_display +])?]{!</td>!}
            {!<td style="background-color: rgba(0, 0, 0, 0.2); font-size: 0.85em;">!}[+ guild_unionist_display +]%[? if n_elections != 1 and demo_change_guild_unionist_display != 0 : ([+ demo_change_guild_unionist_display +])?]{!</td>!}
