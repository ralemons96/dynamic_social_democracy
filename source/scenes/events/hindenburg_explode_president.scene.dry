@round_1
go-to: election_algorithm
set-jump: post_election


@post_election
on-arrival: {!
var candidate_descs = {
Seckard: "Hans Seckard, an independent formerly of the <span style='color: #C0A054; font-weight: bold;'>Golds</span>",
Eckhart: "the independent <span style='color: #000000;'>rep</span><span style='color: #DD0000;'>ubl</span><span style='color: #FFCC00;'>ican</span> candidate Hugo Eckhart",
Aldermoor: "Konrad Aldermoor of the <span style='color: #000000; font-weight: bold;'>Unionist Party</span>",
Gesling: "Gareth Gesling, independent formerly of the <span style='color: #D3C24D; font-weight: bold;'>Golds</span>",
Vesh: "Joran Vesh of the <span style='color: #c00000; font-weight: bold;'>Marchers</span>",
Grenshaw: "Albert Grenshaw of the <span style='color: #c00000; font-weight: bold;'>Marchers</span>"
}
for (var k in candidate_descs) {
    Q[k + '_running'] = 0;
}
var candidate_votes = {};
for (var i = 0; i < Q.parties.length; i++) {
    var party = Q.parties[i];
    var supported_candidate = Q[party + '_candidate'];
    //console.log(party, supported_candidate);
    supported_candidate = supported_candidate.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    Q[supported_candidate + '_running'] = 1;
    if (supported_candidate in candidate_votes) {
        candidate_votes[supported_candidate] += Q[party+'_normalized'];
    } else {
        candidate_votes[supported_candidate] = Q[party+'_normalized'];
    }
}
var total_votes = 0;
Q.winner = "";
Q.winner_votes = 0;
Q.has_majority = 0;
for (var k in candidate_votes) {
    if (Q[k + '_bonus']) {
        candidate_votes[k] += Q[k + '_bonus']/100;
    }
    total_votes += candidate_votes[k];
    if (candidate_votes[k] > Q.winner_votes) {
        Q.winner = k;
        Q.winner_votes = candidate_votes[k];
    }
    if (candidate_votes[k] >= 0.5) {
        Q.has_majority = 1;
    }
}
for (var k in candidate_votes) {
    Q[k + '_votes'] = Math.round(1000*candidate_votes[k]/total_votes)/10;
    Q[k + '_votes_disp'] = Q[k + '_votes'].toFixed(1);
}
Q.winner_votes = Math.round(1000*Q.winner_votes/total_votes)/10;
Q.winner_votes_disp = Q.winner_votes.toFixed(1);
Q.winner_desc = candidate_descs[Q.winner];

if (Q.sapd_candidate == "Boycott" || Q.collectivist_candidate == "Boycott"){
    Q.boycott_votes = 0;
    if (Q.collectivist_candidate == "Boycott") Q.boycott_votes += Q.collectivist_votes;
    if (Q.sapd_candidate == "Boycott") Q.boycott_votes += Q.sapd_votes;
}

Q.round += 1
!}
go-to: r2_start if round = 1 and not has_majority; election_end if round > 1; r1_winner if has_majority

Election results:

[? if Seckard_running : <span style="color: #808080;">**Seckard**</span> - [+ Seckard_votes_disp +]% ?]

[? if Aldermoor_running : <span style="color: #000000;">**Aldermoor**</span> - [+ Aldermoor_votes_disp +]% ?]

[? if Gesling_running : [? if not lvp_formed: <span style="color: #D3C24D;">**Gesling**</span>?][? if lvp_formed: <span style="color: #FFCC00;">**Gesling**</span>?] - [+ Gesling_votes_disp +]% ?]

[? if Eckhart_running : <span style="color: #000000;">**Eck**</span><span style="color: #DD0000;">**ha**</span><span style="color: #FFCC00;">**rt**</span> - [+ Eckhart_votes_disp +]% ?]

[? if Grenshaw_running : <span style="color: #c00000;">**Grenshaw**</span> - [+ Grenshaw_votes_disp +]% ?]
[? if Vesh_running : <span style="color: #c00000;">**Vesh**</span> - [+ Vesh_votes_disp +]% ?]

[? if sapd_candidate == "Boycott" or collectivist_candidate == "Boycott" : Spoiled Ballots - [+ boycott_votes +]% ?]

@r2_start
on-arrival: {!
Q.adenauer_drops_out = 0;
Q.gessler_drops_out = 0;
if (Q.unionist_candidate == "Aldermoor" && (Q.ddp_candidate == "Gesling" && !Q.lvp_formed || Q.gold_candidate == "Gesling" && !Q.lvp_formed && Q.gold_exist || Q.lvp_candidate == "Gesling" && Q.lvp_formed) && Q.unionist_candidate != Q.marcher_candidate && (Q.ddp_candidate != Q.marcher_candidate && !Q.lvp_formed || Q.gold_candidate != Q.marcher_candidate && !Q.lvp_formed && Q.gold_exist || Q.lvp_candidate != Q.marcher_candidate && Q.lvp_exist)) {
    if (Q.Aldermoor_votes > Q.Gesling_votes) {
        Q.gessler_drops_out = 1;
        if (Q.ddp_candidate != Q.marcher_candidate) {
            Q.ddp_candidate = "Aldermoor";
        }
        if (Q.gold_candidate != Q.marcher_candidate) {
            Q.gold_candidate = "Aldermoor";
        }
        if (Q.lvp_candidate != Q.marcher_candidate) {
            Q.lvp_candidate = "Aldermoor";
        }
    } else {
        Q.adenauer_drops_out = 1;
        Q.unionist_candidate = "Gesling";
    }
}
// Golds drops out to favor the center candidate
if (Q.gold_candidate != Q.marcher_candidate && Q.gold_candidate != Q.ddp_candidate && Q.gold_candidate != Q.unionist_candidate) {
}
!}
go-to: r2_menu

In the lead is [+ winner_desc +]. There is no majority in the first round. In the second round, any candidate who wins a plurality will win overall.

[? if gessler_drops_out : The <span style="color: #FFCC00;">liberal</span> candidate Gareth Gesling has dropped out in favor of the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?]'s Konrad Aldermoor. This consolidates the votes of the moderate propertied bloc. ?]
[? if adenauer_drops_out : The [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] candidate Konrad Aldermoor has dropped out in favor of Gareth Gesling. This consolidates the votes of the moderate propertied bloc. ?]

What should we do?

@r2_menu

- @r2_endorse_adenauer
- @r2_endorse_gessler
- @r2_endorse_eckener
- @r2_campaigning: Can we convince any of the parties to change their endorsements?
- @r2_vote: Let the voting begin.

@r2_endorse_adenauer
title: Switch our support to Konrad Aldermoor of the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?].
view-if: unionist_candidate = "Aldermoor" and marcher_candidate != unionist_candidate
on-departure: collectivist_candidate = "Boycott" if collectivist_candidate == marcher_candidate; sapd_candidate = collectivist_candidate; marcher_candidate = "Aldermoor"; unionist_relation += 4; Seckard_bonus += 2.5 if not impeachment_bvp; is_unity_candidate = 1
go-to: r2_campaigning

We have endorsed Konrad Aldermoor of the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?].

[? if not impeachment_bvp: With our support of Aldermoor, some of the most conservative parts of the <span style="color: #A2D8E0;">the Arcanists</span> have broken away from the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?], shifting their support to Seckard. ?]

[? if collectivist_candidate = marcher_candidate: The <span style="color: #700000;">**Collectivists**</span> is now breaking from our previous coalition and supporting no one.  ?]

@r2_endorse_gessler
title: Switch our support to Gareth Gesling.
view-if: ddp_candidate = "Gesling" and marcher_candidate != ddp_candidate
on-departure: collectivist_candidate = "Boycott" if collectivist_candidate == marcher_candidate; sapd_candidate = collectivist_candidate; marcher_candidate = "Gesling"; ddp_relation += 4; gold_candidate = "Seckard" if not impeachment_gold; is_unity_candidate = 1
go-to: r2_campaigning

We have endorsed Gareth Gesling, independent formerly of the <span style="color: #D3C24D;">**Golds**</span>.

[? if not impeachment_gold and gold_exist and not lvp_formed : With our support of Gesling, the <span style="color: #C0A054;">**Golds**</span> components supporting him have broken away and are now shifting their support to Seckard. ?]

[? if collectivist_candidate = marcher_candidate: The <span style="color: #700000;">**Collectivists**</span> is now breaking from our previous coalition and supporting no one. ?]

@r2_endorse_eckener
title: Convince the Unity Coalition parties to unite behind Hugo Eckhart.
subtitle: -2 resources
unavailable-subtitle: [? if resources < 2 : -2 resources - Not enough resources. ?][? if (unionist_relation < 55 and unionist_ideology == "Right") or (unionist_relation < 35 and unionist_ideology == "Left") : We need higher relations with the <span style="color: #000000;">Unionist Party</span>. ?][? if ddp_relation < 35 and not lvp_formed : We need higher relations with the <span style="color: #D3C24D;">[+ ddp_name +]</span>. ?][? if lvp_relation < 45 and lvp_formed : We need higher relations with the <span style="color: #C0A054;">Golds</span>. ?]
choose-if: resources >= 2 and ((unionist_relation >= 55 and unionist_ideology == "Right") or (unionist_relation >= 45 and unionist_ideology = "Left")) and ((ddp_relation >= 35 and not lvp_formed) or lvp_relation >= 45 and lvp_formed)
view-if: unionist_candidate = "Aldermoor" and ((ddp_candidate = "Gesling" and not lvp_formed) or (lvp_candidate = "Gesling" and lvp_formed)) and marcher_candidate != "Eckhart"
on-departure: collectivist_candidate = "Boycott" if collectivist_candidate == marcher_candidate; sapd_candidate = collectivist_candidate; marcher_candidate = "Eckhart"; unionist_candidate = "Eckhart"; ddp_candidate = "Eckhart"; lvp_candidate = "Eckhart"; resources -= 2; is_unity_candidate = 1
go-to: r2_campaigning

We have successfully united all of the parties of the Unity Coalition behind Hugo Eckhart!

[? if collectivist_candidate = marcher_candidate: The <span style="color: #700000;">**Collectivists**</span> is now breaking from our previous coalition and supporting no one. ?]

@r2_campaigning
view-if: round = 1

