@results_overall
title: Overall Results
view-if: bavaria_seen and wurttemberg_seen
on-arrival: {!
if (Q.liberal_wurttemberg_defeat) {
    Q.burgher_ddp *= 0.6;
    Q.guild_ddp *= 0.6;
    Q.landed_ddp *= 0.6;
    Q.lvp_right += 5;
    Q.ddp_right += 3;
    Q.gold_right += 5;
    Q.pro_republic -= Q.ddp_votes + Q.gold_votes + Q.lvp_votes;
}

if (Q.royalist_local_elections_vote >= 20) {
    Q.burgher_royalist += 3;
    Q.guild_royalist += 3;
    Q.landed_royalist += 3;
    Q.pro_republic -= 3;
    Q.dufour_angry_bruning += 30;
    Q.unionist_relation -= 5;
}
if (Q.royalist_bavaria_elections_vote >= 25) {
    Q.landed_royalist += 3;
}
if (Q.royalist_wurttemberg_elections_vote >= 15) {
    Q.faithful_royalist += 3;
}
if (Q.royalist_local_elections_vote >= 34) {
    Q.commons_royalist += 3;
    Q.disfavored_royalist += 3;
    Q.dufour_angry_bruning += 50;
    Q.pro_republic -= 3;
    Q.unionist_relation -= 3;
}

if (Q.marcher_local_elections_vote >= 30) {
    if (Q.pro_republic < 50) Q.pro_republic += 8;
    Q.pro_republic += 3;
    Q.unionist_relation += 5;
    Q.ddp_relation += 5;
    Q.gold_relation += 3;
    Q.lvp_relation += 5;
    Q.ddp_left += 3;
    Q.ddp_cohesion += 1;
    Q.gold_left += 1.5;
    Q.lvp_left += 3;
    Q.burgher_marcher += 2;
    Q.commons_marcher += 2;
    Q.dufour_angry += 30;
}

if (Q.collectivist_local_elections_vote + Q.sapd_local_elections_vote >= 16) {
    Q.collectivist_relation += 20;
    Q.communist_coalition += 1;
    Q.commons_collectivist += 3;
    Q.disfavored_collectivist += 3;
    Q.commons_sapd += 3;
    Q.disfavored_sapd += 3;
    Q.pro_republic -= 3;
    Q.sa_strength += 100;
    Q.sh_strength += 50;
    Q.coup_progress += 3;
    Q.unionist_relation -= 3;
    Q.ddp_relation -= 3;
    Q.gold_relation -= 3;
    Q.lvp_relation -= 3;
    Q.ddp_right += 2;
    Q.gold_right += 2;
    Q.lvp_right += 2;
    Q.dufour_angry += 30;
    Q.dufour_angry_bruning += 50;
}

if (Q.unionist_local_elections_vote + Q.ddp_local_elections_vote + Q.gold_local_elections_vote + Q.lvp_local_elections_vote + Q.other_local_elections_vote + Q.kvp_local_elections_vote >= 40 && Q.traditionalist_ideology == "Radical" && !Q.concord_formed) {
    Q.pro_republic += 3;
    Q.dufour_angry_bruning -= 50;
    Q.burgher_ddp *= 1.2;
    Q.guild_ddp *= 1.2;
    Q.burgher_gold *= 1.2;
    Q.guild_gold *= 1.2;
    Q.burgher_lvp *= 1.1;
    Q.guild_lvp *= 1.1;
    Q.burgher_other += 2;
    Q.guild_other += 2;
    Q.landed_other += 3;
    Q.unionist_relation -= 5;
    Q.ddp_relation -= 5;
    Q.gold_relation -= 5;
    Q.lvp_relation -= 5;
    Q.ddp_right += 2;
    Q.gold_right += 4;
    Q.lvp_right += 3;
    Q.bourgeois_local_win = 1;
} else if (Q.unionist_local_elections_vote + Q.ddp_local_elections_vote + Q.gold_local_elections_vote + Q.lvp_local_elections_vote + Q.other_local_elections_vote + Q.traditionalist_local_elections_vote >= 40 && Q.traditionalist_ideology == "Moderate" && !Q.concord_formed) {
    Q.pro_republic += 5;
    Q.dufour_angry_bruning -= 50;
    Q.burgher_ddp *= 1.2;
    Q.guild_ddp *= 1.2;
    Q.burgher_gold *= 1.2;
    Q.guild_gold *= 1.2;
    Q.burgher_lvp *= 1.1;
    Q.guild_lvp *= 1.1;
    Q.burgher_traditionalist += 2;
    Q.guild_traditionalist += 2;
    Q.landed_traditionalist += 3;
    Q.unionist_relation -= 5;
    Q.ddp_relation -= 5;
    Q.gold_relation -= 5;
    Q.lvp_relation -= 5;
    Q.ddp_right += 2;
    Q.gold_right += 4;
    Q.lvp_right += 3;
    Q.bourgeois_local_win = 1;
} else if (Q.unionist_local_elections_vote + Q.ddp_local_elections_vote + Q.gold_local_elections_vote + Q.lvp_local_elections_vote + Q.other_local_elections_vote + Q.kvp_local_elections_vote >= 40 && Q.concord_formed) {
    Q.pro_republic += 5;
    Q.dufour_angry_bruning -= 50;
    Q.burgher_ddp *= 1.2;
    Q.guild_ddp *= 1.2;
    Q.burgher_gold *= 1.2;
    Q.guild_gold *= 1.2;
    Q.burgher_lvp *= 1.1;
    Q.guild_lvp *= 1.1;
    Q.burgher_unionist += 6;
    Q.guild_unionist += 6;
    Q.landed_unionist += 4;
    Q.unionist_relation -= 5;
    Q.ddp_relation -= 5;
    Q.gold_relation -= 5;
    Q.lvp_relation -= 5;
    Q.ddp_right += 2;
    Q.gold_right += 4;
    Q.lvp_right += 3;
    Q.bourgeois_local_concord_win = 1;
}

!}

**Overall results:**

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td></tr>!}
{!<tr><td><div class="box" style='background-color:#E3000F; outline: 2px; outline-style: solid;'> </div> !} **Marchers:** {!</td><td>!} **[+ marcher_local_elections_vote +]%** {!</td></tr>!}

[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#9B0000'> </div> !}SAPD: {!</td><td>!} [+ sapd_local_elections_vote +]% {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#700000'> </div> !}Collectivists: {!</td><td>!} [+ collectivist_local_elections_vote +]% {!</td></tr>!}

[? if not lvp_formed: {!<tr><td><div class="box" style='background-color:#D3C24D'> </div> !} [+ ddp_name +]: {!</td><td>!} [+ ddp_local_elections_vote +]% {!</td></tr>!} ?]

[? if lvp_formed: {!<tr><td><div class="box" style='background-color:#FFCC00'> </div> !} LVP: {!</td><td>!} [+ lvp_local_elections_vote +]% {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#000'> </div> !} [+ unionist_party_name +] + Arcanists: {!</td><td>!} [+ unionist_local_elections_vote +]% {!</td></tr>!}

[? if not lvp_formed and gold_exist: {!<tr><td><div class="box" style='background-color:#D5AC27'> </div> !} Golds: {!</td><td>!} [+ gold_local_elections_vote +]% {!</td></tr>!} ?]
 
{!<tr><td><div class="box" style='background-color:#a0a0a0'> </div> !} Others: {!</td><td>!} [+ other_local_elections_vote +]% {!</td></tr>!}

[? if kvp_formed : {!<tr><td><div class="box" style='background-color:#0087DC'> </div> !}KVP: {!</td><td>!} [+ kvp_local_elections_vote +]% {!</td></tr>!} ?]

[? if not concord_formed: {!<tr><td><div class="box" style='background-color:#3E88B3'> </div> !} Traditionalists: {!</td><td>!} [+ traditionalist_local_elections_vote +]% {!</td></tr>!}?]

[? if dnf_formed : {!<tr><td><div class="box" style='background-color:#003755'> </div> !}DNF: {!</td><td>!} [+ dnf_local_elections_vote +]% {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#7A3C00'> </div> !} Royalists: {!</td><td>!} [+ royalist_local_elections_vote +]% {!</td></tr>!}
{!</table>!}

[? if royalist_local_elections_vote >= 20: The strong performance of the <span style="color: #7A3C00;">**Royalists**</span> leaves little room for a democratic coalition in many Landtags, and may force the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] to negotiate with them as a last resort. ?]

[? if marcher_local_elections_vote >= 30: We have maintained a strong performance, maintaining many of our seats we've won in 1928. Hopefully our coalition partners have won enough votes as well, to continue our stable and democratic coalitions. ?]

[? if collectivist_local_elections_vote + sapd_local_elections_vote >= 16: The gains made by the <span style="color: #700000;">**Collectivists**</span> have left our grassroots clamoring for a United Left coalition, as our local-level relations are far more cooperative than those between our national leaderships. ?]

[? if bourgeois_local_win: The bourgeois parties have performed unexpectedly well in these elections, despite expectations that the economic crisis would push voters toward the <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span>. This is expected to revitalize the bourgeois parties on the national stage. ?]

[? if bourgeois_local_concord_win: The bourgeois parties, especially the <span style="color: #000000;">**[+ unionist_party_name +]**</span>, have performed unexpectedly well in these elections, defying expectations that the economic crisis would drive voters toward the <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span>. As one of their first electoral tests, the <span style="color: #000000;">**[+ unionist_party_name +]**</span> has enjoyed clear success so far. ?]

[? if bruning_time and royalist_local_elections_vote >= 20 and president == "DuFour": These results are likely the final nail in the coffin for Askew's government, as President DuFour loses confidence in him. It is likely that someone even more right-wing than Askew will replace him, given the nation's continued political shift to the right. ?]

@bavaria
title: <span style="color: #00CCFF;">Avriza</span>'s state Assembly Election
subtitle: Perhaps the <span style="color: #A2D8E0;">**Arcanists**</span> will finally be unseated?
view-if: not bavaria_seen
on-arrival: {!

Q.bavaria_seen = 1;

var bavaria_adjustment_factors = {
    spd: 0.75,
    sapd: 0.0,
    kpd: 0.4,
    ddp: 0.0,
    lvp: 0.4,
    z: 2.2,
    dvp: 0.4,
    dnvp: 0.4,
    nsdap: 1.0,
    other: 1.3,
    kvp: 0.3,
    dnf: 0.2
};

if (!Q.gold_exist) {
    bavaria_adjustment_factors.dnvp += 0.4;
}

if (Q.gold_in_concord) {
    bavaria_adjustment_factors.z += 0.4;
}

Q.marcher_r_bavaria = 0;
Q.sapd_r_bavaria = 0;
Q.collectivist_r_bavaria = 0;
Q.ddp_r_bavaria = 0;
Q.lvp_r_bavaria = 0;
Q.unionist_r_bavaria = 0;
Q.gold_r_bavaria = 0;
Q.traditionalist_r_bavaria = 0;
Q.royalist_r_bavaria = 0;
Q.other_r_bavaria = 0;
Q.kvp_r_bavaria = 0;
Q.dnf_r_bavaria = 0;

Q.marcher_bavaria_elections_vote = 0;
Q.sapd_bavaria_elections_vote = 0;
Q.collectivist_bavaria_elections_vote = 0;
Q.ddp_bavaria_elections_vote = 0;
Q.lvp_bavaria_elections_vote = 0;
Q.unionist_bavaria_elections_vote = 0;
Q.gold_bavaria_elections_vote = 0;
Q.traditionalist_bavaria_elections_vote = 0;
Q.royalist_bavaria_elections_vote = 0;
Q.other_bavaria_elections_vote = 0;
Q.kvp_bavaria_elections_vote = 0;
Q.dnf_bavaria_elections_vote = 0;

if (Q.faithful_marcher_normalized >= 30) bavaria_adjustment_factors.spd += 0.2;
if (Q.landed_marcher_normalized >= 30) bavaria_adjustment_factors.spd += 0.2;
Q.marcher_bavaria_elections_vote = Q.marcher_local_elections_vote*bavaria_adjustment_factors.spd;
Q.sapd_bavaria_elections_vote = Q.sapd_local_elections_vote*bavaria_adjustment_factors.sapd;
Q.collectivist_bavaria_elections_vote = Q.collectivist_local_elections_vote*bavaria_adjustment_factors.kpd;
if (Q.ddp_votes >= 3) bavaria_adjustment_factors.ddp = 0.4;
Q.ddp_bavaria_elections_vote = Q.ddp_local_elections_vote*bavaria_adjustment_factors.ddp;
Q.lvp_bavaria_elections_vote = Q.lvp_local_elections_vote*bavaria_adjustment_factors.lvp;
if (!Q.stegerwald_path) Q.unionist_bavaria_elections_vote = Q.unionist_local_elections_vote*bavaria_adjustment_factors.z;
if (Q.stegerwald_path) Q.unionist_bavaria_elections_vote = Q.unionist_local_elections_vote * 1.5;
if (Q.concord_formed) Q.unionist_bavaria_elections_vote = Q.unionist_local_elections_vote * 1.2;
Q.gold_bavaria_elections_vote = Q.gold_local_elections_vote*bavaria_adjustment_factors.dvp;
Q.traditionalist_bavaria_elections_vote = Q.traditionalist_local_elections_vote*bavaria_adjustment_factors.dnvp;
Q.royalist_bavaria_elections_vote = Q.royalist_local_elections_vote*bavaria_adjustment_factors.nsdap;
Q.other_bavaria_elections_vote = Q.other_local_elections_vote*bavaria_adjustment_factors.other;
Q.kvp_bavaria_elections_vote = Q.kvp_local_elections_vote*bavaria_adjustment_factors.kvp;
if (Q.concord_formed) bavaria_adjustment_factors.dnf += 0.6;
Q.dnf_bavaria_elections_vote = Q.dnf_local_elections_vote*bavaria_adjustment_factors.dnf;

Q.total_votes_bavaria = Q.marcher_bavaria_elections_vote + Q.sapd_bavaria_elections_vote + Q.collectivist_bavaria_elections_vote + Q.ddp_bavaria_elections_vote + Q.lvp_bavaria_elections_vote + Q.unionist_bavaria_elections_vote + Q.gold_bavaria_elections_vote + Q.traditionalist_bavaria_elections_vote + Q.royalist_bavaria_elections_vote + Q.other_bavaria_elections_vote + Q.kvp_bavaria_elections_vote + Q.dnf_bavaria_elections_vote;

if (Q.total_votes_bavaria > 0) {
    Q.marcher_bavaria_elections_vote = (Q.marcher_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.sapd_bavaria_elections_vote = (Q.sapd_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.collectivist_bavaria_elections_vote = (Q.collectivist_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.ddp_bavaria_elections_vote = (Q.ddp_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.lvp_bavaria_elections_vote = (Q.lvp_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.unionist_bavaria_elections_vote = (Q.unionist_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.gold_bavaria_elections_vote = (Q.gold_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.traditionalist_bavaria_elections_vote = (Q.traditionalist_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.royalist_bavaria_elections_vote = (Q.royalist_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.other_bavaria_elections_vote = (Q.other_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.kvp_bavaria_elections_vote = (Q.kvp_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
    Q.dnf_bavaria_elections_vote = (Q.dnf_bavaria_elections_vote / Q.total_votes_bavaria) * 100;
}

Q.marcher_bavaria_elections_vote = (Q.marcher_bavaria_elections_vote != undefined ? parseFloat(Q.marcher_bavaria_elections_vote.toFixed(1)) : 0);
Q.sapd_bavaria_elections_vote = (Q.sapd_bavaria_elections_vote != undefined ? parseFloat(Q.sapd_bavaria_elections_vote.toFixed(1)) : 0);
Q.collectivist_bavaria_elections_vote = (Q.collectivist_bavaria_elections_vote != undefined ? parseFloat(Q.collectivist_bavaria_elections_vote.toFixed(1)) : 0);
Q.ddp_bavaria_elections_vote = (Q.ddp_bavaria_elections_vote != undefined ? parseFloat(Q.ddp_bavaria_elections_vote.toFixed(1)) : 0);
Q.lvp_bavaria_elections_vote = (Q.lvp_bavaria_elections_vote != undefined ? parseFloat(Q.lvp_bavaria_elections_vote.toFixed(1)) : 0);
Q.unionist_bavaria_elections_vote = (Q.unionist_bavaria_elections_vote != undefined ? parseFloat(Q.unionist_bavaria_elections_vote.toFixed(1)) : 0);
Q.gold_bavaria_elections_vote = (Q.gold_bavaria_elections_vote != undefined ? parseFloat(Q.gold_bavaria_elections_vote.toFixed(1)) : 0);
Q.traditionalist_bavaria_elections_vote = (Q.traditionalist_bavaria_elections_vote != undefined ? parseFloat(Q.traditionalist_bavaria_elections_vote.toFixed(1)) : 0);
Q.royalist_bavaria_elections_vote = (Q.royalist_bavaria_elections_vote != undefined ? parseFloat(Q.royalist_bavaria_elections_vote.toFixed(1)) : 0);
Q.other_bavaria_elections_vote = (Q.other_bavaria_elections_vote != undefined ? parseFloat(Q.other_bavaria_elections_vote.toFixed(1)) : 0);
Q.kvp_bavaria_elections_vote = (Q.kvp_bavaria_elections_vote != undefined ? parseFloat(Q.kvp_bavaria_elections_vote.toFixed(1)) : 0);
Q.dnf_bavaria_elections_vote = (Q.dnf_bavaria_elections_vote != undefined ? parseFloat(Q.dnf_bavaria_elections_vote.toFixed(1)) : 0);

if (Q.marcher_bavaria_elections_vote >= 3.3) Q.marcher_r_bavaria = Q.marcher_bavaria_elections_vote;
if (Q.sapd_bavaria_elections_vote >= 3.3) Q.sapd_r_bavaria = Q.sapd_bavaria_elections_vote;
if (Q.collectivist_bavaria_elections_vote >= 3.3) Q.collectivist_r_bavaria = Q.collectivist_bavaria_elections_vote;
if (Q.ddp_bavaria_elections_vote >= 3.3) Q.ddp_r_bavaria = Q.ddp_bavaria_elections_vote;
if (Q.lvp_bavaria_elections_vote >= 3.3) Q.lvp_r_bavaria = Q.lvp_bavaria_elections_vote;
if (Q.unionist_bavaria_elections_vote >= 3.3) Q.unionist_r_bavaria = Q.unionist_bavaria_elections_vote;
if (Q.gold_bavaria_elections_vote >= 3.3) Q.gold_r_bavaria = Q.gold_bavaria_elections_vote;
if (Q.traditionalist_bavaria_elections_vote >= 3.3) Q.traditionalist_r_bavaria = Q.traditionalist_bavaria_elections_vote;
if (Q.royalist_bavaria_elections_vote >= 3.3) Q.royalist_r_bavaria = Q.royalist_bavaria_elections_vote;
if (Q.other_bavaria_elections_vote >= 3.3) Q.other_r_bavaria = Q.other_bavaria_elections_vote;
if (Q.kvp_bavaria_elections_vote >= 3.3) Q.kvp_r_bavaria = Q.kvp_bavaria_elections_vote;
if (Q.dnf_bavaria_elections_vote >= 3.3) Q.dnf_r_bavaria = Q.dnf_bavaria_elections_vote;

Q.total_r_bavaria = 0;

if (Q.marcher_r_bavaria) Q.total_r_bavaria += Q.marcher_r_bavaria;
if (Q.sapd_r_bavaria) Q.total_r_bavaria += Q.sapd_r_bavaria;
if (Q.collectivist_r_bavaria) Q.total_r_bavaria += Q.collectivist_r_bavaria;
if (Q.ddp_r_bavaria) Q.total_r_bavaria += Q.ddp_r_bavaria;
if (Q.lvp_r_bavaria) Q.total_r_bavaria += Q.lvp_r_bavaria;
if (Q.unionist_r_bavaria) Q.total_r_bavaria += Q.unionist_r_bavaria;
if (Q.gold_r_bavaria) Q.total_r_bavaria += Q.gold_r_bavaria;
if (Q.traditionalist_r_bavaria) Q.total_r_bavaria += Q.traditionalist_r_bavaria;
if (Q.royalist_r_bavaria) Q.total_r_bavaria += Q.royalist_r_bavaria;
if (Q.other_r_bavaria) Q.total_r_bavaria += Q.other_r_bavaria;
if (Q.kvp_r_bavaria) Q.total_r_bavaria += Q.kvp_r_bavaria;
if (Q.dnf_r_bavaria) Q.total_r_bavaria += Q.dnf_r_bavaria;

if (Q.total_r_bavaria > 0) {
    Q.marcher_r_bavaria = (Q.marcher_r_bavaria / Q.total_r_bavaria) * 100;
    Q.sapd_r_bavaria = (Q.sapd_r_bavaria / Q.total_r_bavaria) * 100;
    Q.collectivist_r_bavaria = (Q.collectivist_r_bavaria / Q.total_r_bavaria) * 100;
    Q.ddp_r_bavaria = (Q.ddp_r_bavaria / Q.total_r_bavaria) * 100;
    Q.lvp_r_bavaria = (Q.lvp_r_bavaria / Q.total_r_bavaria) * 100;
    Q.unionist_r_bavaria = (Q.unionist_r_bavaria / Q.total_r_bavaria) * 100;
    Q.gold_r_bavaria = (Q.gold_r_bavaria / Q.total_r_bavaria) * 100;
    Q.traditionalist_r_bavaria = (Q.traditionalist_r_bavaria / Q.total_r_bavaria) * 100;
    Q.royalist_r_bavaria = (Q.royalist_r_bavaria / Q.total_r_bavaria) * 100;
    Q.other_r_bavaria = (Q.other_r_bavaria / Q.total_r_bavaria) * 100;
    Q.kvp_r_bavaria = (Q.kvp_r_bavaria / Q.total_r_bavaria) * 100;
    Q.dnf_r_bavaria = (Q.dnf_r_bavaria / Q.total_r_bavaria) * 100;
}

Q.farm_bavaria_elections_vote = Q.other_bavaria_elections_vote*0.8
Q.farm_r_bavaria = Q.other_r_bavaria*0.8

Q.non_farm_bavaria_elections_vote = Q.other_bavaria_elections_vote*0.2
Q.non_farm_r_bavaria = Q.other_r_bavaria*0.2

function allocateSeats(percentages, totalSeats = 128) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_bavaria: Q.marcher_r_bavaria,
    sapd_r_bavaria: Q.sapd_r_bavaria,
    kpd_r_bavaria: Q.collectivist_r_bavaria,
    ddp_r_bavaria: Q.ddp_r_bavaria,
    lvp_r_bavaria: Q.lvp_r_bavaria,
    z_r_bavaria: Q.unionist_r_bavaria,
    dvp_r_bavaria: Q.gold_r_bavaria,
    dnvp_r_bavaria: Q.traditionalist_r_bavaria,
    nsdap_r_bavaria: Q.royalist_r_bavaria,
    non_farm_r_bavaria: Q.non_farm_r_bavaria,
    farm_r_bavaria: Q.farm_r_bavaria,
    kvp_r_bavaria: Q.kvp_r_bavaria,
    dnf_r_bavaria: Q.dnf_r_bavaria
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 128).toFixed(1));
}

Q.other_r_bavaria = Q.farm_r_bavaria + Q.non_farm_r_bavaria;

Q.left_coalition_bavaria = parseFloat((Q.marcher_r_bavaria + Q.collectivist_r_bavaria + Q.sapd_r_bavaria).toFixed(1));
Q.bourgeois_coalition_bavaria = parseFloat((Q.unionist_r_bavaria + Q.gold_r_bavaria + Q.ddp_r_bavaria + Q.lvp_r_bavaria + Q.other_r_bavaria + Q.traditionalist_r_bavaria).toFixed(1));
if (Q.traditionalist_ideology == "Radical" && Q.kvp_formed) Q.bourgeois_coalition_bavaria = parseFloat((Q.unionist_r_bavaria + Q.gold_r_bavaria + Q.ddp_r_bavaria + Q.lvp_r_bavaria + Q.kvp_r_bavaria + Q.other_r_bavaria).toFixed(1));
Q.marcher_coalition_bavaria = parseFloat((Q.marcher_r_bavaria + (Q.other_r_bavaria * 0.8) + Q.ddp_r_bavaria + Q.lvp_r_bavaria).toFixed(1));

Q.farm_bavaria_elections_vote = (Q.farm_bavaria_elections_vote != undefined ? parseFloat(Q.farm_bavaria_elections_vote.toFixed(1)) : 0);
Q.non_farm_bavaria_elections_vote = (Q.non_farm_bavaria_elections_vote != undefined ? parseFloat(Q.non_farm_bavaria_elections_vote.toFixed(1)) : 0);

!}
on-display: {!
data = [{
    "id": "kpd",
    "legend": "Collectivist",
    "name": "Collectivist",
    "seats": Math.round(Q.collectivist_r_bavaria * 1.28),
}];

if (Q.sapd_formed && Q.sapd_r_bavaria) {
    data.push({
        "id": "sapd",
        "legend": "SAPD",
        "name": "SAPD",
        "seats": Math.round(Q.sapd_r_bavaria * 1.28),
    });
}

data = data.concat([{
    "id": "spd",
    "legend": "Marcher",
    "name": "Marcher",
    "seats": Math.round(Q.marcher_r_bavaria * 1.28),
}]);

if (Q.ddp_r_bavaria && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r_bavaria * 1.28),
    });
}

if (Q.lvp_r_bavaria && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r_bavaria * 1.28),
    });
}

data = data.concat([{
        "id": "bvp",
        "legend": "Arcanists",
        "name": "Arcanists",
        "seats": Math.round((Q.unionist_r_bavaria) * 1.28),
}
]);

if (Q.gold_r_bavaria && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "dvp",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r_bavaria * 1.28),
    });
}

if (Q.other_r_bavaria) {
    let total = Q.farm_r_bavaria + Q.non_farm_r_bavaria; 
    if (total > 0) {
        let farmShare = (Q.farm_r_bavaria / total) * 1.28;
        let otherShare = (Q.non_farm_r_bavaria / total) * 1.28;
        data.push({
            "id": "other",
            "legend": "Other",
            "name": "Other",
            "seats": Math.round(Q.other_r_bavaria * otherShare),
        });
        data.push({
            "id": "farm",
            "legend": "Farm",
            "name": "Farm",
            "seats": Math.round(Q.other_r_bavaria * farmShare),
        });
    }
}
if (Q.kvp_formed && Q.kvp_r_bavaria) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round(Q.kvp_r_bavaria * 1.28),
    });
}
if (Q.traditionalist_r_bavaria) {
    data.push({
        "id": "dnvp",
        "legend": "Traditionalist",
        "name": "Traditionalist",
        "seats": Math.round(Q.traditionalist_r_bavaria * 1.28),
    });
}
if (Q.dnf_formed && Q.dnf_r_bavaria) {
    data.push({
        "id": "dnf",
        "legend": "DNF",
        "name": "DNF",
        "seats": Math.round(Q.dnf_r_bavaria * 1.28),
    });
}
data = data.concat([{
    "id": "nsdap",
    "legend": "Royalist",
    "name": "Royalist",
    "seats": Math.round(Q.royalist_r_bavaria * 1.28),
}, ]);

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("bavaria_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#bavaria_landtag").datum(data).call(parliament);
}
!}
go-to: bavaria_coalition_menu


