}

if (Q.lambach_points < 3 && Q.pro_republic < ((Q.royalist_votes + Q.dnf_votes + Q.collectivist_votes)*2)) {
    Q.westarp_trigger = 1;
}

if (Q.lambach_points < 3 && !Q.westarp_trigger && !Q.schiele_trigger) {
