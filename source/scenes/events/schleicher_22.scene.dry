title: The <span style="color: #6A1E1E;">**DSU**</span> Breaks with Staal!
subtitle: Crowde realizes he has fallen into Staal’s trap.
view-if: chancellor = "Staal" and dsu_policy >= 4 and gnu_formed and collectivist_explode and gnu_total_votes >= 30
new-page: true
priority: 1
tags: event
max-visits: 1
face-image: img/portraits/strasser.jpg

= <span style="color: #6A1E1E;">**DSU**</span> Breaks with Staal

Despite their pragmatism, the <span style="color: #6A1E1E;">**DSU**</span> are still <span style="color: #7A3C00;">Royalists</span> at heart, clinging fully to their wicked ideology. Fortunately, despite entering government, they’ve found no path to revive their own party, nor a chance to strike at the <span style="color: #005EB8;">Jews</span> they claim hoard the nation’s wealth, or the capitalist system they rail against.

Now, a bitter realization dawns on Crowde and his top <span style="color: #7A3C00;">Royalist</span> lieutenants: they’ve been used. Staal has no intention of letting them control anything beyond the Interior Ministry. Worse, their party has been bleeding support in local elections, punished for failing to deliver on its grand promises.

After all, it’s Staal the people thank for their jobs—not the <span style="color: #6A1E1E;">**DSU**</span>, whose fights with the <span style="color: #700000;">revolutionaries</span> do little to put food on the table for their electoral base. The formation of the <span style="color: #BFC8CC;">**GNU**</span> has only deepened the wound, as many of their former voters flock to this new pole of order and stability.

- @schleicher_2: Out of funds, out of followers, out of luck.

@schleicher_2
on-arrival: {!
Q.dsu_explode = 1;

Q.dsu_leader = "Otto Crowde";
Q.dsu_in_gov = 0;
Q.dsu_was_gov = 1;

Q.commons_royalist -= 6;
Q.burgher_royalist -= 6;
Q.guild_royalist -= 2;
Q.landed_royalist -= 2;
Q.faithful_royalist -= 2;
Q.disfavored_royalist -= 6;

Q.commons_gnu += 6;
Q.burgher_gnu += 6;
Q.guild_gnu += 2;
Q.landed_gnu += 2;
Q.faithful_gnu += 2;
Q.disfavored_gnu += 6;

Q.gnu_relation -= 10;

if (Q.vice_chancellor == "Crowde" && Q.unionist_in_gov) Q.vice_chancellor = "Sedgewick";
if (Q.vice_chancellor == "Crowde" && !Q.unionist_in_gov) Q.vice_chancellor = 0;
if (Q.heartland_leader == "Crowde") Q.heartland_leader = "Goodlake";

Q.gnu_r += parseFloat((Q.dsu_r * 0.6).toFixed(1));
Q.dsu_r = parseFloat((Q.dsu_r * 0.4).toFixed(1));

Q.gnu_r = parseFloat(Q.gnu_r.toFixed(1));
!}
on-display: {!  
    var cardEl = document.createElement('div');  
    cardEl.className = "face-figure2";  

    var image = new Image();  
    image.className = "face-img";  
    image.src = "img/otto_strasser.jpg";  

    cardEl.appendChild(image);  
    var contentDiv = document.querySelector("#page #mid_panel #content");
    contentDiv.appendChild(cardEl);
!}
go-to: new_reichstag

The various <span style="color: #7A3C00;">Royalist</span> splinter parties that have emerged are now beginning to collapse entirely. Burdening such a dynamic, revolutionary movement with the compromises of government—and failing to deliver real solutions to their base’s hardships—has sapped their morale and dried up donations.

Overcome with resignation, Crowde announces his withdrawal from political life, intending to return to his old profession as a local pharmacist. Many other top <span style="color: #7A3C00;">Royalist</span> figures follow suit, as [+ royalist_leader +] remains too paranoid and vengeful to allow any splitters back into the <span style="color: #7A3C00;">**Royalists**</span>.

The <span style="color: #6A1E1E;">**DSU**</span> has since fallen under the control of a radical clique of self-styled "<span style="color: #7A3C00;">national</span> <span style="color: #700000;">bolsheviks</span>" surrounding Gregor Crowde’s more extreme brother, Otto Crowde. 

Yet only a handful of fanatics remain in this rump organization, while the "tamed" <span style="color: #7A3C00;">Royalists</span> drift into the ranks of the <span style="color: #BFC8CC;">**GNU**</span>, including most of its parliamentary delegation.

@new_reichstag
on-arrival: {!
Q.unionist_minus_bvp_votes = parseFloat((Q.unionist_votes - Q.bvp_votes).toFixed(1));
Q.unionist_minus_bvp_r = parseFloat((Q.unionist_r - Q.bvp_r).toFixed(1));
if (Q.bvp_r == Q.unionist_r) Q.unionist_minus_bvp_r = 0;
!}
on-display: {!
data = [{
    "id": "collectivist",
    "legend": "Collectivist",
    "name": "Collectivist",
    "seats": Math.round(Q.collectivist_r * Q.reichstag_size),
}];

if (Q.sapd_formed && Q.sapd_r) {
    data.push({
        "id": "sapd",
        "legend": "SAPD",
        "name": "SAPD",
        "seats": Math.round(Q.sapd_r * Q.reichstag_size),
    });
}

if (Q.marcher_r) {
    data.push({
        "id": "marcher",
        "legend": "Marcher",
        "name": "Marcher",
        "seats": Math.round(Q.marcher_r * Q.reichstag_size),
    });
}

if (Q.rdp_r) {
    data.push({
        "id": "rdp",
        "legend": "RDP",
        "name": "RDP",
        "seats": Math.round(Q.rdp_r * Q.reichstag_size),
    });
}

if (Q.ddp_r && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r * Q.reichstag_size),
    });
}

if (Q.lvp_r && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r * Q.reichstag_size),
    });
}

if (Q.unionist_minus_bvp_r) {
    data.push({
        "id": "unionist",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(Q.unionist_minus_bvp_r * Q.reichstag_size),
    });
}

if (Q.bvp_r) {
    data.push({
        "id": "bvp",
        "legend": "Arcanists",
        "name": "Arcanists",
        "seats": Math.round(Q.bvp_r * Q.reichstag_size),
    });
}

if (Q.gold_r && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "gold",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r * Q.reichstag_size),
    });
}

if (Q.gnu_r && Q.gnu_formed) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round(Q.gnu_r * Q.reichstag_size),
    });
}

if (Q.other_r) {
    data.push({
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_r * Q.reichstag_size),
    });
}

if (Q.kvp_formed && Q.kvp_r) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round(Q.kvp_r * Q.reichstag_size),
    });
}

if (Q.traditionalist_r) {
    data.push({
        "id": "traditionalist",
        "legend": "Traditionalist",
        "name": "Traditionalist",
        "seats": Math.round(Q.traditionalist_r * Q.reichstag_size),
    });
}

if (Q.dnf_formed && Q.dnf_r) {
    data.push({
        "id": "dnf",
        "legend": "DNF",
        "name": "DNF",
        "seats": Math.round(Q.dnf_r * Q.reichstag_size),
    });
}

if (Q.dsu_exist && Q.dsu_r) {
    data.push({
        "id": "dsu",
        "legend": "DSU",
        "name": "DSU",
        "seats": Math.round(Q.dsu_r * Q.reichstag_size),
    });
}

if (Q.royalist_split && Q.royalist_gallax_r) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_gallax_r * Q.reichstag_size),
    });
}

if (!Q.royalist_split && Q.royalist_r) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_r * Q.reichstag_size),
    });
}

if (Q.nvf_exist && Q.nvf_r) {
    data.push({
        "id": "nvf",
        "legend": "NVF",
        "name": "NVF",
        "seats": Math.round(Q.nvf_r * Q.reichstag_size),
    });
}
if (d3 && window) {
    // get screen width
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);

    var lines = d3.linegraph(false, false,
            Q.parties_graph,
            {'marcher': '#E3000F', 'collectivist': '#700000', 'ddp': '#D3C24D', 'unionist': '#000', 'gold': '#D5AC27', 'traditionalist': '#3E88B3', 'royalist': '#7A3C00', 'other': '#a0a0a0', 'sapd': '#9B0000', 'dnf': '#003755', 'kvp': '#0087DC', 'lvp': '#FFCC00', 'gnu': '#BFC8CC'},
            {'marcher': 'Marcher', 'collectivist': 'Collectivist', 'ddp': Q.ddp_name, 'unionist': Q.unionist_party_name + ' + Arcanists', 'gold': 'Gold', 'traditionalist': 'Traditionalist', 'royalist': 'Royalist', 'other': 'Others', 'sapd': 'SAPD', 'dnf': 'DNF', 'kvp': 'KVP', 'lvp': 'LVP', 'gnu': 'GNU'});
    lines.width(width).height(400);
    //var svg = lines(Q.election_records);
    if (Q.election_records.length > 0) {
        d3.select("#election_history").datum(Q.election_records).call(lines);
    }
    //document.getElementById('election_history').innerHTML = svg.outerHTML;

    // party support records should not have so many ticks
    if (Q.game_over || (!Q.historical_mode && !Q.rubicon)) {
        var lines_2 = d3.linegraph(true, true,
            Q.parties_graph,
            {'marcher': '#E3000F', 'collectivist': '#700000', 'ddp': '#D3C24D', 'unionist': '#000', 'gold': '#D5AC27', 'traditionalist': '#3E88B3', 'royalist': '#7A3C00', 'other': '#a0a0a0', 'sapd': '#9B0000', 'dnf': '#003755', 'kvp': '#0087DC', 'lvp': '#FFCC00', 'gnu': '#BFC8CC'},
            {'marcher': 'Marcher', 'collectivist': 'Collectivist', 'ddp': Q.ddp_name, 'unionist': Q.unionist_party_name + ' + Arcanists', 'gold': 'Gold', 'traditionalist': 'Traditionalist', 'royalist': 'Royalist', 'other': 'Others', 'sapd': 'SAPD', 'dnf': 'DNF', 'kvp': 'KVP', 'lvp': 'LVP', 'gnu': 'GNU'});
        lines_2.width(width).height(400);
        d3.select("#party_support_history").datum(Q.party_support_records).call(lines_2);
    }

    // economic stats
    var minInflation = d3.min(Q.economic_records, d => d.inflation);
    var maxUnemployment = d3.max(Q.economic_records, d => d.unemployment);
    var lines_3 = d3.linegraph(true, true, ['inflation', 'unemployment'],
            {'inflation': '#0000FF', 'unemployment': '#FF0000'},
            {'inflation': 'Inflation', 'unemployment': 'Unemployment'},
            maxUnemployment + 5, minInflation - 5, 21);
    lines_3.width(width).height(300);
    d3.select("#economic_history").datum(Q.economic_records).call(lines_3);
}
!}

= Assembly composition

