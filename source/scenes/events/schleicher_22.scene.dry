[? if kvp_formed and not concord_kvp_formed and kvp_gnu: {!<tr><td><div class="box2" style='background-color:#0072C0'> </div></td><td>!} KVP: {!</td><td>!} [+ kvp_r +]% {!</td></tr>!} ?]

[? if not concord_formed and traditionalist_gnu: {!<tr><td><div class="box2" style='background-color:#316B8F'> </div></td><td>!} Traditionalists: {!</td><td>!} [+ traditionalist_r +]% {!</td></tr>!} ?]

