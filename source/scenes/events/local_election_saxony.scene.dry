title: Dornwich state Assembly Election
view-if: (year == 1929 and month == 5 and not saxony_election_seen) or (saxony_election_2_trigger_time == time and saxony_election_seen_time != time)
new-page: true
tags: event
on-arrival: saxony_election_seen += 1 if saxony_election_seen; saxony_election_seen = 1 if not saxony_election_seen; saxony_election_seen_time = time; saxony_most_recent = time; saxony_toleration = 0; saxony_groko = 0; red_saxony = 0; saxony_joever = 0; saxony_marcher = 0; saxony_right_2 = 0; saxony_royalist = 0; saxony_marcher_splinter = 0; saxony_soclib = 0; saxony_royalist_maj = 0; saxony_collectivist = 0; saxony_marcher_maj = 0
priority: 2
on-display: {!  
    var cardEl = document.createElement('div');  
    cardEl.className = "face-figure2";  

    var image = new Image();  
    image.className = "face-img";  
    image.src = "img/states.png";  

    cardEl.appendChild(image);  
    var contentDiv = document.querySelector("#page #mid_panel #content");
    contentDiv.appendChild(cardEl);
!}

= Elections, [+ month : month +] [+ year_display +]

The Dornish state elections are to be held now.

# 1932 ref to dissolve saxony

- @saxony: May we do our best...

@saxony
on-arrival: {!

var saxony_adjustment_factors = {
    spd: 1.25,
    sapd: 1.0,
    kpd: 1.25,
    ddp: 1.0,
    lvp: 1.5,
    z: 0.06,
    dvp: 1.6,
    dnvp: 0.6,
    nsdap: 1.0,
    other: 1.3,
    kvp: 1.3,
    dnf: 0.3
};

Q.marcher_r_saxony = 0;
Q.sapd_r_saxony = 0;
Q.collectivist_r_saxony = 0;
Q.ddp_r_saxony = 0;
Q.lvp_r_saxony = 0;
Q.unionist_r_saxony = 0;
Q.gold_r_saxony = 0;
Q.traditionalist_r_saxony = 0;
Q.royalist_r_saxony = 0;
Q.other_r_saxony = 0;
Q.kvp_r_saxony = 0;
Q.dnf_r_saxony = 0;

Q.marcher_saxony_elections_vote = 0;
Q.sapd_saxony_elections_vote = 0;
Q.collectivist_saxony_elections_vote = 0;
Q.ddp_saxony_elections_vote = 0;
Q.lvp_saxony_elections_vote = 0;
Q.unionist_saxony_elections_vote = 0;
Q.gold_saxony_elections_vote = 0;
Q.traditionalist_saxony_elections_vote = 0;
Q.royalist_saxony_elections_vote = 0;
Q.other_saxony_elections_vote = 0;
Q.kvp_saxony_elections_vote = 0;
Q.dnf_saxony_elections_vote = 0;

if (Q.burgher_marcher_normalized + Q.guild_marcher_normalized >= 30) saxony_adjustment_factors.spd += 0.1;
if (Q.commons_marcher_normalized >= 70) saxony_adjustment_factors.spd += 0.1;
Q.marcher_saxony_elections_vote = Q.marcher_votes*saxony_adjustment_factors.spd;
Q.sapd_saxony_elections_vote = Q.sapd_votes*saxony_adjustment_factors.sapd;
Q.collectivist_saxony_elections_vote = Q.collectivist_votes*saxony_adjustment_factors.kpd;
if (Q.stolper_program_adopted) saxony_adjustment_factors.ddp += 0.2;
Q.ddp_saxony_elections_vote = Q.ddp_votes*saxony_adjustment_factors.ddp;
Q.lvp_saxony_elections_vote = Q.lvp_votes*saxony_adjustment_factors.lvp;
if (!Q.stegerwald_path) Q.unionist_saxony_elections_vote = Q.unionist_votes*saxony_adjustment_factors.z;
if (Q.stegerwald_path) Q.unionist_saxony_elections_vote = Q.unionist_votes * 0.8;
Q.gold_saxony_elections_vote = Q.gold_votes*saxony_adjustment_factors.dvp;
if (Q.traditionalist_ideology == "Moderate") saxony_adjustment_factors.dnvp += 0.15;
Q.traditionalist_saxony_elections_vote = Q.traditionalist_votes*saxony_adjustment_factors.dnvp;
Q.royalist_saxony_elections_vote = Q.royalist_votes*saxony_adjustment_factors.nsdap;
if (Q.stolper_program_adopted) saxony_adjustment_factors.other -= 0.1;
Q.other_saxony_elections_vote = Q.other_votes*saxony_adjustment_factors.other;
Q.kvp_saxony_elections_vote = Q.kvp_votes*saxony_adjustment_factors.kvp;
Q.dnf_saxony_elections_vote = Q.dnf_votes*saxony_adjustment_factors.dnf;

Q.total_votes_saxony = Q.marcher_saxony_elections_vote + Q.sapd_saxony_elections_vote + Q.collectivist_saxony_elections_vote + Q.ddp_saxony_elections_vote + Q.lvp_saxony_elections_vote + Q.unionist_saxony_elections_vote + Q.gold_saxony_elections_vote + Q.traditionalist_saxony_elections_vote + Q.royalist_saxony_elections_vote + Q.other_saxony_elections_vote + Q.kvp_saxony_elections_vote + Q.dnf_saxony_elections_vote;

if (Q.total_votes_saxony > 0) {
    Q.marcher_saxony_elections_vote = (Q.marcher_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.sapd_saxony_elections_vote = (Q.sapd_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.collectivist_saxony_elections_vote = (Q.collectivist_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.ddp_saxony_elections_vote = (Q.ddp_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.lvp_saxony_elections_vote = (Q.lvp_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.unionist_saxony_elections_vote = (Q.unionist_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.gold_saxony_elections_vote = (Q.gold_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.traditionalist_saxony_elections_vote = (Q.traditionalist_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.royalist_saxony_elections_vote = (Q.royalist_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.other_saxony_elections_vote = (Q.other_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.kvp_saxony_elections_vote = (Q.kvp_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.dnf_saxony_elections_vote = (Q.dnf_saxony_elections_vote / Q.total_votes_saxony) * 100;
    let target = 34;
    Q.marcher_saxony_elections_vote = Math.round((Q.marcher_saxony_elections_vote + (target - Q.marcher_saxony_elections_vote) * 0.35) * 10) / 10;
    Q.total_votes_saxony = Q.marcher_saxony_elections_vote + Q.sapd_saxony_elections_vote + Q.collectivist_saxony_elections_vote + Q.ddp_saxony_elections_vote + Q.lvp_saxony_elections_vote + Q.unionist_saxony_elections_vote + Q.gold_saxony_elections_vote + Q.traditionalist_saxony_elections_vote + Q.royalist_saxony_elections_vote + Q.other_saxony_elections_vote + Q.kvp_saxony_elections_vote + Q.dnf_saxony_elections_vote;
    Q.marcher_saxony_elections_vote = (Q.marcher_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.sapd_saxony_elections_vote = (Q.sapd_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.collectivist_saxony_elections_vote = (Q.collectivist_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.ddp_saxony_elections_vote = (Q.ddp_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.lvp_saxony_elections_vote = (Q.lvp_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.unionist_saxony_elections_vote = (Q.unionist_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.gold_saxony_elections_vote = (Q.gold_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.traditionalist_saxony_elections_vote = (Q.traditionalist_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.royalist_saxony_elections_vote = (Q.royalist_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.other_saxony_elections_vote = (Q.other_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.kvp_saxony_elections_vote = (Q.kvp_saxony_elections_vote / Q.total_votes_saxony) * 100;
    Q.dnf_saxony_elections_vote = (Q.dnf_saxony_elections_vote / Q.total_votes_saxony) * 100;
}

Q.marcher_saxony_elections_vote = (Q.marcher_saxony_elections_vote != undefined ? parseFloat(Q.marcher_saxony_elections_vote.toFixed(1)) : 0);
Q.sapd_saxony_elections_vote = (Q.sapd_saxony_elections_vote != undefined ? parseFloat(Q.sapd_saxony_elections_vote.toFixed(1)) : 0);
Q.collectivist_saxony_elections_vote = (Q.collectivist_saxony_elections_vote != undefined ? parseFloat(Q.collectivist_saxony_elections_vote.toFixed(1)) : 0);
Q.ddp_saxony_elections_vote = (Q.ddp_saxony_elections_vote != undefined ? parseFloat(Q.ddp_saxony_elections_vote.toFixed(1)) : 0);
Q.lvp_saxony_elections_vote = (Q.lvp_saxony_elections_vote != undefined ? parseFloat(Q.lvp_saxony_elections_vote.toFixed(1)) : 0);
Q.unionist_saxony_elections_vote = (Q.unionist_saxony_elections_vote != undefined ? parseFloat(Q.unionist_saxony_elections_vote.toFixed(1)) : 0);
Q.gold_saxony_elections_vote = (Q.gold_saxony_elections_vote != undefined ? parseFloat(Q.gold_saxony_elections_vote.toFixed(1)) : 0);
Q.traditionalist_saxony_elections_vote = (Q.traditionalist_saxony_elections_vote != undefined ? parseFloat(Q.traditionalist_saxony_elections_vote.toFixed(1)) : 0);
Q.royalist_saxony_elections_vote = (Q.royalist_saxony_elections_vote != undefined ? parseFloat(Q.royalist_saxony_elections_vote.toFixed(1)) : 0);
Q.other_saxony_elections_vote = (Q.other_saxony_elections_vote != undefined ? parseFloat(Q.other_saxony_elections_vote.toFixed(1)) : 0);
Q.kvp_saxony_elections_vote = (Q.kvp_saxony_elections_vote != undefined ? parseFloat(Q.kvp_saxony_elections_vote.toFixed(1)) : 0);
Q.dnf_saxony_elections_vote = (Q.dnf_saxony_elections_vote != undefined ? parseFloat(Q.dnf_saxony_elections_vote.toFixed(1)) : 0);

if (Q.marcher_saxony_elections_vote >= 1.4) Q.marcher_r_saxony = Q.marcher_saxony_elections_vote;
if (Q.sapd_saxony_elections_vote >= 1.4) Q.sapd_r_saxony = Q.sapd_saxony_elections_vote;
if (Q.collectivist_saxony_elections_vote >= 1.4) Q.collectivist_r_saxony = Q.collectivist_saxony_elections_vote;
if (Q.ddp_saxony_elections_vote >= 1.4) Q.ddp_r_saxony = Q.ddp_saxony_elections_vote;
if (Q.lvp_saxony_elections_vote >= 1.4) Q.lvp_r_saxony = Q.lvp_saxony_elections_vote;
if (Q.unionist_saxony_elections_vote >= 1.4) Q.unionist_r_saxony = Q.unionist_saxony_elections_vote;
if (Q.gold_saxony_elections_vote >= 1.4) Q.gold_r_saxony = Q.gold_saxony_elections_vote;
if (Q.traditionalist_saxony_elections_vote >= 1.4) Q.traditionalist_r_saxony = Q.traditionalist_saxony_elections_vote;
if (Q.royalist_saxony_elections_vote >= 1.4) Q.royalist_r_saxony = Q.royalist_saxony_elections_vote;
if (Q.other_saxony_elections_vote >= 1.4) Q.other_r_saxony = Q.other_saxony_elections_vote;
if (Q.kvp_saxony_elections_vote >= 1.4) Q.kvp_r_saxony = Q.kvp_saxony_elections_vote;
if (Q.dnf_saxony_elections_vote >= 1.4) Q.dnf_r_saxony = Q.dnf_saxony_elections_vote;

var saxony_adjustment_r_factors = {
    spd: 1.0,
    sapd: 1.0,
    kpd: 0.98,
    ddp: 0.96,
    lvp: 1.0,
    z: 0.0,
    dvp: 1.0,
    dnvp: 1.0,
    nsdap: 1.0,
    other: 1.0,
    kvp: 0.9,
    dnf: 0.3
};

Q.marcher_r_saxony = Q.marcher_r_saxony*saxony_adjustment_r_factors.spd;
Q.sapd_r_saxony = Q.sapd_r_saxony*saxony_adjustment_r_factors.sapd;
Q.collectivist_r_saxony = Q.collectivist_r_saxony*saxony_adjustment_r_factors.kpd;
if (Q.stolper_program_adopted) saxony_adjustment_r_factors.ddp += 0.04;
Q.ddp_r_saxony = Q.ddp_r_saxony*saxony_adjustment_r_factors.ddp;
Q.lvp_r_saxony = Q.lvp_r_saxony*saxony_adjustment_r_factors.lvp;
if (!Q.stegerwald_path) Q.unionist_r_saxony = Q.unionist_r_saxony*saxony_adjustment_r_factors.z;
if (Q.stegerwald_path) Q.unionist_r_saxony = Q.unionist_r_saxony;
Q.gold_r_saxony = Q.gold_r_saxony*saxony_adjustment_r_factors.dvp;
Q.traditionalist_r_saxony = Q.traditionalist_r_saxony*saxony_adjustment_r_factors.dnvp;
Q.royalist_r_saxony = Q.royalist_r_saxony*saxony_adjustment_r_factors.nsdap;
Q.other_r_saxony = Q.other_r_saxony*saxony_adjustment_r_factors.other;
Q.kvp_r_saxony = Q.kvp_r_saxony*saxony_adjustment_r_factors.kvp;
Q.dnf_r_saxony = Q.dnf_r_saxony*saxony_adjustment_r_factors.dnf;

Q.total_r_saxony = 0;

if (Q.marcher_r_saxony) Q.total_r_saxony += Q.marcher_r_saxony;
if (Q.sapd_r_saxony) Q.total_r_saxony += Q.sapd_r_saxony;
if (Q.collectivist_r_saxony) Q.total_r_saxony += Q.collectivist_r_saxony;
if (Q.ddp_r_saxony) Q.total_r_saxony += Q.ddp_r_saxony;
if (Q.lvp_r_saxony) Q.total_r_saxony += Q.lvp_r_saxony;
if (Q.unionist_r_saxony) Q.total_r_saxony += Q.unionist_r_saxony;
if (Q.gold_r_saxony) Q.total_r_saxony += Q.gold_r_saxony;
if (Q.traditionalist_r_saxony) Q.total_r_saxony += Q.traditionalist_r_saxony;
if (Q.royalist_r_saxony) Q.total_r_saxony += Q.royalist_r_saxony;
if (Q.other_r_saxony) Q.total_r_saxony += Q.other_r_saxony;
if (Q.kvp_r_saxony) Q.total_r_saxony += Q.kvp_r_saxony;
if (Q.dnf_r_saxony) Q.total_r_saxony += Q.dnf_r_saxony;

if (Q.total_r_saxony > 0) {
    Q.marcher_r_saxony = (Q.marcher_r_saxony / Q.total_r_saxony) * 100;
    Q.sapd_r_saxony = (Q.sapd_r_saxony / Q.total_r_saxony) * 100;
    Q.collectivist_r_saxony = (Q.collectivist_r_saxony / Q.total_r_saxony) * 100;
    Q.ddp_r_saxony = (Q.ddp_r_saxony / Q.total_r_saxony) * 100;
    Q.lvp_r_saxony = (Q.lvp_r_saxony / Q.total_r_saxony) * 100;
    Q.unionist_r_saxony = (Q.unionist_r_saxony / Q.total_r_saxony) * 100;
    Q.gold_r_saxony = (Q.gold_r_saxony / Q.total_r_saxony) * 100;
    Q.traditionalist_r_saxony = (Q.traditionalist_r_saxony / Q.total_r_saxony) * 100;
    Q.royalist_r_saxony = (Q.royalist_r_saxony / Q.total_r_saxony) * 100;
    Q.other_r_saxony = (Q.other_r_saxony / Q.total_r_saxony) * 100;
    Q.kvp_r_saxony = (Q.kvp_r_saxony / Q.total_r_saxony) * 100;
    Q.dnf_r_saxony = (Q.dnf_r_saxony / Q.total_r_saxony) * 100;
}

let spd_share = 0.95;
let aspd_share = 0.05;

if (Q.reformists_resign) aspd_share += 0.1;
if (Q.unions_independent) aspd_share += 0.2;

let total_spd_share = aspd_share + spd_share;

aspd_share = (aspd_share / total_spd_share);
spd_share = (spd_share / total_spd_share);

Q.marcher_saxony_elections_vote = Q.marcher_saxony_elections_vote*spd_share;
Q.marcher_r_saxony = Q.marcher_r_saxony*spd_share;

Q.aspd_saxony_elections_vote = Q.marcher_saxony_elections_vote*aspd_share;
Q.aspd_r_saxony = Q.marcher_r_saxony*aspd_share;

let farm_share = 0.27;
if (Q.traditionalist_ideology == "Moderate") farm_share -= 0.1;
let wp_share = 0.59;
if (Q.stolper_program_adopted) wp_share -= 0.05;
if (Q.gold_reform) wp_share -= 0.1;
let vrp_share = 0.14;
if (Q.stolper_program_adopted) vrp_share -= 0.05;

let total_share = wp_share + farm_share + vrp_share;

farm_share = (farm_share / total_share);
wp_share = (wp_share / total_share);
vrp_share = (vrp_share / total_share);

Q.farm_saxony_elections_vote = Q.other_saxony_elections_vote*farm_share;
Q.farm_r_saxony = Q.other_r_saxony*farm_share;

Q.wp_saxony_elections_vote = Q.other_saxony_elections_vote*wp_share;
Q.wp_r_saxony = Q.other_r_saxony*wp_share;

Q.vrp_saxony_elections_vote = Q.other_saxony_elections_vote*vrp_share;
Q.vrp_r_saxony = Q.other_r_saxony*vrp_share;

Q.kpo_saxony_elections_vote = Q.collectivist_saxony_elections_vote*0.06
Q.collectivist_saxony_elections_vote -= Q.kpo_saxony_elections_vote;

function allocateSeats(percentages, totalSeats = 96) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_saxony: Q.marcher_r_saxony,
    aspd_r_saxony: Q.aspd_r_saxony,
    sapd_r_saxony: Q.sapd_r_saxony,
    kpd_r_saxony: Q.collectivist_r_saxony,
    ddp_r_saxony: Q.ddp_r_saxony,
    lvp_r_saxony: Q.lvp_r_saxony,
    z_r_saxony: Q.unionist_r_saxony,
    dvp_r_saxony: Q.gold_r_saxony,
    dnvp_r_saxony: Q.traditionalist_r_saxony,
    nsdap_r_saxony: Q.royalist_r_saxony,
    wp_r_saxony: Q.wp_r_saxony,
    farm_r_saxony: Q.farm_r_saxony,
    vrp_r_saxony: Q.vrp_r_saxony,
    kvp_r_saxony: Q.kvp_r_saxony,
    dnf_r_saxony: Q.dnf_r_saxony
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 96).toFixed(1));
}

Q.other_r_saxony = Q.farm_r_saxony + Q.wp_r_saxony + Q.vrp_r_saxony;

Q.left_coalition_saxony = parseFloat((Q.marcher_r_saxony + Q.collectivist_r_saxony + Q.sapd_r_saxony).toFixed(1));
Q.bourgeois_coalition_saxony = parseFloat((Q.aspd_r_saxony + Q.unionist_r_saxony + Q.ddp_r_saxony + Q.gold_r_saxony + Q.lvp_r_saxony + Q.kvp_r_saxony + Q.other_r_saxony + Q.traditionalist_r_saxony + Q.royalist_r_saxony).toFixed(1));
Q.true_bourgeois_coalition_saxony = parseFloat((Q.aspd_r_saxony + Q.unionist_r_saxony + Q.ddp_r_saxony + Q.gold_r_saxony + Q.lvp_r_saxony + Q.kvp_r_saxony + Q.other_r_saxony + Q.traditionalist_r_saxony).toFixed(1));
Q.marcher_coalition_saxony = parseFloat((Q.aspd_r_saxony + Q.marcher_r_saxony + Q.ddp_r_saxony + Q.lvp_r_saxony + Q.unionist_r_saxony + Q.gold_r_saxony).toFixed(1));

Q.farm_saxony_elections_vote = (Q.farm_saxony_elections_vote != undefined ? parseFloat(Q.farm_saxony_elections_vote.toFixed(1)) : 0);
Q.wp_saxony_elections_vote = (Q.wp_saxony_elections_vote != undefined ? parseFloat(Q.wp_saxony_elections_vote.toFixed(1)) : 0);
Q.vrp_saxony_elections_vote = (Q.vrp_saxony_elections_vote != undefined ? parseFloat(Q.vrp_saxony_elections_vote.toFixed(1)) : 0);
Q.kpo_saxony_elections_vote = (Q.kpo_saxony_elections_vote != undefined ? parseFloat(Q.kpo_saxony_elections_vote.toFixed(1)) : 0);
Q.collectivist_saxony_elections_vote = (Q.collectivist_saxony_elections_vote != undefined ? parseFloat(Q.collectivist_saxony_elections_vote.toFixed(1)) : 0);
Q.aspd_saxony_elections_vote = (Q.aspd_saxony_elections_vote != undefined ? parseFloat(Q.aspd_saxony_elections_vote.toFixed(1)) : 0);
Q.marcher_saxony_elections_vote = (Q.marcher_saxony_elections_vote != undefined ? parseFloat(Q.marcher_saxony_elections_vote.toFixed(1)) : 0);
Q.farm_r_saxony = (Q.farm_r_saxony != undefined ? parseFloat(Q.farm_r_saxony.toFixed(1)) : 0);
Q.wp_r_saxony = (Q.wp_r_saxony != undefined ? parseFloat(Q.wp_r_saxony.toFixed(1)) : 0);
Q.vrp_r_saxony = (Q.vrp_r_saxony != undefined ? parseFloat(Q.vrp_r_saxony.toFixed(1)) : 0);
Q.aspd_r_saxony = (Q.aspd_r_saxony != undefined ? parseFloat(Q.aspd_r_saxony.toFixed(1)) : 0);
Q.marcher_r_saxony = (Q.marcher_r_saxony != undefined ? parseFloat(Q.marcher_r_saxony.toFixed(1)) : 0);

!}
on-display: {!
data = [{
    "id": "collectivist",
    "legend": "Collectivist",
    "name": "Collectivist",
    "seats": Math.round(Q.collectivist_r_saxony * 0.96),
}];

if (Q.sapd_formed && Q.sapd_r_saxony) {
    data.push({
        "id": "sapd",
        "legend": "Laborists",
        "name": "Laborists",
        "seats": Math.round(Q.sapd_r_saxony * 0.96),
    });
}

data = data.concat([{
    "id": "marcher",
    "legend": "Marcher",
    "name": "Marcher",
    "seats": Math.round(Q.marcher_r_saxony * 0.96),
}]);

if (Q.aspd_r_saxony) {
    data.push({
        "id": "aspd",
        "legend": "ORP",
        "name": "ORP",
        "seats": Math.round(Q.aspd_r_saxony * 0.96),
    });
}

if (Q.ddp_r_saxony && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r_saxony * 0.96),
    });
}

if (Q.lvp_r_saxony && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r_saxony * 0.96),
    });
}

if (Q.unionist_r_saxony) {
    data.push({
        "id": "unionist",
        "legend": Q.unionist_party_name,
        "name": Q.unionist_party_name,
        "seats": Math.round(Q.unionist_r_saxony * 0.96),
    });
}

if (Q.gold_r_saxony && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "gold",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r_saxony * 0.96),
    });
}

if (Q.farm_r_saxony) {
    data.push({
        "id": "farm4",
        "legend": "Farm",
        "name": "Farm",
        "seats": Math.round(Q.farm_r_saxony * 0.96),
    });
}

if (Q.wp_r_saxony) {
    data.push({
        "id": "wp",
        "legend": "ECP",
        "name": "ECP",
        "seats": Math.round(Q.wp_r_saxony * 0.96),
    });
}

if (Q.vrp_r_saxony) {
    data.push({
        "id": "vrp",
        "legend": "PRP",
        "name": "PRP",
        "seats": Math.round(Q.vrp_r_saxony * 0.96),
    });
}

if (Q.kvp_formed && Q.kvp_r_saxony) {
    data.push({
        "id": "kvp",
        "legend": "CPP",
        "name": "CPP",
        "seats": Math.round(Q.kvp_r_saxony * 0.96),
    });
}

data = data.concat([{
    "id": "traditionalist",
    "legend": "Traditionalist",
    "name": "Traditionalist",
    "seats": Math.round(Q.traditionalist_r_saxony * 0.96),
}]);
if (Q.dnf_formed && Q.dnf_r_saxony) {
    data.push({
        "id": "dnf",
        "legend": "CNF",
        "name": "CNF",
        "seats": Math.round(Q.dnf_r_saxony * 0.96),
    });
}
data = data.concat([{
    "id": "royalist",
    "legend": "Royalist",
    "name": "Royalist",
    "seats": Math.round(Q.royalist_r_saxony * 0.96),
}, ]);

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("saxony_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#saxony_landtag").datum(data).call(parliament);
}
!}
