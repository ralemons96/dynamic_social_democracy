title: The Stowford Front
subtitle: The right-wing forces unite against the incumbent government.
new-page: true
on-arrival: harzburg_front_seen = 1; harzburg_front_time = time; loyalist_strength += 50; loyalist_militancy += 0.05; warden_militancy += 0.05; guild_royalist += 3; landed_royalist += 3; royalist_urgency += 1; iron_front_timer = 0; gold_right += 1 if gold_leader == "Coalfax"; lvp_right += 1; pro_republic -= 3; dufour_angry += 10; dufour_angry_bruning += 10
