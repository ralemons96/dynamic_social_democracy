on-arrival: {!
// set up the infrastructure
Q.sapd_formed = 1;
Q.parties.push('sapd');
Q.parties_graph.push('sapd');

Q.commons_sapd = 10;
Q.commons_marcher -= 3;
Q.burgher_sapd = 1;
Q.guild_sapd = 0;
Q.landed_sapd = 0;
Q.disfavored_sapd = 2;
Q.faithful_sapd = 0;

Q.commons_other -= 5;

if (Q.unions_independent) {
    Q.commons_sapd += 8;
    Q.disfavored_sapd += 4;
}

Q.old_commons_sapd_display = 0
Q.old_burgher_sapd_display = 0
Q.old_guild_sapd_display = 0
Q.old_landed_sapd_display = 0
Q.old_disfavored_sapd_display = 0
Q.old_faithful_sapd_display = 0

// update all records
Q.sapd_r = 0;
Q.old_sapd_r = 0;
for (var record of Q.election_records) {
    record['sapd'] = 0;
}
for (var record of Q.party_support_records) {
    record['sapd'] = 0;
}
!}
