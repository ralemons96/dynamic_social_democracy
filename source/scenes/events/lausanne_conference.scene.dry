            Q.burgher_unionist += 5;
            Q.guild_unionist += 5;
            Q.landed_unionist += 5;
            Q.disfavored_unionist += 3;
            Q.faithful_unionist += 5;
        }
    }
}

if (Q.bruning_time) {
    if (Q.traditionalist_ideology == "Moderate" && (Q.in_center_right_coalition || Q.in_right_coalition || Q.marcher_toleration_right)) {
        Q.commons_traditionalist += 2;
        Q.burgher_traditionalist += 4;
        Q.guild_traditionalist += 4;
        Q.landed_traditionalist += 4;
        Q.commons_dnf -= 2;
        Q.burgher_dnf -= 4;
        Q.guild_dnf -= 4;
        Q.landed_dnf -= 4;
    } else if (Q.traditionalist_ideology == "Radical") {
        Q.commons_kvp += 3;
        Q.burgher_kvp += 5;
        Q.guild_kvp += 5;
        Q.landed_kvp += 5;
        Q.commons_traditionalist -= 3;
        Q.burgher_traditionalist -= 5;
        Q.guild_traditionalist -= 5;
        Q.landed_traditionalist -= 5;
        if (!Q.kvp_formed) {
            Q.commons_other += 3;
            Q.burgher_other += 5;
            Q.guild_other += 5;
            Q.landed_other += 5;
            Q.faithful_other += 3;
        }
    }
    if (!Q.stegerwald_path) {
        Q.commons_unionist += 3;
        Q.burgher_unionist += 3;
        Q.guild_unionist += 3;
        Q.landed_unionist += 3;
        Q.faithful_unionist += 3;
    } else if (Q.stegerwald_path) {
        Q.commons_unionist += 5;
        Q.burgher_unionist += 5;
        Q.guild_unionist += 5;
        Q.landed_unionist += 5;
        Q.disfavored_unionist += 3;
        Q.faithful_unionist += 5;
    }
    Q.burgher_ddp += 3;
    Q.guild_ddp += 3;
    Q.burgher_gold += 4;
    Q.guild_gold += 4;
    Q.landed_gold += 3;
    
    Q.burgher_lvp += 6;
    Q.guild_lvp += 6;
    Q.landed_lvp += 4;

    Q.commons_royalist *= 0.9;
    Q.burgher_royalist *= 0.9;
    Q.guild_royalist *= 0.9;
    Q.landed_royalist *= 0.9;
    Q.disfavored_royalist *= 0.9;
    Q.faithful_royalist *= 0.9;
}

Q.bruning_coalition_dissent -= 3;
Q.traditionalist_angry -= 4;
