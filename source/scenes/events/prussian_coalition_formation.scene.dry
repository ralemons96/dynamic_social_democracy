on-arrival: pro_republic -= 5 if anti_democratic_coalition_heartland >= 30; commons_royalist += 3 if anti_democratic_coalition_heartland >= 30; commons_collectivist += 3 if anti_democratic_coalition_heartland >= 30; commons_marcher -= 3 if anti_democratic_coalition_heartland >= 30; burgher_royalist += 2 if anti_democratic_coalition_heartland >= 30; guild_royalist += 2 if anti_democratic_coalition_heartland >= 30; landed_royalist += 2 if anti_democratic_coalition_heartland >= 30; burgher_ddp -= 2 if anti_democratic_coalition_heartland >= 30; guild_ddp -= 2 if anti_democratic_coalition_heartland >= 30; landed_ddp -= 2 if anti_democratic_coalition_heartland >= 30; burgher_gold -= 2 if anti_democratic_coalition_heartland >= 30; guild_gold -= 2 if anti_democratic_coalition_heartland >= 30; landed_gold -= 2 if anti_democratic_coalition_heartland >= 30; burgher_lvp -= 2 if anti_democratic_coalition_heartland >= 30; guild_lvp -= 2 if anti_democratic_coalition_heartland >= 30; landed_lvp -= 2 if anti_democratic_coalition_heartland >= 30
