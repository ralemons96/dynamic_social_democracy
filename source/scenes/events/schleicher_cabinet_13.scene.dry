Q.guild_ddp += 3;
Q.burgher_lvp += 3;
Q.guild_lvp += 3;
Q.landed_unionist += 3;
Q.faithful_unionist += 3;

Q.commons_collectivist += 12;
Q.disfavored_collectivist += 12;
Q.burgher_collectivist += 2;

Q.collectivist_banned = 0;
Q.sapd_banned = 0;

for (var party of Q.parties) {
    Q[party+'_r'] = Q[party+'_r_pre'];
}

Q.collectivist_relation += 20;

if (Q.sapd_formed) {
    Q.commons_sapd += 4;
