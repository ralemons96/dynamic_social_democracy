}

Q.commons_gnu -= 12;
Q.burgher_gnu -= 12;
Q.guild_gnu -= 12;
Q.landed_gnu -= 12;
Q.disfavored_gnu -= 12;
Q.total_gnu_bonus -= 12;

Q.dufour_staal_r -= 2;
Q.staal_strength -= 1;
