title: Staal's Turn to Play
subtitle: Will the general hold firm?
view-if: chancellor == "Staal" and collectivist_explode and staal_fight
max-visits: 1
new-page: true
priority: -1
tags: event
face-image: img/portraits/schleicher_cool.jpg
go-to: reichstag

= Staal's Turn to Play

@reichstag
on-arrival: {!
Q.collectivist_r_alt = 0;
Q.sapd_r_alt = 0;
Q.marcher_r_alt = 0;
Q.ddp_r_alt = 0;
Q.lvp_r_alt = 0;
Q.gold_r_alt = 0;
Q.unionist_r_alt = 0;
Q.kvp_r_alt = 0;
Q.total_r_alt = 0;

Q.collectivist_r_alt = Q.collectivist_r_pre;
if (Q.sapd_formed && Q.sapd_r_pre) Q.sapd_r_alt = Q.sapd_r_pre;
Q.marcher_r_alt = Q.marcher_r_pre;
if (!Q.dstp_maintained && Q.libs_against_staal && !Q.lvp_formed) Q.ddp_r_alt = Q.ddp_r_pre;
if (Q.libs_against_staal && Q.lvp_formed) Q.lvp_r_alt = Q.lvp_r_pre;
if (Q.libs_against_staal && Q.gold_relation >= 40 && Q.gold_leader != "Dingeldey" && (Q.industrialists_staal < 4 || Q.republicans_staal <= 0) && Q.gold_exist && !Q.lvp_formed) Q.gold_r_alt = Q.gold_r_pre;
if (Q.unionist_against_staal) Q.unionist_r_alt = Q.unionist_r_pre - Q.bvp_r;

Q.total_r_alt = parseFloat(Q.collectivist_r_alt + Q.sapd_r_alt + Q.marcher_r_alt + Q.ddp_r_alt + Q.gold_r_alt + Q.unionist_r_alt + Q.lvp_r_alt).toFixed(1);
Q.total_r_alt_2 = parseFloat(Q.collectivist_r_alt + Q.sapd_r_alt + Q.marcher_r_alt + Q.ddp_r_alt + Q.gold_r_alt + Q.unionist_r_alt + Q.lvp_r_alt).toFixed(1);

if (Q.total_r_alt < 100) {
    let scale = 100 / Q.total_r_alt;
    Q.collectivist_r_alt = Math.round(Q.collectivist_r_alt * scale * 10) / 10;
    Q.sapd_r_alt = Math.round(Q.sapd_r_alt * scale * 10) / 10;
    Q.marcher_r_alt = Math.round(Q.marcher_r_alt * scale * 10) / 10;
    Q.ddp_r_alt = Math.round(Q.ddp_r_alt * scale * 10) / 10;
    Q.gold_r_alt = Math.round(Q.gold_r_alt * scale * 10) / 10;
    Q.unionist_r_alt   = Math.round(Q.unionist_r_alt * scale * 10) / 10;
    Q.lvp_r_alt = Math.round(Q.lvp_r_alt * scale * 10) / 10;

    Q.total_r_alt = Q.collectivist_r_alt + Q.sapd_r_alt + Q.marcher_r_alt + Q.ddp_r_alt + Q.gold_r_alt + Q.unionist_r_alt + Q.lvp_r_alt;
}

for (var party of Q.parties) {
    if (Q[party+'r_alt'] == null || Q[party+'r_alt'] == undefined) {
        Q[party+'r_alt'] = 0;
    }
}

!}
go-to: reichstag_diagram

In defiance of the illegal adjournment of the Assembly, an alternative assembly has been convened. The parties participating are determined by their ties to us and their role in the ongoing demonstrations.

[? if collectivist_r_alt: With most <span style="color: #700000;">**Collectivists**</span> deputies imprisoned, substitute representatives have been appointed to fill their seats. ?]

@reichstag_diagram
on-display: {!
data = [{
    "id": "collectivist",
    "legend": "Collectivist",
    "name": "Collectivist",
    "seats": Math.round(Q.collectivist_r_alt * 2),
}];

if (Q.sapd_formed && Q.sapd_r_alt) {
    data.push({
        "id": "sapd",
        "legend": "SAPD",
        "name": "SAPD",
        "seats": Math.round(Q.sapd_r_alt * 2),
    });
}

if (Q.marcher_r) {
    data.push({
        "id": "marcher",
        "legend": "Marcher",
        "name": "Marcher",
        "seats": Math.round(Q.marcher_r * 2),
    });
}

if (Q.rdp_r) {
    data.push({
        "id": "rdp",
        "legend": "RDP",
        "name": "RDP",
        "seats": Math.round(Q.rdp_r * 2),
    });
}

if (Q.ddp_r_alt && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r_alt * 2),
    });
}

if (Q.lvp_r_alt && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r_alt * 2),
    });
}

data = data.concat([{
        "id": "unionist",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(Q.unionist_r_alt * 2),
    }
]);

if (Q.gold_r_alt && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "gold",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r_alt * 2),
    });
}

if (Q.gnu_r_alt && Q.gnu_formed) {
    data.push({
        "id": "gnu",
        "legend": "GNU",
        "name": "GNU",
        "seats": Math.round(Q.gnu_r_alt * 2),
    });
}

if (Q.other_r_alt) {
    data.push({
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_r_alt * 2),
    });
}

if (Q.kvp_formed && Q.kvp_r_alt) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round(Q.kvp_r_alt * 2),
    });
}

if (Q.traditionalist_r_alt) {
    data.push({
        "id": "traditionalist",
        "legend": "Traditionalist",
        "name": "Traditionalist",
        "seats": Math.round(Q.traditionalist_r_alt * 2),
    });
}

if (Q.dnf_formed && Q.dnf_r_alt) {
    data.push({
        "id": "dnf",
        "legend": "DNF",
        "name": "DNF",
        "seats": Math.round(Q.dnf_r_alt * 2),
    });
}

if (Q.dsu_exist && Q.dsu_r_alt) {
    data.push({
        "id": "dsu",
        "legend": "DSU",
        "name": "DSU",
        "seats": Math.round(Q.dsu_r_alt * 2),
    });
}

if (Q.royalist_split && Q.royalist_gallax_r_alt) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_gallax_r_alt * 2),
    });
}

if (!Q.royalist_split && Q.royalist_r_alt) {
    data.push({
        "id": "royalist",
        "legend": "Royalist",
        "name": "Royalist",
        "seats": Math.round(Q.royalist_r_alt * 2),
    });
}

if (Q.nvf_exist && Q.nvf_r_alt) {
    data.push({
        "id": "nvf",
        "legend": "NVF",
        "name": "NVF",
        "seats": Math.round(Q.nvf_r_alt * 2),
    });
}
if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("alt_reichstag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#alt_reichstag").datum(data).call(parliament);
}
!}
go-to: negotiation_menu_med if marcher_med; negotiation_menu_win if marcher_win

