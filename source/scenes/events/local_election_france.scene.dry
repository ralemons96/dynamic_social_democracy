Q.disp_fr_votes_france = (Q.disp_fr_votes_france != undefined ? parseFloat(Q.disp_fr_votes_france.toFixed(1)) : 0);
Q.disp_ind_fr_r_france = (Q.disp_ind_fr_r_france != undefined ? parseFloat(Q.disp_ind_fr_r_france.toFixed(1)) : 0);
Q.disp_fr_r_france = (Q.disp_fr_r_france != undefined ? parseFloat(Q.disp_fr_r_france.toFixed(1)) : 0);

!}
on-display: {!
data = [{
    "id": "pcf",
    "legend": "CB",
    "name": "CB",
    "seats": Math.round(Q.pcf_r_france * 6.5),
}];

if (Q.pup_r_france) {
    data.push({
        "id": "pup",
        "legend": "LV",
        "name": "LV",
        "seats": Math.round(Q.pup_r_france * 6.5),
    });
}

data = data.concat([{
    "id": "sfio",
    "legend": "CL",
    "name": "CL",
    "seats": Math.round(Q.sfio_r_france * 6.5),
}]);

if (Q.prs_r_france) {
    data.push({
        "id": "prs",
        "legend": "RP",
        "name": "RP",
        "seats": Math.round(Q.prs_r_france * 6.5),
    });
}

if (Q.rad_r_france) {
    data.push({
        "id": "rad",
        "legend": "RH",
        "name": "RH",
        "seats": Math.round(Q.disp_rad_r_france * 6.5),
    });
    data.push({
        "id": "rad2",
        "legend": "FL",
        "name": "FL",
        "seats": Math.round(Q.disp_ind_rad_r_france * 6.5),
    });
}

if (Q.ad_r_france) {
    data.push({
        "id": "ad",
        "legend": "CA",
        "name": "CA",
        "seats": Math.round(Q.ad_r_france * 6.5),
    });
}

if (Q.pdp_r_france) {
    data.push({
        "id": "pdp",
        "legend": "TB",
        "name": "TB",
        "seats": Math.round(Q.pdp_r_france * 6.5),
    });
}

if (Q.fr_r_france) {
    data.push({
        "id": "fr",
        "legend": "IF",
        "name": "IF",
        "seats": Math.round(Q.disp_fr_r_france * 6.5),
    });
    data.push({
        "id": "fr2",
        "legend": "LH",
        "name": "LH",
        "seats": Math.round(Q.disp_ind_fr_r_france * 6.5),
    });
}

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("france_chamber").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#france_chamber").datum(data).call(parliament);
}
!}
go-to: france_coalition_menu


**The Ducal Council's composition:**

{!<svg id="france_chamber" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Faction</td><td>Vote share</td><td>% Change</td><td>Council Seats</td><td>% Change</td></tr>!}

<tr><td colspan="5" style="text-align: center;"><strong>The Reform Cartel</strong></td></tr>

{!<tr><td><div class="box" style='background-color:#ff0000; outline: 2px; outline-style: solid;'> </div> !} <span class="tooltip-text" title="the Commons League">CL</span> {!</td><td>!} **[+ sfio_france_elections_vote +]%** {!</td><td>!} **[+ str_votes_change_sfio_france +]** {!</td><td>!} **[+ sfio_r_france +]%** {!</td><td>!} **[+ str_change_sfio_france +]** {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#FF6699'> </div> !} <span class="tooltip-text" title="the Reform Pact">RP</span>: {!</td><td>!} [+ prs_france_elections_vote +]% {!</td><td>!} [+ str_votes_change_prs_france +] {!</td><td>!} [+ prs_r_france +]% {!</td><td>!} [+ str_change_prs_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#E0B0FF'> </div> !} <span class="tooltip-text" title="the Radical Houses">RH</span>: {!</td><td>!} [+ disp_rad_votes_france +]% {!</td><td>!} [+ str_votes_change_rad_france +] {!</td><td>!} [+ disp_rad_r_france +]% {!</td><td>!} [+ str_change_rad_france +] {!</td></tr>!}

<tr><td colspan="5" style="text-align: center;"><strong>The Ducal Establishment</strong></td></tr>

{!<tr><td><div class="box" style='background-color:#FFBF00'> </div> !} <span class="tooltip-text" title="the Crown Alliance">CA</span>: {!</td><td>!} [+ ad_france_elections_vote +]% {!</td><td>!} [+ str_votes_change_ad_france +] {!</td><td>!} [+ ad_r_france +]% {!</td><td>!} [+ str_change_ad_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#005ACA'> </div> !} <span class="tooltip-text" title="the Imperial Federation">IF</span>: {!</td><td>!} [+ disp_fr_votes_france +]% {!</td><td>!} [+ str_votes_change_fr_france +] {!</td><td>!} [+ disp_fr_r_france +]% {!</td><td>!} [+ str_change_fr_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#aa4fff'> </div> !} <span class="tooltip-text" title="the Free Lords">FL</span>: {!</td><td>!} [+ disp_ind_rad_votes_france +]% {!</td><td>!} [+ str_votes_change_rad2_france +] {!</td><td>!} [+ disp_ind_rad_r_france +]% {!</td><td>!} [+ str_change_rad2_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#00CCCC'> </div> !} <span class="tooltip-text" title="the Temple Bloc">TB</span>: {!</td><td>!} [+ pdp_france_elections_vote +]% {!</td><td>!} [+ str_votes_change_ad_france +] {!</td><td>!} [+ pdp_r_france +]% {!</td><td>!} [+ str_change_pdp_france +] {!</td></tr>!}
 
{!<tr><td><div class="box" style='background-color:#ADC1FD'> </div> !} <span class="tooltip-text" title="the Lesser Houses">LH</span>: {!</td><td>!} [+ disp_ind_fr_votes_france +]% {!</td><td>!} [+ str_votes_change_fr2_france +] {!</td><td>!} [+ disp_ind_fr_r_france +]% {!</td><td>!} [+ str_change_fr2_france +] {!</td></tr>!}

<tr><td colspan="5" style="text-align: center;"><strong>The Levelling Blocs</strong></td></tr>

{!<tr><td><div class="box" style='background-color:#700000'> </div> !}<span class="tooltip-text" title="the Collectivist Bloc">CB</span>: {!</td><td>!} [+ pcf_france_elections_vote +]% {!</td><td>!} [+ str_votes_change_pcf_france +] {!</td><td>!} [+ pcf_r_france +]% {!</td><td>!} [+ str_change_pcf_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#B22222'> </div> !}<span class="tooltip-text" title="the Levellers">LV</span>: {!</td><td>!} [+ pup_france_elections_vote +]% {!</td><td>!} [+ str_votes_change_pup_france +] {!</td><td>!} [+ pup_r_france +]% {!</td><td>!} [+ str_change_pup_france +] {!</td></tr>!}

{!</table>!}
<hr id="read-marker">
United Front (<span style="color: #700000;" class="tooltip-text" title="the Collectivist Bloc">**CB**</span> + <span style="color: #B22222;" class="tooltip-text" title="the Levellers">**LV**</span> + <span style="color: #F0001C;" class="tooltip-text" title="the Commons League">**CL**</span> + <span style="color: #FF6699;" class="tooltip-text" title="the Reform Pact">**RP**</span>): [+ pop_front_france +]% 

Reform Cartel (<span style="color: #F0001C;" class="tooltip-text" title="the Commons League">**CL**</span> + <span style="color: #FF6699;" class="tooltip-text" title="the Reform Pact">**RP**</span> + <span style="color: #E0B0FF;" class="tooltip-text" title="the Radical Houses">**RH**</span>): [+ left_coalition_france +]% 

Ducal Bloc (<span style="color: #aa4fff;" class="tooltip-text" title="the Free Lords">**FL**</span> + <span style="color: #00CCCC;" class="tooltip-text" title="the Temple Bloc">**TB**</span> + <span style="color: #FFBF00;" class="tooltip-text" title="the Crown Alliance">**CA**</span> + <span style="color: #005ACA;" class="tooltip-text" title="the Imperial Federation">**IF**</span>): [+ bourgeois_coalition_france +]% 

Centrist Concentration (<span style="color: #FF6699;" class="tooltip-text" title="the Reform Pact">**RP**</span> + <span style="color: #E0B0FF;" class="tooltip-text" title="the Radical Houses">**RH**</span> + <span style="color: #aa4fff;" class="tooltip-text" title="the Free Lords">**FL**</span> + <span style="color: #FFBF00;" class="tooltip-text" title="the Crown Alliance">**CA**</span>): [+ republican_coalition_france +]%

@france_coalition_menu

<hr id="read-marker">
<span style="color: #002654;">Ethia</span>'s Ducal Council is famously fractious, its blocs forever shifting and its sovereigns short-lived. For four years the realm has been steered by the houses to the right of the <span style="color: #F0001C;">**CL**</span>, our <span style="color: #c00000;">Reformist</span> comrades. Now, with the Reform Cartel resurgent, the crown may yet pass to a friend of reform. However, wary of the Commons League's levelling designs, the <span style="color: #FF6699;">**RP**</span> and <span style="color: #E0B0FF;">**RH**</span> may instead throw in with the <span style="color: #FFBF00;">**CA**</span> and raise a steadier hand.

- @pop_front_france
- @left_cartel_france
- @center_right_france
- @right_wing_france

@pop_front_france
title: The <span style="color: #c00000;">**CL**</span> sets aside the <span style="color: #E0B0FF;">**RH**</span> and the <span style="color: #700000;">**CB**</span> raises Quintis Ticinius to the throne!
subtitle: This should not be possible.
unavailable-subtitle: <span style="color: #700000;">CB</span> + <span style="color: #B22222;">LV</span> + <span style="color: #F0001C;">CL</span> + <span style="color: #FF6699;">RP</span> ([+ pop_front_france +]%)
choose-if: pop_front_france >= 50
on-arrival: dataminer_detected = 1

It is done.

@center_right_france
title: The <span style="color: #FF6699;">**RP**</span> and <span style="color: #E0B0FF;">**RH**</span> throw in with the <span style="color: #FFBF00;">**CA**</span> to elevate Martyn Validar II.
subtitle: The economically right-leaning <span style="color: #E0B0FF;">**RH**</span> and <span style="color: #aa4fff;">**FL**</span> are wary of the <span style="color: #F0001C;">**CL**</span>'s levelling designs.
unavailable-subtitle: The <span style="color: #E0B0FF;">**RH**</span> would rather back their reformist allies.
choose-if: left_coalition_france < republican_coalition_france
on-arrival: west_relation += 2; reparations_negotiation += 1; ethian_friendly = 1
set-bg: img/map_2.jpg

While not the best outcome, the elevation of Martyn Validar II of the <span style="color: #E0B0FF;">Radical Houses</span> is welcome news for our relations with <span style="color: #002654;">Ethia</span>. Closer to the Empire-in-Exile than we would like, he nonetheless remains far more willing to cancel the Commonwealth's War Loans than the previous sovereign.

@left_cartel_france
title: The <span style="color: #FFC0C0;">Reform Cartel</span> shall elevate Edwyn Validar II.
subtitle: The strong showing of the <span style="color: #F0001C;">**CL**</span> and <span style="color: #FF6699;">**RP**</span> has pressured the <span style="color: #E0B0FF;">**RH**</span> to back their reformist allies.
unavailable-subtitle: The <span style="color: #E0B0FF;">**RH**</span> would rather pursue an agreement with the <span style="color: #FFBF00;">**CA**</span>.
choose-if: left_coalition_france >= republican_coalition_france
on-arrival: west_relation += 3; reparations_negotiation += 2; eu_progress += 1; left_cartel_france = 1; ethian_friendly = 1
achievement: vive_le_cartel
set-bg: img/map_2.jpg

Surprisingly, the <span style="color: #E0B0FF;">**RH**</span> have thrown their weight behind the <span style="color: #F0001C;">**CL**</span>, despite their misgivings over economic matters. Edwyn Validar II, a known friend of the Commonwealth, is raised to the Ethian throne.

This is excellent news for our relations with <span style="color: #002654;">Ethia</span>, as he and our <span style="color: #F0001C;">Reformist</span> comrades are far more willing to cancel the Commonwealth's War Loans than the previous sovereign. There is even talk of a <span style="color: #FFDD00;">Regional</span> <span style="color: #001489;">Concordant</span> taking shape under his new reform-minded court.

@right_wing_france
title: The <span style="color: #005ACA;">Ducal Bloc</span> somehow raises Servius Validar to the throne, without the <span style="color: #E0B0FF;">**RH**</span>.
subtitle: This should not be possible.
unavailable-subtitle: <span style="color: #aa4fff;">**FL**</span> + <span style="color: #00CCCC;">**TB**</span> + <span style="color: #FFBF00;">**CA**</span> + <span style="color: #005ACA;">**IF**</span> ([+ bourgeois_coalition_france +]%)
choose-if: bourgeois_coalition_france >= 50
on-arrival: dataminer_detected = 1

ok.