[? if secondary_reactionary_candidate_1932: [? if dufour_run: <span style="color: #808080;">**[+ secondary_reactionary_candidate_1932_disp +]**</span>?][? if (secondary_reactionary_candidate_1932 == "Lytton" or secondary_reactionary_candidate_1932 == "Gesling" or secondary_reactionary_candidate_1932 == "Jarrow") and lvp_formed: <span style="color: #FFCC00;">**[+ secondary_reactionary_candidate_1932_disp +]**</span>?][? if (secondary_reactionary_candidate_1932 == "Lytton" or secondary_reactionary_candidate_1932 == "Jarrow") and not lvp_formed: <span style="color: #C0A054;">**[+ secondary_reactionary_candidate_1932_disp +]**</span>?][? if secondary_reactionary_candidate_1932 == "Gesling" and not lvp_formed: <span style="color: #D3C24D;">**[+ secondary_reactionary_candidate_1932_disp +]**</span>?][? if (secondary_reactionary_candidate_1932 == "Lethmoor" or secondary_reactionary_candidate_1932 == "Westmore") and not kvp_formed: <span style="color: #3E88B3;">**[+ secondary_reactionary_candidate_1932_disp +]**</span>?][? if ((secondary_reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or secondary_reactionary_candidate_1932 == "Westmore") and kvp_formed: <span style="color: #0087DC;">**[+ secondary_reactionary_candidate_1932_disp +]**</span>?][? if secondary_reactionary_candidate_1932 == "Aldermoor" or secondary_reactionary_candidate_1932 == "Askew" or secondary_reactionary_candidate_1932 == "Sedgewick": <span style="color: #000000;">**[+ secondary_reactionary_candidate_1932_disp +]**</span>?]  - supported by: ?]

