title: High Cross state Assembly Election
subtitle: 
view-if: rubicon and chancellor == "Staal" and year == 1933 and month == 1 and week == 3
new-page: true
tags: event
on-arrival: lippe_election_seen = 1
max-visits: 1
priority: 3
on-display: {!  
    var cardEl = document.createElement('div');  
    cardEl.className = "face-figure2";  

    var image = new Image();  
    image.className = "face-img";  
    image.src = "img/states.png";  

    cardEl.appendChild(image);  
    var contentDiv = document.querySelector("#page #mid_panel #content");
    contentDiv.appendChild(cardEl);
!}

= Elections, [+ month : month +] [+ year_display +]

The state elections for the Free State of High Cross are to take place.

- @lippe: May we do our best...

@lippe
on-arrival: {!

var lippe_adjustment_factors = {
    spd: 1.5,
    sapd: 0.4,
    kpd: 0.65,
    ddp: 1.0,
    lvp: 1.2,
    z: 0.17,
    dvp: 2.1,
    dnvp: 0.8,
    nsdap: 1.2,
    other: 1.5,
    kvp: 1.2,
    dnf: 0.6
};

Q.marcher_r_lippe = 0;
Q.sapd_r_lippe = 0;
Q.collectivist_r_lippe = 0;
Q.ddp_r_lippe = 0;
Q.lvp_r_lippe = 0;
Q.unionist_r_lippe = 0;
Q.gold_r_lippe = 0;
Q.traditionalist_r_lippe = 0;
Q.royalist_r_lippe = 0;
Q.other_r_lippe = 0;
Q.kvp_r_lippe = 0;
Q.dnf_r_lippe = 0;

Q.marcher_lippe_elections_vote = 0;
Q.sapd_lippe_elections_vote = 0;
Q.collectivist_lippe_elections_vote = 0;
Q.ddp_lippe_elections_vote = 0;
Q.lvp_lippe_elections_vote = 0;
Q.unionist_lippe_elections_vote = 0;
Q.gold_lippe_elections_vote = 0;
Q.traditionalist_lippe_elections_vote = 0;
Q.royalist_lippe_elections_vote = 0;
Q.other_lippe_elections_vote = 0;
Q.kvp_lippe_elections_vote = 0;
Q.dnf_lippe_elections_vote = 0;

if (Q.burgher_marcher_normalized + Q.guild_marcher_normalized >= 30) lippe_adjustment_factors.spd += 0.05;
if (Q.landed_marcher_normalized >= 20) lippe_adjustment_factors.spd += 0.15;
if (Q.marcher_lippe) lippe_adjustment_factors.spd *= Q.marcher_lippe;
Q.marcher_lippe_elections_vote = Q.marcher_votes*lippe_adjustment_factors.spd;
Q.sapd_lippe_elections_vote = Q.sapd_votes*lippe_adjustment_factors.sapd;
Q.collectivist_lippe_elections_vote = Q.collectivist_votes*lippe_adjustment_factors.kpd;
Q.ddp_lippe_elections_vote = Q.ddp_votes*lippe_adjustment_factors.ddp;
Q.lvp_lippe_elections_vote = Q.lvp_votes*lippe_adjustment_factors.lvp;
if (!Q.stegerwald_path) Q.unionist_lippe_elections_vote = Q.unionist_votes*lippe_adjustment_factors.z;
if (Q.stegerwald_path) Q.unionist_lippe_elections_vote = Q.unionist_votes * 0.8;
if (Q.gold_leader != "Coalfax") lippe_adjustment_factors.dvp += 0.1;
if (Q.gold_votes >= 3) lippe_adjustment_factors.dvp -= 0.2;
if (Q.gold_votes >= 4) lippe_adjustment_factors.dvp -= 0.2;
if (Q.gold_votes >= 5) lippe_adjustment_factors.dvp -= 0.2;
Q.gold_lippe_elections_vote = Q.gold_votes*lippe_adjustment_factors.dvp;
if (Q.traditionalist_ideology == "Moderate") lippe_adjustment_factors.dnvp += 0.4;
Q.traditionalist_lippe_elections_vote = Q.traditionalist_votes*lippe_adjustment_factors.dnvp;
if (Q.royalist_lippe) lippe_adjustment_factors.nsdap *= Q.royalist_lippe;
Q.royalist_lippe_elections_vote = Q.royalist_votes*lippe_adjustment_factors.nsdap;
if (Q.traditionalist_ideology == "Moderate") lippe_adjustment_factors.other -= 1.0;
if (Q.kvp_formed) lippe_adjustment_factors.other -= 0.6;
Q.other_lippe_elections_vote = Q.other_votes*lippe_adjustment_factors.other;
Q.kvp_lippe_elections_vote = Q.kvp_votes*lippe_adjustment_factors.kvp;
Q.dnf_lippe_elections_vote = Q.dnf_votes*lippe_adjustment_factors.dnf;

Q.total_votes_lippe = Q.marcher_lippe_elections_vote + Q.sapd_lippe_elections_vote + Q.collectivist_lippe_elections_vote + Q.ddp_lippe_elections_vote + Q.lvp_lippe_elections_vote + Q.unionist_lippe_elections_vote + Q.gold_lippe_elections_vote + Q.traditionalist_lippe_elections_vote + Q.royalist_lippe_elections_vote + Q.other_lippe_elections_vote + Q.kvp_lippe_elections_vote + Q.dnf_lippe_elections_vote;

if (Q.total_votes_lippe > 0) {
    Q.marcher_lippe_elections_vote = (Q.marcher_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.sapd_lippe_elections_vote = (Q.sapd_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.collectivist_lippe_elections_vote = (Q.collectivist_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.ddp_lippe_elections_vote = (Q.ddp_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.lvp_lippe_elections_vote = (Q.lvp_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.unionist_lippe_elections_vote = (Q.unionist_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.gold_lippe_elections_vote = (Q.gold_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.traditionalist_lippe_elections_vote = (Q.traditionalist_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.royalist_lippe_elections_vote = (Q.royalist_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.other_lippe_elections_vote = (Q.other_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.kvp_lippe_elections_vote = (Q.kvp_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.dnf_lippe_elections_vote = (Q.dnf_lippe_elections_vote / Q.total_votes_lippe) * 100;
    let target = 30;
    Q.marcher_lippe_elections_vote = Math.round((Q.marcher_lippe_elections_vote + (target - Q.marcher_lippe_elections_vote) * 0.2) * 10) / 10;
    let target_2 = 39.5;
    Q.royalist_lippe_elections_vote = Math.round((Q.royalist_lippe_elections_vote + (target_2 - Q.royalist_lippe_elections_vote) * 0.2) * 10) / 10;
    Q.total_votes_lippe = Q.marcher_lippe_elections_vote + Q.sapd_lippe_elections_vote + Q.collectivist_lippe_elections_vote + Q.ddp_lippe_elections_vote + Q.lvp_lippe_elections_vote + Q.unionist_lippe_elections_vote + Q.gold_lippe_elections_vote + Q.traditionalist_lippe_elections_vote + Q.royalist_lippe_elections_vote + Q.other_lippe_elections_vote + Q.kvp_lippe_elections_vote + Q.dnf_lippe_elections_vote;
    Q.marcher_lippe_elections_vote = (Q.marcher_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.sapd_lippe_elections_vote = (Q.sapd_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.collectivist_lippe_elections_vote = (Q.collectivist_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.ddp_lippe_elections_vote = (Q.ddp_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.lvp_lippe_elections_vote = (Q.lvp_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.unionist_lippe_elections_vote = (Q.unionist_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.gold_lippe_elections_vote = (Q.gold_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.traditionalist_lippe_elections_vote = (Q.traditionalist_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.royalist_lippe_elections_vote = (Q.royalist_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.other_lippe_elections_vote = (Q.other_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.kvp_lippe_elections_vote = (Q.kvp_lippe_elections_vote / Q.total_votes_lippe) * 100;
    Q.dnf_lippe_elections_vote = (Q.dnf_lippe_elections_vote / Q.total_votes_lippe) * 100;
}

Q.marcher_lippe_elections_vote = (Q.marcher_lippe_elections_vote != undefined ? parseFloat(Q.marcher_lippe_elections_vote.toFixed(1)) : 0);
Q.sapd_lippe_elections_vote = (Q.sapd_lippe_elections_vote != undefined ? parseFloat(Q.sapd_lippe_elections_vote.toFixed(1)) : 0);
Q.collectivist_lippe_elections_vote = (Q.collectivist_lippe_elections_vote != undefined ? parseFloat(Q.collectivist_lippe_elections_vote.toFixed(1)) : 0);
Q.ddp_lippe_elections_vote = (Q.ddp_lippe_elections_vote != undefined ? parseFloat(Q.ddp_lippe_elections_vote.toFixed(1)) : 0);
Q.lvp_lippe_elections_vote = (Q.lvp_lippe_elections_vote != undefined ? parseFloat(Q.lvp_lippe_elections_vote.toFixed(1)) : 0);
Q.unionist_lippe_elections_vote = (Q.unionist_lippe_elections_vote != undefined ? parseFloat(Q.unionist_lippe_elections_vote.toFixed(1)) : 0);
Q.gold_lippe_elections_vote = (Q.gold_lippe_elections_vote != undefined ? parseFloat(Q.gold_lippe_elections_vote.toFixed(1)) : 0);
Q.traditionalist_lippe_elections_vote = (Q.traditionalist_lippe_elections_vote != undefined ? parseFloat(Q.traditionalist_lippe_elections_vote.toFixed(1)) : 0);
Q.royalist_lippe_elections_vote = (Q.royalist_lippe_elections_vote != undefined ? parseFloat(Q.royalist_lippe_elections_vote.toFixed(1)) : 0);
Q.other_lippe_elections_vote = (Q.other_lippe_elections_vote != undefined ? parseFloat(Q.other_lippe_elections_vote.toFixed(1)) : 0);
Q.kvp_lippe_elections_vote = (Q.kvp_lippe_elections_vote != undefined ? parseFloat(Q.kvp_lippe_elections_vote.toFixed(1)) : 0);
Q.dnf_lippe_elections_vote = (Q.dnf_lippe_elections_vote != undefined ? parseFloat(Q.dnf_lippe_elections_vote.toFixed(1)) : 0);

if (Q.marcher_lippe_elections_vote >= 3.2) Q.marcher_r_lippe = Q.marcher_lippe_elections_vote;
if (Q.sapd_lippe_elections_vote >= 3.2) Q.sapd_r_lippe = Q.sapd_lippe_elections_vote;
if (Q.collectivist_lippe_elections_vote >= 3.2) Q.collectivist_r_lippe = Q.collectivist_lippe_elections_vote;
if (Q.ddp_lippe_elections_vote >= 3.2) Q.ddp_r_lippe = Q.ddp_lippe_elections_vote;
if (Q.lvp_lippe_elections_vote >= 3.2) Q.lvp_r_lippe = Q.lvp_lippe_elections_vote;
if (Q.unionist_lippe_elections_vote >= 3.2) Q.unionist_r_lippe = Q.unionist_lippe_elections_vote;
if (Q.gold_lippe_elections_vote >= 3.2) Q.gold_r_lippe = Q.gold_lippe_elections_vote;
if (Q.traditionalist_lippe_elections_vote >= 3.2) Q.traditionalist_r_lippe = Q.traditionalist_lippe_elections_vote;
if (Q.royalist_lippe_elections_vote >= 3.2) Q.royalist_r_lippe = Q.royalist_lippe_elections_vote;
if (Q.other_lippe_elections_vote >= 3.2) Q.other_r_lippe = Q.other_lippe_elections_vote;
if (Q.kvp_lippe_elections_vote >= 3.2) Q.kvp_r_lippe = Q.kvp_lippe_elections_vote;
if (Q.dnf_lippe_elections_vote >= 3.2) Q.dnf_r_lippe = Q.dnf_lippe_elections_vote;

var lippe_adjustment_r_factors = {
    spd: 1.05,
    sapd: 1.0,
    kpd: 0.85,
    ddp: 1.0,
    lvp: 1.0,
    z: 1.0,
    dvp: 1.05,
    dnvp: 0.75,
    nsdap: 1.05,
    other: 1.0,
    kvp: 1.0,
    dnf: 1.0
};

Q.marcher_r_lippe = Q.marcher_r_lippe*lippe_adjustment_r_factors.spd;
Q.sapd_r_lippe = Q.sapd_r_lippe*lippe_adjustment_r_factors.sapd;
Q.collectivist_r_lippe = Q.collectivist_r_lippe*lippe_adjustment_r_factors.kpd;
Q.ddp_r_lippe = Q.ddp_r_lippe*lippe_adjustment_r_factors.ddp;
Q.lvp_r_lippe = Q.lvp_r_lippe*lippe_adjustment_r_factors.lvp;
if (!Q.stegerwald_path) Q.unionist_r_lippe = Q.unionist_r_lippe*lippe_adjustment_r_factors.z;
if (Q.stegerwald_path) Q.unionist_r_lippe = Q.unionist_r_lippe;
Q.gold_r_lippe = Q.gold_r_lippe*lippe_adjustment_r_factors.dvp;
Q.traditionalist_r_lippe = Q.traditionalist_r_lippe*lippe_adjustment_r_factors.dnvp;
Q.royalist_r_lippe = Q.royalist_r_lippe*lippe_adjustment_r_factors.nsdap;
if (Q.traditionalist_ideology == "Moderate") lippe_adjustment_r_factors.other -= 0.5;
Q.other_r_lippe = Q.other_r_lippe*lippe_adjustment_r_factors.other;
Q.kvp_r_lippe = Q.kvp_r_lippe*lippe_adjustment_r_factors.kvp;
Q.dnf_r_lippe = Q.dnf_r_lippe*lippe_adjustment_r_factors.dnf;

Q.total_r_lippe = 0;

if (Q.marcher_r_lippe) Q.total_r_lippe += Q.marcher_r_lippe;
if (Q.sapd_r_lippe) Q.total_r_lippe += Q.sapd_r_lippe;
if (Q.collectivist_r_lippe) Q.total_r_lippe += Q.collectivist_r_lippe;
if (Q.ddp_r_lippe) Q.total_r_lippe += Q.ddp_r_lippe;
if (Q.lvp_r_lippe) Q.total_r_lippe += Q.lvp_r_lippe;
if (Q.unionist_r_lippe) Q.total_r_lippe += Q.unionist_r_lippe;
if (Q.gold_r_lippe) Q.total_r_lippe += Q.gold_r_lippe;
if (Q.traditionalist_r_lippe) Q.total_r_lippe += Q.traditionalist_r_lippe;
if (Q.royalist_r_lippe) Q.total_r_lippe += Q.royalist_r_lippe;
if (Q.other_r_lippe) Q.total_r_lippe += Q.other_r_lippe;
if (Q.kvp_r_lippe) Q.total_r_lippe += Q.kvp_r_lippe;
if (Q.dnf_r_lippe) Q.total_r_lippe += Q.dnf_r_lippe;

if (Q.total_r_lippe > 0) {
    Q.marcher_r_lippe = (Q.marcher_r_lippe / Q.total_r_lippe) * 100;
    Q.sapd_r_lippe = (Q.sapd_r_lippe / Q.total_r_lippe) * 100;
    Q.collectivist_r_lippe = (Q.collectivist_r_lippe / Q.total_r_lippe) * 100;
    Q.ddp_r_lippe = (Q.ddp_r_lippe / Q.total_r_lippe) * 100;
    Q.lvp_r_lippe = (Q.lvp_r_lippe / Q.total_r_lippe) * 100;
    Q.unionist_r_lippe = (Q.unionist_r_lippe / Q.total_r_lippe) * 100;
    Q.gold_r_lippe = (Q.gold_r_lippe / Q.total_r_lippe) * 100;
    Q.traditionalist_r_lippe = (Q.traditionalist_r_lippe / Q.total_r_lippe) * 100;
    Q.royalist_r_lippe = (Q.royalist_r_lippe / Q.total_r_lippe) * 100;
    Q.other_r_lippe = (Q.other_r_lippe / Q.total_r_lippe) * 100;
    Q.kvp_r_lippe = (Q.kvp_r_lippe / Q.total_r_lippe) * 100;
    Q.dnf_r_lippe = (Q.dnf_r_lippe / Q.total_r_lippe) * 100;
}

Q.farm_r_lippe = 0;
Q.csvd_r_lippe = 0;
Q.wp_r_lippe = 0;

let farm_share = 0.13;
if (Q.landed_other_normalized) farm_share += (Q.landed_other_normalized / 50);
let csvd_share = 0.87;
if (!Q.csvd_formed) csvd_share = 0;
let wp_share = 0.0;
if (Q.burgher_other_normalized + Q.guild_other_normalized >= 15 && Q.other_votes >= 4) wp_share = 0.2;

let total_share = csvd_share + farm_share + wp_share;

farm_share = (farm_share / total_share);
csvd_share = (csvd_share / total_share);
wp_share = (wp_share / total_share);

Q.farm_lippe_elections_vote = Q.other_lippe_elections_vote*farm_share;
Q.farm_r_lippe = Q.other_r_lippe*farm_share;

Q.csvd_lippe_elections_vote = Q.other_lippe_elections_vote*csvd_share;
Q.csvd_r_lippe = Q.other_r_lippe*csvd_share;

Q.wp_lippe_elections_vote = Q.other_lippe_elections_vote*wp_share;
Q.wp_r_lippe = Q.wp_r_lippe*wp_share;

Q.farm_lippe_elections_vote = (Q.farm_lippe_elections_vote != undefined ? parseFloat(Q.farm_lippe_elections_vote.toFixed(1)) : 0);
Q.csvd_lippe_elections_vote = (Q.csvd_lippe_elections_vote != undefined ? parseFloat(Q.csvd_lippe_elections_vote.toFixed(1)) : 0);
Q.wp_lippe_elections_vote = (Q.wp_lippe_elections_vote != undefined ? parseFloat(Q.wp_lippe_elections_vote.toFixed(1)) : 0);

Q.lippe_parties = [...Q.parties];
if (Q.csvd_formed) Q.lippe_parties.push('csvd');
if (Q.burgher_other_normalized + Q.guild_other_normalized >= 15 && Q.other_votes >= 4) Q.lippe_parties.push('wp');
Q.lippe_parties.push('farm');

function allocateSeats(percentages, totalSeats = 21) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_lippe: Q.marcher_r_lippe,
    sapd_r_lippe: Q.sapd_r_lippe,
    kpd_r_lippe: Q.collectivist_r_lippe,
    ddp_r_lippe: Q.ddp_r_lippe,
    lvp_r_lippe: Q.lvp_r_lippe,
    z_r_lippe: Q.unionist_r_lippe,
    dvp_r_lippe: Q.gold_r_lippe,
    dnvp_r_lippe: Q.traditionalist_r_lippe,
    nsdap_r_lippe: Q.royalist_r_lippe,
    wp_r_lippe: Q.wp_r_lippe,
    farm_r_lippe: Q.farm_r_lippe,
    csvd_r_lippe: Q.csvd_r_lippe,
    kvp_r_lippe: Q.kvp_r_lippe,
    dnf_r_lippe: Q.dnf_r_lippe
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 21).toFixed(1));
}

Q.other_r_lippe = Q.farm_r_lippe + Q.wp_r_lippe + Q.csvd_r_lippe;

Q.old_marcher_r_lippe = 42.8;
Q.old_collectivist_r_lippe = 4.8;
Q.old_unionist_r_lippe = 0.0;
Q.old_ddp_r_lippe = 4.8;
Q.old_gold_r_lippe = 14.3;
Q.old_traditionalist_r_lippe = 14.3;
Q.old_royalist_r_lippe = 4.8;
Q.old_wp_r_lippe = 4.8;
Q.old_farm_r_lippe = 4.8;
Q.old_other_r_lippe = 4.8;
Q.old_csvd_r_lippe = 0;
Q.old_lvp_r_lippe = 0.0;
Q.old_kvp_r_lippe = 0.0;
Q.old_dnf_r_lippe = 0.0;
Q.old_sapd_r_lippe = 0.0;

if (Q.lvp_formed) Q.old_lvp_r_lippe = Q.old_gold_r_lippe + Q.old_ddp_r_lippe;
if (Q.kvp_formed) {
    Q.old_traditionalist_r_lippe - 4.8;
    Q.old_kvp_r_lippe = 4.8;
}
if (Q.traditionalist_ideology == "Moderate") {
    Q.old_traditionalist_r_lippe - 4.8;
    Q.old_dnf_r_lippe = 4.8;
}

for (var party of Q.lippe_parties) {
    Q['change_' + party + '_r_lippe'] = Q[party + '_r_lippe'] - Q['old_' + party + '_r_lippe'];
    var sign = Q['change_' + party + '_r_lippe'] > 0 
               ? '<img src="img/arrowup.png"> ' 
               : Q['change_' + party + '_r_lippe'] < 0 
                 ? '<img src="img/arrowdown.png"> ' 
                 : '<img src="img/steady.png"> ';
    Q['change_' + party + '_r_lippe'] = Math.abs(Q['change_' + party + '_r_lippe']);
    Q['str_change_' + party + '_lippe'] = sign + parseFloat(Q['change_' + party + '_r_lippe']).toFixed(1);

    // Calculate changes in votes
    Q['change_' + party + '_votes_lippe'] = Q[party + '_lippe_elections_vote'] - Q['old_' + party + '_lippe_elections_vote'];
    if (Q['old_' + party + '_lippe_elections_vote'] === undefined) {
        Q['change_' + party + '_votes_lippe'] = Q[party + '_lippe_elections_vote'];
    }

    var sign2 = Q['change_' + party + '_votes_lippe'] > 0 
                ? '<img src="img/arrowup.png"> ' 
                : Q['change_' + party + '_votes_lippe'] < 0 
                  ? '<img src="img/arrowdown.png"> ' 
                  : '<img src="img/steady.png"> ';
    Q['str_votes_change_' + party + '_lippe'] = sign2 + Math.abs(Q['change_' + party + '_votes_lippe']).toFixed(1);
}   

Q.change_royalist_votes_lippe = (Q.change_royalist_votes_lippe != undefined ? parseFloat(Q.change_royalist_votes_lippe.toFixed(1)) : 0);

!}
on-display: {!
data = [{
    "id": "collectivist",
    "legend": "Collectivist",
    "name": "Collectivist",
    "seats": Math.round(Q.collectivist_r_lippe * 0.21),
}];

if (Q.sapd_formed && Q.sapd_r_lippe) {
    data.push({
        "id": "sapd",
        "legend": "SAPD",
        "name": "SAPD",
        "seats": Math.round(Q.sapd_r_lippe * 0.21),
    });
}

data = data.concat([{
    "id": "marcher",
    "legend": "Marcher",
    "name": "Marcher",
    "seats": Math.round(Q.marcher_r_lippe * 0.21),
}]);

if (Q.ddp_r_lippe && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r_lippe * 0.21),
    });
}

if (Q.lvp_r_lippe && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r_lippe * 0.21),
    });
}

if (Q.unionist_r_lippe) {
    data.push({
        "id": "unionist",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(Q.unionist_r_lippe * 0.21),
    });
}

if (Q.gold_r_lippe && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "gold",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r_lippe * 0.21),
    });
}

if (Q.other_r_lippe) {
    if (Q.farm_r_lippe) {
        data.push({
            id: "farm3",
            legend: "Farm",
            name: "Farm",
            seats: Math.round(Q.farm_r_lippe * 0.21),
        });
    }
    if (Q.csvd_r_lippe) {
        data.push({
            id: "csvd",
            legend: "CSVD",
            name: "CSVD",
            seats: Math.round(Q.csvd_r_lippe * 0.21),
        });
    }
    if (Q.wp_r_lippe) {
        data.push({
            id: "wp",
            legend: "WP",
            name: "WP",
            seats: Math.round(Q.wp_r_lippe * 0.21),
        });
    }
}
if (Q.kvp_formed && Q.kvp_r_lippe) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round(Q.kvp_r_lippe * 0.21),
    });
}

data = data.concat([{
    "id": "traditionalist",
    "legend": "Traditionalist",
    "name": "Traditionalist",
    "seats": Math.round(Q.traditionalist_r_lippe * 0.21),
}]);
if (Q.dnf_formed && Q.dnf_r_lippe) {
    data.push({
        "id": "dnf",
        "legend": "DNF",
        "name": "DNF",
        "seats": Math.round(Q.dnf_r_lippe * 0.21),
    });
}
data = data.concat([{
    "id": "royalist",
    "legend": "Royalist",
    "name": "Royalist",
    "seats": Math.round(Q.royalist_r_lippe * 0.21),
}, ]);

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("lippe_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#lippe_landtag").datum(data).call(parliament);
}
!}
