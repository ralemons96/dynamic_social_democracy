title: Hoover Moratorium
subtitle: Owing to the economic crisis, our debt payments have been paused...
new-page: true
view-if: banking_crisis_seen = 1 and ((year == 1931 and month >= 7) or (year == 1932)) and war_loans >= 0 and disfavored > 15
on-arrival: budget += 1; reparations_negotiation += 2; hoover_moratorium_seen = 1; burgher_gold += 3 if foreign_minister_party == "Gold"; guild_gold += 3 if foreign_minister_party == "Gold"; landed_gold += 3 if foreign_minister_party == "Gold"; commons_lvp += 3 if foreign_minister_party == "LVP"; burgher_lvp += 3 if foreign_minister_party == "LVP"; guild_lvp += 3 if foreign_minister_party == "LVP"; landed_lvp += 3 if foreign_minister_party == "LVP"; commons_unionist += 3 if foreign_minister_party == "Unionist"; burgher_unionist += 3 if foreign_minister_party == "Unionist"; guild_unionist += 3 if foreign_minister_party == "Unionist"; landed_unionist += 3 if foreign_minister_party == "Unionist"; commons_marcher += 3 if foreign_minister_party == "Marcher"; burgher_marcher += 3 if foreign_minister_party == "Marcher"; guild_marcher += 3 if foreign_minister_party == "Marcher"; landed_marcher += 3 if foreign_minister_party == "Marcher"; pro_republic += 3; economic_growth += 0.5; dufour_angry_bruning -= 20; bruning_coalition_dissent -= 1 if bruning_coalition_dissent >= 1;
