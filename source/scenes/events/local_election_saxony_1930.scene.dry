Q.true_bourgeois_coalition_saxony = parseFloat((Q.unionist_r_saxony + Q.ddp_r_saxony + Q.gold_r_saxony + Q.lvp_r_saxony + Q.kvp_r_saxony + Q.other_r_saxony - Q.farm_r_saxony).toFixed(1));
if (Q.traditionalist_ideology == "Moderate") Q.true_bourgeois_coalition_saxony = parseFloat((Q.unionist_r_saxony + Q.ddp_r_saxony + Q.gold_r_saxony + Q.lvp_r_saxony + Q.other_r_saxony + Q.traditionalist_r_saxony).toFixed(1));
Q.mega_bourgeois_coalition_saxony = parseFloat((Q.marcher_r_saxony + Q.aspd_r_saxony + Q.unionist_r_saxony + Q.ddp_r_saxony + Q.gold_r_saxony + Q.lvp_r_saxony + Q.kvp_r_saxony + Q.other_r_saxony - Q.farm_r_saxony).toFixed(1));
if (Q.traditionalist_ideology == "Moderate") Q.mega_bourgeois_coalition_saxony = parseFloat((Q.marcher_r_saxony + Q.aspd_r_saxony + Q.unionist_r_saxony + Q.ddp_r_saxony + Q.gold_r_saxony + Q.lvp_r_saxony + Q.other_r_saxony + Q.traditionalist_r_saxony).toFixed(1));
Q.far_right_coalition_saxony = parseFloat((Q.unionist_r_saxony + Q.gold_r_saxony + Q.lvp_r_saxony + Q.other_r_saxony + Q.traditionalist_r_saxony + Q.kvp_r_saxony + Q.dnf_r_saxony + Q.royalist_r_saxony - Q.vnr_r_saxony - Q.csvd_r_saxony).toFixed(1));
Q.marcher_coalition_saxony = parseFloat((Q.aspd_r_saxony + Q.marcher_r_saxony + Q.ddp_r_saxony + Q.lvp_r_saxony + Q.unionist_r_saxony + Q.gold_r_saxony).toFixed(1));

if (Q.vnr_r_saxony >= 1.4) Q.vnr_cool = 1;
