title: DuFour's Announcement
subtitle: The President is to announce whether or not he will run again.
new-page: true
on-arrival: {!
Q.the_decision_2010 = 1;
Q.dufour_run_points = 0;
if (Q.royalist_votes + Q.dnf_votes > Q.traditionalist_votes + Q.other_votes + Q.gold_votes + Q.unionist_votes + Q.ddp_votes + Q.lvp_votes && Q.traditionalist_ideology == "Moderate") {
    Q.dufour_run_points += 4;
} else if (Q.royalist_votes + Q.traditionalist_votes > Q.kvp_votes + Q.other_votes + Q.gold_votes + Q.unionist_votes + Q.ddp_votes + Q.lvp_votes && Q.traditionalist_ideology == "Radical") {
    Q.dufour_run_points += 4;
}
if (Q.traditionalist_ideology == "Radical") {
    Q.dufour_run_points += 1;
} else if (Q.traditionalist_ideology == "Moderate") {
    Q.dufour_run_points += 3;
}
if (Q.staal_marcher) Q.dufour_run_points += 8;
if (Q.bruning_toleration_time) Q.dufour_run_points += 3;
if (Q.in_center_right_coalition || Q.in_right_coalition) Q.dufour_run_points -= 1;
if (Q.marcher_votes >= 26) Q.dufour_run_points += 1;
if (Q.marcher_votes >= 29) Q.dufour_run_points += 1;
if (Q.marcher_votes >= 32) Q.dufour_run_points += 1;
if (Q.left_strength >= Q.reformist_strength) {
    Q.dufour_run_points += 1;
}
if (Q.marcher_votes + (Q.unionist_votes*0.8) + Q.ddp_votes + (Q.lvp_votes / 2) >= 50) Q.dufour_run_points += 2;
if (Q.collectivist_relation >= 40) Q.dufour_run_points += 1;
if (Q.capital_strike_progress >= 6) Q.dufour_run_points += 1;
if (Q.coup_progress >= 5) Q.dufour_run_points += 1;
if (Q.pro_republic >= 70) Q.dufour_run_points -= 1;
if (Q.disfavored < 15) Q.dufour_run_points -= 1;
if (Q.disfavored >= 30) Q.dufour_run_points += 1;
if (Q.rubicon_mini) Q.dufour_run_points = 8;
if (Q.dufour_run_points >= 7) Q.dufour_run = 1;

Q.dufour_signatures = Math.round(Q.dufour_run_points * 0.445 * 100) / 100;
!}
on-display: {!  
    var cardEl = document.createElement('div');  
