@spd_win
title: The government is paralyzed!
on-arrival: {!
Q.staal_marcher_influence = 0;
Q.staal_marcher_r = 0;
Q.staal_marcher_support = 0;
Q.staal_approval -= 4;
Q.republicans_staal_bonus -= 4;
Q.commons_staal_bonus -= 6;
Q.industrialists_staal_bonus -= 2;
Q.nationalists_staal_bonus -= 2;

Q.dufour_staal_r -= 2;
Q.staal_strength -= 2;
Q.papen_strength += 1;

