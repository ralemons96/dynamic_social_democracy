title: Presidential Election
subtitle: [? if dufour_run: DuFour runs for re-election... ?][? if not dufour_run: The first round results have come in... ?]
view-if: year = 1932 and month == 3 and presidential_election_seen = 0 and not dufour_term_extended
frequency: 1000
max-visits: 1
new-page: true
on-arrival: {!
Q.gallax_support_dufour = 0;
Q.presidential_election_seen = 1;
if (Q.royalist_candidate_1932) {
    Q.royalist_funds -= 1;
}
!}
tags: event
priority: 2
go-to: election_algorithm
set-jump: pres_election
face-image: img/hindenburg_hitler.jpg

@pres_election

The presidential election's first round is set to take place this month. If no candidate secures a majority, a second round will be held, with the candidate receiving the most votes winning the presidency.

- @final_election: The first round results...

@final_election
on-arrival: election_round = 0
go-to: election_algorithm
set-jump: post_election


@post_election
on-arrival: {!
Q.bvp_votes = Q.bvp_votes / 100;

Q.marcher_president_votes = 0;
Q.dufour_votes = 0;
Q.reactionary_candidate_1_votes = 0;
Q.reactionary_candidate_2_votes = 0;
Q.reactionary_votes = 0;
Q.royalist_presidential_votes = 0;
Q.thalmann_votes = 0;
Q.traditionalist_presidential_votes = 0;
Q.vrp_presidential_votes = 0;

// initial phase:
Q.royalist_presidential_votes += Q.royalist_normalized;

Q.dufour_votes += Q.other_normalized / 2;
if (Q.kvp_formed) Q.dufour_votes += Q.kvp_normalized;
Q.dufour_votes += (Q.traditionalist_normalized*0.2);
if (!Q.dufour_run) {
    let parties = ['unionist', 'ddp', 'gold', 'other'];

    if (Q.kvp_formed) {
        parties.push('kvp');
    }
    if (Q.traditionalist_ideology == "Moderate") {
        parties.push('traditionalist');
    }
    if (Q.lvp_formed) {
        parties.push('lvp');
    }

    Q.reactionary_candidate_1_votes = 0;
    Q.reactionary_candidate_2_votes = 0;

for (const party of parties) {
        const choice = Q[`${party}_choice`];
        const support = Q[`${party}_normalized`];
        Q['choice_pre_'+party] = choice;

        if (choice === Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1_votes += support;
        } else if (choice === Q.secondary_reactionary_candidate_1932) {
            Q.reactionary_candidate_2_votes += support;
        }
    }
}
if (Q.traditionalist_candidate_1932 == "Dusterel") {
    Q.traditionalist_presidential_votes += (Q.traditionalist_normalized*0.8);
    Q.traditionalist_presidential_votes += Q.other_normalized / 2;
} else if (Q.traditionalist_candidate_1932 == "Mallin") {
    if (Q.traditionalist_ideology == "Radical") {
        Q.traditionalist_presidential_votes += (Q.traditionalist_normalized*0.7);
        Q.traditionalist_presidential_votes += Q.other_normalized / 4;
        Q.dufour_votes += Q.other_normalized / 4;
    } else {
        Q.traditionalist_presidential_votes += Q.dnf_normalized;
    }
} else {
    Q.dufour_votes += (Q.traditionalist_normalized*0.8);
}

Q.ddp_president_crossover = 0;
Q.gold_president_crossover = 0; 
Q.lvp_president_crossover = 0;
Q.center_president_crossover = 0;

if (Q.marcher_campaign) {
    Q.marcher_president_votes += Q.marcher_normalized;
    if (Q.rosenfeld_campaign) {
        if (!Q.media_rosenfeld_seen) {
            Q.marcher_president_votes -= (Q.burgher_marcher_normalized / 2000);
            Q.marcher_president_votes -= (Q.guild_marcher_normalized / 1500);
        } else if (Q.media_rosenfeld_seen) {
            Q.marcher_president_votes -= (Q.burgher_marcher_normalized / 2500);
            Q.marcher_president_votes -= (Q.guild_marcher_normalized / 2500);
        }
        if (!Q.party_rosenfeld_seen) {
            Q.marcher_president_votes -= (Q.burgher_marcher_normalized / 2000);
            Q.marcher_president_votes -= (Q.guild_marcher_normalized / 2000);
            Q.marcher_president_votes -= (Q.landed_marcher_normalized / 2000);
        } else if (Q.party_rosenfeld_seen) {
            Q.marcher_president_votes -= (Q.burgher_marcher_normalized / 1500);
            Q.marcher_president_votes -= (Q.guild_marcher_normalized / 1500);
            Q.marcher_president_votes -= (Q.landed_marcher_normalized / 1500);
        }
    }
    if (Q.ddp_support_marcher) {
        if (Q.ddp_ideology == "Left") {
            Q.marcher_president_votes += Q.ddp_normalized;
        }
        if (Q.ddp_ideology == "Moderate") {
            Q.marcher_president_votes += Q.ddp_normalized * 0.8;
            Q.dufour_votes += Q.ddp_normalized * 0.2;
            Q.ddp_president_crossover += Q.ddp_normalized * 0.2;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += Q.ddp_normalized * 0.2;
                Q.dufour_votes -= Q.ddp_normalized * 0.2;
                Q.ddp_president_crossover -= Q.ddp_normalized * 0.2;
            }
        }
        if (Q.ddp_ideology == "Right") {
            Q.marcher_president_votes += Q.ddp_normalized * 0.6;
            Q.dufour_votes += Q.ddp_normalized * 0.4;
            Q.ddp_president_crossover += Q.ddp_normalized * 0.4;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += Q.ddp_normalized * 0.2;
                Q.dufour_votes -= Q.ddp_normalized * 0.2;
                Q.ddp_president_crossover -= Q.ddp_normalized * 0.2;
            }
        }
    } else {
        Q.dufour_votes += Q.ddp_normalized;
    }

    if (Q.lvp_support_marcher) {
        if (Q.lvp_ideology == "Left") {
            Q.marcher_president_votes += Q.lvp_normalized * 0.8;
            Q.dufour_votes += Q.lvp_normalized * 0.2;
            Q.lvp_president_crossover += Q.lvp_normalized * 0.2;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += Q.lvp_normalized * 0.1;
                Q.dufour_votes -= Q.lvp_normalized * 0.1;
                Q.lvp_president_crossover -= Q.lvp_normalized * 0.1;
            }
        }
        if (Q.lvp_ideology == "Moderate") {
            Q.marcher_president_votes += Q.lvp_normalized * 0.6;
            Q.dufour_votes += Q.lvp_normalized * 0.4;
            Q.lvp_president_crossover += Q.lvp_normalized * 0.4;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += Q.lvp_normalized * 0.2;
                Q.dufour_votes -= Q.lvp_normalized * 0.2;
                Q.lvp_president_crossover -= Q.lvp_normalized * 0.2;
            }
        }
        if (Q.lvp_ideology == "Right") {
            Q.marcher_president_votes += Q.lvp_normalized * 0.4;
            Q.dufour_votes += Q.lvp_normalized * 0.6;
            Q.lvp_president_crossover += Q.lvp_normalized * 0.6;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += Q.lvp_normalized * 0.2;
                Q.dufour_votes -= Q.lvp_normalized * 0.2;
                Q.lvp_president_crossover -= Q.lvp_normalized * 0.2;
            }
        }
    } else {
        Q.dufour_votes += Q.lvp_normalized;
    }

    if (Q.gold_support_marcher) {
        if (Q.gold_ideology == "Left") {
            Q.marcher_president_votes += Q.gold_normalized * 0.6;
            Q.dufour_votes += Q.gold_normalized * 0.4;
            Q.gold_president_crossover += Q.gold_normalized * 0.4;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += Q.gold_normalized * 0.2;
                Q.dufour_votes -= Q.gold_normalized * 0.2;
                Q.gold_president_crossover -= Q.gold_normalized * 0.2;
            }
        }
        if (Q.gold_ideology == "Moderate") {
            Q.marcher_president_votes += Q.gold_normalized * 0.5;
            Q.dufour_votes += Q.gold_normalized * 0.5;
            Q.gold_president_crossover += Q.gold_normalized * 0.5;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += Q.gold_normalized * 0.3;
                Q.dufour_votes -= Q.gold_normalized * 0.3;
                Q.gold_president_crossover -= Q.gold_normalized * 0.3;
            }
        }
        if (Q.gold_ideology == "Right") {
            Q.marcher_president_votes += Q.gold_normalized * 0.4;
            Q.dufour_votes += Q.gold_normalized * 0.6;
            Q.gold_president_crossover += Q.gold_normalized * 0.6;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += Q.gold_normalized * 0.3;
                Q.dufour_votes -= Q.gold_normalized * 0.3;
                Q.gold_president_crossover -= Q.gold_normalized * 0.3;
            }
        }
    } else {
        Q.dufour_votes += Q.gold_normalized;
    }

    if (Q.unionist_support_marcher && Q.unionist_support_marcher == 1) {
        if (Q.unionist_ideology == "Left") {
            Q.marcher_president_votes += (Q.unionist_normalized - Q.bvp_votes);
            Q.dufour_votes += Q.bvp_votes;
            Q.center_president_crossover += Q.bvp_votes;
        }
        if (Q.unionist_ideology == "Right" && !Q.unionist_glaze_marcher) {
            Q.marcher_president_votes += (Q.unionist_normalized - Q.bvp_votes) * 0.8;
            Q.dufour_votes += (Q.unionist_normalized - Q.bvp_votes) * 0.2;
            Q.center_president_crossover += (Q.unionist_normalized - Q.bvp_votes) * 0.2;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += (Q.unionist_normalized - Q.bvp_votes) * 0.1;
                Q.dufour_votes -= (Q.unionist_normalized - Q.bvp_votes) * 0.1;
                Q.center_president_crossover -= (Q.unionist_normalized - Q.bvp_votes) * 0.1;
            }
            Q.dufour_votes += Q.bvp_votes;
            Q.center_president_crossover += Q.bvp_votes;
        } else if (Q.unionist_ideology == "Right" && Q.unionist_glaze_marcher) {
            Q.marcher_president_votes += (Q.unionist_normalized - Q.bvp_votes) * 0.9;
            Q.dufour_votes += (Q.unionist_normalized - Q.bvp_votes) * 0.1;
            Q.center_president_crossover += (Q.unionist_normalized - Q.bvp_votes) * 0.1;
            if (Q.eckener_campaign) {
                Q.marcher_president_votes += (Q.unionist_normalized - Q.bvp_votes) * 0.1;
                Q.dufour_votes -= (Q.unionist_normalized - Q.bvp_votes) * 0.1;
                Q.center_president_crossover -= (Q.unionist_normalized - Q.bvp_votes) * 0.1;
            }
            Q.dufour_votes += Q.bvp_votes;
            Q.center_president_crossover += Q.bvp_votes;
        }
        if (Q.bvp_support_marcher) {
            Q.marcher_president_votes += Q.bvp_votes;
            Q.dufour_votes -= Q.bvp_votes;
            Q.center_president_crossover -= Q.bvp_votes;
        } else if (!Q.bvp_support_marcher && !Q.dufour_run) {
            Q.other_normalized += Q.bvp_votes;
        }
    } else {
        Q.dufour_votes += Q.unionist_normalized;
    }
    
    if (Q.collectivist_support_marcher) {
        if (!Q.collectivist_glaze_marcher) {
            Q.marcher_president_votes += Q.collectivist_normalized * 0.8;
            if (!Q.gallax_support_dufour && Q.royalist_candidate_1932 == "Gallax" && Q.marcher_candidate_1932 != "Pendrigon") {
                Q.royalist_presidential_votes += Q.collectivist_normalized * 0.1;
            }
            if (Q.marcher_candidate_1932 == "Pendrigon") {
                Q.royalist_presidential_votes += Q.collectivist_normalized * 0.1;
            }
        } else if (Q.collectivist_glaze_marcher) {
            Q.marcher_president_votes += Q.collectivist_normalized * 0.95;
            if (!Q.gallax_support_dufour && Q.royalist_candidate_1932 == "Gallax" && Q.marcher_candidate_1932 != "Pendrigon") {
                Q.royalist_presidential_votes += Q.collectivist_normalized * 0.05;
            }
            if (Q.marcher_candidate_1932 == "Pendrigon") {
                Q.royalist_presidential_votes += Q.collectivist_normalized * 0.05;
            }
        }

        if (Q.sapd_formed && Q.sapd_votes) {
            Q.marcher_president_votes += Q.sapd_normalized;
        }
    } else {
        Q.thalmann_votes += Q.collectivist_normalized * 0.95;
        if (!Q.gallax_support_dufour && Q.royalist_candidate_1932 == "Gallax") {
            Q.royalist_presidential_votes += Q.collectivist_normalized * 0.05;
        }
        if (Q.sapd_formed && Q.sapd_votes) {
            Q.thalmann_votes += Q.sapd_normalized;
        }
    }

    if (Q.heartland_leader == "Bristol" && Q.braun_campaign) {
        Q.marcher_president_votes += (Q.pro_republic / 2000);
    }

} else if (Q.marcher_support_thalmann) {
    Q.thalmann_votes += Q.collectivist_normalized;
    Q.thalmann_votes += Q.marcher_normalized;

    if (!Q.media_communist_seen) {
        Q.thalmann_votes -= (Q.burgher_marcher_normalized / 1000);
        Q.thalmann_votes -= (Q.guild_marcher_normalized / 1000);
    } else if (Q.media_communist_seen) {
        Q.thalmann_votes -= (Q.burgher_marcher_normalized / 1500);
        Q.thalmann_votes -= (Q.guild_marcher_normalized / 1500);
    }

    Q.thalmann_votes -= (Q.landed_marcher_normalized / 500);
    Q.thalmann_votes -= (Q.faithful_marcher_normalized / 500);

    if (!Q.marcher_glaze_thalmann) {
        Q.thalmann_votes -= (Q.commons_marcher_normalized / 2000);
        Q.dufour_votes += (Q.commons_marcher_normalized / 2000);
    }

    Q.dufour_votes += Q.unionist_normalized;
    Q.dufour_votes += Q.ddp_normalized;
    Q.dufour_votes += Q.gold_normalized;
    Q.dufour_votes += Q.lvp_normalized;

} else {
    if (!Q.dufour_democracy_bonus && Q.dufour_run && !Q.marcher_abstain_1932) {
        Q.dufour_votes += Q.marcher_normalized * 0.9;
    }

    if (Q.dufour_democracy_bonus && Q.dufour_run && !Q.marcher_abstain_1932) {
        Q.dufour_votes += Q.marcher_normalized;
    }

    if (Q.reactionary_democracy_bonus && Q.marcher_support_reactionary && !Q.dufour_run && !Q.marcher_abstain_1932) {
        Q.reactionary_votes += Q.marcher_normalized;
    }

    if (!Q.reactionary_democracy_bonus && Q.marcher_support_reactionary && !Q.dufour_run && !Q.marcher_abstain_1932) {
        Q.reactionary_votes += Q.marcher_normalized*0.95;
    }

    Q.dufour_votes += Q.unionist_normalized;
    Q.dufour_votes += Q.ddp_normalized;
    Q.dufour_votes += Q.gold_normalized;
    Q.dufour_votes += Q.lvp_normalized;

    Q.thalmann_votes += Q.collectivist_normalized;

    if (!Q.dufour_democracy_bonus && Q.dufour_run) {
        Q.thalmann_votes += Q.marcher_normalized * 0.05;
    }
    if (!Q.reactionary_democracy_bonus && !Q.dufour_run) {
        Q.thalmann_votes += Q.marcher_normalized * 0.05;
    }

    if (Q.marcher_abstain_1932) {
        Q.thalmann_votes += Q.marcher_normalized * 0.3;
        Q.dufour_votes += Q.marcher_normalized * 0.5;
        Q.reactionary_votes += Q.marcher_normalized * 0.5;
    }
}
if (Q.gallax_support_dufour) {
    Q.royalist_presidential_votes -= Q.royalist_normalized;
    Q.dufour_votes += Q.royalist_normalized;
}
if (!Q.dufour_run) {
    let parties = ['unionist', 'ddp', 'gold', 'other'];

    if (Q.kvp_formed) {
        parties.push('kvp');
    }
    if (Q.traditionalist_ideology == "Moderate") {
        parties.push('traditionalist');
    }
    if (Q.lvp_formed) {
        parties.push('lvp');
    }

    if (Q.gold_support_marcher) {
        Q.gold_choice = Q.marcher_candidate_1932;
    } else {
        Q.gold_normalized += Q.gold_president_crossover;
        Q.gold_president_crossover = 0;
    }
    if (Q.ddp_support_marcher) {
        Q.ddp_choice = Q.marcher_candidate_1932;
    } else {
        Q.ddp_normalized += Q.ddp_president_crossover;
        Q.ddp_president_crossover = 0;
    }
    if (Q.unionist_support_marcher) {
        Q.unionist_choice = Q.marcher_candidate_1932;
    } else {
        Q.unionist_normalized += Q.center_president_crossover;
        Q.center_president_crossover = 0;
    }
    if (Q.lvp_support_marcher) {
        Q.lvp_choice = Q.marcher_candidate_1932;
    } else {
        Q.lvp_normalized += Q.lvp_president_crossover;
        Q.lvp_president_crossover = 0;
    }
    if (Q.gold_support_marcher) {
        Q.gold_choice = Q.marcher_candidate_1932;
    } else {
        Q.gold_normalized += Q.gold_president_crossover;
        Q.gold_president_crossover = 0;
    }

    if (Q.unionist_choice == Q.marcher_candidate_1932 && Q.center_president_crossover) {
        if (Q.reactionary_candidate_1932 && Q.reactionary_candidate_1932_ideology == "Liberal" && Q.center_president_crossover != 0) {
            Q.reactionary_candidate_1_votes += Q.center_president_crossover;
            Q.center_president_crossover = 0;
        } else if (Q.secondary_reactionary_candidate_1932 && Q.secondary_reactionary_candidate_1932_ideology == "Liberal" && Q.center_president_crossover != 0) {
            Q.reactionary_candidate_2_votes += Q.center_president_crossover;
            Q.center_president_crossover = 0;
        }
        if (Q.reactionary_candidate_1932 && Q.reactionary_candidate_1932_ideology == "Conservative" && Q.center_president_crossover != 0) {
            Q.reactionary_candidate_1_votes += Q.center_president_crossover;
            Q.center_president_crossover = 0;
        } else if (Q.secondary_reactionary_candidate_1932 && Q.secondary_reactionary_candidate_1932_ideology == "Conservative" && Q.center_president_crossover != 0) {
            Q.reactionary_candidate_2_votes += Q.center_president_crossover;
            Q.center_president_crossover = 0;
        }
    }

    if (Q.ddp_choice == Q.marcher_candidate_1932 && Q.ddp_president_crossover) {
        if (Q.reactionary_candidate_1932 && (Q.reactionary_candidate_1932_ideology == "Centrist" || Q.reactionary_candidate_1932_ideology == "Liberal") && Q.ddp_president_crossover != 0) {
            Q.reactionary_candidate_1_votes += Q.ddp_president_crossover;
            Q.ddp_president_crossover = 0;
        } else if (Q.secondary_reactionary_candidate_1932 && (Q.secondary_reactionary_candidate_1932_ideology == "Centrist" || Q.secondary_reactionary_candidate_1932_ideology == "Liberal") && Q.ddp_president_crossover) {
            Q.reactionary_candidate_2_votes += Q.ddp_president_crossover;
            Q.ddp_president_crossover = 0;
        }
        if (Q.reactionary_candidate_1932 && Q.reactionary_candidate_1932_ideology == "Conservative" && Q.ddp_president_crossover != 0) {
            Q.reactionary_candidate_1_votes += Q.ddp_president_crossover;
            Q.ddp_president_crossover = 0;
        } else if (Q.secondary_reactionary_candidate_1932 && Q.secondary_reactionary_candidate_1932_ideology == "Conservative" && Q.ddp_president_crossover) {
            Q.reactionary_candidate_2_votes += Q.ddp_president_crossover;
            Q.ddp_president_crossover = 0;
        }
    }

    if (Q.gold_choice == Q.marcher_candidate_1932 && Q.gold_president_crossover) {
        if (Q.reactionary_candidate_1932 && (Q.reactionary_candidate_1932_ideology == "Centrist" || Q.reactionary_candidate_1932_ideology == "Liberal") && Q.gold_president_crossover != 0) {
            Q.reactionary_candidate_1_votes += Q.gold_president_crossover;
            Q.gold_president_crossover = 0;
        } else if (Q.secondary_reactionary_candidate_1932 && (Q.secondary_reactionary_candidate_1932_ideology == "Centrist" || Q.secondary_reactionary_candidate_1932_ideology == "Liberal") && Q.gold_president_crossover != 0) {
            Q.reactionary_candidate_2_votes += Q.gold_president_crossover;
            Q.gold_president_crossover = 0;
        }
        if (Q.reactionary_candidate_1932 && Q.reactionary_candidate_1932_ideology == "Conservative" && Q.gold_president_crossover != 0) {
            Q.reactionary_candidate_1_votes += Q.gold_president_crossover;
            Q.gold_president_crossover = 0;
        } else if (Q.secondary_reactionary_candidate_1932 && Q.secondary_reactionary_candidate_1932_ideology == "Conservative" && Q.gold_president_crossover != 0) {
            Q.reactionary_candidate_2_votes += Q.gold_president_crossover;
            Q.gold_president_crossover = 0;
        }
    }

    if (Q.lvp_choice == Q.marcher_candidate_1932 && Q.lvp_president_crossover) {
        if (Q.reactionary_candidate_1932 && (Q.reactionary_candidate_1932_ideology == "Centrist" || Q.reactionary_candidate_1932_ideology == "Liberal") && Q.lvp_president_crossover != 0) {
            Q.reactionary_candidate_1_votes += Q.lvp_president_crossover;
            Q.lvp_president_crossover = 0;
        } else if (Q.secondary_reactionary_candidate_1932 && (Q.secondary_reactionary_candidate_1932_ideology == "Centrist" || Q.secondary_reactionary_candidate_1932_ideology == "Liberal") && Q.lvp_president_crossover) {
            Q.reactionary_candidate_2_votes += Q.lvp_president_crossover;
            Q.lvp_president_crossover = 0;
        }
        if (Q.reactionary_candidate_1932 && Q.reactionary_candidate_1932_ideology == "Conservative" && Q.lvp_president_crossover != 0) {
            Q.reactionary_candidate_1_votes += Q.lvp_president_crossover;
            Q.lvp_president_crossover = 0;
        } else if (Q.secondary_reactionary_candidate_1932 && Q.secondary_reactionary_candidate_1932_ideology == "Conservative" && Q.lvp_president_crossover) {
            Q.reactionary_candidate_2_votes += Q.lvp_president_crossover;
            Q.lvp_president_crossover = 0;
        }
    }

    if ((Q.reactionary_candidate_1932_ideology == "Liberal" && Q.secondary_reactionary_candidate_1932_ideology == "Centrist" || Q.reactionary_candidate_1932_ideology == "Centrist" && Q.secondary_reactionary_candidate_1932_ideology == "Liberal" || Q.reactionary_candidate_1932_ideology == "Centrist" && Q.secondary_reactionary_candidate_1932_ideology == "Centrist" || Q.reactionary_candidate_1932_ideology == "Liberal" && Q.secondary_reactionary_candidate_1932_ideology == "Liberal") && Q.marcher_abstain_1932) {
        Q.reactionary_candidate_1_votes += Q.reactionary_votes*0.5;
        Q.reactionary_candidate_2_votes += Q.reactionary_votes*0.5;
    }
    if (Q.marcher_choice == Q.reactionary_candidate_1932 && Q.reactionary_candidate_1932 && !Q.marcher_abstain_1932) {
        Q.reactionary_candidate_1_votes += Q.reactionary_votes;
    } else if (Q.marcher_choice == Q.secondary_reactionary_candidate_1932 && Q.secondary_reactionary_candidate_1932 && !Q.marcher_abstain_1932) {
        Q.reactionary_candidate_2_votes += Q.reactionary_votes;
    }
    for (const party of parties) {
        const new_choice = Q[`${party}_choice`];
        const support = Q[`${party}_normalized`];

        if (Q['choice_pre_'+party] === new_choice) continue;

        if (Q['choice_pre_'+party] === Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1_votes -= support;
        } else if (Q['choice_pre_'+party] === Q.secondary_reactionary_candidate_1932) {
            Q.reactionary_candidate_2_votes -= support;
        }
    }
}

if (Q.reactionary_candidate_2_votes && !Q.secondary_reactionary_candidate_1932) {
    Q.reactionary_candidate_1_votes += Q.reactionary_candidate_2_votes;
    Q.reactionary_candidate_2_votes = 0;
}

if (!Q.dufour_run) Q.dufour_votes = 0;

Q.vrp_presidential_votes = 0.003;
if (Q.inflation >= 4) Q.vrp_presidential_votes += (Q.inflation / 1000);

console.log("DuFour votes: " + Q.dufour_votes);
console.log("Royalists votes: " + Q.royalist_presidential_votes);
console.log("Marchers votes: " + Q.marcher_president_votes);
console.log("Reactionary1 votes: " + Q.reactionary_candidate_1_votes);
console.log("Reactionary2 votes: " + Q.reactionary_candidate_2_votes);
console.log("Traditionalists votes: " + Q.traditionalist_presidential_votes);
console.log("VRP votes: " + Q.vrp_presidential_votes);
console.log("Communists votes: " + Q.thalmann_votes);

Q.total_votes_pres = Q.dufour_votes + Q.royalist_presidential_votes + Q.thalmann_votes + Q.marcher_president_votes + Q.traditionalist_presidential_votes + Q.vrp_presidential_votes + Q.reactionary_candidate_1_votes + Q.reactionary_candidate_2_votes;
if (!Q.dufour_run) {
    Q.total_votes_pres -= Q.dufour_votes;
    Q.dufour_votes = 0;
}
Q.dufour_votes_normalized = (Q.dufour_votes/Q.total_votes_pres);
Q.reactionary_candidate_1_votes_normalized = (Q.reactionary_candidate_1_votes/Q.total_votes_pres);
Q.reactionary_candidate_2_votes_normalized = (Q.reactionary_candidate_2_votes/Q.total_votes_pres);
Q.royalist_presidential_votes_normalized = (Q.royalist_presidential_votes/Q.total_votes_pres);
Q.marcher_president_votes_normalized = (Q.marcher_president_votes/Q.total_votes_pres);
Q.thalmann_votes_normalized = (Q.thalmann_votes/Q.total_votes_pres);
Q.traditionalist_presidential_votes_normalized = (Q.traditionalist_presidential_votes/Q.total_votes_pres);
Q.vrp_presidential_votes_normalized = (Q.vrp_presidential_votes/Q.total_votes_pres);

// check for majority
Q.dufour_votes = Math.round(Q.dufour_votes_normalized*1000)/10;
Q.reactionary_candidate_1_votes = Math.round(Q.reactionary_candidate_1_votes_normalized*1000)/10;
Q.reactionary_candidate_2_votes = Math.round(Q.reactionary_candidate_2_votes_normalized*1000)/10;
Q.marcher_president_votes = Math.round(Q.marcher_president_votes_normalized*1000)/10;
Q.royalist_presidential_votes = Math.round(Q.royalist_presidential_votes_normalized*1000)/10;
Q.thalmann_votes = Math.round(Q.thalmann_votes_normalized*1000)/10;
Q.traditionalist_presidential_votes = Math.round(Q.traditionalist_presidential_votes_normalized*1000)/10;
Q.vrp_presidential_votes = (Q.vrp_presidential_votes_normalized*1000)/10;

Q.dufour_majority = (Q.dufour_votes >= 50);
Q.reactionary_candidate_1_majority = Math.round(Q.reactionary_candidate_1_votes >= 50);
Q.reactionary_candidate_2_majority = Math.round(Q.reactionary_candidate_2_votes >= 50);
Q.thalmann_majority = (Q.thalmann_votes >= 50);
Q.royalist_president_majority = (Q.royalist_presidential_votes >= 50);
Q.marcher_president_majority = (Q.marcher_president_votes >= 50);
Q.traditionalist_presidential_majority = (Q.traditionalist_presidential_votes >= 50);
Q.vrp_presidential_majority = (Q.vrp_presidential_votes >= 50);
Q.any_majority = Q.dufour_majority | Q.reactionary_candidate_1_majority | Q.reactionary_candidate_2_majority | Q.thalmann_majority | Q.royalist_president_majority | Q.marcher_president_majority | Q.traditionalist_presidential_majority | Q.vrp_presidential_majority

const candidate_votes = [
  "dufour_votes",
  "reactionary_candidate_1_votes",
  "reactionary_candidate_2_votes",
  "thalmann_votes",
  "royalist_presidential_votes",
  "marcher_president_votes",
  "traditionalist_presidential_votes",
  "vrp_presidential_votes"
];

let maxVotes = 0;
for (const key of candidate_votes) {
  if (Q[key] > maxVotes) {
    maxVotes = Q[key];
  }
}

Q.dufour_plurality = Q.dufour_votes === maxVotes;
Q.reactionary_candidate_1_plurality = Q.reactionary_candidate_1_votes === maxVotes;
Q.reactionary_candidate_2_plurality = Q.reactionary_candidate_2_votes === maxVotes;
Q.thalmann_plurality = Q.thalmann_votes === maxVotes;
Q.royalist_president_plurality = Q.royalist_presidential_votes === maxVotes;
Q.marcher_plurality = Q.marcher_president_votes === maxVotes;
Q.traditionalist_presidential_plurality = Q.traditionalist_presidential_votes === maxVotes;
Q.vrp_presidential_plurality = Q.vrp_presidential_votes === maxVotes;

Q.election_round += 1;

// making the vote numbers nicer for the display
Q.dufour_votes_disp = Q.dufour_votes.toFixed(1);
Q.reactionary_candidate_1_votes_disp = Q.reactionary_candidate_1_votes.toFixed(1);
Q.reactionary_candidate_2_votes_disp = Q.reactionary_candidate_2_votes.toFixed(1);
Q.marcher_president_votes_disp = Q.marcher_president_votes.toFixed(1);
Q.royalist_presidential_votes_disp = Q.royalist_presidential_votes.toFixed(1);
Q.thalmann_votes_disp = Q.thalmann_votes.toFixed(1);
Q.traditionalist_presidential_votes_disp = Q.traditionalist_presidential_votes.toFixed(1);
Q.vrp_presidential_votes_disp = Q.vrp_presidential_votes.toFixed(1);

Q.dufour_votes_rnd_1 = Q.dufour_votes;
Q.reactionary_candidate_1_votes_rnd_1 = Q.reactionary_candidate_1_votes;
Q.reactionary_candidate_2_votes_rnd_1 = Q.reactionary_candidate_2_votes;
Q.marcher_president_votes_rnd_1 = Q.marcher_president_votes;
Q.royalist_presidential_votes_rnd_1 = Q.royalist_presidential_votes;
Q.thalmann_votes_rnd_1 = Q.thalmann_votes;
Q.traditionalist_presidential_votes_rnd_1 = Q.traditionalist_presidential_votes;
Q.vrp_presidential_votes_rnd_1 = Q.vrp_presidential_votes;

if (Q.thalmann_votes < 15 && Q.thalmann_votes) {
    Q.commons_collectivist *= 0.85;
    Q.disfavored_collectivist *= 0.85;
    if (!Q.marcher_campaign) {
        Q.disfavored_royalist += 5;
        Q.commons_royalist += 3;
    } else if (Q.marcher_campaign) {
        Q.disfavored_marcher += 5;
        Q.commons_marcher += 3;
    }
    Q.thalmann_joever = 1;
}
if (Q.dufour_votes >= 45 && Q.royalist_presidential_votes < 36 && Q.marcher_president_votes < 36 && Q.dufour_run) {
    Q.commons_royalist += 2;
    Q.burgher_royalist += 4;
    Q.guild_royalist += 4;
    Q.faithful_royalist += 2;
    Q.landed_royalist += 2;
    Q.disfavored_royalist += 4;
    Q.burgher_traditionalist -= 4;
    Q.guild_traditionalist -= 4;
    Q.faithful_traditionalist -= 2;
    Q.dufour_confidence = 1;
}
// deusterberg effects should depend on endorsements of rlb and stuff

if (Q.liberal_reactionary_candidate_1932 && Q.center_reactionary_candidate_1932) {
    if (Q.liberal_reactionary_candidate_1932_name == Q.reactionary_candidate_1932) {
        if (Q.reactionary_candidate_1_votes < Q.reactionary_candidate_2_votes) {
            Q.lib_drop_out_bourgeois = 1;
        } else {
            Q.unionist_drop_out_bourgeois = 1;
        }
    }
    if (Q.liberal_reactionary_candidate_1932_name == Q.secondary_reactionary_candidate_1932) {
        if (Q.reactionary_candidate_2_votes < Q.reactionary_candidate_1_votes) {
            Q.lib_drop_out_bourgeois = 1;
        } else {
            Q.unionist_drop_out_bourgeois = 1;
        }
    }
}


!}
go-to: achievement_calculation

@achievement_calculation
on-arrival: {!
if (Q.vrp_presidential_votes >= 1) Q.blauer_winter = 1;
if (Q.braun_campaign && Q.unionist_support_marcher == 1 && Q.collectivist_support_marcher == 1 && ((Q.ddp_support_marcher == 1 && !Q.lvp_formed) || (Q.lvp_support_marcher && Q.lvp_formed))) Q.braun_koalition = 1;
if (Q.braun_campaign && Q.marcher_president_votes >= 60) Q.der_beliebte_prasident = 1;
!}
go-to: blauer_winter if blauer_winter; achievement_calculation_2 if not blauer_winter

@achievement_calculation_2
go-to: braun_koalition if braun_koalition; achievement_calculation_3 if not braun_koalition

@achievement_calculation_3
go-to: der_beliebte_prasident if der_beliebte_prasident; calculation if not der_beliebte_prasident

@blauer_winter
achievement: blauer_winter
go-to: achievement_calculation_2

@braun_koalition 
achievement: braun_koalition
go-to: achievement_calculation_3

@der_beliebte_prasident 
achievement: der_beliebte_prasident
go-to: calculation

@calculation
go-to: hindenburg_wins if dufour_majority == 1; thalmann_wins if thalmann_majority == 1; hitler_wins if royalist_president_majority == 1; braun_wins if marcher_president_majority == 1 and marcher_candidate_1932 == "Bristol"; rosenfeld_wins if marcher_president_majority == 1 and marcher_candidate_1932 == "Pendrigon"; eckener_wins if marcher_president_majority == 1 and marcher_candidate_1932 == "Eckhart"; reactionary_candidate_wins if (reactionary_candidate_1_majority or reactionary_candidate_2_majority); no_majority_round1 if any_majority == 0

Results:

[? if collectivist_support_marcher == 0 : <span style="color: #700000;">**[+ communist_candidate_1932 +]**</span> - [+ thalmann_votes_disp +]% ?]

[? if marcher_campaign > 0 : [? if marcher_candidate_1932 != "Eckhart": <span style="color: #c00000;">**[+ marcher_candidate_1932 +]**</span>?][? if marcher_candidate_1932 == "Eckhart": <span style="color: #000000;">**Eck**</span><span style="color: #DD0000;">**ha**</span><span style="color: #FFCC00;">**rt**</span>?] - [+ marcher_president_votes_disp +]% ?]

<span style="color: #0075EB;">**Winter**</span> - [+ vrp_presidential_votes_disp +]%

[? if dufour_run: <span style="color: #808080;">**[+ reactionary_candidate_1932 +]**</span> - [+ dufour_votes_disp +]% ?][? if not dufour_run: [? if (reactionary_candidate_1932 == "Lytton" or reactionary_candidate_1932 == "Gesling" or reactionary_candidate_1932 == "Jarrow") and lvp_formed: <span style="color: #FFCC00;">**[+ reactionary_candidate_1932 +]**</span>?][? if (reactionary_candidate_1932 == "Lytton" or reactionary_candidate_1932 == "Jarrow") and not lvp_formed: <span style="color: #C0A054;">**[+ reactionary_candidate_1932 +]**</span>?][? if reactionary_candidate_1932 == "Gesling" and not lvp_formed: <span style="color: #D3C24D;">**[+ reactionary_candidate_1932 +]**</span>?][? if ((reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or reactionary_candidate_1932 == "Westmore") and not kvp_formed: <span style="color: #3E88B3;">**[+ reactionary_candidate_1932 +]**</span>?][? if ((reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or reactionary_candidate_1932 == "Westmore") and kvp_formed: <span style="color: #0087DC;">**[+ reactionary_candidate_1932 +]**</span>?][? if reactionary_candidate_1932 == "Aldermoor" or reactionary_candidate_1932 == "Askew" or reactionary_candidate_1932 == "Sedgewick" or (reactionary_candidate_1932 == "Lethmoor" and concord_formed): <span style="color: #000000;">**[+ reactionary_candidate_1932 +]**</span>?] - [+ reactionary_candidate_1_votes_disp +]% ?]

[? if not dufour_run and secondary_reactionary_candidate_1932: [? if (secondary_reactionary_candidate_1932 == "Lytton" or secondary_reactionary_candidate_1932 == "Gesling" or secondary_reactionary_candidate_1932 == "Jarrow") and lvp_formed: <span style="color: #FFCC00;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if (secondary_reactionary_candidate_1932 == "Lytton" or secondary_reactionary_candidate_1932 == "Jarrow") and not lvp_formed: <span style="color: #C0A054;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if secondary_reactionary_candidate_1932 == "Gesling" and not lvp_formed: <span style="color: #D3C24D;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if ((secondary_reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or secondary_reactionary_candidate_1932 == "Westmore") and not kvp_formed: <span style="color: #3E88B3;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if ((secondary_reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or secondary_reactionary_candidate_1932 == "Westmore") and kvp_formed: <span style="color: #0087DC;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if secondary_reactionary_candidate_1932 == "Aldermoor" or secondary_reactionary_candidate_1932 == "Askew" or secondary_reactionary_candidate_1932 == "Sedgewick" or (secondary_reactionary_candidate_1932 == "Lethmoor" and concord_formed): <span style="color: #000000;">**[+ secondary_reactionary_candidate_1932 +]**</span>?]  - [+ reactionary_candidate_2_votes_disp +]% ?]

[? if traditionalist_ideology == "Radical": <span style="color: #3E88B3;">**[+ traditionalist_candidate_1932 +]**</span> ?][? if traditionalist_ideology == "Moderate": <span style="color: #142e20;">**[+ traditionalist_candidate_1932 +]**</span> ?] - [+ traditionalist_presidential_votes_disp +]%

<span style="color: #7A3C00;">**[+ royalist_candidate_1932 +]**</span> - [+ royalist_presidential_votes_disp +]%

@no_majority_round1
on-arrival: gallax_support_dufour = 1 if (marcher_plurality or thalmann_plurality) and dufour_run
go-to: round2_menu

There is no majority in this round. In the second round, any candidate who wins a plurality will win overall. What should we do?

[? if traditionalist_candidate_1932 == "Dusterel": Due to [+ traditionalist_candidate_1932 +]'s poor performance, he has withdrawn from the race and personally endorsed [? if reactionary_candidate_1_votes >= reactionary_candidate_2_votes: [+ reactionary_candidate_1932 +]?][? if reactionary_candidate_2_votes > reactionary_candidate_1_votes: [+ secondary_reactionary_candidate_1932 +]?]—despite widespread dislike of him among his supporters. Meanwhile, Mallin has urged his followers to abstain from the second round, drawing intense criticism from within his own party. How this will impact the runoff remains uncertain, but [+ royalist_candidate_1932 +] is likely to capture a sizable share of these voters. ?][? if traditionalist_candidate_1932 == "Mallin": Due to [+ traditionalist_candidate_1932 +]'s poor performance, he has withdrawn from the race and urged his followers to abstain from the second round, drawing intense criticism from within his own party. How this will impact the runoff remains uncertain, but [+ royalist_candidate_1932 +] is likely to capture a sizable share of these voters. ?]

[? if dufour_confidence: DuFour has narrowly missed securing the required majority for a first-round victory, making his success in the runoff highly probable. With state and local elections just a month away, the guild-masters and parties backing him have redirected their remaining campaign funds to those contests, confident that his victory is all but assured. This, however, presents a valuable opportunity for [+ royalist_candidate_1932 +] to gain support among [+ traditionalist_candidate_1932 +] voters and leverage their dominance in the presidential campaign to coincide with their local efforts. ?]

[? if thalmann_votes < 15 and thalmann_votes: The <span style="color: #700000;">**Collectivists**</span> have suffered a demoralizing defeat, leaving many of their supporters disillusioned about the prospects of revolution—a future they once saw as inevitable given the Commonwealth’s current state. In the second round, many will abstain from voting altogether, while a small minority may even cast their ballots for [? if not marcher_campaign: [+ royalist_candidate_1932 +] ?][? if marcher_campaign: [+ marcher_candidate_1932 +] ?]in an effort to make their vote count. ?]

[? if traditionalist_candidate_1932: There had been discussions of Prince Castor, a cousin of the Empress, running as a Stowford unity candidate, a prospect the <span style="color: #7A3C00;">**Royalists**</span> showed interest in supporting. However, the <span style="color: #3E88B3;">**Traditionalists**</span> and the <span style="color: #3E88B3;">**Wardens**</span> rejected the idea due to their hostility toward an accommodation with the <span style="color: #7A3C00;">**Royalists**</span>. The nail in the coffin was that his own father threatened to disinherit him if he stood for the "<span style="color: #c00000;">red</span> <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> presidential seat of a Harlow". He has since endorsed [+ royalist_candidate_1932 +]. ?]

[? if gallax_support_dufour : In order to consolidate the vote for the <span style="color: #808080;">right</span>, and to prevent a <span style="color: #c00000;">Reformist</span> from becoming president, <span style="color: #7A3C00;">[+ royalist_candidate_1932 +]</span> is no longer running in the second round, and has switched his endorsement to <span style="color: #808080;">DuFour</span>. ?]

[? if lib_drop_out_bourgeois : In order to consolidate the propertied electorate around a single candidate, [+ liberal_reactionary_candidate_1932_name +] has withdrawn from the race and endorsed [+ center_reactionary_candidate_1932_name +]. ?][? if unionist_drop_out_bourgeois : In order to consolidate the propertied electorate around a single candidate, [+ center_reactionary_candidate_1932_name +] has withdrawn from the race and endorsed [+ liberal_reactionary_candidate_1932_name +]. ?]

@round2_menu
on-arrival: {!
if (Q.unionist_support_marcher == 2) Q.unionist_support_marcher = 0;
if ((Q.lvp_support_marcher && Q.lvp_formed || (Q.gold_support_marcher || Q.ddp_support_marcher && (Q.liberal_reactionary_candidate_1932_name == "Gesling" || Q.liberal_vote - Q.ddp_votes < 8))) && Q.liberal_reactionary_candidate_1932 && !Q.lib_drop_out_bourgeois && !Q.lib_drop_out) Q.lib_drop_out_2 = 1;
if (Q.unionist_support_marcher == 1 && Q.center_reactionary_candidate_1932 && !Q.unionist_drop_out_bourgeois && !Q.unionist_drop_out) Q.unionist_drop_out_2 = 1;
!}

- @round2_convince_z: Convince the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionists</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] to switch their support to us.
- @round2_convince_kpd: Convince the <span style="color: #700000;">**Collectivists**</span> to switch their support to us. 
- @round2_convince_ddp: Convince the <span style="color: #D3C24D;">**[+ ddp_name +]**</span> to switch their support to us.
- @round2_convince_lvp: Convince the <span style="color: #C0A054;">**Golds**</span> to switch their support to us.
- @convince_z_eckener: Convince the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] to switch their support to <span style="color: #000000;">**Eck**</span><span style="color: #DD0000;">**ha**</span><span style="color: #FFCC00;">**rt**</span>.
- @convince_ddp_eckener: Convince the <span style="color: #D3C24D;">**[+ ddp_name +]**</span> to switch their support to <span style="color: #000000;">**Eck**</span><span style="color: #DD0000;">**ha**</span><span style="color: #FFCC00;">**rt**</span>.
- @convince_lvp_eckener: Convince the <span style="color: #C0A054;">**Golds**</span> to switch their support to <span style="color: #000000;">**Eck**</span><span style="color: #DD0000;">**ha**</span><span style="color: #FFCC00;">**rt**</span>.
- @convince_dvp_eckener: Convince the <span style="color: #C0A054;">**Golds**</span> to switch their support to <span style="color: #000000;">**Eck**</span><span style="color: #DD0000;">**ha**</span><span style="color: #FFCC00;">**rt**</span>.
- @round2_hindenburg: Switch our support to DuFour.
- @round2_reactionary: Switch our support to [? if (reactionary_candidate_1932 == "Lytton" or reactionary_candidate_1932 == "Gesling" or reactionary_candidate_1932 == "Jarrow") and lvp_formed: <span style="color: #FFCC00;">**[+ reactionary_candidate_1932 +]**</span>?][? if (reactionary_candidate_1932 == "Lytton" or reactionary_candidate_1932 == "Jarrow") and not lvp_formed: <span style="color: #C0A054;">**[+ reactionary_candidate_1932 +]**</span>?][? if reactionary_candidate_1932 == "Gesling" and not lvp_formed: <span style="color: #D3C24D;">**[+ reactionary_candidate_1932 +]**</span>?][? if ((reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or reactionary_candidate_1932 == "Westmore") and not kvp_formed: <span style="color: #3E88B3;">**[+ reactionary_candidate_1932 +]**</span>?][? if ((reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or reactionary_candidate_1932 == "Westmore") and kvp_formed: <span style="color: #0087DC;">**[+ reactionary_candidate_1932 +]**</span>?][? if reactionary_candidate_1932 == "Aldermoor" or reactionary_candidate_1932 == "Askew" or reactionary_candidate_1932 == "Sedgewick" or (reactionary_candidate_1932 == "Lethmoor" and concord_formed): <span style="color: #000000;">**[+ reactionary_candidate_1932 +]**</span>?].
