[? if (ddp_choice == secondary_reactionary_candidate_1932 or dufour_run) and ddp_support_marcher != 1 and not lvp_formed and secondary_reactionary_candidate_1932: - <span style="color: #D3C24D;">**[+ ddp_name +]**</span> ?]

[? if (gold_choice == secondary_reactionary_candidate_1932 or dufour_run) and gold_support_marcher != 1 and not lvp_formed and secondary_reactionary_candidate_1932: - <span style="color: #C0A054;">**Golds**</span> ?]

[? if (kvp_choice == secondary_reactionary_candidate_1932 or dufour_run) and kvp_formed and secondary_reactionary_candidate_1932: - <span style="color: #0087DC;">**KVP**</span> ?]

[? if (traditionalist_choice == secondary_reactionary_candidate_1932 or dufour_run) and traditionalist_ideology == "Moderate" and not concord_formed and secondary_reactionary_candidate_1932: - <span style="color: #3E88B3;">**Traditionalists**</span> ?]

[? if (other_choice == secondary_reactionary_candidate_1932 or dufour_run) and secondary_reactionary_candidate_1932: - **Others** ?]

[? if royalist_candidate_1932: <span style="color: #7A3C00;">**[+ royalist_candidate_1932_disp +]**</span> - supported by: ?]

[? if royalist_candidate_1932: - <span style="color: #7A3C00;">**Royalists**</span> ?]

[? if collectivist_support_marcher == 0 and communist_candidate_1932: <span style="color: #700000;">**[+ communist_candidate_1932_disp +]**</span> - supported by: ?]

[? if collectivist_support_marcher == 0 and communist_candidate_1932: - <span style="color: #700000;">**Collectivists**</span> ?]

[? if collectivist_support_marcher == 0 and communist_candidate_1932 and sapd_formed: - <span style="color: #9B0000;">**SAPD**</span> ?]

[? if marcher_support_thalmann == 1: - <span style="color: #c00000;">**Marchers**</span> ?]

[? if traditionalist_candidate_1932: [? if traditionalist_ideology == "Radical": <span style="color: #3E88B3;">**[+ traditionalist_candidate_1932_disp +]**</span>?][? if traditionalist_ideology == "Moderate": <span style="color: #003755;">**[+ traditionalist_candidate_1932_disp +]**</span>?] - supported by: ?]

[? if traditionalist_candidate_1932 and traditionalist_ideology == "Radical": - <span style="color: #3E88B3;">**Traditionalists**</span> ?]

[? if traditionalist_candidate_1932 and traditionalist_ideology == "Moderate": - <span style="color: #003755;">**DNF**</span> ?]

@abstain
title: This is highly controversial within the party!
subtitle: The future of the Republic is at stake, and we are urging our supporters not to vote.
on-arrival: {!
Q.marcher_abstain_1932 = 1;
Q.left_dissent += 10;
Q.center_dissent += 10;
Q.reformist_dissent += 15;
Q.knight_dissent += 10;
Q.labor_dissent += 10;
Q.commons_marcher -= 3;
Q.burgher_marcher -= 2;
Q.guild_marcher -= 2;
Q.landed_marcher -= 2;

// campaign activities...

if (Q.royalist_candidate_1932 == "Gallax") {
    Q.commons_royalist += 2;
    Q.burgher_royalist += 4;
    Q.guild_royalist += 4;
    Q.faithful_royalist += 2;
    Q.landed_royalist += 4;
    Q.disfavored_royalist += 6;
    Q.burgher_traditionalist -= 3;
    Q.guild_traditionalist -= 3; 
    Q.landed_other -= 3; 
    Q.faithful_other -= 3;
    Q.disfavored_collectivist -= 3;
} else if (Q.royalist_candidate_1932 == "Gorrick") {
    Q.guild_royalist += 4;
    Q.guild_traditionalist -= 4;
    Q.landed_royalist += 2;
    Q.landed_traditionalist -= 2;
    Q.commons_collectivist += 3;
    Q.commons_royalist -= 3;
}

if (Q.dufour_run) {
    if (Q.industrial_total_backing) {
        Q.dufour_funds += Q.industrial_ddp_backing;
        Q.dufour_funds += Q.industrial_lvp_backing;
        Q.dufour_funds += Q.industrial_gold_backing;
        Q.dufour_funds += Q.industrial_traditionalist_backing;
        Q.dufour_funds += ((100 - Q.royalist_votes) / 25);
        if (Q.marcher_in_government) Q.dufour_funds += ((100 - Q.collectivist_votes) / 10);
    }

    if (Q.dufour_funds >= 5) {
        Q.burgher_kvp += Q.dufour_funds / 2;
        Q.guild_kvp += Q.dufour_funds / 2;
        Q.landed_kvp += Q.dufour_funds / 2;
        if (Q.traditionalist_ideology == "Moderate") {
            Q.burgher_traditionalist += Q.dufour_funds / 2;
            Q.guild_traditionalist += Q.dufour_funds / 2;
            Q.landed_traditionalist += Q.dufour_funds / 3;
        }
        Q.burgher_other += Q.dufour_funds / 3;
        Q.guild_other += Q.dufour_funds / 3;
        Q.landed_other += Q.dufour_funds / 3;
        Q.burgher_gold += Q.dufour_funds / 3;
        Q.guild_gold += Q.dufour_funds / 3;
        Q.landed_gold += Q.dufour_funds / 4;
        Q.burgher_lvp += Q.dufour_funds / 2;
        Q.guild_lvp += Q.dufour_funds / 2;
        Q.landed_lvp += Q.dufour_funds / 4;
    }

    Q.dufour_unity = 10;
    if (Q.dufour_angry_bruning >= 75) Q.dufour_unity -= 1;
    if (Q.gold_defect) Q.dufour_unity -= 1;
    if (Q.cnblp_defect) Q.dufour_unity -= 1;
    if (Q.second_bruning_cabinet_seen) Q.dufour_unity -= 1;
    if (Q.marcher_support_reactionary) Q.dufour_unity -= 3;
    if (Q.marcher_campaign || Q.marcher_support_thalmann || Q.collectivist_support_marcher) Q.dufour_unity += 3;

    if (Q.dufour_unity >= 8) {
        Q.dufour_support += 2;
    }
    if (Q.dufour_unity >= 5) {
        Q.dufour_support += 2;
    }
    if (Q.dufour_unity >= 3) {
        Q.dufour_support += 1;
    }
    if (Q.dufour_unity) {
        Q.dufour_support += 1;
    }

    if (Q.dufour_support) {
        Q.burgher_kvp += Q.dufour_support;
        Q.guild_kvp += Q.dufour_support;
        Q.landed_kvp += Q.dufour_support;
        if (Q.traditionalist_ideology == "Moderate") {
            Q.burgher_traditionalist += Q.dufour_support;
            Q.guild_traditionalist += Q.dufour_support;
            Q.landed_traditionalist += Q.dufour_support;
        }
        Q.burgher_ddp += Q.dufour_support / 3;
        Q.guild_ddp += Q.dufour_support / 3;
        Q.burgher_other += Q.dufour_support / 1.5;
        Q.guild_other += Q.dufour_support / 1.5;
        Q.burgher_gold += Q.dufour_support / 3;
        Q.guild_gold += Q.dufour_support / 3;
        Q.landed_other += Q.dufour_support / 1.5;
        Q.pro_republic += Q.dufour_support;
        if (!Q.kvp_formed) Q.landed_other += Q.dufour_support;
        Q.burgher_royalist -= Q.dufour_support;
        Q.old_royalist -= Q.dufour_support;
        Q.landed_royalist -= Q.dufour_support;
    }
    if (Q.rlb_royalist) {
        Q.rlb_dufour = 0;
        Q.landed_royalist += Q.landed_other * 0.1;
        Q.landed_other *= 0.9;
        Q.landed_traditionalist *= 0.9;
    } else if (!Q.rlb_royalist) {
        Q.rlb_dufour = 1;
        Q.landed_other += 4;
        if (Q.traditionalist_ideology == "Moderate") {
            Q.landed_traditionalist += 2;
        } else {
            Q.landed_kvp += 2;
        }
    }
}

if (!Q.dufour_run) {
    if (Q.industrial_total_backing) {
        if (Q.ddp_choice == Q.marcher_choice) Q.reactionary_funds += Q.industrial_ddp_backing;
        if (Q.lvp_choice == Q.marcher_choice) Q.reactionary_funds += Q.industrial_lvp_backing;
        if (Q.gold_choice == Q.marcher_choice) Q.reactionary_funds += Q.industrial_gold_backing;
        if (Q.traditionalist_choice == Q.marcher_choice) Q.reactionary_funds += Q.industrial_traditionalist_backing;
        if (Q.kvp_choice == Q.marcher_choice) Q.reactionary_funds += Q.industrial_kvp_backing;
        Q.reactionary_funds += ((100 - Q.royalist_votes) / 25);
        if (Q.marcher_in_government) Q.reactionary_funds += ((100 - Q.collectivist_votes) / 10);
    }
    if (Q.reactionary_funds >= 5 && !Q.industrial_reactionary) {
        Q.burgher_kvp += Q.reactionary_funds / 2;
        Q.guild_kvp += Q.reactionary_funds / 2;
        Q.landed_kvp += Q.reactionary_funds / 2;
        if (Q.traditionalist_ideology == "Moderate") {
            Q.burgher_traditionalist += Q.reactionary_funds / 2;
            Q.guild_traditionalist += Q.reactionary_funds / 2;
            Q.landed_traditionalist += Q.reactionary_funds / 3;
        }
        Q.burgher_other += Q.reactionary_funds / 3;
        Q.guild_other += Q.reactionary_funds / 3;
        Q.landed_other += Q.reactionary_funds / 3;
        Q.burgher_gold += Q.reactionary_funds / 3;
        Q.guild_gold += Q.reactionary_funds / 3;
        Q.landed_gold += Q.reactionary_funds / 4;
        Q.burgher_lvp += Q.reactionary_funds / 2;
        Q.guild_lvp += Q.reactionary_funds / 2;
        Q.landed_lvp += Q.reactionary_funds / 4;
    }
    Q.industrial_reactionary = 1;
}
!}

None of the candidates are worthy of our support, and we are either unable or unwilling to field a candidate of our own. This decision is widely seen as irresponsible, given our status as the nominally largest party. [? if dufour_run: DuFour is privately relieved by this, as receiving our endorsement would personally pain him. ?] The <span style="color: #700000;">**Collectivists**</span> will seize upon our lack of an endorsement, attempting to position [+ communist_candidate_1932_disp +] as the sole left-wing candidate in the race, likely drawing many of our voters as a protest vote.

@run_braun
subtitle: This will cost us 2 resources.
choose-if: resources >= 2 and not staal_marcher
unavailable-subtitle: [? if resources < 2: Not enough resources. ?][? if staal_marcher: As part of our deal with Staal, we are now obligated to support DuFour’s re-election. ?]
on-arrival: resources -= 2; marcher_campaign = 1; braun_campaign = 1; reformist_dissent -= 10; reformist_strength += 10; ddp_support_marcher = 0; lvp_support_marcher = 0; gold_support_marcher = 0

It takes effort to run a somewhat unexpected campaign. First, Bristol has to be convinced to run. [? if dufour_run: He himself had supported voting for DuFour, and it takes a good deal of prodding to convince him of his destiny. ?][? if not dufour_run: It takes a good deal of prodding to convince him of his destiny. ?]

[? if not lvp_formed: The [? if ddp_votes < 2: miniscule remnants of the?] [? if ddp_name == "Gold": <span style="color: #D3C24D;">**Democratic Party**</span>?][? if ddp_name == "DStP": <span style="color: #D3C24D;">**State Party**</span>?] aren't guaranteed to support us, [? if ddp_relation < 40: with a deterioration in our relationship?][? if ddp_relation >= 40: but are open to it due to their reluctance in supporting DuFour?]?][? if lvp_formed: The <span style="color: #C0A054;">**Golds**</span> aren't exactly the biggest fans of <span style="color: #c00000;">Reformism</span>, [? if lvp_relation < 40: with the deterioration in relations making their support a near impossibility.?][? if lvp_relation >= 40: but are at least open to it due to their reluctance in supporting DuFour?]?]. Who else will? Can we convince the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionists</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] to support Bristol? What about the <span style="color: #700000;">**Collectivists**</span>?

- @endorsements_braun: Scout out potential endorsements. 

@run_rosenfeld
subtitle: This will cost us 2 resources.
choose-if: resources >= 2 and not staal_marcher and left_strength > reformist_strength and (marcher_votes + collectivist_votes + sapd_votes >= 40) and marcher_votes >= collectivist_votes
unavailable-subtitle: [? if resources < 2: Not enough resources. ?][? if staal_marcher: As part of our deal with Staal, we are now obligated to support DuFour’s re-election. ?][? if reformist_strength >= left_strength: Our reformist elements manage to steer the party toward supporting Bristol instead. ?][? if (marcher_votes + collectivist_votes + sapd_votes < 40): The <span style="color: #700000;">Collectivists</span> is unwilling to back Pendrigon as a unity candidate, citing pessimism about our electoral prospects. ?][? if marcher_votes < collectivist_votes: The <span style="color: #700000;">Collectivists</span> sees no reason to support our candidate, as they currently enjoy greater popular support than we do. ?][? if collectivist_relation < 40: The <span style="color: #700000;">Collectivists</span> has made their stance clear—there’s little point in proposing a unity candidate they are unlikely to support. ?]
on-arrival: resources -= 2; marcher_campaign = 1; rosenfeld_campaign = 1; reformist_dissent += 20; left_dissent -= 20; left_strength += 10; collectivist_relation += 10; unionist_relation -= 5; ddp_relation -= 5; gold_relation -= 5; lvp_relation -= 5; lvp_right += 3; gold_right += 3; ddp_right += 3; ddp_cohesion -= 2; ddp_support_marcher = 0; lvp_support_marcher = 0; gold_support_marcher = 0; marcher_candidate_1932 = "Pendrigon"; marcher_candidate_1932_disp = "Cael Pendrigon"

It takes effort to run a somewhat unexpected campaign. First, Pendrigon has to be convinced to run. He isn't particularly eager to be promoted to the presidency from his lowly position in the party.

His candidacy has severely limited our options for endorsements, but we can likely count on the support of the <span style="color: #700000;">**Collectivists**</span>[? if left_split:&nbsp;and <span style="color: #9B0000;">**SAPD**</span>?]. But who else? The [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionists</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] is likely hostile, and the <span style="color: #FFCC00;">liberals</span> are irreconcilably opposed. Furthermore, many of our voters outside the working class have voiced objections to his candidacy and will not support him with much enthusiasm. Perhaps this will become the ultimate battle between the <span style="color: #9B0000;">Vaelist</span> and propertied halves of the country.

- @endorsements_rosenfeld: Scout out potential endorsements. 

@run_eckener
subtitle: This will cost us 1 resource.
choose-if: resources >= 1 and not staal_marcher and not dufour_run and reformist_strength >= left_strength + center_strength and unionist_relation >= 40
unavailable-subtitle: [? if resources < 1: Not enough resources. ?][? if staal_marcher: As part of our deal with Staal, we are now obligated to support DuFour’s re-election. ?][? if dufour_run: He isn't interested in running against DuFour.?][? if reformist_strength < left_strength + center_strength: He isn't interested in being the candidate of the <span style="color: #c00000;">Marchers</span>, at least given our current ideological stance.?][? if unionist_relation < 40: Due to our poor relations with the <span style="color: #000000;">Unionist Party</span>, he isn’t interested unless he will genuinely be united behind as a unity candidate. ?]
on-arrival: resources -= 1; marcher_campaign = 1; eckener_campaign = 1; reformist_dissent -= 10; left_dissent += 15; collectivist_relation -= 15; commons_marcher -= 3; commons_collectivist += 3; unionist_relation += 5; ddp_relation += 5; gold_relation += 5; lvp_relation += 5; lvp_left += 3; gold_left += 3; ddp_left += 3; ddp_cohesion += 2; ddp_support_marcher = 0; lvp_support_marcher = 0; gold_support_marcher = 0; marcher_candidate_1932 = "Eckhart"; marcher_candidate_1932_disp = "Hugo Eckhart"

It takes effort to launch a somewhat unexpected campaign. First, Eckhart must be convinced to run. He isn't particularly eager to be the candidate of the <span style="color: #c00000;">Reformists</span>, as it would invite slander from the Commonwealth Right—whom he feels a greater affinity with.

With his status as a non-<span style="color: #c00000;">Reformist</span>—and even conservative—unity candidate, and his non-partisanship, Eckhart is positioned to attract endorsements from a wide range of parties. However, much of this depends on their relationship with us, as our backing alone is enough to disgust many otherwise eager supporters. The [? if not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span> and <span style="color: #C0A054;">**Golds**</span> are likely to back Eckhart, although the <span style="color: #C0A054;">**Golds**</span> requires convincing. ?][? if lvp_formed: <span style="color: #C0A054;">**Golds**</span> is likely to back Eckhart, although their industrial-right elements object to the arrangement. ?] The [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionists</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] is nominally supportive, although the <span style="color: #A2D8E0;">**Arcanists**</span> remains another problem. Finally, the <span style="color: #700000;">**Collectivists**</span>[? if left_split:&nbsp;and <span style="color: #9B0000;">**SAPD**</span>?] are firmly opposed to supporting a propertied conservative—for obvious reasons.

- @endorsements_eckener: Scout out potential endorsements. 

@support_hindenburg
subtitle: This is the default option.
view-if: dufour_run
on-arrival: marcher_support_reactionary = 1; left_dissent += 15; labor_dissent += 10; dufour_angry_bruning += 25; dufour_angry -= 40; commons_marcher -= 3; commons_collectivist += 3; disfavored_marcher -= 3; disfavored_collectivist += 3

Despite his known <span style="color: #808080;">reactionary</span> nature, DuFour has at least been keeping the <span style="color: #7A3C00;">Royalists</span> at bay. Thus, we must support him. [? if bruning_time: DuFour is reportedly dissatisfied with having been elected with the support of <span style="color: #c00000;">Reformists</span>, blaming Askew and his unpopular cabinet for this outcome. ?]

@support_reactionary
subtitle: This is the default option.
view-if: not dufour_run and reactionary_candidate_1932 and reactionary_candidate_1932 != "Westmore" and reactionary_candidate_1932 != "Lethmoor"
on-arrival: marcher_support_reactionary = 1; marcher_support_reactionary_1 = 1; marcher_choice = reactionary_candidate_1932; left_dissent += 15; labor_dissent += 10; dufour_angry -= 40; commons_marcher -= 3; commons_collectivist += 3; disfavored_marcher -= 3; disfavored_collectivist += 3

For some reason, whether we are physically <i>unable</i> to run a candidate of our own, or genuinely believe that [+ reactionary_candidate_1932 +] is the safest bet for Commonwealth democracy, we are supporting him now. 

@support_reactionary_2
subtitle: This is the default option.
view-if: not dufour_run and secondary_reactionary_candidate_1932 and secondary_reactionary_candidate_1932 != "Westmore" and secondary_reactionary_candidate_1932 != "Lethmoor"
on-arrival: marcher_support_reactionary = 1; marcher_support_reactionary_2 = 1; marcher_choice = secondary_reactionary_candidate_1932; left_dissent += 15; labor_dissent += 10; dufour_angry -= 40; commons_marcher -= 3; commons_collectivist += 3; disfavored_marcher -= 3; disfavored_collectivist += 3

For some reason, whether we are physically <i>unable</i> to run a candidate of our own, or genuinely believe that [+ secondary_reactionary_candidate_1932 +] is the safest bet for Commonwealth democracy, we are supporting him now. 

@support_thalmann
choose-if: collectivist_relation >= 50 and reformist_strength < left_strength and not staal_marcher
unavailable-subtitle: [? if collectivist_relation < 50 : We do not have good enough relations with the <span style="color: #700000;">Collectivists</span>, so they are not even willing to accept our support. ?] [? if reformist_strength >= left_strength : The reformist faction is able to dissuade the party from supporting this arrangement. ?][? if staal_marcher: As part of our deal with Staal, we are now obligated to support DuFour’s re-election. ?]

Supporting [+ communist_candidate_1932 +] is rather unpopular in our party, even if the <span style="color: #700000;">**Collectivists**</span> accept our support. Are we sure?

- @support_thalmann_2: Yes, we will support <span style="color: #700000;">**[+ communist_candidate_1932 +]**</span>, despite the reformists' pleas against it.
- @run_braun: Support <span style="color: #c00000;">Bristol</span> instead.
- @support_hindenburg: Support <span style="color: #808080;">DuFour</span> instead.
- @run_rosenfeld: Run Cael Pendrigon of the [? if not left_split: <span style="color: #c00000;">**Marchers**</span>?][? if left_split: <span style="color: #9B0000;">**SAPD**</span>?] instead.
- @run_eckener: Run Hugo Eckhart as a unity candidate instead.
- @abstain: Abstain from endorsing any candidate instead.

@support_thalmann_2
on-arrival: marcher_support_thalmann = 1; reformist_dissent += 15; center_dissent += 10; labor_dissent += 5; knight_dissent += 10; faithful_marcher -= 5; commons_marcher -= 3; commons_collectivist += 5; collectivist_relation += 10; communist_coalition += 2; unionist_relation -= 15; gold_relation -= 15; ddp_relation -= 10; gold_right += 10; ddp_right += 6; ddp_cohesion -= 6; lvp_right += 10

Fine. We have thrown our support to Chairman [+ communist_candidate_1932 +] of the <span style="color: #700000;">**Collectivists**</span> to the dismay of our propertied allies.

@endorsements_braun
on-arrival: unionist_support_marcher = 0 if unionist_support_marcher == 2

We can't win this election alone, we need support from other parties. [? if marcher_votes >= 50: Nevermind. We actually can win this election alone. ?]

- @convince_z: Convince the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] to back <span style="color: #c00000;">Bristol</span>[? if center_reactionary_candidate_1932:&nbsp;and withdraw support from [+ center_reactionary_candidate_1932_name +]?].
- @convince_kpd: Convince the <span style="color: #700000;">**Collectivists**</span> to back <span style="color: #c00000;">Bristol</span>.
- @convince_ddp: Convince the <span style="color: #D3C24D;">**[+ ddp_name +]**</span> to back <span style="color: #c00000;">Bristol</span>[? if liberal_reactionary_candidate_1932:&nbsp;and withdraw support from [+ liberal_reactionary_candidate_1932_name +]?].
- @convince_lvp: Convince the <span style="color: #C0A054;">**Golds**</span> to back <span style="color: #c00000;">Bristol</span>[? if liberal_reactionary_candidate_1932:&nbsp;and withdraw support from [+ liberal_reactionary_candidate_1932_name +]?].
- @view_candidates: View party endorsements.
- @hope: We have concluded negotiations with other parties.

@hope
on-arrival: {!
if ((Q.lvp_support_marcher && Q.lvp_formed || (Q.gold_support_marcher || Q.ddp_support_marcher && (Q.liberal_reactionary_candidate_1932_name == "Gesling" || Q.liberal_vote - Q.ddp_votes < 8))) && Q.liberal_reactionary_candidate_1932) Q.lib_drop_out = 1;
if (Q.unionist_support_marcher == 1 && Q.center_reactionary_candidate_1932) Q.unionist_drop_out = 1;
if ((Q.lib_drop_out && Q.unionist_drop_out || Q.unionist_drop_out && !Q.secondary_reactionary_candidate_1932 || Q.lib_drop_out && !Q.secondary_reactionary_candidate_1932)) {
    Q.vorbeck_run = 1;
    Q.vorbeck_fallback = 1;
    Q.reactionary_candidate_1932 = "Lethmoor";
    Q.reactionary_candidate_1932_disp = "Paul von Lethmoor";
    Q.secondary_reactionary_candidate_1932 = 0;
    Q.secondary_reactionary_candidate_1932_disp = 0;
    Q.unionist_choice = Q.reactionary_candidate_1932;
    Q.ddp_choice = Q.reactionary_candidate_1932;
    Q.gold_choice = Q.reactionary_candidate_1932;
    Q.lvp_choice = Q.reactionary_candidate_1932;
    Q.other_choice = Q.reactionary_candidate_1932;
    Q.kvp_choice = Q.reactionary_candidate_1932;
    Q.traditionalist_choice = Q.reactionary_candidate_1932;
} else {
    if (Q.lib_drop_out) {
        if (Q.reactionary_candidate_1932 == "Lytton") {
            Q.reactionary_candidate_1932 = Q.secondary_reactionary_candidate_1932;
            Q.reactionary_candidate_1932_disp = Q.secondary_reactionary_candidate_1932_disp;
            Q.secondary_reactionary_candidate_1932 = 0;
            Q.secondary_reactionary_candidate_1932_disp = 0;
        } else if (Q.secondary_reactionary_candidate_1932 == "Lytton") {
            Q.secondary_reactionary_candidate_1932 = 0;
            Q.secondary_reactionary_candidate_1932_disp = 0;
