title: Presidential Election Candidates
subtitle: Should we field our own candidate?
new-page: true
on-arrival: {!
Q.presidential_election_campaigning_seen = 1;
if (!Q.gallax_deported && Q.gallax_citizen) {
    Q.royalist_candidate_1932 = "Gallax";
    Q.royalist_candidate_1932_disp = "Alaric Gallax";
} else {
    Q.royalist_candidate_1932 = "Gorrick";
    Q.royalist_candidate_1932_disp = "Ulric Gorrick";
}
Q.marcher_candidate_1932 = "Bristol";
if (Q.dufour_run) {
    Q.reactionary_candidate_1932 = "DuFour";
    // angry that he is running in the first place
    Q.dufour_angry_bruning += 20;
}
Q.communist_candidate_1932 = "Halsmark";

Q.marcher_candidate_1932_disp = "Lyle Bristol";
if (Q.dufour_run) Q.reactionary_candidate_1932_disp = "Paul von DuFour";
Q.communist_candidate_1932_disp = "Ernst Halsmark";

if (Q.royalist_candidate_1932) {
    Q.traditionalist_candidate_1932 = "Dusterel";
    Q.traditionalist_candidate_1932_disp = "Rafe Dusterel";
}
!}
tags: event
view-if: year = 1932 and month >= 2 and not dufour_term_extended
on-display: {!  
    var cardEl = document.createElement('div');  
    cardEl.className = "face-figure2";  

    var image = new Image();  
    image.className = "face-img";  
    image.src = "img/campaign.jpg";  

    cardEl.appendChild(image);  
    var contentDiv = document.querySelector("#page #mid_panel #content");
    contentDiv.appendChild(cardEl);
!}
priority: 1
max-visits: 1
go-to: candidate_selection


= Presidential Election Candidates

With the 4297 Commonwealth Presidential election coming up next month, we need to decide whether to run a candidate of our own or support one from another party. [? if dufour_run: Many are calling for us to support the incumbent DuFour, despite his <span style="color: #808080;">reactionary</span> tendencies. Contrary to fears, he hasn’t used his office to destroy the republic yet, so supporting him would hopefully prevent the <span style="color: #7A3C00;">Royalists</span>, who actually support destroying the republic, from winning. ?][? if not dufour_run: With DuFour's withdrawal, the Commonwealth Right is in disarray, struggling to find a candidate who can attract support from the moderate right and middle, while also embodying the unifying character of DuFour. It’s likely that the candidate they put forward will have a military or industrial background and will be distanced from the partisan bickering of politics. ?]

On the other hand, many in our party are calling for [+ marcher_candidate_1932_disp +] to run again, but he is reluctant. [? if collectivist_relation >= 50 : Another strange possibility is an united front with the <span style="color: #700000;">Collectivists</span>, either to support their candidate or our own candidate. ?][? if sapd_formed: The <span style="color: #9B0000;">**SAPD**</span>, our former leftists, are likely to share an endorsement with the <span style="color: #700000;">Collectivists</span>. ?]

Anyhow, let's see who will be the candidates on <span class="tooltip-text" title="good game">the campaign trail</span>.

@candidate_selection


- @view_candidates_1: View the running candidates.

@view_candidates_1


- @reactionary: Who will be the successor to DuFour?
- @hindenburg: DuFour is, of course, running once more.

@reactionary
on-arrival: {!
Q.bourgeois_votes = Q.ddp_votes + Q.gold_votes + Q.lvp_votes + Q.other_votes + Q.kvp_votes + Q.traditionalist_votes + Q.unionist_votes;

if ((Q.lvp_ideology == "Right" && Q.lvp_leader == "Coalfax" && Q.lvp_formed || Q.gold_votes >= 6 && Q.bourgeois_parliament && Q.bourgeois_votes >= 40 && !Q.lvp_formed) && Q.liberal_vote >= 8) Q.jarres_unlock_pres = 1;
if ((Q.gold_leader == "Lytton" || Q.lvp_leader == "Lytton") && Q.pro_republic >= 50 && Q.liberal_vote >= 8 && Q.bourgeois_votes >= 35) Q.luther_unlock_pres = 1;
if (((Q.dstp_formed || Q.ddp_relation < 40 || Q.pro_republic < 40) && Q.ddp_ideology != "Left" && !Q.lvp_formed || Q.lvp_formed && Q.lvp_ideology != "Left" && Q.pro_republic < 50) && Q.liberal_vote >= 8 && Q.bourgeois_votes >= 35) Q.gessler_unlock_pres = 1;
if (Q.stegerwald_path) Q.adenauer_unlock_pres = 1;
if (!Q.stegerwald_path && Q.unionist_relation >= 30 && Q.chancellor != "Askew" && Q.bourgeois_votes >= 40) Q.bruning_unlock_pres = 1;
if (!Q.stegerwald_path && !Q.bruning_unlock_pres && !Q.adenauer_unlock_pres) Q.stegerwald_unlock_pres = 1;
if (Q.traditionalist_ideology == "Moderate" && Q.bourgeois_votes < 35 || Q.kvp_formed && Q.bourgeois_votes < 35 || Q.concord_formed && Q.concord_ideology == "Right") Q.vorbeck_unlock_pres = 1;
if (Q.traditionalist_ideology == "Moderate" && Q.bourgeois_votes >= 35) Q.westarp_unlock_pres = 1;

if (!Q.jarres_unlock_pres && !Q.gessler_unlock_pres && !Q.adenauer_unlock_pres && !Q.bruning_unlock_pres && !Q.stegerwald_unlock_pres && !Q.vorbeck_unlock_pres && !Q.westarp_unlock_pres) {
    Q.vorbeck_unlock_pres = 1;
    Q.vorbeck_fallback = 1;
}

if (Q.westarp_unlock_pres && Q.vorbeck_unlock_pres) {
    Q.westarp_unlock_pres = 0;
}

if (Q.vorbeck_unlock_pres && Q.concord_formed) {
    Q.westarp_unlock_pres = 0;
    Q.jarres_unlock_pres = 0;
    Q.adenauer_unlock_pres = 0;
    Q.bruning_unlock_pres = 0;
    Q.stegerwald_unlock_pres = 0;
}

let count = 0;
if (Q.jarres_unlock_pres) count++;
if (Q.luther_unlock_pres) count++;
if (Q.gessler_unlock_pres) count++;

if (count >= 2 && Q.jarres_unlock_pres) {
    Q.jarres_unlock_pres = 0;
    count--;
}
if (count >= 2 && !Q.jarres_unlock_pres) {
    Q.luther_unlock_pres = 0;
    count--
}


let count2 = 0;
if (Q.jarres_unlock_pres) count2++;
if (Q.luther_unlock_pres) count2++;
if (Q.gessler_unlock_pres) count2++;
if (Q.adenauer_unlock_pres) count2++;
if (Q.bruning_unlock_pres) count2++;
if (Q.stegerwald_unlock_pres) count2++;
if (Q.vorbeck_unlock_pres) count2++;
if (Q.westarp_unlock_pres) count2++;

Q.reactionary_candidate_1932_count = count2;

Q.reactionary_candidate_1932_ideology = 0;
Q.secondary_reactionary_candidate_1932_ideology = 0;

if (Q.reactionary_candidate_1932_count > 0) {
    if (Q.jarres_unlock_pres) {
        Q.jarres_run = 1; 
        if (Q.reactionary_candidate_1932) {
            Q.secondary_reactionary_candidate_1932 = "Jarrow";
            Q.secondary_reactionary_candidate_1932_disp = "Lorne Jarrow";
        }
        if (!Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1932 = "Jarrow";
            Q.reactionary_candidate_1932_disp = "Lorne Jarrow";
        }
        Q.reactionary_candidate_1932_count -= 1;
    }

    if (Q.luther_unlock_pres) {
        Q.luther_run = 1;
        if (Q.reactionary_candidate_1932) {
            Q.secondary_reactionary_candidate_1932 = "Lytton";
            Q.secondary_reactionary_candidate_1932_disp = "Hans Lytton";
        }
        if (!Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1932 = "Lytton";
            Q.reactionary_candidate_1932_disp = "Hans Lytton";
        }
        Q.reactionary_candidate_1932_count -= 1;
    }

    if (Q.gessler_unlock_pres) {
        Q.gessler_run = 1; 
        if (Q.reactionary_candidate_1932) {
            Q.secondary_reactionary_candidate_1932 = "Gesling";
            Q.secondary_reactionary_candidate_1932_disp = "Gareth Gesling";
        }
        if (!Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1932 = "Gesling";
            Q.reactionary_candidate_1932_disp = "Gareth Gesling";
        }
        Q.reactionary_candidate_1932_count -= 1;
    }

    if (Q.adenauer_unlock_pres) {
        Q.adenauer_run = 1; 
        if (Q.reactionary_candidate_1932) {
            Q.secondary_reactionary_candidate_1932 = "Aldermoor";
            Q.secondary_reactionary_candidate_1932_disp = "Konrad Aldermoor";
        }
        if (!Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1932 = "Aldermoor";
            Q.reactionary_candidate_1932_disp = "Konrad Aldermoor";
        }
        Q.reactionary_candidate_1932_count -= 1;
    }

    if (Q.bruning_unlock_pres) {
        Q.bruning_run = 1; 
        if (Q.reactionary_candidate_1932) {
            Q.secondary_reactionary_candidate_1932 = "Askew";
            Q.secondary_reactionary_candidate_1932_disp = "Edmund Askew";
        }
        if (!Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1932 = "Askew";
            Q.reactionary_candidate_1932_disp = "Edmund Askew";
        }
        Q.reactionary_candidate_1932_count -= 1;
    }

    if (Q.stegerwald_unlock_pres) {
        Q.stegerwald_run = 1; 
        if (Q.reactionary_candidate_1932) {
            Q.secondary_reactionary_candidate_1932 = "Sedgewick";
            Q.secondary_reactionary_candidate_1932_disp = "Adam Sedgewick";
        }
        if (!Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1932 = "Sedgewick";
            Q.reactionary_candidate_1932_disp = "Adam Sedgewick";
        }
        Q.reactionary_candidate_1932_count -= 1;
    }

    if (Q.vorbeck_unlock_pres) {
        Q.vorbeck_run = 1; 
        if (Q.reactionary_candidate_1932) {
            Q.secondary_reactionary_candidate_1932 = "Lethmoor";
            Q.secondary_reactionary_candidate_1932_disp = "Paul von Lethmoor";
        }
        if (!Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1932 = "Lethmoor";
            Q.reactionary_candidate_1932_disp = "Paul von Lethmoor";
        }
        Q.reactionary_candidate_1932_count -= 1;
    }

    if (Q.westarp_unlock_pres) {
        Q.westarp_run = 1; 
        if (Q.reactionary_candidate_1932) {
            Q.secondary_reactionary_candidate_1932 = "Westmore";
            Q.secondary_reactionary_candidate_1932_disp = "Kuno von Westmore";
        }
        if (!Q.reactionary_candidate_1932) {
            Q.reactionary_candidate_1932 = "Westmore";
            Q.reactionary_candidate_1932_disp = "Kuno von Westmore";
        }
        Q.reactionary_candidate_1932_count -= 1;
    }
    
    if (Q.reactionary_candidate_1932 == "Lytton" || Q.reactionary_candidate_1932 == "Gesling" || Q.reactionary_candidate_1932 == "Jarrow") {
        Q.liberal_reactionary_candidate_1932 = 1;
        Q.liberal_reactionary_candidate_1932_name = Q.reactionary_candidate_1932;
    }
    if (Q.reactionary_candidate_1932 == "Aldermoor" || Q.reactionary_candidate_1932 == "Askew" || Q.reactionary_candidate_1932 == "Sedgewick") {
        Q.center_reactionary_candidate_1932 = 1;
        Q.center_reactionary_candidate_1932_name = Q.reactionary_candidate_1932;
    }

    if (Q.secondary_reactionary_candidate_1932 == "Lytton" || Q.secondary_reactionary_candidate_1932 == "Gesling" || Q.secondary_reactionary_candidate_1932 == "Jarrow") {
        Q.liberal_reactionary_candidate_1932 = 1;
        Q.liberal_reactionary_candidate_1932_name = Q.secondary_reactionary_candidate_1932;
    }
    if (Q.secondary_reactionary_candidate_1932 == "Aldermoor" || Q.secondary_reactionary_candidate_1932 == "Askew" || Q.secondary_reactionary_candidate_1932 == "Sedgewick") {
        Q.center_reactionary_candidate_1932 = 1;
        Q.center_reactionary_candidate_1932_name = Q.secondary_reactionary_candidate_1932;
    }

}

Q.unionist_choice = Q.reactionary_candidate_1932;
Q.ddp_choice = Q.reactionary_candidate_1932;
Q.gold_choice = Q.reactionary_candidate_1932;
Q.lvp_choice = Q.reactionary_candidate_1932;
Q.other_choice = Q.reactionary_candidate_1932;
Q.kvp_choice = Q.reactionary_candidate_1932;
Q.traditionalist_choice = Q.reactionary_candidate_1932;

if (Q.secondary_reactionary_candidate_1932) {
    if (Q.secondary_reactionary_candidate_1932 == "Westmore") {
        Q.traditionalist_choice = Q.secondary_reactionary_candidate_1932;
        Q.kvp_choice = Q.secondary_reactionary_candidate_1932;
        Q.other_choice = Q.secondary_reactionary_candidate_1932;
    } else if (Q.secondary_reactionary_candidate_1932 == "Lethmoor") {
        if (Q.concord_formed) Q.unionist_choice = Q.reactionary_candidate_1932;
        Q.traditionalist_choice = Q.secondary_reactionary_candidate_1932;
        Q.kvp_choice = Q.secondary_reactionary_candidate_1932;
        if (!Q.liberal_reactionary_candidate_1932) Q.gold_choice = Q.secondary_reactionary_candidate_1932;
        Q.other_choice = Q.secondary_reactionary_candidate_1932;
    } else if (Q.secondary_reactionary_candidate_1932 == "Askew") {
        Q.unionist_choice = Q.secondary_reactionary_candidate_1932;
        if (!Q.liberal_reactionary_candidate_1932) Q.ddp_choice = Q.secondary_reactionary_candidate_1932;
        if (!Q.lvp_defect && !Q.liberal_reactionary_candidate_1932) Q.lvp_choice = Q.secondary_reactionary_candidate_1932;
        if (!Q.gold_defect && !Q.liberal_reactionary_candidate_1932) Q.gold_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.reactionary_candidate_1932_ideology = "Liberal") Q.other_choice = Q.secondary_reactionary_candidate_1932;
    } else if (Q.secondary_reactionary_candidate_1932 == "Aldermoor") {
        Q.unionist_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.liberal_reactionary_candidate_1932) Q.kvp_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.liberal_reactionary_candidate_1932) Q.traditionalist_choice = Q.secondary_reactionary_candidate_1932;
    } else if (Q.secondary_reactionary_candidate_1932 == "Sedgewick") {
        Q.unionist_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.liberal_reactionary_candidate_1932) Q.other_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.liberal_reactionary_candidate_1932) Q.kvp_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.liberal_reactionary_candidate_1932) Q.traditionalist_choice = Q.secondary_reactionary_candidate_1932;
    } else if (Q.secondary_reactionary_candidate_1932 == "Gesling") {
        Q.ddp_choice = Q.secondary_reactionary_candidate_1932;
        Q.lvp_choice = Q.secondary_reactionary_candidate_1932;
        Q.gold_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.reactionary_candidate_1932_ideology != "Conservative") Q.other_choice = Q.secondary_reactionary_candidate_1932;
    } else if (Q.secondary_reactionary_candidate_1932 == "Lytton") {
        Q.ddp_choice = Q.secondary_reactionary_candidate_1932;
        Q.lvp_choice = Q.secondary_reactionary_candidate_1932;
        Q.gold_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.reactionary_candidate_1932_ideology != "Conservative") Q.other_choice = Q.secondary_reactionary_candidate_1932;
    } else if (Q.secondary_reactionary_candidate_1932 == "Jarrow") {
        Q.lvp_choice = Q.secondary_reactionary_candidate_1932;
        Q.gold_choice = Q.secondary_reactionary_candidate_1932;
        if (Q.reactionary_candidate_1932_ideology != "Conservative") Q.other_choice = Q.secondary_reactionary_candidate_1932;
    }
}

if (Q.reactionary_candidate_1932 == "Lytton" || Q.reactionary_candidate_1932 == "Gesling" || Q.reactionary_candidate_1932 == "Jarrow") {
    Q.reactionary_candidate_1932_ideology = "Liberal";
} else if (Q.reactionary_candidate_1932 == "Westmore" || Q.reactionary_candidate_1932 == "Lethmoor") {
    Q.reactionary_candidate_1932_ideology = "Conservative";
} else if (Q.reactionary_candidate_1932 == "Aldermoor" || Q.reactionary_candidate_1932 == "Askew" || Q.reactionary_candidate_1932 == "Sedgewick") {
    Q.reactionary_candidate_1932_ideology = "Centrist";
}

if (Q.secondary_reactionary_candidate_1932 == "Lytton" || Q.secondary_reactionary_candidate_1932 == "Gesling" || Q.secondary_reactionary_candidate_1932 == "Jarrow") {
    Q.secondary_reactionary_candidate_1932_ideology = "Liberal";
} else if (Q.secondary_reactionary_candidate_1932 == "Westmore" || Q.secondary_reactionary_candidate_1932 == "Lethmoor") {
    Q.secondary_reactionary_candidate_1932_ideology = "Conservative";
} else if (Q.secondary_reactionary_candidate_1932 == "Aldermoor" || Q.secondary_reactionary_candidate_1932 == "Askew" || Q.secondary_reactionary_candidate_1932 == "Sedgewick") {
    Q.secondary_reactionary_candidate_1932_ideology = "Centrist";
}

Q.reactionary_candidate_1932_count_2 = 1;
if (Q.secondary_reactionary_candidate_1932) Q.reactionary_candidate_1932_count_2 = 2;
!}
view-if: not dufour_run
go-to: reactionary_candidates

With local elections fast approaching, many parties have opted not to field their own candidates, instead consolidating their support behind a select few.

@reactionary_candidates

- @jarres
- @luther
- @gessler
- @adenauer
- @bruning
- @stegerwald
- @vorbeck
- @westarp

@jarres
title: Lorne Jarrow, mayor of Duisburg, former Vice-Chancellor, and the <span style="color: #C0A054;">**Golds**</span>'s candidate in 4290.
view-if: jarres_unlock_pres
on-arrival: reactionary_candidate_1932_count_2 -= 1
face-image: img/portraits/jarres.jpg
max-visits: 1
go-to: reactionary_candidates if reactionary_candidate_1932_count_2 > 0

Lorne Jarrow, having been compelled to withdraw his candidacy in 4290 in favor of DuFour, has once again entered the race. While not an overtly partisan figure—having remained relatively quiet in national politics in recent years—Jarrow is expected to share many of the same anti-<span style="color: #c00000;">**Marchers**</span> biases that DuFour currently harbors. Moreover, he subscribes to the "taming strategy" concerning the <span style="color: #7A3C00;">Royalists</span>. It is imperative that we field a candidate of our own to prevent such an outcome.

His candidacy is supported by the <span style="color: #C0A054;">**Golds**</span>.

- @harzburg: We await the decision of the Harzburg Front.

@luther
title: Hans Lytton, [? if luther_reichsbank: president of the Commonwealth Bank?][? if not luther_reichsbank: leader of the [? if not lvp_formed: <span style="color: #C0A054;">**Golds**</span>?][? if lvp_formed: <span style="color: #C0A054;">**Golds**</span>?]?] and former chancellor.
view-if: luther_unlock_pres
on-arrival: reactionary_candidate_1932_count_2 -= 1
face-image: img/portraits/luther.jpg
max-visits: 1
go-to: reactionary_candidates if reactionary_candidate_1932_count_2 > 0

Hans Lytton, former Chancellor of the first federal right-wing coalition and key figure in addressing the hyperinflationary crisis, is certainly not lacking in the experience required to assume the presidency of the Commonwealth. Among his peers, he stands out as relatively open to constructive cooperation with the <span style="color: #c00000;">**Marchers**</span>, though it is clear that he favors a presidential propertied government over continued <span style="color: #c00000;">Reformist</span> participation in power. Despite his party affiliation, he is widely viewed as a non-partisan candidate.

His candidacy is supported by the [? if not lvp_formed: <span style="color: #C0A054;">**Golds**</span>?][? if lvp_formed: <span style="color: #C0A054;">**Golds**</span>?]. [? if not lvp_formed: He is also nominally supported by the <span style="color: #D3C24D;">**[+ ddp_name +]**</span>. ?]

- @harzburg: We await the decision of the Harzburg Front.

@gessler
title: Gareth Gesling, controversial former Defense Minister and former <span style="color: #D3C24D;">**Golds**</span> member.
view-if: gessler_unlock_pres
on-arrival: reactionary_candidate_1932_count_2 -= 1
face-image: img/portraits/gessler.jpg
max-visits: 1
go-to: reactionary_candidates if reactionary_candidate_1932_count_2 > 0

Gareth Gesling, who served as Defense Minister for eight years following Brask’s departure and preceding Ravabelle, is a conservative and a <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> by reason rather than conviction—often at odds with his colleagues in the <span style="color: #D3C24D;">**Golds**</span> throughout his tenure. He made little effort to reform the Commonwealth Army and played an active role in the <i>Commonwealth intervention</i> against our United Left governments in Dornwich and Stathmore during the Commonwealth October. Now, after stepping away from politics in early 4293, he seeks a return to the national stage.

His candidacy is supported by the [? if not lvp_formed: <span style="color: #C0A054;">**Golds**</span>?][? if lvp_formed: <span style="color: #C0A054;">**Golds**</span>?]. [? if not lvp_formed: He is also nominally supported by the <span style="color: #D3C24D;">**[+ ddp_name +]**</span>, which has grown more right-wing and more accepting over the years. ?]

- @harzburg: We await the decision of the Harzburg Front.

@adenauer
title: Konrad Aldermoor, Mayor of Bradford, and an advocate for the <span style="color: #000000;">Unionist Party</span> "leaving the tower".
view-if: adenauer_unlock_pres
on-arrival: reactionary_candidate_1932_count_2 -= 1
face-image: img/portraits/adenauer.jpg
max-visits: 1
go-to: reactionary_candidates if reactionary_candidate_1932_count_2 > 0

Konrad Aldermoor, a staunch advocate of the <span style="color: #000000;">Unionist Party</span>'s strategy to "leave the tower" and open itself to Protestant support, has decided to run for the presidency after achieving that very aim. Still relatively inexperienced in national politics, the Mayor is known for his strong anti-Heartland stance—going so far as to reject a chancellorship offer in 4291 on the grounds that Stratton was "too Heartland." Aligned with Sedgewick and situated on the party's right wing, Aldermoor has expressed interest in the so-called "taming strategy" toward the <span style="color: #7A3C00;">Royalists</span>.

His candidacy is supported by the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?].

- @harzburg: We await the decision of the Harzburg Front.

@bruning
title: Edmund Askew, on the [? if not concord_formed: right wing?][? if concord_formed: left wing?] of the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] and their[? if chancellor == "Askew":&nbsp;candidate for?] chancellor.
view-if: bruning_unlock_pres
on-arrival: reactionary_candidate_1932_count_2 -= 1
unavailable-subtitle: Words.
face-image: img/portraits/AskewHeinrich.jpg
max-visits: 1
go-to: reactionary_candidates if reactionary_candidate_1932_count_2 > 0

Edmund Askew, a politician we know all too well, is running for the most powerful position in the Commonwealth. He has a long history, tracing back to the Christian Trade Unions and his mentorship under Sedgewick, eventually rising to become the leader of the party's parliamentary group and its candidate for Chancellor. Despite his record of favoring austerity and deflationary policies in response to the Great Depression, he is a flexible figure—intelligent enough to recognize the dangers of the "taming strategy," and not entirely opposed to governing alongside the <span style="color: #c00000;">**Marchers**</span>.

His candidacy is supported by the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?]. 

- @harzburg: We await the decision of the Harzburg Front.

@stegerwald
title: Adam Sedgewick, on the [? if not concord_formed: right wing?][? if concord_formed: left wing?] of the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?] and a prominent Christian trade unionist.
view-if: stegerwald_unlock_pres
on-arrival: reactionary_candidate_1932_count_2 -= 1
unavailable-subtitle: Words.
face-image: img/portraits/stegerwald.jpg
max-visits: 1
go-to: reactionary_candidates if reactionary_candidate_1932_count_2 > 0

Adam Sedgewick, situated on the right wing of the <span style="color: #000000;">Unionist Party</span>, and having advocated for it to "leave the tower" and open up the party to Protestants, has made himself a controversial figure among many. However, perhaps a man with his ideals—of a <span style="color: #000000;">Christian</span>, <span style="color: #586593;">democratic</span>, <span style="color: #000000;">Commonwealth</span>, and <span style="color: #c00000;">social</span> the Commonwealth—can be the one to unite it. Despite his background as a unionist, he would rather work with the political Right than the <span style="color: #c00000;">**Marchers**</span> if possible.

His candidacy is supported by the [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionist Party</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?]. [? if kvp_formed or traditionalist_ideology == "Moderate": He may attract some crossover support from the <span style="color: #3E88B3;">nationalists</span>. ?]

- @harzburg: We await the decision of the Harzburg Front.

@vorbeck
title: Paul von Lethmoor, war hero of the Great War and [? if not concord_formed: [? if traditionalist_ideology == "Radical": <span style="color: #0087DC;">**KVP**</span>?][? if traditionalist_ideology == "Moderate": <span style="color: #3E88B3;">**Traditionalists**</span>?]?][? if concord_formed: <span style="color: #000000;">**Concord**</span>?] member.
view-if: vorbeck_unlock_pres
on-arrival: reactionary_candidate_1932_count_2 -= 1
unavailable-subtitle: Lethmoor is reluctant to lead, and prefers his unglamorous life away from the public. Unless he is convinced, of course.
face-image: img/portraits/lettowvorbeck.jpg
max-visits: 1
go-to: reactionary_candidates if reactionary_candidate_1932_count_2 > 0

By some miracle for the Commonwealth Right, they have managed to persuade Paul von Lethmoor—renowned for his successful guerrilla campaign in Commonwealth East Africa during the Great War—to run for the presidency. However, the circumstances now are far more dire than they were in 4290. The Commonwealth Right is significantly less unified behind Lethmoor than it had been for President DuFour.

How Lethmoor would govern remains uncertain. It is highly likely that, much like DuFour, a camarilla of close advisors would shape his decisions from behind the scenes.

His candidacy is backed by the [? if not vorbeck_fallback: [? if not concord_formed: [? if traditionalist_ideology == "Radical": <span style="color: #0087DC;">**KVP**</span>?][? if traditionalist_ideology == "Moderate": <span style="color: #3E88B3;">**Traditionalists**</span>?]?][? if concord_formed: <span style="color: #000000;">**Concord**</span>?], along with a disparate coalition of minor propertied parties. ?][? if vorbeck_fallback: entirety of the Bürgerblock parties, who view him as their collective last hope at retaining power. ?]

- @harzburg: We await the decision of the Harzburg Front.

@westarp
title: Kuno von Westmore, [? if traditionalist_leader != "Westmore": former?] leader of the <span style="color: #3E88B3;">**Traditionalists**</span>, and an old friend of DuFour.
view-if: westarp_unlock_pres
on-arrival: reactionary_candidate_1932_count_2 -= 1
face-image: img/portraits/Kuno_von_Westarp.jpg
max-visits: 1
go-to: reactionary_candidates if reactionary_candidate_1932_count_2 > 0

Kuno von Westmore, a familiar figure in Commonwealth politics, has long been a stalwart of the <span style="color: #3E88B3;">**Traditionalists**</span>, once serving as both party leader and head of its parliamentary group. While not entirely opposed to his party’s participation in a <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> system, he has made no secret of his monarchist aspirations. His rigid partisanship and staunchly anti-<span style="color: #c00000;">Reformist</span> convictions are likely to define his rule—perhaps even making him a more hostile figure than DuFour.

It is imperative that we prevail over these forces of reaction if we are to have any hope of returning to government.

His candidacy is backed by the [? if traditionalist_ideology == "Radical": <span style="color: #0087DC;">**KVP**</span>?][? if traditionalist_ideology == "Moderate": <span style="color: #3E88B3;">**Traditionalists**</span>?], along with a disparate coalition of minor propertied parties.

- @harzburg: We await the decision of the Harzburg Front.

@hindenburg
view-if: dufour_run
face-image: img/portraits/DuFour.jpg

President DuFour is, of course, running for re-election, and many in our party are prepared to support him as the last bastion of democracy against Gallax and the <span style="color: #7A3C00;">Royalists</span>. The <span class="tooltip-text" title="Following DuFour's overseeing of the Commonwealth's crushing victory at Tannenberg in the Great War, DuFour has become the center of a massive personality cult, lauded as the living ideal of Commonwealth masculinity and patriotism. He is the embodiment of the best virtues of Heartland tradition.">DuFour Mythos</span> serves as a powerful rallying point for all parties, as he maintains high personal popularity despite everything the Commonwealth has endured. However, the more support he receives from the Commonwealth left and center, the more DuFour views it as a stain on his personal honor. The refusal of August von Mackensen and other high-ranking officers with whom he served during the war to embrace his candidacy proved particularly painful to the Commonwealth president.

In response, he may shift further to the right after the election in an effort to restore his sense of honor and to appease his former comrades and friends on the Commonwealth Right. This urge has only been reinforced by the Harzburg Front’s refusal to support him without concessions, as they see DuFour as the greatest obstacle to their rise to power.

- @harzburg: We await the decision of the Harzburg Front.

@harzburg
go-to: duesterberg if traditionalist_votes < 8 and traditionalist_ideology == "Radical"; hugenberg if (traditionalist_votes >= 8 and traditionalist_ideology == "Radical") or traditionalist_ideology == "Moderate"


@duesterberg
face-image: img/portraits/duesterberg.jpg

The Harzburg Front has fractured, with the <span style="color: #3E88B3;">**Traditionalists**</span> and <span style="color: #3E88B3;">**Wardens**</span> nominating a separate candidate than the <span style="color: #7A3C00;">**Royalists**</span>, who rather run their own candidate. In a deal between the leadership of the <span style="color: #3E88B3;">**Wardens**</span> and Mallin, the <span style="color: #3E88B3;">**Traditionalists**</span> is to support and campaign for whoever the <span style="color: #3E88B3;">**Wardens**</span> nominates, in exchange for the <span style="color: #3E88B3;">**Wardens**</span>'s full support for the <span style="color: #3E88B3;">**Traditionalists**</span> in the upcoming local elections. The <span style="color: #3E88B3;">**Wardens**</span> have decided to nominate its deputy leader, Rafe Dusterel.

- @nsdap_selection: Who will the <span style="color: #7A3C00;">**Royalists**</span> run?

@hugenberg
on-arrival: {!
Q.traditionalist_candidate_1932 = "Mallin";
Q.traditionalist_candidate_1932_disp = "Alfred Mallin";
!}
face-image: img/portraits/AlfredMallin.jpg

The Harzburg Front has fractured, with the [? if traditionalist_ideology == "Radical": <span style="color: #3E88B3;">**Traditionalists**</span>?][? if traditionalist_ideology == "Moderate": <span style="color: #003755;">**DNF**</span>?] choosing to nominate its unpopular leader, Alfred Mallin, rather than support the <span style="color: #7A3C00;">**Royalists**</span>'s candidate. Mallin's decision is driven by ego; his well-known flaws—an absence of charisma, an aloof detachment from ordinary Germans, and a reputation for obstruction—render his campaign almost certainly doomed.

[? if traditionalist_ideology == "Radical": The <span style="color: #3E88B3;">**Wardens**</span>, infuriated by Mallin's abandonment of negotiations for a united front, have reverted to their traditional stance of non-partisanship, a position long favored by many in their ranks. Nonetheless, their supporters are expected to divide roughly evenly among the right-wing candidates. ?][? if traditionalist_ideology == "Moderate": If there was ever a chance of the <span style="color: #3E88B3;">**Wardens**</span> supporting a candidate of the <span style="color: #7A3C00;">national</span> <span style="color: #003755;">opposition</span>, it has vanished with the hated Mallin entering the race. ?]

- @nsdap_selection: Who will the <span style="color: #7A3C00;">**Royalists**</span> run?

@nsdap_selection
go-to: hitler if ((royalist_votes >= 15 and dufour_run) or (royalist_votes >= 10 and not dufour_run)) and gallax_citizen; goring if not gallax_citizen; frick if ((royalist_votes < 15 and dufour_run) or (royalist_votes < 10 and not dufour_run)) and gallax_citizen

@hitler
on-arrival: {!
Q.royalist_candidate_1932 = "Gallax";
Q.royalist_candidate_1932_disp = "Alaric Gallax";
!}
view-if: not harzburg_unity
face-image: img/portraits/hitler2.jpg

The <span style="color: #7A3C00;">**Royalists**</span> will run Alaric Gallax, who is likely to only receive the backing of his own party. [? if dufour_run: However, there has been some reluctance on Gallax's part to run against President DuFour, with his character commanding great respect throughout all corners of the Commonwealth. Furthermore, the second most important leader in the <span style="color: #7A3C00;">**Royalists**</span>, Garrick Crowde, opposes his candidacy as he believes he cannot defeat DuFour, but <span style="color: #7A3C00;">Royalist</span> propagandist Alden Standerton argues for it. We suspect that the <span style="color: #7A3C00;">Royalists</span> are putting on a show of indecisiveness, and always had Gallax as as candidate in mind. ?][? if not dufour_run: Gallax is somewhat reluctant to run in the election, believing he cannot win outright. However, the propaganda value of putting the charismatic Gallax forward ahead of the local elections has justified the risk. If he were to win, it would likely mean the swift collapse of the Republic—and possibly civil war. ?]

- @collectivist: We await the decision the <span style="color: #700000;">Collectivists</span>.

@frick
on-arrival: {!
Q.royalist_candidate_1932 = "Frask";
Q.royalist_candidate_1932_disp = "Bram Frask";
!}
view-if: not harzburg_unity
face-image: img/portraits/frick.jpg

The <span style="color: #7A3C00;">**Royalists**</span> has nominated Bram Frask, who is expected to receive backing only from his own party. [? if dufour_run: The decision to run Frask instead of the more charismatic and popular Gallax stems from Gallax’s deep reluctance to challenge the universally respected and personally popular President DuFour—believing such a move would tarnish his image. Garrick Crowde’s argument ultimately prevailed over Standerton’, and Gallax has chosen to sit this one out. ?][? if not dufour_run: The decision to run Frask instead of the more charismatic and popular Gallax stems from Gallax’s reluctance to enter an unwinnable race, fearing it would damage his image. By putting forward the more pragmatic Frask, he hopes to attract some conservative support ahead of the local elections.?] Should Frask win, he would serve as little more than a proxy for the <span style="color: #7A3C00;">Royalist</span> leader. 

- @collectivist: We await the decision the <span style="color: #700000;">Collectivists</span>.

@goring
on-arrival: {!
Q.royalist_candidate_1932 = "Gorrick";
Q.royalist_candidate_1932_disp = "Ulric Gorrick";
!}
view-if: not harzburg_unity
face-image: img/portraits/goring.jpg

The <span style="color: #7A3C00;">**Royalists**</span> has nominated Ulric Gorrick, who is expected to receive support solely from his own party. Normally, Gallax would have been their candidate, but for one reason or another, he is disqualified from the race. With his reputation as a decorated fighter ace from the Great War and his strong ties to the conservative establishment and industrial elites, Gorrick will win over some <span style="color: #3E88B3;">nationalists</span> who might have otherwise been wary of Gallax. Still, Gorrick is widely expected to act as little more than a proxy, taking direction from the <span style="color: #7A3C00;">Royalist</span> leader operating behind the scenes.

- @collectivist: We await the decision the <span style="color: #700000;">Collectivists</span>.

@collectivist
go-to: thalmann


@thalmann
face-image: img/portraits/HalsmarkErnst.jpg

The <span style="color: #700000;">**Collectivists**</span> will run Ernst Halsmark, their leader and candidate in 4290. If we were to not run a candidate, or to support a right-wing or propertied one, Halsmark and the <span style="color: #700000;">**Collectivists**</span> would greatly capitalize by painting themselves as the only left-wing option in the race. However, if our relations with the <span style="color: #700000;">**Collectivists**</span> are high enough, we may be able to convince him to drop out in favour of a unity candidate between our two parties.

- @Reformist: So, what is our decision? Should we run our own candidate?

@Reformist
go-to: braun


@braun
face-image: img/portraits/braun.jpg

Lyle Bristol has been floated around as a candidate for the presidency once more, after his failed run in 4290. He is personally reluctant, and it would take a lot of convincing to get him to run, but after that, could he even win? It's unlikely for propertied parties to outright support a <span style="color: #c00000;">Reformist</span> for President, even with his reformist and right-wing leanings within our own party. Joshua Heath and other Heartland officials have instead proposed running Hugo Eckhart, a nationalist anti-<span style="color: #7A3C00;">Royalist</span> Zeppelin pilot[? if dufour_run:, but this possibility has been extinguished with DuFour's decision to run again?][? if not dufour_run:, but he is personally reluctant?].

[? if collectivist_relation >= 50: Another proposal from our Left faction is the candidacy of Cael Pendrigon as a <span style="color: #9B0000;">Vaelist</span> unity candidate representing both the <span style="color: #c00000;">**Marchers**</span>[? if left_split:, <span style="color: #9B0000;">**SAPD**</span>?] and the <span style="color: #700000;">**Collectivists**</span>. His alignment with our left wing, his ideological convictions, and his legal defense of <span style="color: #700000;">**Collectivists**</span> members make such a ticket plausible. However, this move would almost certainly alienate the propertied parties—perhaps permanently. ?]

So, what's our choice?

- @run_braun: Run Lyle Bristol of the <span style="color: #c00000;">**Marchers**</span>.
- @run_rosenfeld: Run Cael Pendrigon of the [? if not left_split: <span style="color: #c00000;">**Marchers**</span>?][? if left_split: <span style="color: #9B0000;">**SAPD**</span>?].
- @run_eckener: Run Hugo Eckhart as a unity candidate.
- @support_hindenburg: Support <span style="color: #808080;">DuFour</span>.
- @support_reactionary: Support [? if (reactionary_candidate_1932 == "Lytton" or reactionary_candidate_1932 == "Gesling" or reactionary_candidate_1932 == "Jarrow") and lvp_formed: <span style="color: #FFCC00;">**[+ reactionary_candidate_1932 +]**</span>?][? if (reactionary_candidate_1932 == "Lytton" or reactionary_candidate_1932 == "Jarrow") and not lvp_formed: <span style="color: #C0A054;">**[+ reactionary_candidate_1932 +]**</span>?][? if reactionary_candidate_1932 == "Gesling" and not lvp_formed: <span style="color: #D3C24D;">**[+ reactionary_candidate_1932 +]**</span>?][? if ((reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or reactionary_candidate_1932 == "Westmore") and not kvp_formed: <span style="color: #3E88B3;">**[+ reactionary_candidate_1932 +]**</span>?][? if ((reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or reactionary_candidate_1932 == "Westmore") and kvp_formed: <span style="color: #0087DC;">**[+ reactionary_candidate_1932 +]**</span>?][? if reactionary_candidate_1932 == "Aldermoor" or reactionary_candidate_1932 == "Askew" or reactionary_candidate_1932 == "Sedgewick" or (reactionary_candidate_1932 == "Lethmoor" and concord_formed): <span style="color: #000000;">**[+ reactionary_candidate_1932 +]**</span>?].
- @support_reactionary_2: Support [? if (secondary_reactionary_candidate_1932 == "Lytton" or secondary_reactionary_candidate_1932 == "Gesling" or secondary_reactionary_candidate_1932 == "Jarrow") and lvp_formed: <span style="color: #FFCC00;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if (secondary_reactionary_candidate_1932 == "Lytton" or secondary_reactionary_candidate_1932 == "Jarrow") and not lvp_formed: <span style="color: #C0A054;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if secondary_reactionary_candidate_1932 == "Gesling" and not lvp_formed: <span style="color: #D3C24D;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if ((secondary_reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or secondary_reactionary_candidate_1932 == "Westmore") and not kvp_formed: <span style="color: #3E88B3;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if ((secondary_reactionary_candidate_1932 == "Lethmoor" and not concord_formed) or secondary_reactionary_candidate_1932 == "Westmore") and kvp_formed: <span style="color: #0087DC;">**[+ secondary_reactionary_candidate_1932 +]**</span>?][? if secondary_reactionary_candidate_1932 == "Aldermoor" or secondary_reactionary_candidate_1932 == "Askew" or secondary_reactionary_candidate_1932 == "Sedgewick" or (secondary_reactionary_candidate_1932 == "Lethmoor" and concord_formed): <span style="color: #000000;">**[+ secondary_reactionary_candidate_1932 +]**</span>?].
- @support_thalmann: Support [+ communist_candidate_1932_disp +] of the <span style="color: #700000;">**Collectivists**</span>.
- @abstain: Abstain from endorsing any candidate.

