title: Thuringian state Assembly Election
view-if: (year == 1929 and month == 12 and not thuringia_election_seen) or (thuringia_election_2_trigger_time == time and thuringia_election_seen_time != time)
new-page: true
tags: event
on-arrival: thuringia_election_seen = 1; thuringia_election_seen_time = time
priority: 2
on-display: {!  
    var cardEl = document.createElement('div');  
    cardEl.className = "face-figure2";  

    var image = new Image();  
    image.className = "face-img";  
    image.src = "img/states.png";  

    cardEl.appendChild(image);  
    var contentDiv = document.querySelector("#page #mid_panel #content");
    contentDiv.appendChild(cardEl);
!}

= Elections, [+ month : month +] [+ year_display +]

The Thuringian state elections are to be held now.

- @thuringia: May we do our best...

@thuringia
on-arrival: {!

var thuringia_adjustment_factors = {
    spd: 1.15,
    sapd: 1.0,
    kpd: 1.15,
    ddp: 0.8,
    lvp: 1.0,
    z: 0.08,
    dvp: 1.5,
    dnvp: 0.4,
    nsdap: 1.1,
    other: 1.9,
    kvp: 1.3,
    dnf: 0.3
};

Q.marcher_r_thuringia = 0;
Q.sapd_r_thuringia = 0;
Q.collectivist_r_thuringia = 0;
Q.ddp_r_thuringia = 0;
Q.lvp_r_thuringia = 0;
Q.unionist_r_thuringia = 0;
Q.gold_r_thuringia = 0;
Q.traditionalist_r_thuringia = 0;
Q.royalist_r_thuringia = 0;
Q.other_r_thuringia = 0;
Q.kvp_r_thuringia = 0;
Q.dnf_r_thuringia = 0;

Q.marcher_thuringia_elections_vote = 0;
Q.sapd_thuringia_elections_vote = 0;
Q.collectivist_thuringia_elections_vote = 0;
Q.ddp_thuringia_elections_vote = 0;
Q.lvp_thuringia_elections_vote = 0;
Q.unionist_thuringia_elections_vote = 0;
Q.gold_thuringia_elections_vote = 0;
Q.traditionalist_thuringia_elections_vote = 0;
Q.royalist_thuringia_elections_vote = 0;
Q.other_thuringia_elections_vote = 0;
Q.kvp_thuringia_elections_vote = 0;
Q.dnf_thuringia_elections_vote = 0;

if (Q.burgher_marcher_normalized + Q.guild_marcher_normalized >= 30) thuringia_adjustment_factors.spd += 0.1;
if (Q.landed_marcher_normalized >= 20) thuringia_adjustment_factors.spd += 0.1;
Q.marcher_thuringia_elections_vote = Q.marcher_votes*thuringia_adjustment_factors.spd;
Q.sapd_thuringia_elections_vote = Q.sapd_votes*thuringia_adjustment_factors.sapd;
Q.collectivist_thuringia_elections_vote = Q.collectivist_votes*thuringia_adjustment_factors.kpd;
if (Q.stolper_program_adopted) thuringia_adjustment_factors.ddp += 0.6;
Q.ddp_thuringia_elections_vote = Q.ddp_votes*thuringia_adjustment_factors.ddp;
Q.lvp_thuringia_elections_vote = Q.lvp_votes*thuringia_adjustment_factors.lvp;
if (!Q.stegerwald_path) Q.unionist_thuringia_elections_vote = Q.unionist_votes*thuringia_adjustment_factors.z;
if (Q.stegerwald_path) Q.unionist_thuringia_elections_vote = Q.unionist_votes * 0.8;
if (Q.gold_leader != "Eikenvorst") thuringia_adjustment_factors.dvp += 0.1;
Q.gold_thuringia_elections_vote = Q.gold_votes*thuringia_adjustment_factors.dvp;
if (Q.traditionalist_ideology == "Moderate") thuringia_adjustment_factors.dnvp += 1.0;
Q.traditionalist_thuringia_elections_vote = Q.traditionalist_votes*thuringia_adjustment_factors.dnvp;
Q.royalist_thuringia_elections_vote = Q.royalist_votes*thuringia_adjustment_factors.nsdap;
if (Q.gold_leader != "Eikenvorst") thuringia_adjustment_factors.other -= 0.1;
if (Q.stolper_program_adopted) thuringia_adjustment_factors.other -= 0.1;
Q.other_thuringia_elections_vote = Q.other_votes*thuringia_adjustment_factors.other;
Q.kvp_thuringia_elections_vote = Q.kvp_votes*thuringia_adjustment_factors.kvp;
Q.dnf_thuringia_elections_vote = Q.dnf_votes*thuringia_adjustment_factors.dnf;

Q.total_votes_thuringia = Q.marcher_thuringia_elections_vote + Q.sapd_thuringia_elections_vote + Q.collectivist_thuringia_elections_vote + Q.ddp_thuringia_elections_vote + Q.lvp_thuringia_elections_vote + Q.unionist_thuringia_elections_vote + Q.gold_thuringia_elections_vote + Q.traditionalist_thuringia_elections_vote + Q.royalist_thuringia_elections_vote + Q.other_thuringia_elections_vote + Q.kvp_thuringia_elections_vote + Q.dnf_thuringia_elections_vote;

if (Q.total_votes_thuringia > 0) {
    Q.marcher_thuringia_elections_vote = (Q.marcher_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.sapd_thuringia_elections_vote = (Q.sapd_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.collectivist_thuringia_elections_vote = (Q.collectivist_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.ddp_thuringia_elections_vote = (Q.ddp_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.lvp_thuringia_elections_vote = (Q.lvp_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.unionist_thuringia_elections_vote = (Q.unionist_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.gold_thuringia_elections_vote = (Q.gold_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.traditionalist_thuringia_elections_vote = (Q.traditionalist_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.royalist_thuringia_elections_vote = (Q.royalist_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.other_thuringia_elections_vote = (Q.other_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.kvp_thuringia_elections_vote = (Q.kvp_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.dnf_thuringia_elections_vote = (Q.dnf_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    let target = 32;
    Q.marcher_thuringia_elections_vote = Math.round((Q.marcher_thuringia_elections_vote + (target - Q.marcher_thuringia_elections_vote) * 0.35) * 10) / 10;
    Q.total_votes_thuringia = Q.marcher_thuringia_elections_vote + Q.sapd_thuringia_elections_vote + Q.collectivist_thuringia_elections_vote + Q.ddp_thuringia_elections_vote + Q.lvp_thuringia_elections_vote + Q.unionist_thuringia_elections_vote + Q.gold_thuringia_elections_vote + Q.traditionalist_thuringia_elections_vote + Q.royalist_thuringia_elections_vote + Q.other_thuringia_elections_vote + Q.kvp_thuringia_elections_vote + Q.dnf_thuringia_elections_vote;
    Q.marcher_thuringia_elections_vote = (Q.marcher_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.sapd_thuringia_elections_vote = (Q.sapd_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.collectivist_thuringia_elections_vote = (Q.collectivist_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.ddp_thuringia_elections_vote = (Q.ddp_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.lvp_thuringia_elections_vote = (Q.lvp_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.unionist_thuringia_elections_vote = (Q.unionist_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.gold_thuringia_elections_vote = (Q.gold_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.traditionalist_thuringia_elections_vote = (Q.traditionalist_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.royalist_thuringia_elections_vote = (Q.royalist_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.other_thuringia_elections_vote = (Q.other_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.kvp_thuringia_elections_vote = (Q.kvp_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
    Q.dnf_thuringia_elections_vote = (Q.dnf_thuringia_elections_vote / Q.total_votes_thuringia) * 100;
}

Q.marcher_thuringia_elections_vote = (Q.marcher_thuringia_elections_vote != undefined ? parseFloat(Q.marcher_thuringia_elections_vote.toFixed(1)) : 0);
Q.sapd_thuringia_elections_vote = (Q.sapd_thuringia_elections_vote != undefined ? parseFloat(Q.sapd_thuringia_elections_vote.toFixed(1)) : 0);
Q.collectivist_thuringia_elections_vote = (Q.collectivist_thuringia_elections_vote != undefined ? parseFloat(Q.collectivist_thuringia_elections_vote.toFixed(1)) : 0);
Q.ddp_thuringia_elections_vote = (Q.ddp_thuringia_elections_vote != undefined ? parseFloat(Q.ddp_thuringia_elections_vote.toFixed(1)) : 0);
Q.lvp_thuringia_elections_vote = (Q.lvp_thuringia_elections_vote != undefined ? parseFloat(Q.lvp_thuringia_elections_vote.toFixed(1)) : 0);
Q.unionist_thuringia_elections_vote = (Q.unionist_thuringia_elections_vote != undefined ? parseFloat(Q.unionist_thuringia_elections_vote.toFixed(1)) : 0);
Q.gold_thuringia_elections_vote = (Q.gold_thuringia_elections_vote != undefined ? parseFloat(Q.gold_thuringia_elections_vote.toFixed(1)) : 0);
Q.traditionalist_thuringia_elections_vote = (Q.traditionalist_thuringia_elections_vote != undefined ? parseFloat(Q.traditionalist_thuringia_elections_vote.toFixed(1)) : 0);
Q.royalist_thuringia_elections_vote = (Q.royalist_thuringia_elections_vote != undefined ? parseFloat(Q.royalist_thuringia_elections_vote.toFixed(1)) : 0);
Q.other_thuringia_elections_vote = (Q.other_thuringia_elections_vote != undefined ? parseFloat(Q.other_thuringia_elections_vote.toFixed(1)) : 0);
Q.kvp_thuringia_elections_vote = (Q.kvp_thuringia_elections_vote != undefined ? parseFloat(Q.kvp_thuringia_elections_vote.toFixed(1)) : 0);
Q.dnf_thuringia_elections_vote = (Q.dnf_thuringia_elections_vote != undefined ? parseFloat(Q.dnf_thuringia_elections_vote.toFixed(1)) : 0);

if (Q.marcher_thuringia_elections_vote >= 1.6) Q.marcher_r_thuringia = Q.marcher_thuringia_elections_vote;
if (Q.sapd_thuringia_elections_vote >= 1.6) Q.sapd_r_thuringia = Q.sapd_thuringia_elections_vote;
if (Q.collectivist_thuringia_elections_vote >= 1.6) Q.collectivist_r_thuringia = Q.collectivist_thuringia_elections_vote;
if (Q.ddp_thuringia_elections_vote >= 1.6) Q.ddp_r_thuringia = Q.ddp_thuringia_elections_vote;
if (Q.lvp_thuringia_elections_vote >= 1.6) Q.lvp_r_thuringia = Q.lvp_thuringia_elections_vote;
if (Q.unionist_thuringia_elections_vote >= 1.6) Q.unionist_r_thuringia = Q.unionist_thuringia_elections_vote;
if (Q.gold_thuringia_elections_vote >= 1.6) Q.gold_r_thuringia = Q.gold_thuringia_elections_vote;
if (Q.traditionalist_thuringia_elections_vote >= 1.6) Q.traditionalist_r_thuringia = Q.traditionalist_thuringia_elections_vote;
if (Q.royalist_thuringia_elections_vote >= 1.6) Q.royalist_r_thuringia = Q.royalist_thuringia_elections_vote;
if (Q.other_thuringia_elections_vote >= 1.6) Q.other_r_thuringia = Q.other_thuringia_elections_vote;
if (Q.kvp_thuringia_elections_vote >= 1.6) Q.kvp_r_thuringia = Q.kvp_thuringia_elections_vote;
if (Q.dnf_thuringia_elections_vote >= 1.6) Q.dnf_r_thuringia = Q.dnf_thuringia_elections_vote;

var thuringia_adjustment_r_factors = {
    spd: 1.0,
    sapd: 1.0,
    kpd: 0.92,
    ddp: 0.5,
    lvp: 1.0,
    z: 0.0,
    dvp: 1.0,
    dnvp: 0.95,
    nsdap: 1.1,
    other: 1.0,
    kvp: 1.0,
    dnf: 0.3
};

Q.marcher_r_thuringia = Q.marcher_r_thuringia*thuringia_adjustment_r_factors.spd;
Q.sapd_r_thuringia = Q.sapd_r_thuringia*thuringia_adjustment_r_factors.sapd;
Q.collectivist_r_thuringia = Q.collectivist_r_thuringia*thuringia_adjustment_r_factors.kpd;
if (Q.stolper_program_adopted) thuringia_adjustment_r_factors.ddp += 0.5;
Q.ddp_r_thuringia = Q.ddp_r_thuringia*thuringia_adjustment_r_factors.ddp;
Q.lvp_r_thuringia = Q.lvp_r_thuringia*thuringia_adjustment_r_factors.lvp;
if (!Q.stegerwald_path) Q.unionist_r_thuringia = Q.unionist_r_thuringia*thuringia_adjustment_r_factors.z;
if (Q.stegerwald_path) Q.unionist_r_thuringia = Q.unionist_r_thuringia;
Q.gold_r_thuringia = Q.gold_r_thuringia*thuringia_adjustment_r_factors.dvp;
Q.traditionalist_r_thuringia = Q.traditionalist_r_thuringia*thuringia_adjustment_r_factors.dnvp;
Q.royalist_r_thuringia = Q.royalist_r_thuringia*thuringia_adjustment_r_factors.nsdap;
if (Q.stolper_program_adopted) thuringia_adjustment_r_factors.other -= 0.1;
Q.other_r_thuringia = Q.other_r_thuringia*thuringia_adjustment_r_factors.other;
Q.kvp_r_thuringia = Q.kvp_r_thuringia*thuringia_adjustment_r_factors.kvp;
Q.dnf_r_thuringia = Q.dnf_r_thuringia*thuringia_adjustment_r_factors.dnf;

Q.total_r_thuringia = 0;

if (Q.marcher_r_thuringia) Q.total_r_thuringia += Q.marcher_r_thuringia;
if (Q.sapd_r_thuringia) Q.total_r_thuringia += Q.sapd_r_thuringia;
if (Q.collectivist_r_thuringia) Q.total_r_thuringia += Q.collectivist_r_thuringia;
if (Q.ddp_r_thuringia) Q.total_r_thuringia += Q.ddp_r_thuringia;
if (Q.lvp_r_thuringia) Q.total_r_thuringia += Q.lvp_r_thuringia;
if (Q.unionist_r_thuringia) Q.total_r_thuringia += Q.unionist_r_thuringia;
if (Q.gold_r_thuringia) Q.total_r_thuringia += Q.gold_r_thuringia;
if (Q.traditionalist_r_thuringia) Q.total_r_thuringia += Q.traditionalist_r_thuringia;
if (Q.royalist_r_thuringia) Q.total_r_thuringia += Q.royalist_r_thuringia;
if (Q.other_r_thuringia) Q.total_r_thuringia += Q.other_r_thuringia;
if (Q.kvp_r_thuringia) Q.total_r_thuringia += Q.kvp_r_thuringia;
if (Q.dnf_r_thuringia) Q.total_r_thuringia += Q.dnf_r_thuringia;

if (Q.total_r_thuringia > 0) {
    Q.marcher_r_thuringia = (Q.marcher_r_thuringia / Q.total_r_thuringia) * 100;
    Q.sapd_r_thuringia = (Q.sapd_r_thuringia / Q.total_r_thuringia) * 100;
    Q.collectivist_r_thuringia = (Q.collectivist_r_thuringia / Q.total_r_thuringia) * 100;
    Q.ddp_r_thuringia = (Q.ddp_r_thuringia / Q.total_r_thuringia) * 100;
    Q.lvp_r_thuringia = (Q.lvp_r_thuringia / Q.total_r_thuringia) * 100;
    Q.unionist_r_thuringia = (Q.unionist_r_thuringia / Q.total_r_thuringia) * 100;
    Q.gold_r_thuringia = (Q.gold_r_thuringia / Q.total_r_thuringia) * 100;
    Q.traditionalist_r_thuringia = (Q.traditionalist_r_thuringia / Q.total_r_thuringia) * 100;
    Q.royalist_r_thuringia = (Q.royalist_r_thuringia / Q.total_r_thuringia) * 100;
    Q.other_r_thuringia = (Q.other_r_thuringia / Q.total_r_thuringia) * 100;
    Q.kvp_r_thuringia = (Q.kvp_r_thuringia / Q.total_r_thuringia) * 100;
    Q.dnf_r_thuringia = (Q.dnf_r_thuringia / Q.total_r_thuringia) * 100;
}

let farm_share = 0.6;
if (Q.traditionalist_ideology == "Moderate") farm_share -= 0.3;
let wp_share = 0.35;
if (Q.stolper_program_adopted) wp_share -= 0.1;
if (Q.gold_leader != "Eikenvorst") wp_share -= 0.1;
let other_share = 0.05;

let total_share = wp_share + farm_share + other_share;

farm_share = (farm_share / total_share);
wp_share = (wp_share / total_share);

Q.farm_thuringia_elections_vote = Q.other_thuringia_elections_vote*farm_share;
Q.farm_r_thuringia = Q.other_r_thuringia*farm_share;

Q.wp_thuringia_elections_vote = Q.other_thuringia_elections_vote*wp_share;
Q.wp_r_thuringia = Q.other_r_thuringia*wp_share;

Q.true_other_thuringia_elections_vote = Q.other_thuringia_elections_vote*other_share;

Q.kpo_thuringia_elections_vote = Q.collectivist_thuringia_elections_vote*0.12
Q.collectivist_thuringia_elections_vote -= Q.kpo_thuringia_elections_vote;

function allocateSeats(percentages, totalSeats = 53) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    spd_r_thuringia: Q.marcher_r_thuringia,
    sapd_r_thuringia: Q.sapd_r_thuringia,
    kpd_r_thuringia: Q.collectivist_r_thuringia,
    ddp_r_thuringia: Q.ddp_r_thuringia,
    lvp_r_thuringia: Q.lvp_r_thuringia,
    z_r_thuringia: Q.unionist_r_thuringia,
    dvp_r_thuringia: Q.gold_r_thuringia,
    dnvp_r_thuringia: Q.traditionalist_r_thuringia,
    nsdap_r_thuringia: Q.royalist_r_thuringia,
    wp_r_thuringia: Q.wp_r_thuringia,
    farm_r_thuringia: Q.farm_r_thuringia,
    kvp_r_thuringia: Q.kvp_r_thuringia,
    dnf_r_thuringia: Q.dnf_r_thuringia
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 53).toFixed(1));
}

Q.other_r_thuringia = Q.farm_r_thuringia + Q.wp_r_thuringia;

Q.farm_thuringia_elections_vote = (Q.farm_thuringia_elections_vote != undefined ? parseFloat(Q.farm_thuringia_elections_vote.toFixed(1)) : 0);
Q.wp_thuringia_elections_vote = (Q.wp_thuringia_elections_vote != undefined ? parseFloat(Q.wp_thuringia_elections_vote.toFixed(1)) : 0);
Q.true_other_thuringia_elections_vote = (Q.true_other_thuringia_elections_vote != undefined ? parseFloat(Q.true_other_thuringia_elections_vote.toFixed(1)) : 0);
Q.kpo_thuringia_elections_vote = (Q.kpo_thuringia_elections_vote != undefined ? parseFloat(Q.kpo_thuringia_elections_vote.toFixed(1)) : 0);
Q.collectivist_thuringia_elections_vote = (Q.collectivist_thuringia_elections_vote != undefined ? parseFloat(Q.collectivist_thuringia_elections_vote.toFixed(1)) : 0);

Q.left_coalition_thuringia = parseFloat((Q.marcher_r_thuringia + Q.collectivist_r_thuringia + Q.sapd_r_thuringia).toFixed(1));
Q.bourgeois_coalition_thuringia = parseFloat((Q.unionist_r_thuringia + Q.ddp_r_thuringia + Q.gold_r_thuringia + Q.lvp_r_thuringia + Q.kvp_r_thuringia + Q.other_r_thuringia + Q.traditionalist_r_thuringia).toFixed(1));
Q.far_right_coalition_thuringia = parseFloat((Q.unionist_r_thuringia + Q.gold_r_thuringia + Q.lvp_r_thuringia + Q.kvp_r_thuringia + Q.other_r_thuringia + Q.traditionalist_r_thuringia + Q.royalist_r_thuringia + Q.dnf_r_thuringia).toFixed(1));
Q.marcher_coalition_thuringia = parseFloat((Q.marcher_r_thuringia + Q.ddp_r_thuringia + Q.lvp_r_thuringia + Q.unionist_r_thuringia + Q.gold_r_thuringia).toFixed(1));

!}
on-display: {!
data = [{
    "id": "collectivist",
    "legend": "Collectivist",
    "name": "Collectivist",
    "seats": Math.round(Q.collectivist_r_thuringia * 0.53),
}];

if (Q.sapd_formed && Q.sapd_r_thuringia) {
    data.push({
        "id": "sapd",
        "legend": "SAPD",
        "name": "SAPD",
        "seats": Math.round(Q.sapd_r_thuringia * 0.53),
    });
}

data = data.concat([{
    "id": "marcher",
    "legend": "Marcher",
    "name": "Marcher",
    "seats": Math.round(Q.marcher_r_thuringia * 0.53),
}]);

if (Q.ddp_r_thuringia && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r_thuringia * 0.53),
    });
}

if (Q.lvp_r_thuringia && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r_thuringia * 0.53),
    });
}

if (Q.unionist_r_thuringia) {
    data.push({
        "id": "unionist",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(Q.unionist_r_thuringia * 0.53),
    });
}

if (Q.gold_r_thuringia && !Q.lvp_formed && Q.gold_exist) {
    data.push({
        "id": "gold",
        "legend": "Gold",
        "name": "Gold",
        "seats": Math.round(Q.gold_r_thuringia * 0.53),
    });
}

if (Q.other_r_thuringia) {
    data.push({
        "id": "farm3",
        "legend": "Farm",
        "name": "Farm",
        "seats": Math.round(Q.farm_r_thuringia * 0.53),
    });
    data.push({
        "id": "wp",
        "legend": "WP",
        "name": "WP",
        "seats": Math.round(Q.wp_r_thuringia * 0.53),
    });
}
if (Q.kvp_formed && Q.kvp_r_thuringia) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round(Q.kvp_r_thuringia * 0.53),
    });
}

data = data.concat([{
    "id": "traditionalist",
    "legend": "Traditionalist",
    "name": "Traditionalist",
    "seats": Math.round(Q.traditionalist_r_thuringia * 0.53),
}]);
if (Q.dnf_formed && Q.dnf_r_thuringia) {
    data.push({
        "id": "dnf",
        "legend": "DNF",
        "name": "DNF",
        "seats": Math.round(Q.dnf_r_thuringia * 0.53),
    });
}
data = data.concat([{
    "id": "royalist",
    "legend": "Royalist",
    "name": "Royalist",
    "seats": Math.round(Q.royalist_r_thuringia * 0.53),
}, ]);

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("thuringia_landtag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#thuringia_landtag").datum(data).call(parliament);
}
!}
