@r2_start
on-arrival: {!
// 1. coordination between the right/far-right
if (!Q.concord_formed) {
    if (Q.Hitler_votes && Q.Reactionary_votes) {
        if (Q.Hitler_votes > Q.Reactionary_votes) {
            Q.traditionalist_candidate = "Gallax";
            Q.other_candidate = "Gallax";
            if (Q.kvp_candidate == Q.reactionary_candidate_1934) Q.kvp_candidate = "Gallax";
            Q.dnf_candidate = "Gallax";
            Q.Hitler_bonus = (Q.Hitler_bonus || 0) - 0.25*Q.other_votes;
            if (Q.center_running) {
                Q.Center_bonus = (Q.Center_bonus || 0) + 0.25*Q.other_votes;
            } else if (Q.lib_running) {
                Q.Liberal_bonus = (Q.Liberal_bonus || 0) + 0.25*Q.other_votes;
            }
        } else {
            Q.royalist_candidate = Q.reactionary_candidate_1934;
            Q.dnf_candidate = Q.reactionary_candidate_1934;
        }
    } else if (Q.Gorrick_votes && Q.Reactionary_votes) {
        if (Q.Gorrick_votes > Q.Reactionary_votes) {
            Q.traditionalist_candidate = "Gorrick";
            if (Q.kvp_candidate == Q.reactionary_candidate_1934) Q.other_candidate = "Gorrick";
            Q.dnf_candidate = "Gorrick";
            Q.Gorrick_bonus = (Q.Gorrick_bonus || 0) - 0.25*Q.other_votes;
            if (Q.center_running) {
                Q.Center_bonus = (Q.Center_bonus || 0) + 0.25*Q.other_votes;
            } else if (Q.lib_running) {
                Q.Liberal_bonus = (Q.Liberal_bonus || 0) + 0.25*Q.other_votes;
            }
        } else {
            Q.royalist_candidate = Q.reactionary_candidate_1934;
            Q.dnf_candidate = Q.reactionary_candidate_1934;
        }
    }
}
// 2. If Aldermoor & Gesling are both running and neither are part of the Marchers coalition, the smaller of these drops out.
Q.center_drops_out = 0;
Q.lib_drops_out = 0;
if (!Q.concord_formed) {
    if (Q.unionist_candidate == Q.center_candidate_1934 && (Q.ddp_candidate == Q.lib_candidate_1934 && !Q.lvp_formed || Q.gold_candidate == Q.lib_candidate_1934 && !Q.lvp_formed && Q.gold_exist || Q.lvp_candidate == Q.lib_candidate_1934 && Q.lvp_formed) && Q.unionist_candidate != Q.marcher_candidate && (Q.ddp_candidate != Q.marcher_candidate && !Q.lvp_formed || Q.gold_candidate != Q.marcher_candidate &&   !Q.lvp_formed && Q.gold_exist || Q.lvp_candidate != Q.marcher_candidate && Q.lvp_exist)) {
        if (Q.Center_votes > Q.Liberal_votes) {
            Q.lib_drops_out = 1;
            if (Q.ddp_candidate != Q.marcher_candidate) {
                Q.ddp_candidate = Q.center_candidate_1934;
            }
            if (Q.gold_candidate != Q.marcher_candidate) {
                Q.gold_candidate = Q.center_candidate_1934;
            }
            if (Q.lvp_candidate != Q.marcher_candidate) {
                Q.lvp_candidate = Q.center_candidate_1934;
            }
            Q.Center_bonus = (Q.Center_bonus || 0) + 0.25*Q.other_votes;
        } else {
            Q.center_drops_out = 1;
            Q.unionist_candidate = Q.lib_candidate_1934;
            Q.Liberal_bonus = 0.25*Q.other_votes;
        }
        if (Q.royalist_candidate == Q.reactionary_candidate_1934) {
            Q.Reactionary_bonus = (Q.Reactionary_bonus || 0) - 0.25*Q.other_votes;
        } else if (Q.royalist_candidate == "Gallax" || Q.royalist_candidate == "Gorrick") {
            Q.Hitler_bonus = (Q.Hitler_bonus || 0) - 0.25*Q.other_votes;
        }
    }
}
// Golds drops out to favor the center candidate
if (Q.gold_candidate != Q.marcher_candidate && Q.gold_candidate != Q.ddp_candidate && Q.gold_candidate != Q.unionist_candidate) {
}
!}
