on-arrival: {!
Q.unionist_support_braun = 0;
if (Q.unionist_relation >= 40 || (Q.unionist_relation > 20 && Q.unionist_leader == "Hawkins")) {
    Q.unionist_support_braun = 1;
} else if (Q.unionist_relation <= 20) {
    Q.unionist_support_braun = 0;
} else {
    Q.unionist_support_braun = 2;
}
!}
