title: The <span style="color: #C0A054;">**Golds**</span> merges with the [? if traditionalist_ideology == "Moderate":<span style="color: #3E88B3;">**Traditionalists**</span> ?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]!
subtitle: [+ gold_leader +] and [? if traditionalist_ideology == "Moderate":[+ traditionalist_leader +] ?][? if kvp_formed:[+ kvp_leader +] ?] have reached an agreement.
view-if: dkp_merger_timer == time
max-visits: 1
tags: event
priority: 3
on-display: {!  
    var cardEl = document.createElement('div');  
