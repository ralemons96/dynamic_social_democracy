        Q.disfavored_royalist -= 10/12;
        Q.faithful_royalist -= 2/12;
    }
}

if (Q.reformist_plan_time >= Q.time) {
    if (Q.disfavored >= 8) Q.disfavored *= 0.995;
    if (Q.disfavored >= 24) Q.disfavored *= 0.995;
