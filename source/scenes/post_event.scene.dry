    } else if (Q.far_right_paramilitary_high) {
        Q.commons_royalist += 3*Q.strife_size/12;
        Q.commons_marcher -= 3*Q.strife_size/12;
        Q.disfavored_royalist += 6*Q.strife_size/12;
        Q.disfavored_marcher -= 4*Q.strife_size/12;
        Q.disfavored_collectivist -= 4*Q.strife_size/12;
