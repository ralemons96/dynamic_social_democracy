        Q.disfavored_marcher += 4*Q.strife_size/12;
        Q.disfavored_royalist -= 4*Q.strife_size/12;
        Q.burgher_royalist -= 1*Q.strife_size/12;
        Q.burgher_marcher += 1*Q.strife_size/12;
        if (Q.pro_republic < 50) Q.pro_republic += Q.strife / 8;
    } else if (Q.democracy_paramilitary_low) {
        Q.disfavored_royalist -= 2*Q.strife_size/12;
        Q.disfavored_marcher += 2*Q.strife_size/12;
        if (Q.pro_republic < 50) Q.pro_republic += Q.strife / 12;
    }
    if (Q.vanguard_force >= Q.democracy_force) {
        Q.commons_collectivist += 4*Q.strife_size/12;
        Q.commons_marcher -= 4*Q.strife_size/12;
        Q.disfavored_collectivist += 6*Q.strife_size/12;
        Q.disfavored_marcher -= 6*Q.strife_size/12;
        Q.burgher_collectivist += 1*Q.strife_size/12;
        Q.burgher_marcher -= 1*Q.strife_size/12;
        Q.faithful_collectivist += 1*Q.strife_size/12;
        Q.faithful_marcher -= 1*Q.strife_size/12;
        Q.pro_republic -= 0.5;
    }
    if (Q.democracy_force >= Q.pro_republic) Q.pro_republic += 1;
} else if (Q.state_paramilitary) {}

if (Q.heartland_force >= 50 && Q.year >= 1930 && !Q.streetfighting_joever) {
    Q.heartland_force_timer += 1;
    if (Q.heartland_force_timer >= 12) Q.polizeistaat = 1;
} else {
    Q.heartland_force_timer = 0;
}

if (!Q.wtb_adopted && Q.veran_crash_seen) {
    Q.wtb_points_gain = 0;
    if (Q.labor_strength >= (Q.center_strength + Q.left_strength)) Q.wtb_points_gain += 3
    Q.wtb_points_gain += Q.labor_strength/50;
    if (Q.woytinsky_advisor) {
        Q.wtb_points_gain += Q.labor_strength/50;
    }
    Q.wtb_points_gain += Q.leipart_advisor + Q.baade_advisor;
    if (Q.inflation < -2) Q.wtb_points_gain += ((Q.inflation/8)*-1);
    if (Q.economic_growth < -2) Q.wtb_points_gain += ((Q.economic_growth/15)*-1);
    Q.wtb_points_gain += Q.disfavored/15;
    if (Q.banking_crisis_seen) Q.wtb_points_gain += 2;
    if (Q.royalist_votes + Q.collectivist_votes >= 35) Q.wtb_points += (Q.royalist_votes + Q.collectivist_votes) / 20
    if (Q.unions_independent) Q.wtb_points_gain -= 3;
    if (Q.wtb_support) Q.wtb_points_gain += Q.wtb_support;
    if (Q.year >= 1931) Q.wtb_points_gain += 1;
    Q.wtb_points_gain += Q.budget;
    Q.wtb_points_gain += Q.crisis_urgency + (Q.royalist_urgency / 2);
    if (Q.marcher_in_government) Q.wtb_points_gain += 1;
    if (Q.marcher_in_government && Q.labor_minister_party == "Marcher") {
        Q.wtb_points_gain += 1;
    }
    if (Q.marcher_in_government && Q.economic_minister_party == "Marcher") {
        Q.wtb_points_gain += 1;
    }
    Q.wtb_points_gain*=(1-Q.dissent)
    if (Q.wtb_points_gain > 0) {
        Q.wtb_points += Q.wtb_points_gain;
    }
}

if (Q.works_program >= 4 && Q.wtb_enactment_2_finish > Q.time) {
    if (Q.disfavored > 8) {
        Q.disfavored -= 3/10;
    } else if (Q.disfavored < 8) {
        Q.commons += 2/10;
    }
    Q.economic_growth += 1.6/10;
    if (Q.economic_growth > 5) Q.economic_growth -= 0.6/10;
    if (Q.staal_marcher) {
        Q.disfavored += 1/6;
        Q.inflation -= 0.6/6;
        Q.economic_growth -= 0.4/6;
        Q.commons -= 2/6;
