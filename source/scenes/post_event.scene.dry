        if (Q.guild_royalist_para >= Q.max_guild_para) {
            Q.guild_royalist = Q.guild_royalist_para_pre;
        }
    }
} else if (Q.democracy_paramilitary && Q.year >= 1930 && !Q.streetfighting_joever) {
    if (Q.democracy_paramilitary_highest) {
        Q.commons_marcher += 4*Q.strife_size/12;
        Q.commons_royalist -= 4*Q.strife_size/12;
        Q.disfavored_marcher += 7*Q.strife_size/12;
        Q.disfavored_royalist -= 5*Q.strife_size/12;
        Q.disfavored_collectivist -= 2*Q.strife_size/12;
        Q.burgher_royalist -= 4*Q.strife_size/12;
        Q.burgher_marcher += 3*Q.strife_size/12;
        Q.burgher_ddp += 1*Q.strife_size/12;
        Q.guild_royalist -= 2*Q.strife_size/12;
        Q.guild_marcher += 2*Q.strife_size/12;
        if (Q.faithful_royalist >= 2) Q.faithful_royalist -= 2*Q.strife_size/12;
