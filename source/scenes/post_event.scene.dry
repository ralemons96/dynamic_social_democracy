        Q.guild_marcher -= 1*Q.strife_size/12;
        Q.faithful_royalist += 1*Q.strife_size/12;
        Q.faithful_marcher -= 1*Q.strife_size/12;
        Q.pro_republic -= 0.3;
    } else if (Q.far_right_paramilitary_med) {
