title: Post Event
new-page: true
on-arrival: {!

if (Q.social_patriot && Q.neorevisionism && !Q.left_split && !Q.centrists_resign && !Q.reformists_resign && !Q.unions_independent) {
    this.achieve('das_grosste_aller_zelte');
}

if (Q.chancellor == "Askew" && Q.nationalization_progress > 0 && Q.lautenbach_adopted == 1) {
    this.achieve('bruning_der_rotfrontkampfer');
}

const q = dendryUI.dendryEngine.state.qualities;
const dynamicMode = q.dynamic_mode;
const historicalMode = q.historical_mode;

const newlyAddedAchievements = [];

if (Q.year == 1928 && Q.month <= 1) {
    Q.initialAchievements = Object.keys(q).filter(
        key => key.startsWith("game_achievement") || key.startsWith("achievement")
    );

    for (const key of [...Q.initialAchievements]) {
        if (key.startsWith("achievement") && !key.startsWith("game_")) {
            const gameKey = "game_" + key;
            if (!Q.initialAchievements.includes(gameKey)) {
                Q.initialAchievements.push(gameKey);
            }
        }
    }

    console.log(Q.initialAchievements);
}

const initialAchievements = Array.isArray(Q.initialAchievements)
  ? Q.initialAchievements
  : [];


if (Q.achievement_holy_moly) {
    const content = document.getElementById('content');
    if (content) {
      content.style.border = '3px solid black'
      content.style.boxShadow = '0 0 0 3px red, 0 0 0 6px gold';
    }

    if (Q.rubicon) {
        const content = document.getElementById('content');
        if (content) {
          content.style.border = ''
          content.style.boxShadow = '';
        }
    }
}

if (Q.rubicon && Q.chancellor != Q.royalist_chancellor) {
const contentElement = document.getElementById('content');
contentElement.style.backgroundColor = '#645E51';

const header = document.querySelector('header');
header.style.color = '#0077FF';
contentElement.style.color = '#FFFFFF';

const isMobile = window.innerWidth <= 768;
const toolsElements = document.querySelectorAll('.tools');

toolsElements.forEach(tool => {
    if (isMobile) {
        tool.style.marginLeft = '';
        tool.style.padding = '0.6em';
        tool.style.width = '';
        tool.style.color = '#FFFFFF';
        tool.style.backgroundColor = '#645E51';
        tool.style.boxShadow = '4px 4px 16px rgba(255, 255, 255, 0.4)';
    } else {
        tool.style.marginLeft = '-6em';
        tool.style.padding = '0.6em';
        tool.style.width = '20rem';
        tool.style.color = '#FFFFFF';
        tool.style.backgroundColor = '#645E51';
        tool.style.boxShadow = '4px 4px 16px rgba(255, 255, 255, 0.4)';
    }
});

const qualitiesH1 = document.querySelector('#qualities h1');
if (qualitiesH1) {
    qualitiesH1.style.color = 'white';
}

const emergencyTab = document.getElementById('emergency_tab');
emergencyTab.style.display = '';
emergencyTab.style.width = '100%';

const headerLinks = document.querySelectorAll('#header-links a');
headerLinks.forEach(link => {
    link.style.color = 'black';
});

const tabContainer = document.querySelector('.tab_container');
if (tabContainer) {
    tabContainer.style.backgroundColor = '#c3b8a0';
}

const tabButtons = document.querySelectorAll('.tab_button');
tabButtons.forEach((button) => {
    button.style.backgroundColor = '#c3b8a0';
    if (button.id !== 'emergency_tab') {
        button.style.paddingRight = '59px';
    }
    if (button.id == 'main_tab') {
        button.style.marginLeft = '2px';
    }
    if (button.id == 'poll_tab') {
        button.style.display = 'none';
    }
});

const activeTabButton = document.querySelector('.tab_button.active');
if (activeTabButton) {
    activeTabButton.style.backgroundColor = '#f3f3f3';
}

tabButtons.forEach(button => {
    const computedStyle = window.getComputedStyle(button);
    const originalBackground = computedStyle.backgroundColor;
    button.addEventListener('mouseenter', () => {
        button.style.backgroundColor = '#a89f8b';
    });
    button.addEventListener('mouseleave', () => {
        if (!button.classList.contains('active')) {
            button.style.backgroundColor = originalBackground;
        }
    });
});

const rightTools = document.querySelector('.tools.right');
if (rightTools) {
    rightTools.style.display = 'block';
}
}

Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// make sure no stat is below 0.
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
    }
}

if (Q.pro_republic < 0) {
    Q.pro_republic = 0;
}
if (Q.army_strength < 0) {
    Q.army_strength = 0;
}
if (Q.pro_republic >= 100) {
    Q.pro_republic = 99;
}
// re-calculate party support
// calculate normalized class voting for the achievements
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support; 
    if (party == "royalist" && Q.royalist_split) {
        Q.royalist_gallax_support = Q.landed_royalist_normalized*Q.landed;
        Q.royalist_gallax_support += Q.guild_royalist_normalized*Q.guild;
        Q.royalist_gallax_support += Q.faithful_royalist_normalized*Q.faithful;

        if (Q.dsu_exist && !Q.nvf_exist) {
            Q.dsu_support = Q.commons_royalist*Q.commons*((120 - Q.loyalist_force) / 100);
            Q.dsu_support += Q.disfavored_royalist*Q.disfavored*((80 - Q.loyalist_force) / 100);
            Q.dsu_support += Q.burgher_royalist*Q.burgher;
        } else if (!Q.dsu_exist && Q.nvf_exist) {
            Q.nvf_support = Q.disfavored_royalist*Q.disfavored*((120 - Q.loyalist_force) / 100);
            Q.nvf_support += Q.commons_royalist*Q.commons*((Q.loyalist_force - 80) / 100);
            Q.nvf_support += Q.burgher_royalist*Q.burgher;
        } else if (Q.dsu_exist && Q.nvf_exist) {
            Q.dsu_support = Q.commons_royalist*Q.commons*((120 - Q.loyalist_force) / 100);
            Q.dsu_support += Q.disfavored_royalist*Q.disfavored*((80 - Q.loyalist_force) / 100);
            Q.dsu_support += Q.burgher_royalist*Q.burgher;

            Q.nvf_support = Q.disfavored_royalist*Q.disfavored*((120 - Q.loyalist_force) / 100);
            Q.nvf_support += Q.commons_royalist*Q.commons*((Q.loyalist_force - 80) / 100);
        } else {
            Q.royalist_gallax_support += Q.commons_royalist*Q.commons;
            Q.royalist_gallax_support += Q.disfavored_royalist*Q.disfavored;
            Q.royalist_gallax_support += Q.burgher_royalist*Q.burgher;
        }
    }
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    if (party == "royalist" && Q.royalist_split) {
        Q.royalist_gallax_normalized = Q.royalist_gallax_support / total_support;
        Q.dsu_normalized = Q.dsu_support / total_support;
        Q.nvf_normalized = Q.nvf_support / total_support;
        Q.royalist_gallax_votes = Math.round(Q.royalist_gallax_normalized*1000) / 10;
        Q.dsu_votes = Math.round(Q.dsu_normalized*1000) / 10;
        Q.nvf_votes = Math.round(Q.nvf_normalized*1000) / 10;
    }
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*1000)/ 10;
}


// set faction strength/dissent to 0
for (var c of Q.factions) {
    if (Q[c+'_dissent'] < 0) {
        Q[c+'_dissent'] = 0;
    } else if (Q[c+'_dissent'] >= 100) {
        Q[c+'_dissent'] = 99;
    }
    if (Q[c+'_strength'] < 0) {
        Q[c+'_strength'] = 0;
    }
}

if (Q.disfavored <= 1) {
    Q.disfavored = 1;
}

// re-calculate dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength;
if (Q.neorevisionism) {
    total_strength += Q.knight_strength;
} else {
    Q.knight_strength = 0;
}
if (Q.social_patriot) {
    total_strength += Q.social_patriot_strength;
} else {
    Q.social_patriot_strength = 0;
}
// normalize strength for the different factions
Q.left_strength = 100*Q.left_strength/total_strength;
Q.center_strength = 100*Q.center_strength/total_strength;
Q.labor_strength = 100*Q.labor_strength/total_strength;
Q.reformist_strength = 100*Q.reformist_strength/total_strength;
Q.knight_strength = 100*Q.knight_strength/total_strength;

var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent;
if (Q.neorevisionism) {
    total_dissent += Q.knight_strength*Q.knight_dissent;
} else {
    Q.knight_dissent = 0;
}
if (Q.social_patriot) {
    total_dissent += Q.social_patriot_strength*Q.social_patriot_dissent;
}
else {
    Q.social_patriot_dissent = 0;
}
Q.dissent = 0.01*total_dissent/total_strength;
Q.dissent_percent = Q.dissent*100;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

Q.loyalist_force = Q.loyalist_strength*Q.loyalist_militancy;
Q.warden_force = Q.warden_strength*Q.warden_militancy;
Q.banner_force = Q.banner_strength*Q.banner_militancy;
Q.vanguard_force = Q.vanguard_strength*Q.vanguard_militancy;
Q.heartland_force = Q.heartland_police_strength*Q.heartland_police_militancy*Q.heartland_police_loyalty;
if (Q.heartland_leader == "Crowde" || Q.heartland_leader == "Staal" || Q.heartland_leader == "Goodryke") Q.heartland_force = Q.heartland_police_strength*Q.heartland_police_militancy*(1 - Q.heartland_police_loyalty);
Q.army_force = Q.army_strength*Q.army_militancy*(1 - Q.army_loyalty);
Q.total_force = (Q.loyalist_force+Q.warden_force+Q.banner_force+Q.vanguard_force);
var total_force = (Q.loyalist_force+Q.warden_force+Q.banner_force+Q.vanguard_force+Q.heartland_force);
if (Q.army_street) total_force += Q.army_force;

Q.loyalist_force = Math.round((Q.loyalist_force/total_force)*100);
Q.warden_force = Math.round((Q.warden_force/total_force)*100);
Q.banner_force = Math.round((Q.banner_force/total_force)*100);
Q.vanguard_force = Math.round((Q.vanguard_force/total_force)*100);
if (Q.army_street) Q.army_force = Math.round((Q.army_force/total_force)*100);
Q.heartland_force = Math.round((Q.heartland_force/total_force)*100);

Q.far_right_force = Q.warden_force + Q.loyalist_force;
Q.democracy_force = Q.banner_force + Q.heartland_force;
Q.state_force = 0;
if (Q.army_street) Q.state_force += Q.army_force;
if (Q.heartland_leader == "Crowde" || Q.heartland_leader == "Staal" || Q.heartland_leader == "Goodryke") {
    Q.state_force += Q.heartland_force;
    Q.democracy_force -= Q.heartland_force;
}
if (Q.collectivist_truce) Q.democracy_force += Q.vanguard_force;

Q.far_right_paramilitary = 0;
Q.democracy_paramilitary = 0;
Q.state_paramilitary = 0;
Q.far_right_paramilitary_highest = 0;
Q.far_right_paramilitary_high = 0;
Q.far_right_paramilitary_med = 0;
Q.far_right_paramilitary_low = 0;
Q.democracy_paramilitary_highest = 0;
Q.democracy_paramilitary_high = 0;
Q.democracy_paramilitary_med = 0;
Q.democracy_paramilitary_low = 0;
Q.state_paramilitary_highest = 0;
Q.state_paramilitary_high = 0;
Q.state_paramilitary_med = 0;
Q.state_paramilitary_low = 0;

if (Q.far_right_force >= Q.democracy_force && Q.far_right_force >= Q.state_force) {
    if (Q.far_right_force - Q.democracy_force >= 40) {
        Q.far_right_paramilitary_highest = 1;
    } else if (Q.far_right_force - Q.democracy_force >= 30) {
        Q.far_right_paramilitary_high = 1;
    } else if (Q.far_right_force - Q.democracy_force >= 10) {
        Q.far_right_paramilitary_med = 1;
    } else if (Q.far_right_force - Q.democracy_force >= 0) {
        Q.far_right_paramilitary_low = 1;
    }
    if (Q.loyalist_force >= Q.warden_force) {
        Q.loyalist_paramilitary = 1;
        Q.warden_paramilitary = 0;
    } else {
        Q.warden_paramilitary = 1;
        Q.loyalist_paramilitary = 0;
    }
    Q.far_right_paramilitary = 1;
} else if (Q.democracy_force > Q.far_right_force && Q.democracy_force >= Q.state_force) {
    if (Q.democracy_force - Q.far_right_force >= 40) {
        Q.democracy_paramilitary_highest = 1;
    } else if (Q.democracy_force - Q.far_right_force >= 30) {
        Q.democracy_paramilitary_high = 1;
    } else if (Q.democracy_force - Q.far_right_force >= 10) {
        Q.democracy_paramilitary_med = 1;
    } else if (Q.democracy_force - Q.far_right_force >= 0) {
        Q.democracy_paramilitary_low = 1;
    }
    Q.democracy_paramilitary = 1;
} else if (Q.state_force > Q.democracy_force && Q.state_force >= Q.far_right_force) {
    if (Q.democracy_force > Q.far_right_force) Q.secondary_force = Q.democracy_force;
    if (Q.far_right_force >= Q.democracy_force) Q.secondary_force = Q.far_right_force;
    if (Q.state_force - Q.secondary_force >= 40) {
        Q.state_paramilitary_highest = 1;
    } else if (Q.state_force - Q.secondary_force >= 30) {
        Q.state_paramilitary_high = 1;
    } else if (Q.state_force - Q.secondary_force >= 10) {
        Q.state_paramilitary_med = 1;
    } else if (Q.state_force - Q.secondary_force >= 0) {
        Q.state_paramilitary_low = 1;
    }
    Q.state_paramilitary = 1;
}

Q.dnf_r = Math.round(Q.dnf_r * 10) / 10;
Q.traditionalist_r = Math.round(Q.traditionalist_r * 10) / 10;
Q.kvp_r = Math.round(Q.kvp_r * 10) / 10;
Q.royalist_r = Math.round(Q.royalist_r * 10) / 10;

if (Q.ddp_r) Q.ddp_r_last = Q.ddp_r;
if (Q.lvp_r) Q.lvp_r_last = Q.lvp_r;
if (Q.kvp_r) Q.kvp_r_last = Q.kvp_r;
if (Q.gold_r) Q.gold_r_last = Q.gold_r;
if (Q.unionist_r) Q.unionist_r_last = Q.unionist_r;
if (Q.bvp_r) Q.unionist_r_last = Q.bvp_r;
if (Q.traditionalist_r) Q.traditionalist_r_last = Q.traditionalist_r;
if (Q.other_r) Q.other_r_last = Q.other_r;
if (Q.nvf_r) Q.nvf_r_last = Q.nvf_r;

if (Q.dstp_gnu) {
    Q.ddp_relation = Q.gnu_relation;

    if (Q.ddp_r) {
        Q.gnu_r += Q.ddp_r;
        Q.ddp_r = 0;
    }
}

if (Q.lvp_gnu) {
    Q.lvp_relation = Q.gnu_relation - 5;

    if (Q.lvp_r) {
        Q.gnu_r += Q.lvp_r;
        Q.lvp_r = 0;
    }
}

if (Q.kvp_gnu) {
    Q.kvp_relation = (Q.gnu_relation/2);

    if (Q.kvp_r) {
        Q.gnu_r += Q.kvp_r;
        Q.kvp_r = 0;
    }
}

if (Q.gold_gnu) {
    Q.gold_relation = (Q.gnu_relation - 20);

    if (Q.gold_r) {
        Q.gnu_r += Q.gold_r;
        Q.gold_r = 0;
    }
}

if (Q.unionist_gnu) {
    Q.unionist_relation = (Q.gnu_relation - 10);

    if (Q.unionist_r) {
        Q.gnu_r += Q.unionist_r;
        Q.unionist_r = 0;
        Q.bvp_r = 0;
    }
}

if (Q.traditionalist_gnu) {
    Q.traditionalist_relation = (Q.gnu_relation - 35);

    if (Q.traditionalist_r) {
        Q.gnu_r += Q.traditionalist_r;
        Q.traditionalist_r = 0;
    }
}

if (Q.other_gnu) {
    if (Q.other_r) {
        Q.gnu_r += Q.other_r;
        Q.other_r = 0;
    }
}

if (Q.nvf_gnu) {
    if (Q.nvf_r) {
        Q.gnu_r += Q.nvf_r;
        Q.nvf_r = 0;
    }
}

if (Q.gnu_formed) {
    Q.gnu_total_votes = Q.gnu_votes;
    if (Q.dstp_gnu) {
        Q.gnu_total_votes += Q.ddp_votes;
    }
    if (Q.lvp_gnu) {
        Q.gnu_total_votes += Q.lvp_votes;
    }
    if (Q.kvp_gnu) {
        Q.gnu_total_votes += Q.kvp_votes;
    }
    if (Q.gold_gnu) {
        Q.gnu_total_votes += Q.gold_votes;
    }
    if (Q.unionist_gnu) {
        Q.gnu_total_votes += Q.unionist_votes;
    }
    if (Q.other_gnu) {
        Q.gnu_total_votes += Q.other_votes;
    }
    if (Q.traditionalist_gnu) {
        Q.gnu_total_votes += Q.traditionalist_votes;
    }
    if (Q.nvf_gnu) {
        Q.gnu_total_votes += Q.nvf_votes;
    }
}

if (Q.gnu_formed) {
    Q.commons_staal = 0;
    Q.industrialists_staal = 0;
    Q.republicans_staal = 0;
    Q.nationalists_staal = 0;

    if (Q.staal_rig && !Q.staal_rig_exposed) {
        Q.commons_staal += 1;
        Q.industrialists_staal += 1;
        Q.republicans_staal += 1;
        Q.nationalists_staal += 1;
    } else if (Q.staal_rig && Q.staal_rig_exposed) {
        Q.commons_staal -= 2;
        Q.republicans_staal -= 4;
    }
    if (Q.staal_approval) {
        Q.commons_staal += Q.staal_approval / 4;
        Q.industrialists_staal += Q.staal_approval / 4;
        Q.republicans_staal += Q.staal_approval / 4;
        Q.nationalists_staal += Q.staal_approval / 4;
    }
    if (Q.press_censorship) {
        Q.commons_staal += 1;
        Q.industrialists_staal += 1;
        Q.republicans_staal += 1;
        Q.nationalists_staal += 1;
    }
    if (Q.state_police) {
        Q.commons_staal += 1;
        Q.industrialists_staal += 1;
        Q.republicans_staal += 1;
        Q.nationalists_staal += 1;
    }
    if (Q.staal_cabinet_weak) {
        Q.commons_staal -= 2;
        Q.industrialists_staal -= 2;
        Q.republicans_staal -= 2;
        Q.nationalists_staal -= 3;
    }
    if (Q.chancellor == "Goodlake") {
        Q.commons_staal -= 5;
        Q.republicans_staal -= 3;
    } else if (Q.chancellor == "Bredon") {
        Q.commons_staal -= 4;
        Q.republicans_staal -= 2;
        Q.nationalists_staal -= 2;
        Q.industrialists_staal -= 2;
    } else if (Q.chancellor == "Trevannon") {
        Q.commons_staal -= 5;
        Q.republicans_staal -= 3;
    }

    if (Q.marcher_votes < 15) {
        Q.commons_staal += 4;
        Q.republicans_staal += 4;
    } else if (Q.marcher_votes < 20) {
        Q.commons_staal += 3;
        Q.republicans_staal += 3;
    } else if (Q.marcher_votes < 25) {
        Q.commons_staal += 2;
        Q.republicans_staal += 2;
    } else if (Q.marcher_votes < 30) {
        Q.commons_staal += 1;
        Q.republicans_staal += 1;
    }

    Q.commons_staal_pre = Q.commons_staal;
    Q.republicans_staal_pre = Q.republicans_staal;
    Q.nationalists_staal_pre = Q.nationalists_staal;
    Q.industrialists_staal_pre = Q.industrialists_staal;

    if (Q.gnu_total_votes) {
        const vote_thresholds = [20, 25, 30, 35, 40, 45, 50];

        for (const threshold of vote_thresholds) {
            if (Q.gnu_total_votes >= threshold) {
                Q.commons_staal += 0.5;
                Q.republicans_staal += 1;
                Q.nationalists_staal += 0.5;
                Q.industrialists_staal += 0.5;
            }
        }
    }


    if (Q.staal_marcher_influence) Q.commons_staal += Q.staal_marcher_influence / 2;
    if (Q.staal_marcher_support) Q.commons_staal += Q.staal_marcher_support / 4;
    if (Q.staal_marcher_r < 2) Q.commons_staal -= (Q.commons_marcher_normalized / 25);
    if (Q.labor_dissent) Q.commons_staal += Q.labor_dissent / 20;
    if (Q.unionist_in_gov) Q.commons_staal += Q.commons_unionist_normalized / 5;
    if (Q.staal_labor) Q.commons_staal += 2;
    if (Q.unions_staal) Q.commons_staal += 5;
    if (Q.adgb_explode) Q.commons_staal += 1;
    if (Q.nvf_gnu) Q.commons_staal -= 1;
    if (Q.commons_gnu_normalized) Q.commons_staal += (Q.commons_gnu_normalized / 10);
    if (Q.industrialists_gnu) Q.commons_staal -= 3;
    if (Q.united_labor) Q.commons_staal -= 3;
    if (Q.staal_economy_time) Q.commons_staal += ((Q.economic_growth + 10) / 3.5);
    Q.commons_staal += Q.commons_staal_bonus;
    if (Q.commons_staal > 12) Q.commons_staal = 12;
    if (Q.commons_staal < 0) Q.commons_staal = 0;

    if (Q.unionist_in_gov) Q.industrialists_staal += 1;
    if (Q.dsu_in_gov) Q.industrialists_staal -= 1;
    if (Q.gold_gnu) Q.industrialists_staal += 3;
    if (Q.kvp_gnu || Q.traditionalist_gnu) Q.industrialists_staal += 2;
    if (Q.nvf_gnu) Q.industrialists_staal -= 3;
    if (Q.staal_economy_time) Q.industrialists_staal += ((Q.economic_growth + 10) / 5);
    if (Q.staal_labor) Q.industrialists_staal -= 2;
    if (Q.gnu_formed) Q.industrialists_staal += Q.guild_gnu_normalized / 10;
    if (Q.industrialists_gnu) Q.industrialists_staal += 5;
    Q.industrialists_staal += Q.industrialists_staal_bonus;
    if (Q.industrialists_staal > 12) Q.industrialists_staal = 12;
    if (Q.industrialists_staal < 0) Q.industrialists_staal = 0;

    if (Q.staal_marcher_r) Q.republicans_staal += Q.staal_marcher_r / 4;
    if (Q.staal_marcher_support) Q.republicans_staal += Q.staal_marcher_support / 6;
    if (Q.unionist_in_gov) Q.republicans_staal += 2;
    if (Q.staal_labor) Q.republicans_staal += 1;
    if (Q.unionist_leader == "Sedgewick") Q.republicans_staal += 1;
    if (Q.unionist_leader == "Bracht" || Q.unionist_gnu) Q.republicans_staal += 3;
    if (Q.unionist_gnu) Q.republicans_staal += 1;
    if (Q.dstp_gnu) Q.republicans_staal += 1;
    if (Q.gold_gnu) Q.republicans_staal += 1;
    if (Q.lvp_gnu) Q.republicans_staal += 2;
    if (Q.nvf_gnu) Q.republicans_staal -= 3;
    if (Q.army_strength > 100) Q.republicans_staal -= Q.army_strength / 100;
    if (Q.gnu_total_votes >= Q.pro_republic) Q.republicans_staal += 1;
    if (Q.gnu_total_votes >= Q.pro_republic + 5) Q.republicans_staal += 1;
    if (Q.gnu_total_votes >= Q.pro_republic + 10) Q.republicans_staal += 1;
    if (Q.reichstag_break) Q.republicans_staal -= (Q.pro_republic / 10);
    if (Q.pro_republic <= 0) {
        Q.republicans_staal += 7;
    } else if (Q.pro_republic < 5) {
        Q.republicans_staal += 6;
    } else if (Q.pro_republic < 10) {
        Q.republicans_staal += 5;
    } else if (Q.pro_republic < 15) {
        Q.republicans_staal += 4;
    } else if (Q.pro_republic < 20) {
        Q.republicans_staal += 3;
    } else if (Q.pro_republic < 25) {
        Q.republicans_staal += 2;
    } else if (Q.pro_republic < 30) {
        Q.republicans_staal += 1;
    }
    if (Q.pro_republic >= 30) Q.republicans_staal -= Q.pro_republic / 10;
    if (Q.united_labor) Q.republicans_staal -= 1;
    Q.republicans_staal += Q.republicans_staal_bonus;
    if (Q.republicans_staal > 12) Q.republicans_staal = 12;
    if (Q.republicans_staal < 0) Q.republicans_staal = 0;

    if (Q.kvp_formed) Q.nationalists_staal += 1;
    if (Q.staal_kvp) Q.nationalists_staal += 1;
    if (Q.kvp_gnu) Q.nationalists_staal += 1;
    if (Q.traditionalist_gnu) Q.nationalists_staal += 3;
    if (Q.nvf_gnu) Q.nationalists_staal -= 2;
    if (Q.army_strength > 100) Q.nationalists_staal += Q.army_strength / 50;
    if (Q.gold_gnu) Q.nationalists_staal += 1;
    if (Q.dstp_maintained) Q.nationalists_staal += 1;
    if (Q.traditionalist_ideology == "Moderate") Q.nationalists_staal += 2;
    if (Q.dsu_in_gov) Q.nationalists_staal += 1;
    if (Q.staal_marcher_r) Q.nationalists_staal -= Q.staal_marcher_r / 3;
    if (Q.staal_stahlhelm) Q.nationalists_staal += 3;
    Q.nationalists_staal += Q.nationalists_staal_bonus;
    if (Q.nationalists_staal > 12) Q.nationalists_staal = 12;
    if (Q.nationalists_staal < 0) Q.nationalists_staal = 0;

    Q.staal_approval_decay = -0.05;

    if (Q.commons_staal < 6) Q.staal_approval_decay += 0.05;
    if (Q.commons_staal < 4) Q.staal_approval_decay += 0.05;
    if (Q.commons_staal < 2) Q.staal_approval_decay += 0.1;

    if (Q.industrialists_staal < 6) Q.staal_approval_decay += 0.05;
    if (Q.industrialists_staal < 4) Q.staal_approval_decay += 0.05;
    if (Q.industrialists_staal < 2) Q.staal_approval_decay += 0.1;

    if (Q.republicans_staal < 6) {
        Q.staal_approval_decay += 0.05;
        if (Q.weimar_votes < 20) Q.staal_approval_decay -= 0.01;
        if (Q.weimar_votes < 30) Q.staal_approval_decay -= 0.01;
        if (Q.weimar_votes < 40) Q.staal_approval_decay -= 0.01;
    }
    if (Q.republicans_staal < 4) {
        Q.staal_approval_decay += 0.05;
        if (Q.weimar_votes < 20) Q.staal_approval_decay -= 0.01;
        if (Q.weimar_votes < 30) Q.staal_approval_decay -= 0.01;
        if (Q.weimar_votes < 40) Q.staal_approval_decay -= 0.01;
    }
    if (Q.republicans_staal < 2) {
        Q.staal_approval_decay += 0.1;
        if (Q.weimar_votes < 20) Q.staal_approval_decay -= 0.02;
        if (Q.weimar_votes < 30) Q.staal_approval_decay -= 0.02;
        if (Q.weimar_votes < 40) Q.staal_approval_decay -= 0.02;
    }

    if (Q.nationalists_staal < 6) {
        Q.staal_approval_decay += 0.05;
        if (Q.nationalist_votes < 15) Q.staal_approval_decay -= 0.025;
    }
    if (Q.nationalists_staal < 4) {
        Q.staal_approval_decay += 0.05;
        if (Q.nationalist_votes < 15) Q.staal_approval_decay -= 0.025;
    }
    if (Q.nationalists_staal < 2) {
        Q.staal_approval_decay += 0.05;
        if (Q.nationalist_votes < 15) Q.staal_approval_decay -= 0.025;
    }
    Q.staal_approval -= (Q.staal_approval_decay / 2);
}

if (Q.rubicon && Q.month_actions >= 1 && Q.month_actions != Q.month_actions_checked) {
    Q.rubicon_time += 1;
    Q.week += 1;
    Q.pro_republic -= 1;
    if (!Q.gnu_formed && Q.chancellor == "Staal") Q.pro_republic += 0.5;
    if (Q.commons_marcher_normalized >= 45) Q.commons_marcher *= 0.99;
    if (Q.disfavored_marcher_normalized >= 15) Q.disfavored_marcher *= 0.99;
    if (Q.pro_republic < (Q.marcher_votes + Q.ddp_votes + (Q.lvp_votes / 2) + Q.unionist_votes - Q.bvp_votes)) {
        if (Q.commons_marcher_normalized >= 45) Q.commons_marcher *= 0.99;
        if (Q.disfavored_marcher_normalized >= 15) Q.disfavored_marcher *= 0.99;
        if (Q.gnu_formed && Q.chancellor == "Staal") {
            Q.commons_gnu += 2/12;
            Q.burgher_gnu += 4/12;
            Q.guild_gnu += 4/12;
            Q.landed_gnu += 2/12;
            Q.disfavored_gnu += 2/12;
            Q.faithful_gnu += 2/12;
        }
        Q.unionist_relation -= 0.25;
        Q.ddp_relation -= 0.25;
        Q.gold_relation -= 0.25;
        Q.lvp_relation -= 0.25;
        Q.gnu_relation -= 0.25;
    }
    Q.weimar_votes = Q.marcher_votes + Q.ddp_votes + (Q.lvp_votes / 2) + Q.unionist_votes - Q.bvp_votes;
    Q.nationalist_votes = Q.traditionalist_votes + Q.dnf_votes + Q.kvp_votes;
    if (Q.next_election_week == 0) Q.new_election_week = 1;
    if (Q.next_election_week_heartland == 0) Q.next_election_week_heartland = 1;
    if (Q.chancellor == "Goodryke") {
        Q.papen_time += 1;
        if (Q.marburg_trigger) Q.marburg_time += 1;
    }
    if (Q.chancellor == "Staal") {
        Q.staal_time += 1;
        if (Q.staal_post) {
            Q.staal_post_time += 1;
            if (Q.unionist_in_gov) Q.unionist_in_gov_time += 1;
            if (Q.dsu_in_gov) Q.dsu_in_gov_time += 1;
        }
        if (Q.unionist_leader == "Bracht") Q.bracht_time += 1;
        if (Q.reichstag_joever) Q.reichstag_joever_time += 1;
    } else if (Q.chancellor == "Bredon") {
        Q.bredow_time += 1;
    } else if (Q.chancellor == "Goodlake") {
        Q.goerdeler_time += 1;
    } else if (Q.chancellor == "Trevannon") {
        Q.treviranus_time += 1;
    }
    if (Q.state_paramilitary && Q.gnu_formed && !Q.streetfighting_joever) {
        if (Q.state_paramilitary_highest) {
            Q.commons_marcher -= 6/12;
            if (Q.commons_collectivist_normalized >= 10) Q.commons_collectivist -= 6/12;
            Q.commons_unionist -= 3/12;
            Q.commons_gnu += 6/12;
            Q.disfavored_marcher -= 2/12;
            if (Q.disfavored_collectivist_normalized >= 15) Q.disfavored_collectivist -= 6/12;
            Q.disfavored_gnu += 6/12;
            Q.burgher_gnu += 6/12;
            Q.burgher_marcher -= 6/12;
            Q.guild_gnu += 4/12;
            Q.faithful_gnu += 2/12;
        } else if (Q.state_paramilitary_high) {
            Q.commons_marcher -= 4/12;
            if (Q.commons_collectivist_normalized >= 10) Q.commons_collectivist -= 4/12;
            Q.commons_unionist -= 2/12;
            Q.commons_gnu += 4/12;
            Q.disfavored_marcher -= 2/12;
            if (Q.disfavored_collectivist_normalized >= 15) Q.disfavored_collectivist -= 4/12;
            Q.disfavored_gnu += 4/12;
            Q.burgher_gnu += 4/12;
            Q.burgher_marcher -= 4/12;
            Q.guild_gnu += 2/12;
            Q.faithful_gnu += 1/12;
        } else if (Q.state_paramilitary_med) {
            Q.commons_marcher -= 3/12;
            if (Q.commons_collectivist_normalized >= 10) Q.commons_collectivist -= 3/12;
            Q.commons_unionist -= 1/12;
            Q.commons_gnu += 5/12;
            Q.disfavored_marcher -= 1/12;
            if (Q.disfavored_collectivist_normalized >= 15) Q.disfavored_collectivist -= 3/12;
            Q.disfavored_gnu += 4/12;
            Q.burgher_gnu += 2/12;
            Q.burgher_marcher -= 2/12;
        } else if (Q.state_paramilitary_low) {
            Q.commons_marcher -= 2/12;
            if (Q.commons_collectivist_normalized >= 10) Q.commons_collectivist -= 2/12;
            Q.commons_gnu += 4/12;
            Q.disfavored_marcher -= 1/12;
            if (Q.disfavored_collectivist_normalized >= 15) Q.disfavored_collectivist -= 2/12;
            Q.disfavored_gnu += 3/12;
            Q.burgher_gnu += 1/12;
            Q.burgher_marcher -= 1/12;
        }
    }
    if (Q.week >= 5) {
        Q.week = 1;
    }
    if (Q.papen_time == 9) {
        Q.dufour_staal_r -= 1;
        Q.staal_strength -= 1;
        Q.papen_strength += 1;
        Q.meissner_goal = "Convince DuFour to continue supporting Goodryke";
        Q.oskar_goal = "Convince DuFour to continue supporting Goodryke"
    }
    if (Q.papen_economy_time >= Q.rubicon_time) {
        Q.disfavored -= 2/12;
        Q.economic_growth += 2/12;
        Q.inflation += 1/12;
    }
    for (timer of Q.rubicon_timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }
    if (Q.heartland_leader == "Goodryke" || Q.heartland_leader == "Staal") {
        Q.burgher_marcher -= 4/12;
        Q.burgher_ddp -= 2/12;
        Q.burgher_traditionalist += 2/12;
        Q.burgher_dnf += 2/12;
        Q.burgher_royalist += 2/12;
    }
    if (Q.papen_time == 9 && Q.gallax_right_coalition >= 50) {
        Q.burgher_unionist -= 2;
        Q.guild_unionist -= 2;
        Q.landed_unionist -= 2;
    } else if (Q.papen_time == 15 && Q.gallax_right_coalition >= 50) {
        Q.commons_unionist -= 2;
        Q.burgher_unionist -= 1;
        Q.banner_strength += 50;
    }
    if (Q.staal_time == 4 && (Q.disfavored >= 42 || (Q.commons_royalist_normalized + Q.commons_collectivist_normalized) >= 55 || Q.staal_marcher_r >= 4)) {
        Q.staal_public_works_fast = 1;
    }
    if (Q.staal_time == 5 && Q.hugenberg_gold) Q.hugenberg_gold = 0;
    if (Q.staal_time == 8) {
        Q.staal_goal = "Regain public confidence";
    }
    if (Q.staal_time >= 15) {
        Q.staal_goal = "Consolidate power";
    }
    if (Q.staal_economy_time >= Q.rubicon_time) {
        Q.disfavored *= 0.99;
        if (Q.disfavored < 30) Q.disfavored *= 1.0025;
        if (Q.disfavored < 25) Q.disfavored *= 1.0025;
        if (Q.disfavored < 20) Q.disfavored *= 1.0025;
        Q.economic_growth += 1/12;
        if (Q.economic_growth > 0) Q.economic_growth -= 0.2/12;
        if (Q.economic_growth > 1) Q.economic_growth -= 0.2/12;
        if (Q.economic_growth > 2) Q.economic_growth -= 0.2/12;
        Q.inflation += 1.5/12;
        if (Q.inflation > -1) Q.inflation -= 0.3/12;
        if (Q.inflation > 0) Q.inflation -= 0.3/12;
        if (Q.inflation > 1) Q.inflation -= 0.3/12;
        if (Q.inflation > 2) Q.inflation -= 0.3/12;
        if (Q.inflation > 3) Q.inflation -= 0.3/12;
        if (Q.inflation > 4) Q.inflation -= 0.3/12;
    }
    if (Q.commons_staal >= 6) Q.staal_marcher_influence += 0.1;
    if (Q.commons_staal >= 8) Q.staal_marcher_influence += 0.15;
    if (Q.commons_staal >= 10) Q.staal_marcher_influence += 0.2;
    if (Q.commons_staal >= 12) Q.staal_marcher_influence += 0.4;
    if (!Q.royalist_peak_triggered) {
        Q.royalist_peak_base = 25;
        Q.royalist_peak = Q.royalist_peak_base;
        Q.royalist_peak += (Q.disfavored / 3);
        Q.royalist_peak += (100 - Q.pro_republic) / 10;
        Q.royalist_peak += (Q.loyalist_force / 10)
        if (Q.royalist_presidential_votes_disp >= 30) Q.royalist_peak += 5;
        if (Q.reparations_resolved && Q.chancellor == "Askew") Q.royalist_peak -= 5;
        if (Q.lautenbach_adopted && Q.chancellor == "Askew") Q.royalist_peak -= 5;
        if (Q.year >= 1932 && Q.month >= 4) {
            Q.royalist_peak -= (Q.other_votes + Q.gold_votes + Q.ddp_votes + Q.traditionalist_votes +  Q.dnf_votes + Q.lvp_votes) / 2
        }
        if (Q.royalist_r >= 30) {
            Q.royalist_peak -= 5;
        } else if (Q.royalist_votes >= Q.royalist_r + 10 && Q.royalist_r_heartland < 10) {
            Q.royalist_peak -= (Q.royalist_votes - Q.royalist_r) / 3;
        }
        if (Q.chancellor == "Goodryke" && Q.traditionalist_ideology == "Radical") {
            Q.royalist_peak -= (Q.traditionalist_votes / 2);
        } else if (Q.chancellor == "Goodryke" && Q.traditionalist_ideology == "Moderate") {
            Q.royalist_peak -= Q.dnf_votes / 2;
        }
        if (Q.year == 1933) {
            Q.royalist_peak -= 10;
        } else if (Q.year >= 1934) {
            Q.royalist_peak -= 15;
        }
        if (Q.gallax_mode) Q.royalist_peak = 100;
    }   
    if (Q.royalist_votes >= Q.royalist_peak && !Q.royalist_peak_triggered && Q.royalist_votes >= 22) {
        Q.royalist_peak_triggered = 1;
        Q.royalist_peak_votes = Q.royalist_votes;
        Q.royalist_decay_timer = 24;
        Q.coup_progress += 4;
    }
    if (Q.royalist_decay_timer > 0 && Q.royalist_votes >= Q.royalist_peak_votes - 10 && (Q.royalist_funds_timer > 0 || Q.staal_economy_time >= Q.time)) {
        Q.commons_royalist -= 6/12;
        Q.burgher_royalist -= 12/12;
        Q.guild_royalist -= 12/12;
        Q.landed_royalist -= 8/12;
        Q.disfavored_royalist -= 8/12;
        Q.faithful_royalist -= 5/12;
        Q.loyalist_strength *= 0.97;
        Q.loyalist_militancy -= 0.01;
        Q.burgher_ddp += 2/12;
        Q.burgher_gold += 2/12;
        Q.commons_collectivist += 3/12;
        Q.commons_traditionalist += 3/12;
        if (Q.stegerwald_path) {
            Q.commons_unionist += 6/12;
            Q.burgher_unionist += 10/12;
            Q.guild_unionist += 10/12;
            Q.landed_unionist += 10/12;
            Q.disfavored_unionist += 3/12;
            Q.faithful_unionist += 5/12;
        }
        if (Q.traditionalist_ideology == "Moderate") {
            Q.burgher_traditionalist += 6/12;
            Q.burgher_dnf += 2/12;
        } else if (Q.traditionalist_ideology == "Radical") {
            Q.burgher_traditionalist += 6/12;
            Q.burgher_kvp += 4/12;
            Q.burgher_other += 4/12;
        }
        Q.guild_ddp += 2/12;
        Q.guild_gold += 2/12;
        if (Q.traditionalist_ideology == "Moderate") {
            Q.guild_traditionalist += 8/12;
            Q.guild_dnf += 4/12;
        } else if (Q.traditionalist_ideology == "Radical") {
            Q.guild_traditionalist += 8/12;
            Q.guild_kvp += 4/12;
            Q.guild_other += 4/12;
        }
        if (Q.traditionalist_ideology == "Moderate") {
            Q.landed_traditionalist += 12/12;
            Q.landed_dnf += 6/12;
        } else if (Q.traditionalist_ideology == "Radical") {
            Q.landed_traditionalist += 10/12;
            Q.landed_kvp += 4/12;
            Q.landed_other += 4/12;
        }
        Q.landed_ddp += 1/12;
        Q.landed_gold += 2/12;
        Q.burgher_lvp += 10/12;
        Q.guild_lvp += 10/12;
        Q.landed_lvp += 6/12;
        Q.disfavored_collectivist += 3/12;
        Q.disfavored_marcher += 5/12;
        if (Q.traditionalist_ideology == "Moderate") {
            Q.faithful_traditionalist += 4/12;
            Q.faithful_unionist += 1/12;
        } else if (Q.traditionalist_ideology == "Radical") {
            Q.faithful_traditionalist += 2/12;
            Q.faithful_unionist += 3/12;
        }
        if (Q.gnu_formed) {
            Q.commons_gnu += 8/12;
            Q.burgher_gnu += 12/12;
            Q.guild_gnu += 12/12;
            Q.landed_gnu += 6/12;
            Q.disfavored_gnu += 6/12;
            Q.faithful_gnu += 4/12;
            Q.burgher_ddp -= 1/12;
            Q.burgher_gold -= 1/12;
            Q.burgher_lvp -= 6/12;
            Q.guild_ddp -= 1/12;
            Q.guild_gold -= 1/12;
            Q.guild_lvp -= 6/12;
            Q.guild_traditionalist -= 4/12;
            Q.guild_kvp -= 2/12;
            Q.guild_dnf -= 2/12;
            Q.landed_traditionalist -= 4/12;
            Q.landed_kvp -= 2/12;
            Q.landed_dnf -= 2/12;
            Q.faithful_unionist -= 2/12;
            Q.faithful_traditionalist -= 3/12;
            Q.disfavored_marcher -= 3/12;
            Q.disfavored_collectivist -= 1/12;
        }
    }
}

Q.month_actions_checked = Q.month_actions;

if (Q.ddp_in_popular_front && !Q.in_popular_front) Q.ddp_in_popular_front = 0;

// 1. update dates
if ((Q.month_actions >= 1 && !Q.rubicon) || (Q.month_actions >= 4 && Q.rubicon)) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
        Q.year_display = Q.year + 2365;
        Q.resources += Q.dues;
        if (Q.dissent_percent < 5) {
            Q.resources += 1;
        } else if (Q.dissent_percent > 30) {
            Q.resources -= 1;
        }
    }
    if (Q.chancellor == "Goodryke" && !Q.papen_time) {
        Q.papen_time += 1;
    }
    if (Q.chancellor == "Staal" && !Q.staal_time) {
        Q.papen_time += 1;
    }
    // decrement timers
    if (!Q.rubicon) {
        for (timer of Q.timers) {
            if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
                Q[timer+'_timer'] -= 1;
            }
        }
    }
    if (Q.lvp_existence_timer >= 0 && (Q.lvp_timer_2_trigger || Q.threshold_lvp) && Q.lvp_formed) {
        Q.lvp_existence_timer += 1;
    }
    if (Q.traditionalist_split_2 && Q.traditionalist_split_2_timer >= 1) {
        Q.traditionalist_split_2_timer += 1;
    }   
    // append to historical party support records
    var party_support_results = {'date': new Date(Q.year, Q.month - 1)};
    for (var party of Q.parties_graph) {
        party_support_results[party] = Q[party + '_normalized']*100;
    }
    Q.party_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'inflation': Q.inflation,
                             'unemployment': Q.disfavored});
    // change economic stats...
    // we're basically implicity drawing a Philips curve
    // budget deficits lead to some inflation
    if (Q.budget <= 0 && Q.budget > -2 && Q.inflation < 2.5) {
        Q.inflation += 0.1;
    }
    if (Q.budget <= -2 && Q.budget > -5 && Q.inflation < 5) {
        Q.inflation += 0.2;
        if (Q.disfavored >= 12) {
            Q.inflation -= 0.1;
        }
    }
    if (Q.budget <= -5 && Q.inflation < 10) {
        Q.inflation += 0.3;
        if (Q.disfavored >= 15) {
            Q.inflation -= 0.1;
        }
    }
    // deflation is bad
    if (Q.inflation < -0.5 && Q.inflation > -5 && Q.disfavored < 15) {
        Q.disfavored += 0.1;
    }
    if (Q.inflation <= -5 && Q.disfavored < 20) {
        Q.disfavored += 0.1;
    }
    if (Q.inflation <= -8 && Q.disfavored < 26) {
        Q.disfavored += 0.1;
    }
    if (Q.inflation <= -12 && Q.disfavored < 32) {
        Q.disfavored += 0.1;
    }
    // economic growth
    if (Q.economic_growth < -0.5 && Q.disfavored <= 16) {
        Q.disfavored += 0.1;
    }
    if (Q.economic_growth < -5 && Q.disfavored <= 24) {
        Q.disfavored += 0.1;
    }
    if (Q.economic_growth >= 2 && Q.disfavored >= 17) {
        Q.disfavored -= 0.1;
    }
    if (Q.economic_growth >= 4 && Q.disfavored >= 12) {
        Q.disfavored -= 0.1;
    }
    if (Q.economic_growth >= 6 && Q.disfavored >= 7) {
        Q.disfavored -= 0.1;
    }
    if (Q.economic_growth >= 8 && Q.disfavored >= 3) {
        Q.disfavored -= 0.1;
    }
    if (Q.economic_growth >= 4 && Q.inflation >= 7.5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= -2.5 && Q.inflation <= -5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 7) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 10) {
        Q.economic_growth -= 0.2;
    }
    if (Q.economic_growth >= 12) {
        Q.economic_growth -= 0.3;
    }
    if (Q.economic_growth < -10) {
        Q.economic_growth += 0.1;
    }
    if (Q.economic_growth < -13) {
        Q.economic_growth += 0.1;
    }
    if (Q.economic_growth < -16) {
        Q.economic_growth += 0.1;
    }
    if (Q.economic_growth >= 3 && Q.disfavored < 20 && Q.veran_crash_seen) {
        Q.capital_strike_progress -= 0.25;
    }
    if (!Q.economic_democracy && !Q.nationalization_progress && Q.marcher_in_government) {
        Q.capital_strike_progress -= 0.1;
    }
    if (Q.budget > 0 && Q.veran_crash_seen && Q.marcher_in_government) {
        Q.capital_strike_progress += ((Q.upper_tax_rates - 5) / 25);
    }

    //////////////////////////////// Education & Science support/economic changes
    // science bonus to economic growth
    Q.science_bonus = 0;
    if (Q.major_curriculum && Q.major_curriculum == "democratic") {
        if (Q.pro_republic < 60) {
            Q.pro_republic += 0.3;
        } 
    }
    if (Q.minor_curriculum && Q.minor_curriculum == "democratic") {
        if (Q.pro_republic < 60) {
            Q.pro_republic += 0.15;
        } 
    }
    // science bonus to economic growth
    // education bonus
    Q.science_bonus = 0;
    if (Q.education_science) {
        Q.science_bonus += Q.education_science;
    }
    if (Q.science) {
        if (Q.science >= 1) {
            Q.science_bonus += 1;
        } else if (Q.science >= 3) {
            Q.science_bonus += 2;
        } else if (Q.science >= 5) {
            Q.science_bonus += 3;
        }
    }
    if (Q.applied_research && Q.applied_research >= 1) {
        Q.science_bonus += 0.5*Q.applied_research;
    }
    // cap the science bonus at 6
    if (Q.science_bonus > 6) {
        Q.science_bonus = 6;
    }
    console.log(Q.science_bonus);
    // this is kinda messy but basically more science -> higher levels of baseline growth
    if (Q.science_bonus >= 1) {
        if (Q.return_to_normalcy && Q.economic_growth < Q.science_bonus + 3) {
            Q.economic_growth += 0.1;
        }
        if (Q.return_to_normalcy && Q.economic_growth < Q.science_bonus) {
            Q.economic_growth += 0.1;
        }
        if (Q.economic_growth < Q.science_bonus - 3) {
            Q.economic_growth += 0.1;
        }
    }
    // accumulated economic growth/decline
    // Maybe there should be differences for positive/negative growth?
    if (Q.economic_growth < 0) {
        if (Q.economic_expansion > 0) {
            Q.economic_expansion = 0;
        } else {
            Q.economic_expansion += Q.economic_growth;
        }
    }
    if (Q.economic_growth > 0 && Q.war_loans <= -2 && Q.marcher_in_government) {
        Q.economic_expansion += Q.economic_growth;
    } else if (Q.economic_growth > 0 && Q.marcher_in_government) {
        Q.economic_expansion += Q.economic_growth/2;
    }
    /////////////////////////////// update opinions based on economy
    if (Q.disfavored > 15 && Q.pro_republic > 50) {
        Q.pro_republic -= 1;
    }
    if (Q.disfavored > 30 && Q.pro_republic > 35) {
        Q.pro_republic -= 1;
    }
    if (Q.inflation >= 8 && Q.pro_republic > 40) {
        Q.pro_republic -= 1;
    }
    if ((Q.collectivist_votes + Q.royalist_votes + Q.traditionalist_votes + Q.other_votes) - (100 - Q.pro_republic) > 5 && Q.dnf_formed == 0 && Q.year >= 1930 && Q.collectivist_leader != "Conciliators") {
        Q.pro_republic -= 1;
    } else if ((Q.collectivist_votes + Q.royalist_votes + (Q.traditionalist_votes / 2) + Q.other_votes) - (100 - Q.pro_republic) > 5 && Q.dnf_formed == 0 && Q.year < 1930 && Q.collectivist_leader != "Conciliators") {
        Q.pro_republic -= 1;
    } else if ((Q.royalist_votes + Q.traditionalist_votes + Q.other_votes) - (100 - Q.pro_republic) > 5 && Q.dnf_formed == 0 && Q.collectivist_leader == "Conciliators") {
        Q.pro_republic -= 1;
    }
    if ((Q.collectivist_votes + Q.royalist_votes + Q.other_votes + Q.dnf_votes) - (100 - Q.pro_republic) > 5 && Q.dnf_formed == 1 && Q.collectivist_leader != "Conciliators") {
        Q.pro_republic -= 1;
    } else if ((Q.royalist_votes + Q.other_votes + Q.dnf_votes) - (100 - Q.pro_republic) > 5 && Q.dnf_formed == 1 && Q.collectivist_leader == "Conciliators") {
        Q.pro_republic -= 1;
    }
    if ((Q.collectivist_votes + Q.royalist_votes + Q.traditionalist_votes + Q.other_votes) - (100 - Q.pro_republic) > 10 && Q.dnf_formed == 0 && Q.year >= 1930 && Q.collectivist_leader != "Conciliators") {
        Q.pro_republic -= 2;
    } else if ((Q.collectivist_votes + Q.royalist_votes + (Q.traditionalist_votes / 2) + Q.other_votes) - (100 - Q.pro_republic) > 10 && Q.dnf_formed == 0 && Q.year < 1930 && Q.collectivist_leader != "Conciliators") {
        Q.pro_republic -= 2;
    } else if ((Q.royalist_votes + Q.traditionalist_votes + Q.other_votes) - (100 - Q.pro_republic) > 10 && Q.dnf_formed == 0 && Q.collectivist_leader == "Conciliators") {
        Q.pro_republic -= 2;
    }
    if ((Q.collectivist_votes + Q.royalist_votes + Q.other_votes + Q.dnf_votes) - (100 - Q.pro_republic) > 10 && Q.dnf_formed == 1 && Q.collectivist_leader != "Conciliators") {
        Q.pro_republic -= 2;
    } else if ((Q.royalist_votes + Q.other_votes + Q.dnf_votes) - (100 - Q.pro_republic) > 10 && Q.dnf_formed == 1 && Q.collectivist_leader == "Conciliators") {
        Q.pro_republic -= 2;
    }
    if (Q.royalist_votes >= 26 && Q.collectivist_votes < 14) Q.collectivist_relation += 1;
    if (Q.royalist_votes >= 32 && Q.collectivist_votes < 18) Q.collectivist_relation += 1;
    if ((Q.royalist_votes + Q.other_votes + Q.dnf_votes + Q.traditionalist_votes + Q.gold_votes + (Q.lvp_votes / 2) + Q.kvp_votes) > Q.nationalism) {
        Q.nationalism += 1;
    }
    if (Q.banner_strength < 0) {
        Q.banner_strength = 0;
    }
    if (Q.warden_strength < 0) {
        Q.warden_strength = 0;
    }
    if (Q.loyalist_strength < 0) {
        Q.loyalist_strength = 0;
    }
    if (Q.vanguard_strength < 0) {
        Q.vanguard_strength = 0;
    }
    if (Q.banner_militancy < 0) {
        Q.banner_militancy = 0;
    }
    if (Q.warden_militancy < 0) {
        Q.warden_militancy = 0;
    }
    if (Q.loyalist_militancy < 0) {
        Q.loyalist_militancy = 0;
    }
    if (Q.vanguard_militancy < 0) {
        Q.vanguard_militancy = 0;
    }
    if (Q.sapd_formed == 1 && Q.centrists_resign == 1) {
        Q.labor_dissent += 5/12;
    }
    if (Q.sapd_formed == 1 && Q.unions_independent == 1) {
        Q.center_dissent += 5/12;
    }
    if (Q.sapd_formed == 1 && Q.pro_republic >= 75 && Q.collectivist_leader != "Conciliators") {
        Q.commons_collectivist -= 3/12;
        Q.commons_sapd += 3/12;
    } else if (Q.sapd_formed && Q.collectivist_leader == "Conciliators") {
        Q.commons_collectivist += 3/12;
        Q.commons_sapd -= 3/12;
    }
    if (Q.gold_left + Q.gold_right >= 35) {
        Q.gold_left *= 0.9;
        Q.gold_right *= 0.9;
    }
    if (Q.ddp_left + Q.ddp_right >= 20) {
        Q.ddp_left *= 0.9;
        Q.ddp_right *= 0.9;
    }
    if (Q.lvp_left + Q.lvp_right >= 35) {
        Q.lvp_left *= 0.9;
        Q.lvp_right *= 0.9;
    }
    if (Q.pro_republic >= (Q.royalist_votes + Q.traditionalist_votes + Q.kvp_votes + Q.dnf_votes + Q.collectivist_votes + Q.other_votes + 30)) {
        Q.ddp_left += 0.05;
        Q.gold_left += 0.1;
    }
    
    Q.commons_royalist_pre = Q.commons_royalist;
    Q.burgher_royalist_pre = Q.burgher_royalist;
    Q.guild_royalist_pre = Q.guild_royalist;
    Q.landed_royalist_pre = Q.landed_royalist;
    Q.disfavored_royalist_pre = Q.disfavored_royalist;
    Q.faithful_royalist_pre = Q.faithful_royalist;

    ///////////////////////////// change party support based on pro_republic
    // if pro_republic is less than the support of the Commonwealth coalition, reduce Marchers support...
    if ((Q.pro_republic < (Q.marcher_votes + Q.ddp_votes + (Q.lvp_votes / 2) + Q.unionist_votes - Q.bvp_votes) && !Q.concord_formed) || (Q.pro_republic < (Q.marcher_votes + Q.ddp_votes + (Q.lvp_votes / 2) + (Q.unionist_votes / 2.5) - Q.bvp_votes) && Q.concord_formed)) {
        if (Q.burgher_marcher > 6) {
            Q.burgher_marcher -= 6/12;
            Q.burgher_royalist += 2/12;
        }
        if (Q.guild_marcher > 4) {
            Q.guild_marcher -= 6/12;
            Q.guild_royalist += 2/12;
        }
        if (Q.landed_marcher > 4) {
            Q.landed_marcher -= 6/12;
            Q.landed_royalist += 2/12;
        }
        if (Q.commons_marcher_normalized > 40) {
            Q.commons_marcher -= 4/12;
        }
        if (Q.faithful_marcher > 15) {
            Q.faithful_marcher -= 4/12;
        }
        if (Q.disfavored_marcher_normalized > 10) {
            Q.disfavored_marcher -= 6/12;
        }
        Q.pro_republic += 1;
    }
    if (Q.other_votes < 4 && !Q.stegerwald_path && !Q.gnu_formed) {
        Q.guild_other += 6/12;
        Q.burgher_other += 6/12;
        Q.landed_other += 4/12;
    }
    if (Q.ddp_votes < 1 && !Q.dstp_gnu) {
        Q.guild_ddp += 6/12;
        Q.burgher_ddp += 4/12;
    }
    if (Q.traditionalist_votes < 6 && Q.traditionalist_ideology == "Radical" && Q.year >= 1931 && Q.royalist_votes >= 25) {
        Q.burgher_traditionalist += 4/12;
        Q.guild_traditionalist += 4/12;
        Q.landed_traditionalist += 4/12;
    }
    if (Q.disfavored_marcher_normalized < 10) {
        Q.disfavored_marcher += 4/12;
    } else if (Q.disfavored_marcher_normalized < 15) {
        Q.disfavored_marcher += 2/12;
    }
    // soft cap for nsdap workers
    if (Q.commons_royalist_normalized >= (Q.commons_collectivist_normalized - 7) && Q.disfavored >= 15) {
        Q.commons_royalist -= 4/12;
    }

    Q.center_dissent_decay = 1;
    Q.labor_dissent_decay = 1;
    Q.left_dissent_decay = 1;
    Q.reformist_dissent_decay = 1;

    Q.center_strength_gain = 0;
    Q.labor_strength_gain = 0;
    Q.left_strength_gain = 0;
    Q.reformist_strength_gain = 0;

    if (Q.left_strength < 10) Q.left_dissent_decay += 1;
    if (Q.center_strength < 10) Q.center_dissent_decay += 1;
    if (Q.labor_strength < 10) Q.labor_dissent_decay += 1;
    if (Q.reformist_strength < 10) Q.reformist_dissent_decay += 1;

    if (Q.centrists_resign) {
        Q.left_dissent_decay += 1;
        Q.labor_dissent_decay += 1;
        Q.reformist_dissent_decay += 1;
    }

    Q.center_advisor_n = 0;
    if (Q.hilferding_advisor) Q.center_advisor_n += 1;
    if (Q.wels_advisor) Q.center_advisor_n += 1;
    if (Q.muller_advisor) Q.center_advisor_n += 1;
    if (Q.breitscheid_advisor) Q.center_advisor_n += 1;

    var centrist_advisor_decay_effect = Q.center_advisor_n*0.3;

    if (Q.center_advisor_n) {
        Q.center_dissent_decay *= (1-centrist_advisor_decay_effect);
        Q.labor_dissent_decay *= (1-centrist_advisor_decay_effect);
        Q.left_dissent_decay *= (1-centrist_advisor_decay_effect);
        Q.reformist_dissent_decay *= (1-centrist_advisor_decay_effect);
    }

    Q.non_factional_advisor_n = 0;
    if (Q.baade_advisor) {
        Q.non_factional_advisor_n += 1;
        if (Q.land_reform) Q.non_factional_advisor_n += 1;
    }
    if (Q.hirschfeld_advisor) {
        Q.non_factional_advisor_n += 1;
        if (Q.homosexual_rights) Q.non_factional_advisor_n += 1;
    }
    if (Q.stampfer_advisor && Q.editorial_line == "Center") {
        Q.non_factional_advisor_n += 1;
        if (Q.collectivist_truce) Q.non_factional_advisor_n += 1;
    }
    if (Q.radbruch_advisor) {
        Q.non_factional_advisor_n += 1;
        if (Q.judicial_reform >= 2) Q.non_factional_advisor_n += 1;
    }

    var non_factional_advisor_decay_effect = Q.non_factional_advisor_n*0.15;

    if (Q.non_factional_advisor_n) {
        Q.center_dissent_decay *= (1-non_factional_advisor_decay_effect);
        Q.labor_dissent_decay *= (1-non_factional_advisor_decay_effect);
        Q.left_dissent_decay *= (1-non_factional_advisor_decay_effect);
        Q.reformist_dissent_decay *= (1-non_factional_advisor_decay_effect);
    }

    Q.labor_advisor_n = 0;
    if (Q.leipart_advisor) Q.labor_advisor_n += 1;
    if (Q.aufhauser_advisor) Q.labor_advisor_n += 1;
    if (Q.wissell_advisor) Q.labor_advisor_n += 1;
    if (Q.woytinsky_advisor) Q.labor_advisor_n += 1;

    Q.left_advisor_n = 0;
    if (Q.levi_advisor) Q.left_advisor_n += 1;
    if (Q.sender_advisor) Q.left_advisor_n += 1;
    if (Q.rosenfeld_advisor) Q.left_advisor_n += 1;
    if (Q.seydewitz_advisor) Q.left_advisor_n += 1;

    Q.reformist_advisor_n = 0;
    if (Q.severing_advisor) Q.reformist_advisor_n += 1;
    if (Q.braun_advisor) Q.reformist_advisor_n += 1;
    if (Q.juchacz_advisor) Q.reformist_advisor_n += 1;
    if (Q.pfulf_advisor) Q.reformist_advisor_n += 1;

    if (Q.royalist_votes >= 20) {
        Q.center_dissent_decay *= 0.6;
        Q.labor_dissent_decay *= 0.7;
        Q.left_dissent_decay *= 0.8;
        Q.reformist_dissent_decay *= 0.5;
    }

    if (Q.chancellor == "Staal" && Q.staal_marcher_influence) {
        Q.left_dissent_decay += Q.staal_marcher_influence*2;
    }
    // to represent schleicher glazers bullying lefties out of the party

    if (Q.chancellor == "Staal" && Q.staal_marcher_r) {
        Q.left_dissent_decay += Q.staal_marcher_r*2;
        Q.center_dissent_decay += Q.staal_marcher_r*2;
        Q.labor_dissent_decay += Q.staal_marcher_r;
        Q.reformist_dissent_decay += Q.staal_marcher_r;
    }
    // to represent general dissatisfaction with schleicher

    if (Q.center_advisor_n) {
        if (Q.center_advisor_n == 2) {
            Q.center_dissent_decay = -0.25;
        } else if (Q.center_advisor_n == 3) {
            Q.center_dissent_decay = -0.5;
        } else {
            Q.center_dissent_decay = 0;
        }
    }

    if (Q.labor_advisor_n) {
        if (Q.labor_advisor_n == 2) {
            Q.labor_dissent_decay = -0.25;
        } else if (Q.labor_advisor_n == 3) {
            Q.labor_dissent_decay = -0.5;
        } else {
            Q.labor_dissent_decay = 0;
        }
    }

    if (Q.left_advisor_n) {
        if (Q.left_advisor_n == 2) {
            Q.left_dissent_decay = -0.25;
        } else if (Q.left_advisor_n == 3) {
            Q.left_dissent_decay = -0.5;
        } else {
            Q.left_dissent_decay = 0;
        }
    }

    if (Q.reformist_advisor_n) {
        if (Q.reformist_advisor_n == 2) {
            Q.reformist_dissent_decay = -0.25;
        } else if (Q.reformist_advisor_n == 3) {
            Q.reformist_dissent_decay = -0.5;
        } else {
            Q.reformist_dissent_decay = 0;
        }
    }

    Q.center_dissent += Q.center_dissent_decay;
    Q.labor_dissent += Q.labor_dissent_decay;
    Q.left_dissent += Q.left_dissent_decay;
    Q.reformist_dissent += Q.reformist_dissent_decay;

    Q.center_strength_gain += (Q.center_advisor_n / 2);
    Q.labor_strength_gain += (Q.labor_advisor_n / 1.5);
    Q.left_strength_gain += Q.left_advisor_n;
    Q.reformist_strength_gain += Q.reformist_advisor_n;

    if (Q.center_strength >= 40) Q.center_strength -= 0.25;
    if (Q.center_strength >= 50) Q.center_strength -= 0.25;
    if (Q.center_strength >= 60) Q.center_strength -= 0.25;
    if (Q.center_strength >= 70) Q.center_strength -= 0.25;

    if (Q.center_strength < 0) Q.center_strength = 0;
    if (Q.labor_strength < 0) Q.labor_strength = 0;
    if (Q.left_strength < 0) Q.left_strength = 0;
    if (Q.reformist_strength < 0) Q.reformist_strength = 0;

    if (Q.center_dissent < 0) Q.center_dissent = 0;
    if (Q.labor_dissent < 0) Q.labor_dissent = 0;
    if (Q.left_dissent < 0) Q.left_dissent = 0;
    if (Q.reformist_dissent < 0) Q.reformist_dissent = 0;

    Q.center_strength += Q.center_strength_gain;
    Q.labor_strength += Q.labor_strength_gain;
    Q.left_strength += Q.left_strength_gain;
    Q.reformist_strength += Q.reformist_strength_gain; 

    if (Q.reformist_strength >= 60) {
        if (Q.unionist_relation < 30 && !Q.stegerwald_path) {
            Q.unionist_relation += 0.5;
        } else if (Q.unionist_relation < 20 && !Q.concord_formed) {
            Q.unionist_relation += 0.5;
        }
        if (Q.ddp_relation < 40 && !Q.dstp_maintained) {
            Q.ddp_relation += 0.5;
        } else if (Q.ddp_relation < 30 && Q.dstp_maintained) {
            Q.ddp_relation += 0.5;
        }
        if (Q.lvp_relation < 35 && Q.lvp_leader != "Dingeldey") {
            Q.lvp_relation += 0.5;
        } else if (Q.lvp_relation < 25 && Q.lvp_leader == "Dingeldey") {
            Q.lvp_relation += 0.5;
        }
    } else if (Q.reformist_strength >= 40) {
        if (Q.unionist_relation < 30 && !Q.stegerwald_path) {
            Q.unionist_relation += 0.35;
        } else if (Q.unionist_relation < 20 && !Q.concord_formed) {
            Q.unionist_relation += 0.35;
        }
        if (Q.ddp_relation < 40 && !Q.dstp_maintained) {
            Q.ddp_relation += 0.35;
        } else if (Q.ddp_relation < 30 && Q.dstp_maintained) {
            Q.ddp_relation += 0.35;
        }
        if (Q.lvp_relation < 35 && Q.lvp_leader != "Dingeldey") {
            Q.lvp_relation += 0.35;
        } else if (Q.lvp_relation < 25 && Q.lvp_leader == "Dingeldey") {
            Q.lvp_relation += 0.35;
        }
    } else if (Q.reformist_strength >= 25) {
        if (Q.unionist_relation < 30 && !Q.stegerwald_path) {
            Q.unionist_relation += 0.25;
        } else if (Q.unionist_relation < 20 && !Q.concord_formed) {
            Q.unionist_relation += 0.25;
        }
        if (Q.ddp_relation < 40 && !Q.dstp_maintained) {
            Q.ddp_relation += 0.25;
        } else if (Q.ddp_relation < 30 && Q.dstp_maintained) {
            Q.ddp_relation += 0.25;
        }
        if (Q.lvp_relation < 35 && Q.lvp_leader != "Dingeldey") {
            Q.lvp_relation += 0.35;
        } else if (Q.lvp_relation < 25 && Q.lvp_leader == "Dingeldey") {
            Q.lvp_relation += 0.35;
        }
    }

    if (Q.left_strength >= Q.reformist_strength && Q.collectivist_relation < 60) {
        if (Q.left_strength >= 60) {
            Q.collectivist_relation += 1;
        } else if (Q.left_strength >= 40) {
            Q.collectivist_relation += 0.75;
        } else if (Q.left_strength >= 25) {
            Q.collectivist_relation += 0.5;
        }
    }

    if (Q.labor_strength >= 60 && Q.commons_marcher_normalized < 45 && !Q.peoples_party) {
        Q.commons_marcher += 1;
        if (Q.disfavored_marcher_normalized < 10) {
            Q.disfavored_marcher += 1;
        }
    } else if (Q.labor_strength >= 40 && Q.commons_marcher_normalized < 45 && !Q.peoples_party) {
        Q.commons_marcher += 0.75;
        if (Q.disfavored_marcher_normalized < 10) {
            Q.disfavored_marcher += 0.75;
        }
    } else if (Q.labor_strength >= 25 && Q.commons_marcher_normalized < 45 && !Q.peoples_party) {
        Q.commons_marcher += 0.5;
        if (Q.disfavored_marcher_normalized < 10) {
            Q.disfavored_marcher += 0.5;
        }
    }

    if (Q.bourgeois_parliament && Q.royalist_votes >= 15) {
