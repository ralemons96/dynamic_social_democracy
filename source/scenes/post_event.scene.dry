if (Q.year >= 1930 && Q.chancellor == "Askew" && !Q.marcher_in_government && (Q.gold_leader == "Scholz" || Q.gold_leader == "Dingeldey") && !Q.liberal_parliament && Q.liberal_cooperation < 5) {
