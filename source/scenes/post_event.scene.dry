if (Q.year == 1929 && Q.month == 12 && Q.dnf_formed == 1 && Q.gold_relation_9 >= 40 && Q.gold_ideology_9 !== "Right" && Q.was_in_center_right_coalition == 0 && Q.pro_republic_8 >= 70 && !Q.lvp_formed) {
