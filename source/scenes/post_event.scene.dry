    Q.guild_lvp -= 3/12;
    Q.landed_gold -= 4/12;
    Q.landed_lvp -= 4/12;
    Q.landed_traditionalist -= 6/12;
    Q.landed_dnf -= 2/12;
}

if (Q.reichsbank_policy_time >= Q.time) {
    Q.disfavored *= 0.997;
    if (Q.economic_growth < -2) Q.economic_growth *= 0.995;
    if (Q.inflation < -4) Q.inflation *= 0.995;
    if (Q.soviet_relation < 3) {
        Q.disfavored *= (0.997 - (Q.soviet_relation / 100));
    } else if (Q.soviet_relation >= 3) {
        Q.disfavored *= (0.957);
    }
    Q.commons_royalist -= 4/12;
    Q.disfavored_royalist -= 4/12;
}

if (Q.lautenbach_adopted && Q.lautenbach_plan_time >= Q.time && !Q.marcher_in_government) {
    if (Q.disfavored >= 20) Q.disfavored *= 0.988;
    if (Q.economic_growth < 0) Q.economic_growth *= 0.985;
    if (Q.inflation < 0 && !Q.bruning_sigma_time && !Q.bruning_skibidi_time) Q.inflation *= 0.985;
    if (Q.inflation < 0 && (Q.bruning_sigma_time || Q.bruning_skibidi_time)) Q.inflation *= 0.99;
    if (Q.stegerwald_path || Q.concord_formed) {
        Q.commons_unionist += 8/12;
        Q.burgher_unionist += 8/12;
        Q.guild_unionist += 8/12;
        Q.landed_unionist += 6/12;
        Q.disfavored_unionist += 12/12;
