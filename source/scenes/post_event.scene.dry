    Q.landed_traditionalist += 0.6;
    Q.guild_dnf -= 0.4;
    Q.guild_traditionalist += 0.4;
}

if (Q.traditionalist_ideology == "Radical" && Q.unionist_leader == "Sedgewick" && Q.stegerwald_transformation_timer > 0) {
    Q.burgher_unionist += 3/12;
    Q.guild_unionist += 3/12;
    Q.landed_unionist += 3/12;
    Q.landed_traditionalist -= 3/12;
    Q.burgher_traditionalist -= 3/12;
    Q.guild_traditionalist -= 3/12;
} 

if (Q.unionist_leader == "Sedgewick" && Q.stegerwald_transformation_timer > 0) {
    Q.faithful -= 5/12;
    Q.commons_marcher -= 7/12;
    Q.commons_unionist += 9/12;
    Q.burgher_unionist += 8/12;
