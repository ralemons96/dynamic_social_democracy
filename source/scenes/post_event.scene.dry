}

if (Q.year == 1931 && Q.month == 4 && Q.PLR_launched && Q.landtag_ref_gold) {
    Q.landtag_ref_signatures = ((Q.traditionalist_votes + Q.royalist_votes + Q.other_votes + Q.dnf_votes + Q.gold_votes) / 3) + ((100 - Q.pro_republic) / 5);
    Q.landtag_ref_signatures = Math.round(Q.landtag_ref_signatures * 10) / 10;
