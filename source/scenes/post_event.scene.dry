    }
}

if (Q.heuss_election_time == Q.time - 1 && Q.lvp_leader == "Hewes") {
    Q.lvp_votes_start = Q.lvp_votes;
} else if (Q.dietrich_election_time == Q.time - 1 && Q.lvp_leader == "Dietrich") {
    Q.lvp_votes_start = Q.lvp_votes;
} else if (Q.dingeldey_election_time == Q.time - 1 && Q.lvp_leader == "Dingeldey") {
    Q.lvp_votes_start = Q.lvp_votes;
}

if (Q.year == 1930 && Q.month == 8) {
    Q.brunswick_election_seen = 1;
    if (Q.traditionalist_votes + Q.royalist_votes + Q.other_votes + Q.gold_votes + Q.dnf_votes + Q.kvp_votes + Q.lvp_votes >= (Q.marcher_votes*1.6)) {
        Q.brunswick_gallax = 1;
    }
}

if (Q.disfavored >= 20 || (Q.year < 1930 && !Q.marcher_government_burden_peoples)) {
    if (Q.burgher_marcher_normalized >= 16) Q.burgher_marcher -= (Q.disfavored / 3)/12;
    if (Q.guild_marcher_normalized >= 10) Q.guild_marcher -= (Q.disfavored / 3)/12;
    if (Q.landed_marcher_normalized >= 14) Q.landed_marcher -= (Q.disfavored / 3)/12;
}

if ((!Q.works_program || Q.disfavored_marcher_normalized >= 35) && Q.veran_crash_seen && Q.disfavored >= 15) {
    if (Q.disfavored >= 35 && Q.disfavored_marcher_normalized >= 12) {
        Q.disfavored_marcher -= 10/12;
        Q.disfavored_royalist += 10/12;
    } else if (Q.disfavored >= 30 && Q.disfavored_marcher_normalized >= 15) {
        Q.disfavored_marcher -= 8/12;
        Q.disfavored_royalist += 8/12;
    } else if (Q.disfavored >= 25 && Q.disfavored_marcher_normalized >= 20) {
        Q.disfavored_marcher -= 6/12;
        Q.disfavored_royalist += 6/12;
    } else if (Q.disfavored >= 20 && Q.disfavored_marcher_normalized >= 30) {
        Q.disfavored_marcher -= 4/12;
        Q.disfavored_royalist += 4/12;
    } else if (Q.disfavored >= 15 && Q.veran_crash_seen) {
        Q.disfavored_marcher -= 2/12;
        Q.disfavored_royalist += 2/12;
    }
}

if (!Q.royalist_peak_triggered && Q.royalist_votes >= 20) {
    if (Q.commons_royalist >= Q.commons_royalist_pre + 2) {
        if (Q.commons_royalist_normalized >= 5) {
            Q.commons_royalist -= 4/12;
        }
        if (Q.commons_royalist_normalized >= 10) {
            Q.commons_royalist -= 4/12;
        }
        if (Q.commons_royalist_normalized >= 15) {
            Q.commons_royalist -= 4/12;
        }
    }
    if (Q.burgher_royalist >= Q.burgher_royalist_pre + 3) {
        if (Q.burgher_royalist_normalized >= 40) {
            Q.burgher_royalist -= 1;
        }
        if (Q.burgher_royalist_normalized >= 50) {
            Q.burgher_royalist -= 1;
        }
        if (Q.burgher_royalist_normalized >= 60) {
            Q.burgher_royalist -= 1;
        }
        if (Q.burgher_royalist_normalized >= 70) {
            Q.burgher_royalist -= 3;
        }
    }
    if (Q.guild_royalist >= Q.guild_royalist_pre + 3) {
        if (Q.guild_royalist_normalized >= 40) {
            Q.guild_royalist -= 1;
        }
        if (Q.guild_royalist_normalized >= 50) {
            Q.guild_royalist -= 1;
        }
        if (Q.guild_royalist_normalized >= 60) {
            Q.guild_royalist -= 1;
        }
        if (Q.guild_royalist_normalized >= 70) {
            Q.guild_royalist -= 3;
        }
    }
    if (Q.landed_royalist >= Q.landed_royalist_pre + 2) {
        if (Q.landed_royalist_normalized >= 40) {
            Q.landed_royalist -= 1;
        }
        if (Q.landed_royalist_normalized >= 50) {
            Q.landed_royalist -= 1;
        }
        if (Q.landed_royalist_normalized >= 60) {
            Q.landed_royalist -= 1;
        }
        if (Q.landed_royalist_normalized >= 70) {
            Q.landed_royalist -= 3;
        }
    }
}

if (Q.burgher_royalist > 110) {
    Q.burgher_royalist -= 2;
}
if (Q.guild_royalist > 110) {
    Q.guild_royalist -= 2;
}
if (Q.landed_royalist > 110) {
    Q.landed_royalist -= 2;
}

if (Q.concord_formed && Q.royalist_votes >= 20) {
    Q.commons_unionist += 3/12;
    Q.disfavored_unionist += 3/12;
    Q.burgher_unionist += 5/12;
    Q.guild_unionist += 5/12;
    Q.landed_unionist += 3/12;
    Q.commons_royalist -= 3/12;
    Q.disfavored_royalist -= 3/12;
    Q.burgher_royalist -= 5/12;
    Q.guild_royalist -= 5/12;
    Q.landed_royalist -= 3/12;
}

if (!Q.gold_exist) {
    if (Q.foreign_minister_party == "Gold") { 
        Q.foreign_minister_party = "Unionist";
        Q.foreign_minister = "Askew";
    }
    if (Q.economic_minister_party == "Gold") Q.economic_minister_party = "Traditionalist";
    if (Q.finance_minister_party == "Gold") Q.finance_minister_party = "Traditionalist";
}

for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_calculations_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_calculations_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support_calculations'] = party_support;
    total_support += party_support; 
}
for (var party of Q.parties) {
    Q[party+'_normalized_calculations'] = Q[party + '_support_calculations']/total_support;
    Q[party+'_votes_calculations'] = Math.round(Q[party+'_normalized_calculations']*1000)/ 10;
}

if (Q.ddp_ideology == "Right" && Q.ddp_leader == "Dietrich" && !Q.dstp_formed && (Q.bourgeois_parliament_ddp || Q.liberal_parliament) && !Q.lvp_formed) {
    Q.industrial_ddp_backing = 2;
} else if (!Q.lvp_formed && !Q.dstp_formed) {
    Q.industrial_ddp_backing = 1;
} else {
    Q.industrial_ddp_backing = 0;
}

if (((Q.gold_ideology == "Right" || (Q.gold_leader == "Dingeldey" || Q.gold_leader == "Scholz" || Q.gold_leader == "Lytton" || (Q.gold_leader == "Stratton" && !Q.gold_reform))) || (Q.gold_ideology == "Moderate" && Q.gold_relation < 30)) && ((Q.bourgeois_parliament || Q.liberal_parliament) || Q.year < 1930) && !Q.lvp_formed) {
    Q.industrial_gold_backing = 3;
} else if (Q.gold_leader != "Glatzel" && Q.gold_leader != "Thiel" && Q.gold_votes >= 3 && !Q.lvp_formed) {
    Q.industrial_gold_backing = 2;
} else if (!Q.lvp_formed) {
    Q.industrial_gold_backing = 1;
} else {
    Q.industrial_gold_backing = 0;
}

if (Q.lvp_formed) {
    if ((Q.lvp_ideology == "Right" && Q.lvp_leader == "Dingeldey") || Q.lvp_leader == "Lytton") {
        Q.industrial_lvp_backing = 4;
    } else if (Q.lvp_leader != "Glatzel") {
        Q.industrial_lvp_backing = 3;
    } else {
        Q.industrial_lvp_backing = 2;
    }
} else {
    Q.industrial_lvp_backing = 0;
}

if (Q.traditionalist_gold_formed) {
    Q.industrial_traditionalist_backing = 4;
} else if (Q.traditionalist_ideology == "Moderate" && Q.traditionalist_leader != "Lambach" && Q.traditionalist_leader != "Schiele" || Q.traditionalist_westarp) {
    Q.industrial_traditionalist_backing = 3;
} else if (Q.traditionalist_ideology == "Moderate" && Q.traditionalist_leader != "Lambach") {
    Q.industrial_traditionalist_backing = 2;
} else if (Q.traditionalist_leader == "Triumvirate" || Q.traditionalist_leader == "Lambach") {
    Q.industrial_traditionalist_backing = 1;
} else {
    Q.industrial_traditionalist_backing = 0;
}

if (Q.kvp_formed) {
    Q.industrial_kvp_backing = 3;
} else {
    Q.industrial_kvp_backing = 0;
}

if (Q.traditionalist_ideology == "Moderate") {
    Q.industrial_dnf_backing = 0;
}

if (Q.concord_formed) {
    if (Q.concord_ideology != "Left" && Q.concord_leader != "Lambach") {
        Q.industrial_unionist_backing = 4;
    } else {
        Q.industrial_unionist_backing = 3;
    }
} else if (Q.unionist_party_name == "Concord") {
    Q.industrial_unionist_backing = 3;
} else {
    Q.industrial_unionist_backing = 0;
}

if (Q.gnu_formed) {
    if (Q.gnu_ideology != "Left") {
        Q.industrial_gnu_backing = 4;
    } else {
        Q.industrial_gnu_backing = 3;
    }
} else {
    Q.industrial_gnu_backing = 0;
}

Q.industrial_total_backing = Q.industrial_ddp_backing + Q.industrial_gold_backing + Q.industrial_lvp_backing + Q.industrial_traditionalist_backing + Q.industrial_kvp_backing + Q.industrial_dnf_backing + Q.industrial_unionist_backing + Q.industrial_gnu_backing;

if (Q.industrial_total_backing < 6 && Q.royalist_votes >= 17) {
    Q.royalist_industrial_backing = 1;
} else {
    Q.royalist_industrial_backing = 0;
}

if (Q.industrial_total_backing) {
    if (Q.ddp_votes_calculations + 0.2 < Q.ddp_votes_post_event) {
        Q.burgher_ddp += Q.industrial_ddp_backing/Q.industrial_total_backing/1.5;
        Q.guild_ddp += Q.industrial_ddp_backing/Q.industrial_total_backing/1.5;
        Q.landed_ddp += Q.industrial_ddp_backing/Q.industrial_total_backing/3;
    }
    if (Q.gold_votes_calculations + 0.2 < Q.gold_votes_post_event) {
        Q.burgher_gold += Q.industrial_gold_backing/Q.industrial_total_backing;
        Q.guild_gold += Q.industrial_gold_backing/Q.industrial_total_backing;
        Q.landed_gold += Q.industrial_gold_backing/Q.industrial_total_backing/2;
    }
    if (Q.lvp_votes_calculations + 0.2 < Q.lvp_votes_post_event) {
        Q.burgher_lvp += Q.industrial_lvp_backing/Q.industrial_total_backing;
        Q.guild_lvp += Q.industrial_lvp_backing/Q.industrial_total_backing;
        Q.landed_lvp += Q.industrial_lvp_backing/Q.industrial_total_backing/2;
    }
    if (Q.traditionalist_votes_calculations + 0.2 < Q.traditionalist_votes_post_event) {
        Q.burgher_traditionalist += Q.industrial_traditionalist_backing/Q.industrial_total_backing;
        Q.guild_traditionalist += Q.industrial_traditionalist_backing/Q.industrial_total_backing;
        Q.landed_traditionalist += Q.industrial_traditionalist_backing/Q.industrial_total_backing;
    }
    if (Q.kvp_votes_calculations + 0.2 < Q.kvp_votes_post_event) {
        Q.burgher_kvp += Q.industrial_kvp_backing/Q.industrial_total_backing;
        Q.guild_kvp += Q.industrial_kvp_backing/Q.industrial_total_backing;
        Q.landed_kvp += Q.industrial_kvp_backing/Q.industrial_total_backing;
    }
    if (Q.unionist_votes_calculations + 0.2 < Q.unionist_votes_post_event) {
        Q.burgher_unionist += Q.industrial_unionist_backing/Q.industrial_total_backing;
        Q.guild_unionist += Q.industrial_unionist_backing/Q.industrial_total_backing;
        Q.landed_unionist += Q.industrial_unionist_backing/Q.industrial_total_backing;
    }
    if (Q.gnu_votes_calculations + 0.1 < Q.gnu_votes_post_event) {
        Q.burgher_gnu += Q.industrial_gnu_backing/Q.industrial_total_backing;
        Q.guild_gnu += Q.industrial_gnu_backing/Q.industrial_total_backing;
        Q.landed_gnu += Q.industrial_gnu_backing/Q.industrial_total_backing;
    }
}

if (Q.royalist_industrial_backing == 1) {
    if (Q.royalist_votes >= 30 && Q.year >= 1932 || Q.gallax_deported) {
        Q.royalist_industrial_backing = 2;
    } else {
        Q.royalist_industrial_backing = 1;
    }
}

Q.ddp_votes_post_event = Q.ddp_votes; 
Q.gold_votes_post_event = Q.gold_votes; 
Q.lvp_votes_post_event = Q.lvp_votes; 
Q.traditionalist_votes_post_event = Q.traditionalist_votes; 
Q.kvp_votes_post_event = Q.kvp_votes; 
Q.royalist_votes_post_event = Q.royalist_votes; 

if (Q.chancellor != "Goodryke") {
    Q.papen_chancellor_timer = 0;
}
if (Q.chancellor != "Staal") {
    Q.staal_chancellor_timer = 0;
}

Q.commons_marcher_difference = Q.commons_marcher - Q.commons_marcher_old;
Q.burgher_marcher_difference = Q.burgher_marcher - Q.burgher_marcher_old;
Q.guild_marcher_difference = Q.guild_marcher - Q.guild_marcher_old;
Q.landed_marcher_difference = Q.landed_marcher - Q.landed_marcher_old;
Q.disfavored_marcher_difference = Q.disfavored_marcher - Q.disfavored_marcher_old;
Q.faithful_marcher_difference = Q.faithful_marcher - Q.faithful_marcher_old;

Q.commons_royalist_difference = Q.commons_royalist - Q.commons_royalist_old;
Q.burgher_royalist_difference = Q.burgher_royalist - Q.burgher_royalist_old;
Q.guild_royalist_difference = Q.guild_royalist - Q.guild_royalist_old;
Q.landed_royalist_difference = Q.landed_royalist - Q.landed_royalist_old;
Q.disfavored_royalist_difference = Q.disfavored_royalist - Q.disfavored_royalist_old;
Q.faithful_royalist_difference = Q.faithful_royalist - Q.faithful_royalist_old;

if (Q.marcher_toleration || Q.rubicon) {
    if (Q.commons_marcher_difference > 0) {
        Q.commons_marcher -= Q.commons_marcher_difference / 3;
    }
    if (Q.burgher_marcher_difference > 0) {
        Q.burgher_marcher -= Q.burgher_marcher_difference / 3;
    }
    if (Q.guild_marcher_difference > 0) {
        Q.guild_marcher -= Q.guild_marcher_difference / 3;
    }
    if (Q.landed_marcher_difference > 0) {
        Q.landed_marcher -= Q.landed_marcher_difference / 3;
    }
    if (Q.disfavored_marcher_difference > 0) { 
        Q.disfavored_marcher -= Q.disfavored_marcher_difference / 3;
    }
    if (Q.faithful_marcher_difference > 0) {
        Q.faithful_marcher -= Q.faithful_marcher_difference / 3;
    }
}

if (Q.dues > Q.base_dues) {
    if (Q.commons_marcher_difference > 0) {
        Q.commons_marcher -= Q.commons_marcher_difference*((Q.dues-Q.base_dues) / 10);
    }
    if (Q.burgher_marcher_difference > 0) {
        Q.burgher_marcher -= Q.burgher_marcher_difference*((Q.dues-Q.base_dues) / 10);
    }
    if (Q.guild_marcher_difference > 0) {
        Q.guild_marcher -= Q.guild_marcher_difference*((Q.dues-Q.base_dues) / 10);
    }
    if (Q.landed_marcher_difference > 0) {
        Q.landed_marcher -= Q.landed_marcher_difference*((Q.dues-Q.base_dues) / 10);
    }
    if (Q.disfavored_marcher_difference > 0) { 
        Q.disfavored_marcher -= Q.disfavored_marcher_difference*((Q.dues-Q.base_dues) / 10);
    }
    if (Q.faithful_marcher_difference > 0) {
        Q.faithful_marcher -= Q.faithful_marcher_difference*((Q.dues-Q.base_dues) / 10);
    }
}


Q.time_since_election = (48 - (Q.next_election_time - Q.time));

Q.commons_marcher_old = Q.commons_marcher;
Q.burgher_marcher_old = Q.burgher_marcher;
Q.guild_marcher_old = Q.guild_marcher;
Q.landed_marcher_old = Q.landed_marcher;
Q.disfavored_marcher_old = Q.disfavored_marcher;
Q.faithful_marcher_old = Q.faithful_marcher;

Q.commons_royalist_old = Q.commons_royalist;
Q.burgher_royalist_old = Q.burgher_royalist;
Q.guild_royalist_old = Q.guild_royalist;
Q.landed_royalist_old = Q.landed_royalist;
Q.disfavored_royalist_old = Q.disfavored_royalist;
Q.faithful_royalist_old = Q.faithful_royalist;

if (Q.gold_relation < 0) {
    Q.gold_relation = 0;
}

if (Q.collectivist_relation < 20 && !Q.blutmai) {
    Q.collectivist_relation = 20;
} else if (Q.collectivist_relation < 0 && Q.blutmai) {
    Q.collectivist_relation = 0;
}

if (Q.lvp_relation < 0) {
    Q.lvp_relation = 0;
}

if (Q.unionist_relation < -20 && Q.concord_formed) {
    Q.unionist_relation = -20;
}

Q.ddp_r = Math.round(Q.ddp_r * 10) / 10;    
Q.unionist_r = Math.round(Q.unionist_r * 10) / 10;    
Q.other_r = Math.round(Q.other_r * 10) / 10;    

Q.bvp_votes = Q.unionist_votes*0.2;
if (Q.stegerwald_path && Q.bvp_votes >= 4) {
    Q.bvp_votes = 4;
}

if (Q.lvp_formed) {
    Q.weimar_coalition = parseFloat((Q.marcher_r + Q.lvp_r + Q.unionist_r - Q.bvp_r).toFixed(1));
} else {
    Q.weimar_coalition = parseFloat((Q.marcher_r + Q.ddp_r + Q.unionist_r - Q.bvp_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.social_liberal_coalition = parseFloat((Q.marcher_r + Q.lvp_r).toFixed(1));
} else {
    Q.social_liberal_coalition = parseFloat((Q.marcher_r + Q.ddp_r).toFixed(1));
}

Q.social_catholic_coalition = parseFloat((Q.marcher_r + Q.unionist_r - Q.bvp_r).toFixed(1));

if (Q.lvp_formed) {
    Q.grand_coalition = parseFloat((Q.marcher_r + Q.lvp_r + Q.unionist_r).toFixed(1));
} else {
    Q.grand_coalition = parseFloat((Q.marcher_r + Q.ddp_r + Q.unionist_r + Q.gold_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.unionist_r + Q.gold_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r).toFixed(1));
} else {
    Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.unionist_r + Q.gold_r + Q.other_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r + Q.traditionalist_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.unionist_r + Q.ddp_r + Q.gold_r + Q.other_r + Q.traditionalist_r + Q.kvp_r).toFixed(1));
} else if (!Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r + Q.traditionalist_r).toFixed(1));
} else {
    Q.center_right_coalition = parseFloat((Q.unionist_r + Q.ddp_r + Q.gold_r + Q.other_r + Q.traditionalist_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.right_coalition = parseFloat((Q.unionist_r + Q.lvp_r + Q.other_r + Q.traditionalist_r).toFixed(1));
} else {
    Q.right_coalition = parseFloat((Q.unionist_r + Q.gold_r + Q.other_r + Q.traditionalist_r).toFixed(1));
}

if (Q.traditionalist_ideology === "Moderate") {
    Q.far_right_coalition = parseFloat((Q.dnf_r + Q.royalist_r).toFixed(1));
} else {
    Q.far_right_coalition = parseFloat((Q.traditionalist_r + Q.royalist_r).toFixed(1));
}

if (Q.gold_leader == "Dingeldey" && Q.gold_ideology == "Right" && Q.gold_right - Q.gold_left >= 15 || Q.hugenberg_gold) {
    Q.far_right_coalition += Q.gold_r;
}

Q.left_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.sapd_r).toFixed(1));

if (Q.lvp_formed) {
    Q.popular_front_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.unionist_r - Q.bvp_r + Q.sapd_r).toFixed(1));
} else if (Q.liberal_parliament == 0 && Q.bourgeois_parliament_ddp == 0) {
    Q.popular_front_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.unionist_r + Q.ddp_r - Q.bvp_r + Q.sapd_r).toFixed(1));
} else if (Q.liberal_parliament == 1 || Q.bourgeois_parliament_ddp == 1) {
    Q.popular_front_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.unionist_r - Q.bvp_r + Q.sapd_r).toFixed(1));
}

if (Q.traditionalist_ideology === "Moderate") {
    Q.anti_democratic_coalition = parseFloat((Q.collectivist_r + Q.royalist_r + Q.dnf_r).toFixed(1));
} else {
    Q.anti_democratic_coalition = parseFloat((Q.collectivist_r + Q.royalist_r + Q.traditionalist_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.neo_weimar_coalition = parseFloat((Q.marcher_r + Q.lvp_r + Q.unionist_r + Q.other_r).toFixed(1));
} else {
    Q.neo_weimar_coalition = parseFloat((Q.marcher_r + Q.ddp_r + Q.unionist_r + Q.gold_r + Q.other_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.marcher_r + Q.lvp_r + Q.unionist_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.marcher_r + Q.ddp_r + Q.unionist_r + Q.gold_r + Q.other_r + Q.traditionalist_r + Q.kvp_r).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.marcher_r + Q.unionist_r + Q.lvp_r + Q.other_r + Q.traditionalist_r).toFixed(1));
} else {
    Q.cordon_sanitaire = parseFloat((Q.marcher_r + Q.unionist_r + Q.ddp_r + Q.gold_r + Q.other_r + Q.traditionalist_r).toFixed(1));
}

Q.gallax_right_coalition = parseFloat((Q.unionist_r + Q.royalist_r).toFixed(1));

Q.goerdeler_right_coalition = parseFloat((Q.unionist_r + Q.gold_r + Q.lvp_r + Q.other_r + Q.kvp_r + Q.traditionalist_r + Q.dnf_r).toFixed(1));

if (Q.lvp_formed) {
    Q.progressive_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + (Q.lvp_r / 3) + Q.sapd_r).toFixed(1));
} else {
    Q.progressive_coalition = parseFloat((Q.marcher_r + Q.collectivist_r + Q.ddp_r + Q.sapd_r).toFixed(1));
}

if (Q.gnu_formed) {
    Q.staal_right_coalition = parseFloat((Q.gnu_r + Q.lvp_r + Q.gold_r + Q.ddp_r + Q.unionist_r + Q.other_r + Q.kvp_r + Q.traditionalist_r + Q.dnf_r + Q.dsu_r).toFixed(1));
    Q.staal_left_coalition = parseFloat((Q.gnu_r + Q.marcher_r + Q.lvp_r + Q.gold_r + Q.ddp_r + Q.unionist_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.weimar_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland + Q.unionist_r_heartland ).toFixed(1));
} else {
    Q.weimar_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland).toFixed(1));
}

if (Q.lvp_formed) {
    Q.social_liberal_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland).toFixed(1));
} else {
    Q.social_liberal_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland).toFixed(1));
}

Q.social_catholic_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.unionist_r_heartland).toFixed(1));

if (Q.lvp_formed) {
    Q.grand_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland + Q.unionist_r_heartland).toFixed(1));
} else {
    Q.grand_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.bourgeois_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.bourgeois_coalition_heartland = parseFloat((Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.bourgeois_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland).toFixed(1));
} else {
    Q.bourgeois_coalition_heartland = parseFloat((Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.center_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.ddp_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (!Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
} else {
    Q.center_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.ddp_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
}

if (Q.lvp_formed) {
    Q.right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
} else {
    Q.right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
}

if (Q.traditionalist_ideology === "Moderate") {
    Q.far_right_coalition_heartland = parseFloat((Q.dnf_r_heartland + Q.royalist_r_heartland).toFixed(1));
} else {
    Q.far_right_coalition_heartland = parseFloat((Q.traditionalist_r_heartland + Q.royalist_r_heartland).toFixed(1));
}

if (Q.gold_leader == "Dingeldey" && Q.gold_ideology == "Right" && Q.gold_right - Q.gold_left >= 15 || Q.hugenberg_gold) {
    Q.far_right_coalition_heartland = parseFloat((Q.far_right_coalition_heartland + Q.gold_r_heartland).toFixed(1));
}

Q.left_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.sapd_r_heartland).toFixed(1));

if (Q.lvp_formed) {
    Q.popular_front_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.unionist_r_heartland + Q.sapd_r_heartland).toFixed(1));
} else if (Q.liberal_parliament == 0) {
    Q.popular_front_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.unionist_r_heartland + Q.ddp_r_heartland + Q.sapd_r_heartland).toFixed(1));
} else if (Q.liberal_parliament == 1) {
    Q.popular_front_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.unionist_r_heartland + Q.sapd_r_heartland).toFixed(1));
}

if (Q.traditionalist_ideology === "Moderate") {
    Q.anti_democratic_coalition_heartland = parseFloat((Q.collectivist_r_heartland + Q.royalist_r_heartland + Q.dnf_r_heartland).toFixed(1));
} else {
    Q.anti_democratic_coalition_heartland = parseFloat((Q.collectivist_r_heartland + Q.royalist_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
}

if (Q.lvp_formed) {
    Q.neo_weimar_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland + Q.unionist_r_heartland + Q.other_r_heartland).toFixed(1));
} else {
    Q.neo_weimar_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.cordon_sanitaire_heartland = parseFloat((Q.marcher_r_heartland + Q.lvp_r_heartland + Q.unionist_r_heartland + Q.other_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.cordon_sanitaire_heartland = parseFloat((Q.marcher_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland + Q.kvp_r_heartland).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.cordon_sanitaire_heartland = parseFloat((Q.marcher_r_heartland + Q.unionist_r_heartland + Q.lvp_r_heartland + Q.other_r_heartland + Q.traditionalist_r_heartland).toFixed(1));
} else {
    Q.cordon_sanitaire_heartland = parseFloat((Q.marcher_r_heartland + Q.unionist_r_heartland + Q.ddp_r_heartland + Q.gold_r_heartland + Q.other_r_heartland + Q.traditionalist_r).toFixed(1));
}

// Q.gallax_right_coalition_heartland = parseFloat((Q.unionist_r_heartland + Q.traditionalist_r_heartland + Q.royalist_r_heartland).toFixed(1));

if (Q.lvp_formed) {
    Q.progressive_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + (Q.lvp_r_heartland / 2) + Q.sapd_r_heartland).toFixed(1));
} else {
    Q.progressive_coalition_heartland = parseFloat((Q.marcher_r_heartland + Q.collectivist_r_heartland + Q.ddp_r_heartland + Q.sapd_r_heartland).toFixed(1));
}

if (Q.gnu_formed) {
    Q.staal_right_coalition_heartland = parseFloat((Q.gnu_r_heartland + Q.lvp_r_heartland + Q.gold_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland + Q.other_r_heartland + Q.kvp_r_heartland + Q.traditionalist_r_heartland + Q.dnf_r_heartland + Q.dsu_r_heartland).toFixed(1));
    Q.staal_left_coalition_heartland = parseFloat((Q.gnu_r_heartland + Q.marcher_r_heartland + Q.lvp_r_heartland + Q.ddp_r_heartland + Q.unionist_r_heartland).toFixed(1));
}

if (Q.collectivist_relation >= 30 && Q.sapd_formed == 1) {
    Q.weimar_coalition_heartland += Q.sapd_r_heartland;
}

if (Q.in_social_catholic_coalition_heartland || Q.in_social_liberal_coalition_heartland || Q.in_weimar_coalition_heartland == 1 || Q.in_grand_coalition_heartland == 1 || Q.in_popular_front_heartland == 1 || Q.in_left_front_heartland == 1 || Q.in_marcher_majority_heartland == 1 || Q.in_minority_weimar_coalition_heartland == 1 || Q.in_minority_grand_coalition_heartland == 1) {
    Q.marcher_heartland = 1;
    Q.right_heartland = 0;
} else if (Q.in_right_coalition_heartland == 1 || Q.in_center_right_coalition_heartland == 1 || Q.heartland_leader == "Goodryke" || Q.heartland_leader == "Goring" || Q.in_far_right_coalition_heartland == 1) {
    Q.right_heartland = 1;
    Q.marcher_heartland = 0;
}

for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c + '_' + party] < 0) {
            Q[c + '_' + party] = 0;
        }
        class_votes += Q[c + '_' + party];
    }
    let multiplier = 1.0;
    if (class_votes >= 100) {
        multiplier *= 0.99;
        if (class_votes >= 150) multiplier *= 0.98;
        if (class_votes >= 200) multiplier *= 0.97;
        if (class_votes >= 250) multiplier *= 0.96;
        if (Q.year >= 1934) multiplier *= 0.98;
    }
    for (var party of Q.parties) {
        Q[c + '_' + party] *= multiplier;
    }
    let new_total = 0;
    for (var party of Q.parties) {
        new_total += Q[c + '_' + party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100 * Q[c + '_' + party] / new_total;
        Q[c + '_' + party + '_display'] = Math.round(Q[c + '_' + party + '_normalized']);
    }
}

if (Q.stolper_program_adopted != undefined) {
    this.achieve('stolper_program');
}

if (Q.year == 1930 && Q.month == 11 && Q.dstp_collapsed && !Q.lvp_formed && !Q.lvp_timer_2_trigger) {
    this.achieve('dstp_congress');
    this.achieve('ddp_dietrich')
}

if (Q.budget < 0) {
    Q.schwarze_null = 0;
}

if (Q.marcher_toleration || (Q.marcher_in_government && !Q.in_marcher_majority))
    Q.catastrophepolitik_cancel = 1;
}

if (Q.chancellor == "Askew") {
    if (!Q.soziale_marktwirtschaft_start && Q.disfavored >= 15) Q.soziale_marktwirtschaft_start = Q.disfavored;
} else {
    Q.soziale_marktwirtschaft_start = 0;
}

if (Q.disfavored <= Q.soziale_marktwirtschaft_start - 10) {
    this.achieve('soziale_marktwirtschaft');
}

if (!(Q.year == 1928 && Q.month <= 1)) {
    for (const key in q) {
      if ((key.startsWith("game_achievement") || key.startsWith("achievement")) && q[key] === 1) {
        if (!initialAchievements.includes(key)) {
          newlyAddedAchievements.push(key);
          console.log(newlyAddedAchievements)
        }
      }
    }
}

if ((!dynamicMode && !historicalMode && Q.difficulty != 1) || (Q.year == 1934 && Q.month > 7) || Q.year >= 1935) {
  const achievementsKey = 'Reformism: An Alternate History_achievements';
  const stored = localStorage[achievementsKey];

  if (newlyAddedAchievements.length > 0) {
    newlyAddedAchievements.forEach(key => {
      q[key] = 0;
    });

    if (stored) {
        let parsed = JSON.parse(stored);
        console.log('Before deletion:', parsed);

        newlyAddedAchievements.forEach(key => {
            const strippedKey = key.replace(/^game_achievement_|^achievement_/, '');
        if (parsed[strippedKey] !== undefined) {
            delete parsed[strippedKey];
        }
    });
    console.log('After deletion:', parsed);
    localStorage[achievementsKey] = JSON.stringify(parsed);
    }
  }
}

Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    Q.has_event = 0;
}
// pre-load all of the event images
if (this.ui && this.ui.show_portraits) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc.faceImage) {
            var im = new Image();
            im.url = cc.faceImage;
        }
    }
}
if (typeof window !== "undefined" && window.generateBar) {
}
!}
go-to: bg_change if rubicon; events_choice if has_event = 1 and not rubicon; main if has_event = 0 and difficulty >= 0 and not rubicon; main.main_easy if has_event = 0 and difficulty < 0 and not rubicon

= [+ month : month +] [+ year_display +][? if rubicon:, Week [+ week +]?]

@bg_change
set-bg: img/street.jpg
