        Q.disfavored_marcher -= 2*Q.strife_size/12;
        Q.disfavored_collectivist -= 2*Q.strife_size/12;
        Q.burgher_royalist += 1*Q.strife_size/12;
        Q.burgher_marcher -= 1*Q.strife_size/12;
        Q.pro_republic -= 0.1;
    }
    if (Q.loyalist_paramilitary) {
        Q.commons_royalist += 1*Q.strife_size/12;
        Q.disfavored_royalist += 2*Q.strife_size/12;
        Q.disfavored_marcher -= 1*Q.strife_size/12;
        Q.disfavored_collectivist -= 1*Q.strife_size/12;
