        Q.commons_gold += 1/12;
        Q.burgher_gold += 2/12;
        Q.landed_gold += 1/12;
        Q.faithful_gold += 2/12;
    }
}

Q.strife_size = 0;
Q.strife_size += Q.loyalist_militancy*0.8;
Q.strife_size += Q.warden_militancy/2;
Q.strife_size += Q.strife / 50;
if (Q.year == 1930) Q.strife_size = Q.strife_size / 2;

Q.max_commons_para = 10;
Q.max_disfavored_para = 10; 
Q.max_burgher_para = 5;
Q.max_guild_para = 3;

if (Q.year >= 1930 && !Q.royalist_check) {
    Q.commons_royalist_para = 0;
    Q.disfavored_royalist_para = 0;
    Q.burgher_royalist_para = 0;
    Q.guild_royalist_para = 0;
    Q.royalist_check = 1;
}

Q.commons_royalist_para_pre = Q.commons_royalist;
Q.disfavored_royalist_para_pre = Q.disfavored_royalist;
Q.burgher_royalist_para_pre = Q.burgher_royalist;
Q.guild_royalist_para_pre = Q.guild_royalist;

if (Q.far_right_paramilitary && Q.year >= 1930 && !Q.streetfighting_joever) {
    if (Q.far_right_paramilitary_highest) {
        Q.commons_royalist += 4*Q.strife_size/12;
        Q.commons_marcher -= 4*Q.strife_size/12;
        Q.disfavored_royalist += 6*Q.strife_size/12;
        Q.disfavored_marcher -= 6*Q.strife_size/12;
