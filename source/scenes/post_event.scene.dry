        Q.commons_marcher -= 2*Q.strife_size/12;
        Q.disfavored_royalist += 4*Q.strife_size/12;
        Q.disfavored_marcher -= 3*Q.strife_size/12;
        Q.disfavored_collectivist -= 3*Q.strife_size/12;
        Q.burgher_royalist += 2*Q.strife_size/12;
        Q.burgher_marcher -= 2*Q.strife_size/12;
        Q.pro_republic -= 0.2;
    } else if (Q.far_right_paramilitary_low) {
