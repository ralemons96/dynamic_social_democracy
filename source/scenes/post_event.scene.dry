                Q.burgher_lvp += 10/12;
            }
            if (Q.guild_lvp_normalized < 40) {
                Q.guild_lvp += 10/12;
            }
            if (Q.landed_traditionalist_normalized < 40) {
                Q.landed_traditionalist += 6/12;
            }
            if (Q.faithful_unionist_normalized < 40 && !Q.concord_formed) {
                Q.faithful_unionist += 6/12;
            }
            if (Q.concord_formed) {
                if (Q.commons_unionist_normalized < 15) {
                    Q.faithful_unionist += 6/12;
                }
                if (Q.burgher_unionist_normalized < 40) {
                    Q.burgher_unionist += 6/12;
                }
                if (Q.guild_unionist_normalized < 40) {
                    Q.guild_unionist += 8/12;
                }
                if (Q.landed_unionist_normalized < 40) {
                    Q.landed_unionist += 8/12;
                }
                if (Q.disfavored_unionist_normalized < 10) {
                    Q.disfavored_unionist += 4/12;
                }
                if (Q.faithful_unionist_normalized < 30) {
                    Q.faithful_unionist += 4/12;
                }                                                
            }
            if (Q.pro_republic >= 75 && Q.kvp_formed) {
                Q.landed_kvp += 5/12;
                Q.burgher_kvp += 5/12;
                Q.guild_kvp += 5/12;
                Q.landed_traditionalist -= 5/12;
                Q.burgher_traditionalist -= 3/12;
                Q.guild_traditionalist -= 3/12;
            }
        }
        if (Q.disfavored >= 20) {
            Q.disfavored *= 0.99;
            Q.inflation += 3/12;
            Q.economic_growth += 2/12;
            if (Q.bruning_time) {
                Q.burgher_ddp -= 2/12;
                Q.guild_ddp -= 1/12;
                Q.burgher_gold -= 2/12;
                Q.burgher_lvp -= 4/12;
                Q.guild_gold -= 2/12;
                Q.guild_lvp -= 3/12;
                Q.landed_gold -= 2/12;
                Q.landed_lvp -= 2/12;
            }
            if (Q.bruning_toleration_time && Q.marcher_votes >= 26) {
                Q.commons_marcher -= 4/12;
                Q.commons_collectivist += 6/12;
                Q.commons_royalist += 2/12;
                Q.burgher_marcher -= 4/12;
                Q.guild_marcher -= 4/12;
                Q.landed_marcher -= 4/12;
                Q.faithful_marcher -= 2/12;
            }
        }
    }
    // prevent forever support if the economy is bad
    if (Q.year >= 1934) {
        if (Q.disfavored >= 15 && Q.year == 1934) {
            Q.disfavored *= 0.98;
            Q.inflation += 3/12;
            Q.economic_growth += 3/12;
        }
        if ((Q.inflation >= 8 || Q.disfavored >= 20) && Q.pro_republic <= 45 && Q.marcher_in_government) {
            if (Q.commons_marcher_normalized > 40) {
                Q.commons_marcher -= 6/12;
            }
            if (Q.disfavored_marcher_normalized > 20) {
                Q.disfavored_marcher -= 6/12;
            }
            if (Q.burgher_marcher_normalized > 20) {
                Q.burgher_marcher -= 6/12;
            }
            if (Q.guild_marcher_normalized > 20) {
                Q.guild_marcher -= 6/12;
            }
            if (Q.landed_marcher_normalized > 20) {
                Q.landed_marcher -= 6/12;
            }
            if (Q.faithful_marcher_normalized > 20) {
                Q.faithful_marcher -= 6/12;
            }
        }
    }

if (Q.dnf_decay_timer > 0) {
    Q.burgher_dnf -= 0.25;
