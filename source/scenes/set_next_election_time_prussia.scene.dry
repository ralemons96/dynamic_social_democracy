title: next election time
on-arrival: next_election_time_heartland = time+3 if next_election_time_heartland >= time+3; next_election_month_heartland = month + 3 if next_election_time_heartland >= time+3; next_election_year_heartland = year if next_election_time_heartland >= time+3; next_election_year_heartland += 1 if next_election_month_heartland > 12; next_election_month_heartland -= 12 if next_election_month_heartland > 12; 
