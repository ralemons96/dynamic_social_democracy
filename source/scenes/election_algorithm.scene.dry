title: Election
on-arrival: {!
// calculate normalized class voting amounts (0 to 100)
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}

// 1. calculate support for each of the parties
var total_support = 0;
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        // but this version is somewhat more entertaining and allows for wilder swings in votes.
        // the other option basically necessitates a multi-class strategy. while the first option allows for a working-class-only strategy.
        if (Q.old_demographics) {
            // okay i'm pretty sure this is wrong, and the hard version is correct
            // basically this allows for "spillover" effects in other demographics.
            // so you can campaign among say the workers and 
            party_support += Q[c]*Q[c+'_'+party];
            // However, there should be a cap on how much party support you can get in a certain demo.
        } else  {
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        }
    }
    Q[party + '_support'] = party_support;
    total_support += party_support;
    if (party == "other") {
        Q.cnblp_normalized = Q.landed_other_normalized*Q.landed;
        Q.wp_normalized = (Q.burgher_other_normalized*Q.burgher) + (Q.guild_other_normalized*Q.guild);
        if (Q.csvd_formed && !Q.aspd_other) Q.csvd_normalized = Q.commons_other_normalized*Q.commons;
        if (Q.aspd_other) Q.aspd_normalized = (Q.commons_other_normalized*Q.commons) + (Q.disfavored_other_normalized*Q.disfavored);
        if (Q.aspd_kvp) Q.aspd_normalized = (Q.commons_kvp_normalized*Q.commons) + (Q.disfavored_kvp_normalized*Q.disfavored);
        if (Q.right_gnu) Q.right_gnu_normalized = ((Q.burgher_gnu_normalized / 2)*Q.burgher) + (Q.guild_gnu_normalized*Q.guild) + (Q.landed_gnu_normalized*Q.landed) + ((Q.faithful_gnu_normalized / 2)*Q.faithful);
        if (Q.left_gnu) Q.left_gnu_normalized = ((Q.burgher_gnu_normalized / 2)*Q.burgher) + (Q.commons_gnu_normalized*Q.commons) + (Q.disfavored_gnu_normalized*Q.disfavored) + ((Q.faithful_gnu_normalized / 2)*Q.faithful);
    }
    if (party == "royalist" && Q.royalist_split) {
        Q.royalist_gallax_support = Q.landed_royalist_normalized*Q.landed;
        Q.royalist_gallax_support += Q.guild_royalist_normalized*Q.guild;
        Q.royalist_gallax_support += Q.faithful_royalist_normalized*Q.faithful;

        if (Q.dsu_exist && !Q.nvf_exist) {
            Q.dsu_support = Q.commons_royalist*Q.commons*((120 - Q.loyalist_force) / 100);
            Q.dsu_support += Q.disfavored_royalist*Q.disfavored*((80 - Q.loyalist_force) / 100);
            Q.dsu_support += Q.burgher_royalist*Q.burgher;
        } else if (!Q.dsu_exist && Q.nvf_exist) {
            Q.nvf_support = Q.disfavored_royalist*Q.disfavored*((120 - Q.loyalist_force) / 100);
            Q.nvf_support += Q.commons_royalist*Q.commons*((Q.loyalist_force - 80) / 100);
            Q.nvf_support += Q.burgher_royalist*Q.burgher;
        } else if (Q.dsu_exist && Q.nvf_exist) {
            Q.dsu_support = Q.commons_royalist*Q.commons*((120 - Q.loyalist_force) / 100);
            Q.dsu_support += Q.disfavored_royalist*Q.disfavored*((80 - Q.loyalist_force) / 100);
            Q.dsu_support += Q.burgher_royalist*Q.burgher;

            Q.nvf_support = Q.disfavored_royalist*Q.disfavored*((120 - Q.loyalist_force) / 100);
            Q.nvf_support += Q.commons_royalist*Q.commons*((Q.loyalist_force - 80) / 100);
        } else {
            Q.royalist_gallax_support += Q.commons_royalist*Q.commons;
            Q.royalist_gallax_support += Q.disfavored_royalist*Q.disfavored;
            Q.royalist_gallax_support += Q.burgher_royalist*Q.burgher;
        }
    }
}
// 2. normalize support (fraction)
// 3. Round to integers
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    if (party == "other") {
        Q.cnblp_votes = (Q.cnblp_normalized/total_support);
        Q.wp_votes = (Q.wp_normalized/total_support);
        if (Q.csvd_formed && !Q.aspd_other) Q.csvd_votes = (Q.csvd_normalized/total_support);
        if (Q.aspd_other || Q.aspd_kvp) Q.aspd_votes = (Q.aspd_normalized/total_support);
        if (Q.right_gnu) Q.right_gnu_votes = (Q.right_gnu_normalized/total_support);
        if (Q.left_gnu) Q.left_gnu_votes = (Q.left_gnu_normalized/total_support);
    }
    if (party == "royalist" && Q.royalist_split) {
        Q.royalist_gallax_normalized = Q.royalist_gallax_support / total_support;
        Q.dsu_normalized = Q.dsu_support / total_support;
        if (Q.nvf_exist) Q.nvf_normalized = Q.nvf_support / total_support;
        Q.royalist_gallax_votes = Math.round(Q.royalist_gallax_normalized*1000) / 10;
        Q.dsu_votes = Math.round(Q.dsu_normalized*1000) / 10;
        if (Q.nvf_exist) Q.nvf_votes = Math.round(Q.nvf_normalized*1000) / 10;
    }
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*1000)/ 10;
    if (party == "other") {
        Q.cnblp_votes = Math.round((Q.cnblp_votes*1000)/10);
        Q.wp_votes = Math.round((Q.wp_votes*1000)/10);
        if (Q.csvd_formed && !Q.aspd_other) Q.csvd_votes = Math.round((Q.csvd_votes*1000)/10);
        if (Q.aspd_other || Q.aspd_kvp) Q.aspd_votes = Math.round((Q.aspd_votes*1000)/10);
        if (Q.right_gnu) Q.right_gnu_votes = Math.round((Q.right_gnu_votes*1000)/10);
        if (Q.left_gnu) Q.left_gnu_votes = Math.round((Q.left_gnu_votes*1000)/10);
    }
}
!}
go-to: jumpScene

# note: this is a helpful utility to deal with elections and so on.
