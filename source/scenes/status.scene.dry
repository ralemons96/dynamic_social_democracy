@paramilitaries
on-arrival: {!
Q.banner_strength_2 = Q.banner_strength.toFixed(1);
Q.vanguard_strength_2 = Q.vanguard_strength.toFixed(1);
Q.warden_strength_2 = Q.warden_strength.toFixed(1);
Q.loyalist_strength_2 = Q.loyalist_strength.toFixed(1);
!}

