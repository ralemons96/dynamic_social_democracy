[? if not lvp_formed: [? if ddp_name == "CSP": <span class="tooltip-text" title="Commonwealth State Party" style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if ddp_name == "Gold": <span class="tooltip-text" title="Commonwealth Democratic Party" style="color: #D3C24D;">**[+ ddp_name +]**</span>?]: [? if industrial_ddp_backing == 0: none?][? if industrial_ddp_backing == 1: low?][? if industrial_ddp_backing == 2: medium?]  ?]

[? if lvp_formed: <span class="tooltip-text" title="Golds" style="color: #C0A054;">**Golds**</span>: [? if industrial_lvp_backing == 2: medium?][? if industrial_lvp_backing == 3: high?][? if industrial_lvp_backing == 4: highest?] ?]

[? if not lvp_formed and gold_exist: <span class="tooltip-text" title="Commonwealth People's Party" style="color: #C0A054;">**Golds**</span>: [? if industrial_gold_backing == 1: low?][? if industrial_gold_backing == 2: medium?][? if industrial_gold_backing == 3: high?] ?]

[? if not concord_formed and not traditionalist_defunct: <span class="tooltip-text" title="Commonwealth National People's Party" style="color: #3E88B3;">**Traditionalists**</span>: [? if industrial_traditionalist_backing == 4: highest?][? if industrial_traditionalist_backing == 3: high?][? if industrial_traditionalist_backing == 2: medium?][? if industrial_traditionalist_backing == 1: low?][? if industrial_traditionalist_backing == 0: [? if traditionalist_ideology == "Moderate": none?][? if traditionalist_ideology == "Radical": Mallin funded?]?]?]

[? if traditionalist_ideology == "Moderate": <span class="tooltip-text" title="Commonwealth National Front" style="color: #003755;">**CNF**</span>: Mallin funded ?]

[? if kvp_formed and not traditionalist_gold_formed: <span class="tooltip-text" title="Conservative People's Party" style="color: #0087DC;">**CPP**</span>: high ?]

[? if traditionalist_gold_formed: <span class="tooltip-text" title="Free Conserative Party" style="color: #00C0FF;">**FCP**</span>: high ?] 

[? if dsu_exist: <span class="tooltip-text" title="Commonwealth Social Free Guild" style="color: #6A1E1E;">**CSG**</span>: none ?]

<span class="tooltip-text" title="Imperial Sovereigntist Commonwealth Worker's Party (Royalists)" style="color: #7A3C00;">**Royalists**</span>: [? if industrial_royalist_backing == 0: none?][? if industrial_royalist_backing == 1: low?][? if industrial_royalist_backing == 2: medium?]

[? if nvf_exist: <span class="tooltip-text" title="National People's Front" style="color: #142e20;">**NPF**</span>: none ?]

