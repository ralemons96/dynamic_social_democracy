Q.crisis_urgency = 0;
// royalist_urgency indicates how seriously the Marchers take the Royalist threat - scale from 0 to 10.
Q.royalist_urgency = 0;
// imperial_fear: public dread of the Empire-in-Exile after the Fall of Ivion - scale from 0 to 10.
Q.imperial_fear = 0;
// radicalization indicates how radical the Marchers's rhetoric is - scale from 0 to 10.
Q.radicalization = 0;
// Support for the WTB plan and proto-Keynesian works creation plans in general
Q.wtb_support = 0;
// Support for Pacifism within the Marchers relative to 1928
Q.pacifism = 0;
// Support for democratic reform within the Marchers relative to 1928
Q.democratization = 0;
// Support for a communist coalition relative to 1928
Q.communist_coalition = 0;
// economic_plan: have we adopted *any* economic plan?
// 1 - WTB plan, 2 - AfA-bund plan, 3 - radical plan (mass nationalization of industries)
Q.economic_plan = 0;
// have we officially adopted the WTB plan?
Q.wtb_adopted = 0;
// have we formed the iron front?
Q.iron_front_formed = 0;
// people's party support
Q.peoples_party_support = 0;
Q.peoples_party = 0;
// support for nationalizations
Q.nationalization_support = 0;
Q.nationalization_adopted = 0;
// moderate economic plan
Q.moderate_plan_support = 0;
Q.moderate_plan_adopted = 0;

// organizations

// inter-party relations
Q.unionist_relation = 50;
Q.collectivist_relation = 25;
Q.ddp_relation = 60;
Q.gold_relation = 35;
// Traditionalists and Royalists are invariably hostile
Q.traditionalist_relation = 5;
Q.royalist_relation = 0;
Q.lvp_relation = 0;
// the Arcanists/Eternals (magi party) start wary of the republic
Q.bvp_relation = 10;
// magi_balance (0-100): the magi caste's allegiance. Low = toward Restoration / the Empire
// (when persecuted); high = toward the republic (when granted rights). 50 = wavering.
Q.magi_balance = 50;
// commonwealth_standing (0-100): the republic's overall strength = stability + military
// readiness + legitimacy. Recomputed when the status is viewed. Strength makes peace credible.
Q.commonwealth_standing = 50;
// empire_posture (0-100): the Empire-in-Exile's stance. Low = the Hardliners ascendant (war);
// high = the Empress's reconciliation faction prevails (peace). Drifts toward our standing.
Q.empire_posture = 50;
// reunification_support (0-100): readiness for a peaceful return to the Empire. Recomputed
// when the status is viewed; read by the Convention endgame for the Reunification outcome.
Q.reunification_support = 33;
// empire_outcome: set by the Convention endgame for a surviving republic - "" / "cold_war" /
