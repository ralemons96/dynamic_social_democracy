title: Ending Slides
view-if: (chancellor != "Gallax" and president != "Gallax" and president != "Gorrick" and (not total_defeat or papen_win)) or rubicon_mini or gallax_empire_end
on-arrival: {!
const toolsWrapper = document.getElementById('tools_wrapper');
if (toolsWrapper) {
  toolsWrapper.style.display = 'none';
}
const elements = document.querySelectorAll('header, #content, footer');
elements.forEach(el => {
  el.style.maxWidth = '800px';
});

if (Q.president != "Hammerton" && Q.president != "Gallax" && Q.president != "Gorrick" && Q.president != "Selden" && Q.chancellor != "Gallax" && !Q.hammerstein_win && !(Q.president == "Hargen" && Q.chancellor == "Selden")) {
  Q.weimar_win = 1;
} else {
  Q.weimar_win = 0;
}

if (Q.weimar_win && (Q.president == "Pendrigon" || Q.president == "Halsmark" || Q.president == "Munzer" || Q.president == "Ostwick" || Q.president == "Mann") && Q.in_left_front && !Q.civil_war_seen) {
  Q.left_win = 1;
  Q.weimar_win = 0;
  Q.collectivist_points = 0;
  Q.collectivist_points += Q.vanguard_force;
  Q.collectivist_points += (100 - Q.pro_republic) / 2;
  Q.collectivist_points += Q.disfavored / 2;
  Q.collectivist_points += Q.collectivist_votes;
  Q.collectivist_points += Q.soviet_relation;
  if (Q.president == "Halsmark") Q.collectivist_points += 16;
  if (Q.president == "Munzer") Q.collectivist_points += 10;
  if (Q.collectivist_leader == "Conciliators") Q.collectivist_points += 6;
  if (Q.sapd_formed) {
    Q.collectivist_points += 2;
    Q.collectivist_points += Q.sapd_votes;
  }
  if (Q.marcher_votes < 26) Q.collectivist_points += 5;
  if (Q.eu) Q.collectivist_points -= 10;
  if (Q.marcher_votes >= 36) Q.collectivist_points -= 5;
  if (Q.marcher_votes >= 40) Q.collectivist_points -= 5;

  if (Q.collectivist_points >= 50) {
    Q.collectivist_win = 1;
  } else {
    Q.collectivist_win = 0;
  }
}

// Empire outcome matrix (lift 5 - the Commonwealth Convention): if the republic survived the
// internal crisis (weimar_win), the real question is the Empire-in-Exile. Strength deters it
// into a Cold War; a moderated realm reunifies in peace; weakness provokes the invasion the
// Hardliners have wanted - resolved, repel/stalemate/conquest, by the civil-war power math.
Q.empire_outcome = "";
if (Q.weimar_win) {
  var _posture = (Q.empire_posture === undefined) ? 50 : Q.empire_posture;
  var _reunion = (Q.reunification_support === undefined) ? 33 : Q.reunification_support;
  var _stab = (Q.stability === undefined) ? 50 : Q.stability;
  var _ready = Q.military_readiness || 0;
  if (_posture >= 65 && _reunion >= 60) {
    Q.empire_outcome = "reunification";
  } else if (_posture >= 50 || (_stab >= 55 && _ready >= 250)) {
    Q.empire_outcome = "cold_war";
  } else {
    // Provoke -> War. Reuse the civil-war strength x militancy x loyalty model: our loyal army
    // + the republican Banners + a popular-defence levy, against the Empire's invading host.
    var _loyalArmy = (Q.army_strength || 0) * (Q.army_militancy || 0) * (Q.army_loyalty || 0);
    var _banners = (Q.banner_strength || 0) * (Q.banner_militancy || 0);
    var _levy = (Q.pro_republic || 0) * 2;
    Q.defense_power = Math.round(_loyalArmy + _banners + _levy);
    // The Empire's host: a strong, magically-backed army, swollen by the loyalists who rally to
    // it and emboldened by our fear and our weakness.
    Q.empire_power = Math.round(700 + (Q.loyalist_strength || 0) * (Q.loyalist_militancy || 0)
        + (Q.imperial_fear || 0) * 30 + Math.max(0, 50 - _posture) * 8);
    if (Q.defense_power > Q.empire_power * 1.1) {
      Q.empire_outcome = "war_repel";
    } else if (Q.defense_power / Q.empire_power >= 0.55) {
      Q.empire_outcome = "war_stalemate";
    } else {
      Q.empire_outcome = "war_conquest";
    }
  }
} else if (Q.gallax_empire_end && !Q.republic_victory && !Q.long_war) {
  // Gallax opened the gate (Part C): DuFour reached for the restorationist, and the Empire collects
  // what the republic could no longer hold. This is the dark mirror of the Staal reunification - not
  // a realm walking north by treaty, but a province delivered up. Texture from the cascade-earned
  // collusion (imperial_collusion) and the Empire's willingness (empire_posture).
  var _gPosture = (Q.empire_posture === undefined) ? 50 : Q.empire_posture;
  var _gCollusion = Q.imperial_collusion || 0;
  Q.empire_outcome = "submission";
  Q.gate_resisted = Q.civil_war_seen ? 1 : 0;
  Q.gate_welcomed = ((_gPosture >= 55) || (_gCollusion >= 3)) ? 1 : 0;
}
// Staal "fair reunification" (Part D): the Staal/GNU win (hammerstein_win) is NOT handled here -
// it routes to the repurposed @dnef_win "The Negotiated Return" slide directly, so no empire_outcome
// is computed for it. The existing @reunification slide stays for the republic-negotiates-return path.
!}
set-bg: img/paper.jpg
new-page: true

A chapter in history closes.

- @taming_lose
- @gate_opened
- @dnef_win
- @weimar_win
- @weimar_mega_win
- @civil_war_win
- @civil_war_long
- @monarchy_win
- @papen_win
- @left_win
- @cold_war
- @reunification
- @war_repel
- @war_stalemate
- @war_conquest

@taming_lose
title: The <span style="color: #7A3C00;">Royalist</span> Beast Tamed?
subtitle: Ending 0.5
view-if: rubicon_mini and not civil_war_seen and (chancellor == royalist_chancellor or president == "Gallax" or president == "Gorrick")
new-page: true

With the appointment of [+ chancellor +] and the passage of the Unitary Power Decree, the Commonwealth is lost. Staal, increasingly sidelined by health issues, fades into irrelevance. Following[? if president == "DuFour":&nbsp;President DuFour's and?] his[? if president == "DuFour":&nbsp;own?] death, General Konrad Halloran assumes the presidency, marking the end of the failed taming experiment.

The bourgeois establishment that once collaborated with the <span style="color: #7A3C00;">Royalists</span> is purged en masse in a single bloody night of reckoning, and offers no serious resistance thereafter—aside from a failed conspiracy, years later, by former Staal loyalists.

And in the end *taming* was always the wrong word for it. The men who installed [+ chancellor +] to bargain with the Empress had mistaken which hand held the leash. Across the northern frontier the Empress's court watches the Commonwealth's institutions fall one by one with the patience of those who know a gate has been left unbarred—and that the men inside spent the last of their strength prying it open.

- @go_back

@dnef_win
title: The Negotiated Return
subtitle: Ending — Annexation
view-if: hammerstein_win and not civil_war_seen
new-page: true
audio: music/1930_1933/anthem.mp3

[? if president != "DuFour": In 1934 President DuFour announced his retirement and endorsed the <span style="color: #BFC8CC;">**GNU**</span>, presenting the resulting election as a test of whether the people wanted Staal's project. They returned it: [+ president +] won the presidency for the <span style="color: #BFC8CC;">**GNU**</span>, and DuFour withdrew from public life. Staal was privately critical of the early retirement, which he regarded as DuFour placing his family above the country and risking a democratic victory at a decisive moment.?][? if president == "DuFour": By the end the <span style="color: #c00000;">**Marchers**</span> were the last party still holding out, and they were absorbed like the others—their leaders folded into the <span style="color: #BFC8CC;">**GNU**</span>, a few given junior ministries to lend the arrangement the look of a partnership. Staal's movement was now the only organized political force in the Commonwealth.?]

By the time reunification with the Empire was formally proposed, it faced no serious opposition. Across his chancellorship Staal had done what he set out to do: he ended the street-fighting, restarted the economy, and consolidated the realm's competing factions into a single bloc. The Commonwealth that opened negotiations was poor and politically repressed, but stable and unified, and so it entered the Empire by agreement rather than by conquest. The terms were, for a defeated republic, comparatively favorable.

The Assembly was retained in name and reduced in fact to a rump advisory body; real authority passed to an imperial governor and the <span style="color: #BFC8CC;">**GNU**</span> administration beneath him. The <span style="color: #c00000;">**Marchers**</span> kept their name, their newspapers, and a reduced place in government, having been spared in exchange for accepting the settlement rather than fighting it. The <span style="color: #700000;">**Collectivists**</span> were not spared: their party was banned and its leadership driven into exile, a condition the Empire required and Staal was willing to meet. The <span style="color: #005EB8;">beast-blooded</span> were given several months to sell their land and homes, after which they were required to leave the realm.

For most of the population, life under the restored Crown was quieter than the years before it. The God of Magic was raised to the head of the state religion, but the Faithful faced no political persecution. Magi who swore loyalty to the Empress were rapidly elevated in status, and many did so. Within a few years the reunified Commonwealth had begun to rearm, its foreign policy turned west toward <span style="color: #002654;">Ethia</span> and the lands lost in the old wars.

Neither Staal nor DuFour had tried to defend the republic; both had concluded it could not be saved. What they refused to accept was a civil war or a hopeless defeat, and they avoided both. Commonwealth democracy did not survive the Convention. Most of its people did. Whether that was a worthwhile exchange remained a matter of debate for decades afterward.

- @go_back

@weimar_win
title: The Unity Republic Limps Forward
subtitle: Ending 2
view-if: ((weimar_win and not return_to_normalcy and marcher_votes < 50 and marcher_r < 50 and pro_republic < 80 and royalist_votes >= 8 and not civil_war_seen) or (weimar_win and (return_to_normalcy or marcher_votes >= 50 or marcher_r >= 50 or pro_republic >= 80 or royalist_votes < 8) and not civil_war_seen and rubicon)) and empire_outcome == ""
new-page: true

[? if rubicon: The republic survived the Commonwealth Convention, but narrowly, and more through the failure of the men who would have ended it than through any strength of its own. The precedent was a dangerous one: a president had lost faith in parliament, suspended ordinary politics, and invited generals to govern in its place, and the institutions had bent rather than broken only by luck and exhaustion. The Empire-in-Exile, denied its opening, withdrew to wait for the next moment of weakness, and few doubted one would come. The Commonwealth that emerged was intact but unstable—its democracy preserved and badly shaken, its recovery far from certain, its survival dependent on years of hard and unglamorous work.

?]Following the scarring experience of the <span style="color: #7A3C00;">Royalist</span> movement’s rapid rise and implosion, the flaws of the Unity system became impossible to ignore. But in the end, the <span style="color: #7A3C00;">reactionaries</span> and <span style="color: #700000;">Collectivists</span> who once battled in the streets now stand together in soup lines. Though a number of neo-<span style="color: #7A3C00;">Royalist</span> movements would emerge after [+ royalist_leader +]’s mask of sanity slipped, the ideology itself remains irrevocably discredited.

No war as destructive as the Great Wars would come again. Slowly, the Commonwealth and the <span style="color: #0A3161;">western powers</span> began to rebuild relations, choosing to forget and forgive. <span style="color: #7A3C00;">Reaction</span> never takes root as a dominant force, and the chief threat to the continent's democracies becomes the resurgent <span style="color: #750e0e;">Central Union</span>. The revolutions in the far south end in a republican victory. [? if austria_defeat: Before long, the <span style="color: #7A3C00;">monarchist</span> regime in the Freehold collapses under popular revolt.?][? if sdapo_win or force_peace: Before long, the Freehold's ruling <span style="color: #A50034;">**Liberty Movement**</span> holds a referendum confirming the realm's accession into the Commonwealth. ?][? if long_war_2: The war in the Freehold is eventually won by the <span style="color: #7A3C00;">monarchists</span>, who receive generous aid from a kindred crown abroad.?]  Isolated and denied any success in its own expansionist aims, the southern strongman is deposed in a monarchist coup, and the south returns to democratic governance[? if long_war_2:, leading the Freehold's regime to democratize as a consequence of losing its benefactor?].

The distant colonies remain in bondage for generations more. What independence comes is granted largely on the colonizers' terms; exploitation persists under a different guise. The cold standoff unfolds along stranger lines, as a "state-capitalist" <span style="color: #750e0e;">Central Union</span> endures, binding to itself a nationalist eastern empire and the freed realms of the far south, which had bled to throw off the western yoke. This three-cornered alliance has solidified into a global power of its own.

[? if not (pro_republic < 50 and marcher_votes < 25 and unionist_ideology == "Right" and unionist_relation < 35 and traditionalist_ideology == "Radical"): Today, the Commonwealth is governed by a stable two-and-a-half party system, rotating power between a non-<span style="color: #9B0000;">Vaelist</span> <span style="color: #c00000;">**Marchers**</span>, the centrist <span style="color: #000000;">**Concord**</span>, and the liberal <span style="color: #FFCC00;">**LDPD**</span>. However, a surging <span style="color: #D79E2A;">**NDPD**</span> has emerged on the far right, capitalizing on public discontent over a refugee crisis driven by wars in the impoverished and unstable realms of the far south. ?]

- @weimar_win_a
- @go_back_2

@weimar_win_a
Title: Subending A - The World's Most Unstable Republic
view-if: pro_republic < 50 and marcher_votes < 25 and unionist_ideology == "Right" and unionist_relation < 35 and traditionalist_ideology == "Radical"

The political deadlock that defined the gravest crisis of the Unity Republic has persisted over the years. The <span style="color: #3E88B3;">**Traditionalists**</span> has never been fully reconciled with a system it was fundamentally opposed to from the start. Meanwhile, the estrangement of the <span style="color: #000000;">Unionist Party</span> from the Unity Coalition has only deepened right-wing hostility toward the <span style="color: #c00000;">**Marchers**</span>.

The presidency has remained out of reach for the <span style="color: #c00000;">**Marchers**</span>, with successors to DuFour's worldview continuing to preside over the Commonwealth and obstruct our return to executive power. Years later, a fresh recession—sparked by unrest abroad and rising tensions with the <span style="color: #750e0e;">Central Union</span>—triggered another wave of extremism. The Commonwealth Army was forced to step in to prevent a "March on Axton" by both <span style="color: #700000;">Collectivists</span> and <span style="color: #7A3C00;">reaction</span>.

Though real democracy was formally restored a generation later following massive public discontent, the <span style="color: #6A1E1E;">**CSG**</span> has remained a persistent force on the far-right. Recently rebranding itself as the <span style="color: #D79E2A;">**NDPD**</span>, it has capitalized on growing public anger over a refugee crisis driven by continued war and instability across the far south.

- @go_back

@weimar_mega_win
title: The Unity Republic Marches On
subtitle: Ending 3
view-if: weimar_win and (return_to_normalcy or marcher_votes >= 50 or marcher_r >= 50 or pro_republic >= 80 or royalist_votes < 8) and not civil_war_seen and not rubicon and empire_outcome == ""
new-page: true

At the turn of the decade, the long calamity and widespread disillusionment with the Unity system left few optimists in the Commonwealth. Yet, the Republic—forged by the will of the people all those years ago—has weathered a crisis of unprecedented proportions. <span style="color: #c00000;">Reformism</span> endures, as do its detractors.

No war as destructive as the Great Wars would come again. Slowly, the Commonwealth and the <span style="color: #0A3161;">western powers</span> began to rebuild relations, choosing to forget and forgive. <span style="color: #7A3C00;">Reaction</span> never takes root as a dominant force, and the chief threat to the continent's democracies becomes the resurgent <span style="color: #750e0e;">Central Union</span>. The revolutions in the far south end in a republican victory. [? if austria_defeat: Before long, the <span style="color: #7A3C00;">monarchist</span> regime in the Freehold collapses under popular revolt.?][? if sdapo_win or force_peace: Before long, the Freehold's ruling <span style="color: #A50034;">**Liberty Movement**</span> holds a referendum confirming the realm's accession into the Commonwealth. ?][? if long_war_2: The war in the Freehold is eventually won by the <span style="color: #7A3C00;">monarchists</span>, who receive generous aid from a kindred crown abroad.?] Isolated and denied any success in its own expansionist aims, the southern strongman is deposed in a monarchist coup, and the south returns to democratic governance[? if long_war_2:, leading the Freehold's regime to democratize as a consequence of losing its benefactor?].

The distant colonies remain in bondage for generations more. What independence comes is granted largely on the colonizers' terms; exploitation persists under a different guise. The cold standoff unfolds along stranger lines, as a "state-capitalist" <span style="color: #750e0e;">Central Union</span> endures, binding to itself a nationalist eastern empire and the freed realms of the far south, which had bled to throw off the western yoke. This three-cornered alliance has solidified into a global power of its own.

- @weimar_mega_win_a
- @weimar_mega_win_b

@weimar_mega_win_a
Title: Subending A - One and a Half Party system
view-if: marcher_votes >= 50 or marcher_r >= 50

The <span style="color: #c00000;">**Marchers**</span>'s rule over the Commonwealth has endured for decades, following its sublime management of the long calamity and successful expansion of support beyond the urban working class. To this day, the <span style="color: #c00000;">**Marchers**</span> retains its status as the "natural governing party," having only been out of office during brief stints in times of crisis. Only a united coalition of all parties from the <span style="color: #FF5349;">**SRPD**</span> to the <span style="color: #3E88B3;">**Traditionalists**</span> has ever managed to take power—only to quickly collapse, paving the way for yet more years of <span style="color: #c00000;">**Marchers**</span> rule.

- @go_back

@weimar_mega_win_b
Title: Subending B - Bloc Politics
view-if: marcher_votes < 50 and marcher_r < 50

The Unity Coalition has begun to fracture, as the <span style="color: #000000;">Unionist Party</span> exits the alliance and repositions itself as a center-right force. However, lingering animosity toward the parties further to the right prevents any formal unification. Instead, the newly formed <span style="color: #000000;">Commonwealth People's Conservative Party</span> has opted to form a new electoral alliance—the "People's Bloc"—alongside the <span style="color: #3E88B3;">**Traditionalists**</span> and the newly established <span style="color: #98C22C;">**NLP**</span>—which is essentially a renamed continuation of its predecessor.

We are only able to enter government as part of a "left bloc" with the <span style="color: #E0B0FF;">**RDP**</span>, <span style="color: #FF7F00;">**CSRP**</span>, and <span style="color: #BE3075;">**LSPD**</span>. This has continued to this day, but the inclusion of the purportedly neo-<span style="color: #7A3C00;">Royalist</span> <span style="color: #D79E2A;">**NDPD**</span> into the People's Bloc—capitalizing on public discontent over a refugee crisis sparked by wars in the impoverished and unstable realms of the far south—is deeply concerning.

- @go_back

@civil_war_win
title: Civil War
subtitle: Ending 4
view-if: civil_war_seen and republic_victory
new-page: true

Following a brief civil war between <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> forces and the <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span>, we’ve been given a blank slate to rebuild the Commonwealth on a truly democratic and social foundation—free, for now, from the fear of reactionary reprisals. A minor coup attempt by General Bredon is foiled, and with it, the Commonwealth Army is finally brought under the banner of the <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ic</span>.

But it is not all sunshine and rainbows. The civil war has devastated countless lives, and the costs of reconstruction and welfare have triggered the return of hyperinflationary nightmares. Hunger now exceeds levels seen during the long calamity, and many are already growing disillusioned with their supposed saviors. Though the reactionary and far-right forces were defeated on the battlefield, it's only a matter of years before a new right-wing movement emerges and takes root among the weary and discontented populace.

No war as destructive as the Great Wars would come again. Slowly, the Commonwealth and the <span style="color: #0A3161;">western powers</span> began to rebuild relations, but <span style="color: #002654;">Ethia</span>'s reoccupation of the western marches has complicated efforts. <span style="color: #7A3C00;">Reaction</span> never takes root as a dominant force, and the chief threat to the continent's democracies becomes the resurgent <span style="color: #750e0e;">Central Union</span>. The revolutions in the far south end in a republican victory. [? if austria_defeat: Before long, the <span style="color: #7A3C00;">monarchist</span> regime in the Freehold collapses under popular revolt.?][? if sdapo_win or force_peace: Before long, the Freehold's ruling <span style="color: #A50034;">**Liberty Movement**</span> holds a referendum confirming the realm's accession into the Commonwealth. ?][? if long_war_2: The war in the Freehold is eventually won by the <span style="color: #7A3C00;">monarchists</span>, who receive generous aid from a kindred crown abroad.?] Isolated and denied any success in its own expansionist aims, the southern strongman is deposed in a monarchist coup, and the south returns to democratic governance[? if long_war_2:, leading the Freehold's regime to democratize as a consequence of losing its benefactor?]..

The distant colonies remain in bondage for generations more. What independence comes is granted largely on the colonizers' terms; exploitation persists under a different guise. The cold standoff unfolds along stranger lines, as a "state-capitalist" <span style="color: #750e0e;">Central Union</span> endures, binding to itself a nationalist eastern empire and the freed realms of the far south, which had bled to throw off the western yoke. This three-cornered alliance has solidified into a global power of its own.

- @civil_war_win_a
- @civil_war_win_b

@civil_war_win_a
Title: Subending A - A False Victory
view-if: pro_republic < 70 or marcher_votes < 30

The fracturing of the <span style="color: #c00000;">**Marchers**</span> into the <span style="color: #f0456a;">**SVD**</span> and the <span style="color: #9B0000;">**SUP**</span> in the wake of post-war optimism deeply divided the Commonwealth left. As in years past, leftist disunity once again produced a scenario where a "New Unity Coalition"—composed of the <span style="color: #f0456a;">**SVD**</span>, <span style="color: #C0A054;">Golds</span>, and <span style="color: #FF7F00;">**CSRP**</span>—was unable to secure a majority. This led to repeated snap elections, ultimately fueling another resurgence of extremism.

It was only through the formation of the <span style="color: #BFC8CC;">Commonwealth National Unity Front</span>—a broad alliance of all bourgeois parties—and the election of Gareth Gesling as president that the Commonwealth finally escaped its political deadlock. The resulting coalition of the <span style="color: #000000;">**ZCA**</span>, <span style="color: #C0A054;">**Golds**</span>, and <span style="color: #38C538;">**DBP**</span> emerged as the new “natural governing bloc,” as persistent ideological rifts continued to paralyze the left. The <span style="color: #f0456a;">**SVD**</span>, increasingly marginalized, was at times compelled to tolerate these centrist cabinets in the name of stability—abandoning its <span style="color: #9B0000;">Vaelist</span> roots in the process and ceding leadership of the left to the more radical <span style="color: #9B0000;">**SUP**</span>.

Only with the third wave of democratization, generations on, did the long-divided Commonwealth left begin to reunify. The gradual moderation and eventual merger of the <span style="color: #9B0000;">**SUP**</span> and the <span style="color: #f0456a;">**SVD**</span> culminated in the formation of the <span style="color: #c00000;">**VSPD**</span>, which at last returned to government after decades in opposition.

- @go_back

@civil_war_win_b
Title: Subending B - The Socialist Dream
view-if: pro_republic >= 70 and marcher_votes >= 30

Despite the blank slate granted to the <span style="color: #c00000;">**Marchers**</span> to reshape the Commonwealth in its image, the country has faced relentless challenges: the hyperinflationary crisis of the early years, the resurgence of the <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span> a decade on, and a series of counterproductive bans that only emboldened reactionary forces. Yet, step by step, the Commonwealth rebuilds.

Even following the <span style="color: #c00000;">**Marchers**</span>’s splintering into the <span style="color: #9B0000;">**SUP**</span> and <span style="color: #f0456a;">**SVD**</span> due to foreign policy disputes a decade on, both parties cooperated to construct a comprehensive welfare state—one that could stand alongside the northern models in its scope and ambition.

The bourgeois opposition—comprising the <span style="color: #000000;">**ZCA**</span>, <span style="color: #C0A054;">**Golds**</span>, and <span style="color: #38C538;">**DBP**</span>—was relegated to a state of permanent irrelevance, unable to halt the wave of reforms: the rise of workplace councils, sweeping nationalizations, and the assertion of state control over the Commonwealth Bank.

However, the stagnation of later decades marked the beginning of the end for traditional leftist dominance. As the middle class expanded at the expense of the working class, the foundations of class politics began to erode—giving rise to a new multiparty system and ending the era of unchallenged <span style="color: #c00000;">socialist</span> rule.

- @go_back

@civil_war_long
title: the Commonwealth Divided
subtitle: Ending 5
view-if: civil_war_seen and long_war and not (president = "Hargen" and chancellor == "Selden")
new-page: true

As the frontlines settle, a <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> state—committed to the continuation of Unity the Commonwealth—takes root in the West, while a newly formed Red Guard establishes <span style="color: #700000;">**Collectivist**</span> control over the industrial belt. The fragile alliance of <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span> forces soon fractures, with the <span style="color: #3E88B3;">**Wardens**</span> and the <span style="color: #7A3C00;">Royalist militia</span> turning against one another in violent internal conflict.

Isen Glade eventually reduces [+ royalist_leader +] to a puppet, seizing full control and unleashing unspeakable atrocities against the local <span style="color: #005EB8;">beast-blooded</span> and conquered peoples in the territories under their control. A renewed offensive by <span style="color: #000000;">rep</span><span style="color: #DD0000;">ubl</span><span style="color: #FFCC00;">ican</span> forces exploits the chaos on the Right, culminating in the defeat of the reactionary militias. However, a brutal campaign continues in the industrial belt, where every town exacts a death toll of thousands.

Before long, the Commonwealth remains fractured. The northern realms have seized the moment to occupy parts of the East Heartland marches, citing the protection of their kin. Meanwhile, the <span style="color: #002654;">Ethian</span> dispatch a "peacekeeping" force into the western marches. In the end, it is not so much a victory for the Republic as it is a decisive collapse of the <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span>.

No war as destructive as the Great Wars would come again. Slowly, the Commonwealth and the <span style="color: #0A3161;">western powers</span> began to rebuild relations, but <span style="color: #002654;">Ethia</span>'s reoccupation of the western marches has complicated efforts. <span style="color: #7A3C00;">Reaction</span> never takes root as a dominant force, and the chief threat to the continent's democracies becomes the resurgent <span style="color: #750e0e;">Central Union</span>. The revolutions in the far south end in a republican victory. [? if austria_defeat: Before long, the <span style="color: #7A3C00;">monarchist</span> regime in the Freehold collapses under popular revolt.?][? if sdapo_win or force_peace: Before long, the Freehold's ruling <span style="color: #A50034;">**Liberty Movement**</span> holds a referendum confirming the realm's accession into the Commonwealth. ?][? if long_war_2: The war in the Freehold is eventually won by the <span style="color: #7A3C00;">monarchists</span>, who receive generous aid from a kindred crown abroad.?] Isolated and denied any success in its own expansionist aims, the southern strongman is deposed in a monarchist coup, and the south returns to democratic governance[? if long_war_2:, leading the Freehold's regime to democratize as a consequence of losing its benefactor?].

The distant colonies remain in bondage for generations more. What independence comes is granted largely on the colonizers' terms; exploitation persists under a different guise. The cold standoff unfolds along stranger lines, as a "state-capitalist" <span style="color: #750e0e;">Central Union</span> endures, binding to itself a nationalist eastern empire and the freed realms of the far south, which had bled to throw off the western yoke. This three-cornered alliance has solidified into a global power of its own.

- @civil_war_long_a
- @civil_war_long_b

@civil_war_long_a
Title: Subending A - The Black Spot of the Continent
view-if: not west_aid

Despite the Republic’s paper victory, revanchist sentiment over the loss of Eastern and Western territories, coupled with mass radicalization from the staggering death toll, destruction, hyperinflation, widespread hunger, and the absence of meaningful foreign aid, has deeply discredited the political establishment. Under pressure from the Commonwealth Army, martial law remains in place for years, with the military increasingly intruding into civilian governance.

Years later, a global recession—triggered by escalating instability abroad and threats from the <span style="color: #750e0e;">Central Union</span>—obliterates the reconstruction progress made by the ruling <span style="color: #c00000;">**Marchers**</span>, plunging the country into yet another crisis. Following a March on Axton, a "Third Positionist" regime seizes power, led by a new political party composed of former <span style="color: #7A3C00;">Royalists</span> and disillusioned <span style="color: #c00000;">socialists</span>.

the Commonwealth pivots toward autarky and radical self-reliance, sealing its borders to foreigners. The regime earns the moniker "the Black Spot of the continent," ruling for two generations. In that time it coerces the withdrawal of foreign troops from the western marches and reclaims its lost eastern lands—including the contested corridor—capitalizing on the northern realms' distraction with the <span style="color: #750e0e;">Central Union</span> and the shifting priorities of the <span style="color: #0A3161;">western powers</span> as they wage their own distant war.

Today, the Commonwealth remains largely isolated from the rest of the world, with the successor to the dictatorship of old being not much better, being ruled by oligarchs and the wealthy who are relicts of the past regime. Now, the task of <span style="color: #c00000;">Reformism</span> is to prepare for the next election. The incumbent conservative government is unpopular, and we stand to gain. Perhaps the next government will have a <span style="color: #c00000;">socialist</span> plurality.

- @go_back

@civil_war_long_b
Title: Subending B - A <span style="color: #001489;">Concordant</span> <span style="color: #FFDD00;">Future</span>
view-if: west_aid

In exchange for the return of the western marches and the lifting of its post-war War Loans burden, the Commonwealth is compelled to enter a defensive pact with <span style="color: #002654;">Ethia</span> and the <span style="color: #C8102E;">Allied States</span>. With assistance from the <span style="color: #10069f;">Assembly of Realms</span> and the wider West, a punitive but generous reconstruction program, funded by the <span style="color: #0A3161;">western powers</span>, successfully facilitates Commonwealth reconstruction and ushers in an economic miracle under the leadership of Chancellor Konrad Aldermoor.

By the end of the decade, the economies of the <span style="color: #0A3161;">West</span> become increasingly interconnected. Further integration into a nascent "<span style="color: #001489;">Regional</span> <span style="color: #FFDD00;">Concordant</span>"—featuring free trade and the free movement of people—is negotiated by the internationalist <span style="color: #c00000;">**Marchers**</span> and the <span style="color: #C0A054;">**Golds**</span>. Renewed <span style="color: #750e0e;">Central Union</span> threats to the northern and eastern realms, alongside the democratization of the Freehold and the south, have once again galvanized a united continental response to <span style="color: #750e0e;">radical-Collectivist</span> aggression.

Today, the Commonwealth remains a pillar of a federal <span style="color: #001489;">Regional</span> <span style="color: #FFDD00;">Concordant</span> stretching across the West. Now, the task of <span style="color: #f0456a;">Reformism</span> is to prepare for the next election. The incumbent conservative government is unpopular, and we stand to gain. Perhaps the next government will have a <span style="color: #f0456a;">socialist</span> plurality.

- @go_back

@monarchy_win
title: Rule of the Lords
subtitle: Ending 6
view-if: president = "Hargen" and chancellor == "Selden"
new-page: true

With the <span style="color: #7A3C00;">Royalist</span> movement in decline following the end of the economic calamity and an internal leadership struggle, and with the election of the <span style="color: #3E88B3;">nationalist</span> Hargen alongside the appointment of the <span style="color: #3E88B3;">**Wardens**</span>'s Selden, it appears that <span style="color: #808080;">reaction</span> has triumphed over <span style="color: #7A3C00;">revolution</span>. Although various neo-<span style="color: #7A3C00;">Royalist</span> splinters emerged after [+ royalist_leader +]’s final descent into delusion, the ideology itself remains irrevocably discredited.

The Commonwealth Army suppressed an attempted uprising by the <span style="color: #7A3C00;">Royalist militia</span> and purged the remaining <span style="color: #7A3C00;">Royalist</span> elements from government. In heavily managed elections, under the watch of "electoral monitors", the <span style="color: #3E88B3;">aristocratic and Traditionalist</span> parties secured a manufactured mandate. They did not pursue reunification with the Empire, and they crowned no one: the Axton court was regarded with suspicion, and the great landed and noble families preferred to keep power in their own hands. Over the following years the remnants of the republic were dismantled and replaced by rule through a council of the realm's leading nobility, with what elections continued returning only approved candidates. Soon after, a secret rearmament program was launched.

With ambitions fixed on the lost marches of the East and the occupied lands of the West, the Commonwealth began courting allies for its revisionist aims. The restoration of the old crown in the <span style="color: #7A3C00;">Freehold</span>, and the toppling of the southern strongman in a monarchist coup, drastically altered the balance of power. When the northern realms refused to return former imperial lands, the <span style="color: #002654;">Ethian</span> and the <span style="color: #0A3161;">Allied States</span> turned a blind eye to escalating Commonwealth border skirmishes. A <span style="color: #700000;">radical-Collectivist</span> victory in the far south, and the wave of revolutions it triggered across the continent, forced the great powers to prioritize containment of the <span style="color: #750e0e;">Central Union</span> above all else.

The distant colonies remain in bondage for generations more. What independence comes is granted largely on the colonizers' terms; exploitation persists under a different guise. The cold standoff unfolds along stranger lines, as a "state-capitalist" <span style="color: #750e0e;">Central Union</span> endures, binding to itself a nationalist eastern empire and the freed realms of the far south, which had bled to throw off the western yoke. This three-cornered axis grew into a global power of its own, gathering <span style="color: #700000;">radical</span> regimes the world over.

Today, the Commonwealth is a dominant party state, ruled by the elites of the <span style="color: #3E88B3;">**Traditionalists**</span> and the noble houses behind them, who have maintained control for nearly a century. Although dissatisfaction with aristocratic rule and the growing strength of the opposition have forced some minor reforms, each new election consistently delivers a majority for the incumbent coalition. However, cracks are beginning to show in the system. New, young, and popular <span style="color: #c00000;">**Marchers**</span> leaders are making inroads despite state repression—one of them the first to win real power, taking the Minister-Presidency of Stathmore. Perhaps the next government will have a mere <span style="color: #3E88B3;">nationalist</span> plurality.

- @go_back

@papen_win
title: The Imperfect Dictatorship
subtitle: Ending 7
view-if: papen_win
new-page: true

Despite being hated by nearly 90% of the population, Ferris Goodryke's surprising victory—secured through the backing of the elites and the Commonwealth Army—brought him to power in a deeply fractured the Commonwealth. However, consolidating that power proved difficult. Despite the eradication of organized <span style="color: #700000;">Collectivist</span> and <span style="color: #c00000;">Reformist</span> resistance, the industrial heartland remains ablaze with unrest. Meanwhile, ongoing conflict between Goodryke and Werner Staal, who still maintains significant influence within the military, further destabilizes his regime.

Goodryke's nationalist foreign policy has won him few friends abroad, and his goal of unshackling the Commonwealth from the chains of Etaluxia remains distant. In an effort to restore order, Goodryke forms a "National Regeneration Government", rooted in conservative Faithful values, militarism, and the authority of the old elite. Following the death of President Paul DuFour, no figure of comparable standing emerged to replace him, and power settled firmly with the political elite, the industrial magnates, and the army. Goodryke crowned no one and sought no accommodation with the Empire; the Commonwealth is transformed into a dictatorship, with the "New State" he envisioned centralizing authority in the executive.

After a period of economic recovery, Goodryke turns his attention toward foreign policy, seeking to broker an entente with <span style="color: #002654;">Ethia</span> to combat <span style="color: #700000;">radical Collectivism</span> in the East. When these efforts failed, he turned instead to the <span style="color: #7A3C00;">monarchist</span> Freehold and the southern strongman’s realm, who remained among the Commonwealth’s few continental allies.

In time, however, the regime begins to decay. Corruption, unrest, and economic stagnation—coupled with Goodryke’s death—trigger a political thaw. The "Heartland Spring" ushers in a wave of democratic reforms, but the entrenched elites of the old system work to protect their interests. The military retains an active and unofficial role in politics, making it impossible for the reconstituted <span style="color: #c00000;">**Marchers**</span> to assume power without risking a coup.

The distant colonies remain in bondage for generations more. What independence comes is granted largely on the colonizers' terms; exploitation persists under a different guise. The cold standoff unfolds along stranger lines, a <span style="color: #750e0e;">Central Union</span> surviving intact but somewhat softened, serving as the keystone of a global alliance encompassing the <span style="color: #700000;">radical</span> regimes worldwide.

Today, the Commonwealth is a multiparty democracy, following the ousting of the successor conservative party founded by figures of the former regime. Yet all is not well in the republic. The conservative president, heir to the old regime's nostalgics, has drawn criticism for invoking longing for the old system, sparking fears of democratic backsliding and a concentration of power in favor of the oligarchs. Now, the task of <span style="color: #f0456a;">Reformism</span> is to prepare for the next presidential election. Our own standard-bearer is weighing another non-consecutive term; perhaps she is our only hope to topple him.

- @go_back

@left_win
title: The Left Front Triumphs!
subtitle: Ending 8
view-if: left_win
new-page: true
audio: music/1930_1933/Einheitsfrontlied.mp3

The United Front Government, under President [? if president == "Pendrigon": Cael Pendrigon?][? if president == "Halsmark": Ernst Halsmark?][? if president == "Munzer": Willem Munzer?][? if president == "Ostwick": Carl Ostwick?][? if president == "Mann": Heinrich Mann?], withstood everything thrown its way—<span style="color: #C0A054;">capitalist</span> treachery, <span style="color: #3E88B3;">institutional</span> sabotage, and constant subversion by <span style="color: #808080;">reactionaries</span>. Some years on, after winning a second election and slightly increasing its majority, the government faced a coup attempt led by the <span style="color: #808080;">reactionary</span> elements of the Commonwealth Army and increasingly radicalized <span style="color: #3E88B3;">nationalists</span> and <span style="color: #7A3C00;">far</span>-<span style="color: #3E88B3;">right</span> forces. 

The coup failed. The abortive putsch was crushed by the proletarian masses and shattered the political landscape of Unity. The far left of the [? if not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if lvp_formed: <span style="color: #C0A054;">**Golds**</span>?] and [? if unionist_party_name != "Concord": <span style="color: #000000;">Unionists</span>?][? if unionist_party_name == "Concord": <span style="color: #000000;">**Concord**</span>?]—splinters from their parties who maintained ambiguity towards the coup—split off to form the <span style="color: #E0B0FF;">**RDP**</span> and <span style="color: #FF7F00;">**CSRP**</span>, both of which soon joined the United Front.

With the bourgeois center increasingly marginalized, the botched coup gave the United Front the momentum needed to finally purge the Republic of <span style="color: #808080;">reactionary</span> forces and initiate a <span style="color: #9B0000;">socialist</span> economy. Eventually a constitutional convention was called to begin a <span style="color: #9B0000;">Socialist Republic</span>.

- @left_win_a
- @left_win_b

@left_win_a
Title: Subending A - The Vaelists Rise Again
view-if: not collectivist_win

The convention is called, and with overwhelming support, it dismantles the old bourgeois institutions. At last, after all these years, the Commonwealth <span style="color: #750e0e;">Collective Republic</span> is formed—and this time, "All Power to the <span style="color: #750e0e;">Collectives</span>" is more than just a slogan. The <span style="color: #c00000;">**Marchers**</span> takes the lead in constructing the <span style="color: #750e0e;">Collective Republic</span>. Though the process is complex and at times byzantine, born of compromise among many factions, it is unmistakably <span style="color: #700000;">revolutionary</span>.

No war as destructive as the Great Wars would come again. The revolutions in the far south end in a republican victory. [? if austria_defeat: Before long, the <span style="color: #7A3C00;">monarchist</span> regime in the Freehold collapses under popular revolt.?][? if sdapo_win or force_peace: Before long, the Freehold's ruling <span style="color: #A50034;">**Liberty Movement**</span> holds a referendum confirming the realm's accession into the Commonwealth. ?][? if long_war_2: The war in the Freehold is eventually won by the <span style="color: #7A3C00;">monarchists</span>, who receive generous aid from a kindred crown abroad.?] Isolated and denied any success in its own expansionist aims, the southern strongman is deposed in a monarchist coup, and the south returns to democratic governance[? if long_war_2:, leading the Freehold's regime to democratize as a consequence of losing its benefactor?].

In a world largely hostile to <span style="color: #9B0000;">socialism</span>, we stand as a shining example: the economy is <span style="color: #c00000;">socialized</span>, and economic control is placed directly in the hands of the <span style="color: #c00000;">proletariat</span>. The <span style="color: #750e0e;">Central Union</span> remains distant, as does the <span style="color: #0A3161;">West</span>. We emerge as a beacon of socialism amid the growing tensions of a cold standoff—between the <span style="color: #750e0e;">**radical East**</span>, a nationalist eastern empire, and the free realms of the far south on one side, and the capitalist <span style="color: #0A3161;">West</span> on the other.

We maintain a strictly neutral stance, offering principled opposition to both blocs. In doing so, we inspire many nations to follow our political and geopolitical path. Our shining <span style="color: #9B0000;">socialist republic</span> manages to survive, until the end of an inconclusive cold standoff in détente.

As a key neutral player throughout the cold standoff, we reap the benefits—becoming a center for dialogue and commerce. With the arrival of détente, more and more nations join us in non-alignment.

All is not golden though. Our republic is prone to infighting, as the various proletarian groups represented in the economy often clash over resource allocation. Additionally, our collective-centered system faces criticism for its inability to adapt to modern conditions, with growing signs of bureaucratic inefficiency. Nevertheless, in time, the Collective Republic remains a bastion of <span style="color: #c00000;">socialism</span> and <span style="color: #9B0000;">orthodoxy</span>.

Our politics, culture, and economy are still deeply proletarian. Albeit <span style="color: #f0456a;">third way</span> and even <span style="color: #98C22C;">capitalist</span> parties remain on our right—and hardline <span style="color: #700000;">vanguardists</span> on our left—the <span style="color: #c00000;">**Marchers**</span> and its successor parties maintain a firm hold on the Republic.

- @go_back

@left_win_b
Title: Subending B - The Vanguard Takes the Helm
view-if: collectivist_win

As the Constitutional Assembly convenes, it is gradually decided that the new <span style="color: #700000;">socialist</span> state will take inspiration from the great eastern revolution and the <span style="color: #750e0e;">Central Union</span>’s <span style="color: #700000;">vanguardist</span> model. The <span style="color: #c00000;">**Marchers**</span>—whether convinced, divided, or simply powerless to stop the shift—accepts it. The two <span style="color: #9B0000;">**socialist**</span> parties rapidly merge into a single party that monopolizes power in the new state, while allowing some minor parties to remain as bloc parties. The <span style="color: #DC241F;">**Socialist Unity Party**</span> (<span style="color: #DC241F;">**SUP**</span>) takes the helm.

The regime immediately begins aligning with the <span style="color: #750e0e;">Central Union</span> and puts forth its first sweeping economic plans. Soon, the State becomes a member of the radical eastern bloc. A second great war breaks out, a vast conflict between the <span style="color: #0A3161;">capitalist</span> and <span style="color: #700000;">Collectivist</span> worlds. It ends with a vast eastern bloc stretching across half the continent. A cold standoff begins against the <span style="color: #0A3161;">Allied States</span>, the western powers, a nationalist eastern empire, and the <span style="color: #002654;">Ethian</span> government in exile.

The <span style="color: #DC241F;">**SUP**</span> assumes an important role in the radical bloc as the leader of its second most industrialized country. the Commonwealth experiences decades of growth under the economic plans, calming most dissent within the country. To combat the remaining opposition, the Party establishes its own dread secret police, modeled on the <span style="color: #750e0e;">Central Union</span>’s.

Alongside the radical bloc, the <span style="color: #750e0e;">Collective Republic</span> of the Commonwealth largely wins the cold standoff. Key factors include the collapse of the western colonies, a great eastern civil war ending with an unaligned <span style="color: #960000;">socialist</span> realm, and the <span style="color: #0A3161;">Allied States</span> and the western powers shifting towards isolationism.

However, in time, economic problems worsen: inflation rises, corruption grows, and the <span style="color: #750e0e;">people’s democracies</span> begin to decay. Dissent grows to levels even the harshest measures of the secret police fail to contain.

Amid these conditions, a reforming General Secretary of the <span style="color: #750e0e;">Central Union</span> initiates a controlled transition toward genuine <span style="color: #9B0000;">democratic socialism</span>, inspired by the eastern model. Today, the Commonwealth holds its first elections under this new system. The political spectrum is dazzling and complex, though heavily weakened and under state supervision. The quasi-capitalist <span style="color: #87CEFA;">**CNVP**</span> and <span style="color: #FFD700;">**LSV**</span> form a coalition against the <span style="color: #DC241F;">socialists</span> and are gaining momentum.

New socialist parties emerge as the <span style="color: #DC241F;">**SUP**</span> fractures between <span style="color: #700000;">hardliners</span> and <span style="color: #f0456a;">reformers</span>. Perhaps the next government will have a <span style="color: #c00000;">**SEPD**</span> majority.

- @go_back

